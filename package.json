{
  "name": "central-agentic-ops",
  "private": true,
  "scripts": {
    "setup:github-apps": "node .github/cao/setup-github-apps.mjs",
    "activity:local": "local-action run activity local-runner.mjs",
    "activity:local:node": "node activity/local-runner.mjs",
    "dashboard:local": "node dashboard/local-server.mjs",
    "dashboard:local:copilot": "node dashboard/local-server.mjs --copilot",
    "dev": "node dashboard/local-server.mjs --copilot --replace-existing --trace-file .cao-dashboard-traces/latest.jsonl",
    "docs:dev": "astro dev",
    "docs:build": "astro build",
    "docs:preview": "astro preview",
    "lint": "node scripts/check-file-sizes.mjs",
    "typecheck:cao": "npx tsc -p .github/cao/tsconfig.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/control-admission.test.mjs tests/integration/control-failure.test.mjs tests/integration/control-policy-resolver.test.mjs",
    "test:package-lifecycle": "node --test --test-concurrency=1 tests/integration/package-lifecycle.test.mjs",
    "test:load": "node --test tests/load/*.test.mjs",
    "check:svg": "node scripts/check-svg-visual-language.mjs",
    "compile": "gh aw compile --no-emit --no-check-update --schedule-seed githubnext/gh-aw-cao",
    "compile:locks": "gh aw compile --no-check-update --schedule-seed githubnext/gh-aw-cao",
    "check": "npm run lint && npm run typecheck:cao && npm test && npm run test:load && npm run check:svg && npm run compile && npm run docs:build",
    "update-deps": "npx npm-check-updates -u && npm install",
    "test:e2e:copilot-loop": "playwright test --config=playwright.copilot-loop.config.mjs",
    "test:e2e:local-server": "playwright test --config=playwright.local-server.config.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.42.0",
    "@github/copilot-sdk": "1.0.11",
    "astro": "7.3.1",
    "starlight-github-alerts": "0.4.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@actions/core": "^2.0.2",
    "@actions/exec": "^2.0.0",
    "@actions/github": "^7.0.0",
    "@actions/io": "^2.0.0",
    "@github/local-action": "^7.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "undici": "^6.28.1"
  }
}
