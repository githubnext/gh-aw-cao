{
  "name": "central-agentic-ops",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "cao": "activity/cao.mjs"
  },
  "scripts": {
    "install:gh-aw": "curl -sL https://raw.githubusercontent.com/github/gh-aw/main/install-gh-aw.sh | bash -s -- v0.89.8",
    "setup:github-apps": "node .github/cao/setup-github-apps.mjs",
    "dashboard:local": "node dashboard/local-server.mjs",
    "dashboard:local:copilot": "node dashboard/local-server.mjs --copilot",
    "dashboard:local:mobile": "DASHBOARD_DATA_URL=https://githubnext.github.io/gh-aw-cao/cao/gh-aw-logs.jsonl MOBILE_BROWSER=chromium MOBILE_DEVICE='Pixel 7' MOBILE_PROFILE=low-memory MOBILE_MEMORY_MB=256 playwright test --config=playwright.mobile.config.mjs",
    "dashboard:data": "node activity/cao.mjs",
    "dashboard:data:download": "npm run dashboard:data -- download",
    "dev": "node dashboard/local-server.mjs --copilot --replace-existing --trace-file .cao-dashboard-traces/latest.jsonl",
    "docs:dev": "astro dev",
    "docs:build": "astro build",
    "docs:preview": "astro preview",
    "lint": "node scripts/check-file-sizes.mjs",
    "typecheck:cao": "npx tsc -p .github/cao/tsconfig.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/activity-cache.test.mjs tests/integration/control-admission.test.mjs tests/integration/control-failure.test.mjs tests/integration/control-policy-resolver.test.mjs",
    "test:package-lifecycle": "node --test --test-concurrency=1 tests/integration/package-lifecycle.test.mjs",
    "test:load": "node --test tests/load/*.test.mjs",
    "check:svg": "node scripts/check-svg-visual-language.mjs",
    "compile": "gh aw compile --strict --no-emit --no-check-update --schedule-seed githubnext/gh-aw-cao",
    "compile:locks": "gh aw compile --strict --no-check-update --schedule-seed githubnext/gh-aw-cao",
    "check": "npm run lint && npm run typecheck:cao && npm test && npm run test:load && npm run check:svg && npm run compile && npm run docs:build",
    "update-deps": "npx npm-check-updates -u && npm install",
    "test:e2e:docs": "npm run docs:build && playwright test --config=playwright.docs.config.mjs",
    "test:e2e:dashboard-views": "playwright test --config=playwright.dashboard-views.config.mjs",
    "test:e2e:dashboard-deployed": "playwright test --config=playwright.dashboard-deployed.config.mjs",
    "test:e2e:copilot-loop": "playwright test --config=playwright.copilot-loop.config.mjs",
    "test:e2e:local-server": "playwright test --config=playwright.local-server.config.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "0.42.0",
    "@github/copilot-sdk": "1.0.13",
    "astro": "7.3.2",
    "astro-mermaid": "2.1.0",
    "mermaid": "11.17.2",
    "starlight-github-alerts": "0.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@actions/core": "^2.0.3",
    "@actions/exec": "^2.0.0",
    "@actions/github": "^7.0.0",
    "@actions/io": "^2.0.0",
    "@github/local-action": "^7.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2"
  }
}
