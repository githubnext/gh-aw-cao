{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "self-care-dashboard",
    "title": "SelfCare",
    "description": "Track production Pages health, dashboard performance improvements, build-time investigations, and clustered failures across represented public projects.",
    "repository": "githubnext/gh-aw-cao",
    "queries": [
      {
        "name": "self-care-observed-runs",
        "intent": "Show runs for the SelfCare operations represented on this dashboard so operators can compare build, production, performance, and public-project health.",
        "from": "runs",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "in": [
                ".github/workflows/self-care-docs-build-time-investigator.md",
                ".github/workflows/self-care-pages-health.md",
                ".github/workflows/self-care-dashboard-performance.md",
                ".github/workflows/self-care-open-source-failures.md"
              ]
            }
          ]
        },
        "order-by": [
          {
            "field": "started-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "self-care-retained-outcomes",
        "intent": "List retained SelfCare recommendations, reports, improvements, and findings so maintainers can review evidence-backed follow-up work.",
        "from": "outcomes",
        "filter": {
          "predicates": [
            {
              "field": "package",
              "equals": "self-care"
            }
          ]
        },
        "order-by": [
          {
            "field": "published-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "self-care-build-attainment",
        "intent": "Show reliable docs build-speed attainment while preserving maturity, evidence cutoffs, and missing-evidence states.",
        "from": "operational-values",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "equals": ".github/workflows/self-care-docs-build-time-investigator.md"
            }
          ]
        },
        "order-by": [
          {
            "field": "observed-at",
            "direction": "desc"
          }
        ]
      }
    ],
    "pages": [
      {
        "id": "self-care-dashboard",
        "kind": "custom",
        "title": "SelfCare",
        "description": "Track production browser health, Lighthouse improvements, build-time investigations, speed attainment, and remediation findings for clustered public-project failures.",
        "icon": "check-circle",
        "views": [
          {
            "id": "self-care-build-runs",
            "title": "Build-time investigations by conclusion",
            "disclosure": "essential",
            "data": {
              "source": "self-care-observed-runs",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/self-care-docs-build-time-investigator.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "pie",
            "layout": "half",
            "encoding": {
              "x": {
                "field": "run-conclusion",
                "type": "nominal"
              },
              "y": {
                "field": "run",
                "type": "quantitative",
                "aggregate": "count"
              }
            }
          },
          {
            "id": "self-care-build-recommendations",
            "title": "Build-speed recommendations",
            "description": "Retained issues expose actionable timing evidence; creating an issue alone does not establish realized speed improvement.",
            "disclosure": "essential",
            "data": {
              "source": "self-care-retained-outcomes",
              "filters": {
                "workflow": [
                  ".github/workflows/self-care-docs-build-time-investigator.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No build-speed recommendations were retained.",
            "encoding": {
              "href": {
                "field": "external-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "outcome-title",
                  "type": "nominal",
                  "title": "Recommendation",
                  "display": "outcome-link"
                },
                {
                  "field": "outcome-state",
                  "type": "nominal",
                  "title": "Disposition",
                  "display": "status"
                },
                {
                  "field": "published-at",
                  "type": "temporal",
                  "format": "human-friendly-timestamp",
                  "title": "Published"
                }
              ],
              "actions": [
                {
                  "intent": "Review this build-speed recommendation, verify its retained timing evidence, and identify the safest follow-up.",
                  "presentation": "copy-prompt",
                  "icon": "search",
                  "label": "Review",
                  "context": [
                    "repository",
                    "outcome-title",
                    "outcome-summary",
                    "outcome-state",
                    "published-at",
                    "external-link"
                  ]
                }
              ]
            }
          },
          {
            "id": "self-care-build-attainment",
            "disclosure-label": "Reliable build-speed attainment",
            "description": "Attainment compares successful docs.yml execution times while requiring completed-run reliability to be preserved.",
            "disclosure": "supplemental",
            "data": {
              "source": "self-care-build-attainment",
              "filters": {
                "workflow": [
                  ".github/workflows/self-care-docs-build-time-investigator.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No matured build-speed attainment evidence is available.",
            "encoding": {
              "href": {
                "field": "evidence-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "operational-case",
                  "type": "nominal",
                  "title": "Performance opportunity"
                },
                {
                  "field": "operational-value",
                  "type": "quantitative",
                  "title": "Attainment"
                },
                {
                  "field": "maturity-status",
                  "type": "nominal",
                  "title": "Maturity",
                  "display": "status"
                },
                {
                  "field": "evidence-cutoff",
                  "type": "temporal",
                  "format": "human-friendly-timestamp",
                  "title": "Evidence cutoff"
                }
              ]
            }
          },
          {
            "id": "self-care-build-value-trend",
            "title": "Build-speed operational-value trend",
            "description": "Mean attainment summarizes repeated observations under the same frozen evaluator and does not establish causation.",
            "disclosure": "essential",
            "data": {
              "source": "self-care-build-attainment",
              "time": {
                "range": "90d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/self-care-docs-build-time-investigator.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "line",
            "layout": "full",
            "encoding": {
              "x": {
                "field": "observed-at",
                "type": "temporal",
                "format": "human-friendly-timestamp",
                "time-unit": "day"
              },
              "y": {
                "field": "operational-value",
                "type": "quantitative",
                "aggregate": "mean"
              },
              "color": {
                "field": "operational-value-definition",
                "type": "nominal"
              }
            }
          },
          {
            "id": "self-care-pages-health-runs",
            "title": "Pages health runs",
            "description": "Run conclusions for the six-hour desktop, mobile, and low-bandwidth production sweep.",
            "disclosure": "essential",
            "data": {
              "source": "self-care-observed-runs",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/self-care-pages-health.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "bar",
            "layout": "half",
            "encoding": {
              "x": {
                "field": "run-conclusion",
                "type": "nominal"
              },
              "y": {
                "field": "run",
                "type": "quantitative",
                "aggregate": "count"
              },
              "color": {
                "field": "run-conclusion",
                "type": "nominal"
              }
            }
          },
          {
            "id": "self-care-pages-health-outcomes",
            "description": "Replacement reports covering browser errors and per-view Lighthouse evidence across all production profiles.",
            "data": {
              "source": "self-care-retained-outcomes",
              "filters": {
                "workflow": [
                  ".github/workflows/self-care-pages-health.md"
                ]
              },
              "limit": 50
            },
            "disclosure-label": "Current Pages health reports",
            "disclosure": "supplemental",
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No Pages health reports were retained.",
            "encoding": {
              "href": {
                "field": "external-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "outcome-title",
                  "type": "nominal",
                  "title": "Report",
                  "display": "outcome-link"
                },
                {
                  "field": "outcome-state",
                  "type": "nominal",
                  "title": "Disposition",
                  "display": "status"
                },
                {
                  "field": "published-at",
                  "type": "temporal",
                  "format": "human-friendly-timestamp",
                  "title": "Published"
                }
              ]
            }
          },
          {
            "id": "self-care-dashboard-performance-runs",
            "title": "Dashboard performance runs",
            "description": "Run conclusions for trace-backed CFO, CTO, and CSO Lighthouse evaluations.",
            "disclosure": "supplemental",
            "data": {
              "source": "self-care-observed-runs",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/self-care-dashboard-performance.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "bar",
            "layout": "half",
            "encoding": {
              "x": {
                "field": "run-conclusion",
                "type": "nominal"
              },
              "y": {
                "field": "run",
                "type": "quantitative",
                "aggregate": "count"
              },
              "color": {
                "field": "run-conclusion",
                "type": "nominal"
              }
            }
          },
          {
            "id": "self-care-dashboard-performance-outcomes",
            "disclosure-label": "Dashboard performance improvements",
            "description": "Draft pull requests for one trace-backed Lighthouse bottleneck at a time; publication does not establish realized performance improvement.",
            "disclosure": "supplemental",
            "data": {
              "source": "self-care-retained-outcomes",
              "filters": {
                "workflow": [
                  ".github/workflows/self-care-dashboard-performance.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No dashboard performance improvements were retained.",
            "encoding": {
              "href": {
                "field": "external-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "outcome-title",
                  "type": "nominal",
                  "title": "Improvement",
                  "display": "outcome-link"
                },
                {
                  "field": "outcome-state",
                  "type": "nominal",
                  "title": "Disposition",
                  "display": "status"
                },
                {
                  "field": "published-at",
                  "type": "temporal",
                  "format": "human-friendly-timestamp",
                  "title": "Published"
                }
              ]
            }
          },
          {
              "id": "self-care-public-failure-runs",
              "title": "Public-project failure scans",
              "description": "Run conclusions for the worker that clusters failures represented in the CAO dashboard activity snapshot.",
              "disclosure": "supplemental",
              "data": {
                "source": "self-care-observed-runs",
                "time": {
                  "range": "30d"
                },
                "filters": {
                  "workflow": [
                    ".github/workflows/self-care-open-source-failures.md"
                  ]
                }
              },
              "mark": "chart",
              "chart": "bar",
              "layout": "half",
              "encoding": {
                "x": {
                  "field": "run-conclusion",
                  "type": "nominal"
                },
                "y": {
                  "field": "run",
                  "type": "quantitative",
                  "aggregate": "count"
                },
                "color": {
                  "field": "run-conclusion",
                  "type": "nominal"
                }
              }
            },
            {
              "id": "self-care-public-failure-outcomes",
              "disclosure-label": "Public-project failure findings",
              "description": "Retained digests and remediation issues for clustered failures across public projects represented in the dashboard.",
              "disclosure": "supplemental",
              "data": {
                "source": "self-care-retained-outcomes",
                "filters": {
                  "workflow": [
                    ".github/workflows/self-care-open-source-failures.md"
                  ]
                },
                "limit": 50
              },
              "mark": "table",
              "controls": "interactive",
              "lazy-list": true,
              "layout": "full-view",
              "empty-message": "No public-project failure findings were retained.",
              "encoding": {
                "href": {
                  "field": "external-link",
                  "type": "nominal"
                },
                "columns": [
                  {
                    "field": "repository",
                    "type": "nominal"
                  },
                  {
                    "field": "outcome-title",
                    "type": "nominal",
                    "title": "Finding",
                    "display": "outcome-link"
                  },
                  {
                    "field": "outcome-state",
                    "type": "nominal",
                    "title": "Disposition",
                    "display": "status"
                  },
                  {
                    "field": "published-at",
                    "type": "temporal",
                    "format": "human-friendly-timestamp",
                    "title": "Published"
                  }
                ]
              }
            }
        ]
      }
    ],
    "navigation": [
