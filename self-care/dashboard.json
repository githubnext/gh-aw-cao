{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "self-care-dashboard",
    "title": "SelfCare",
    "description": "Track dashboard performance improvements, build-time investigations, and clustered failures across represented public projects.",
    "repository": "githubnext/gh-aw-cao",
    "pages": [
      {
        "id": "self-care-dashboard",
        "kind": "custom",
        "title": "SelfCare",
        "description": "Track Lighthouse improvements, build-time investigations, speed attainment, and remediation findings for clustered public-project failures.",
        "icon": "check-circle",
        "views": [
          {
            "id": "self-care-build-runs",
            "title": "Build-time investigations by conclusion",
            "disclosure": "essential",
            "data": {
              "source": "runs",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/self-care-docs-build-time-investigator.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "pie",
            "encoding": {
              "x": {
                "field": "run-conclusion",
                "type": "nominal"
              },
              "y": {
                "field": "run",
                "type": "quantitative",
                "aggregate": "count"
              }
            }
          },
          {
            "id": "self-care-build-recommendations",
            "title": "Build-speed recommendations",
            "description": "Retained issues expose actionable timing evidence; creating an issue alone does not establish realized speed improvement.",
            "disclosure": "essential",
            "data": {
              "source": "outcomes",
              "filters": {
                "workflow": [
                  ".github/workflows/self-care-docs-build-time-investigator.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "empty-message": "No build-speed recommendations were retained.",
            "encoding": {
              "href": {
                "field": "external-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "outcome-title",
                  "type": "nominal",
                  "title": "Recommendation"
                },
                {
                  "field": "outcome-state",
                  "type": "nominal",
                  "title": "Disposition",
                  "display": "status"
                },
                {
                  "field": "published-at",
                  "type": "temporal",
                  "title": "Published"
                }
              ]
            }
          },
          {
            "id": "self-care-build-attainment",
            "title": "Reliable build-speed attainment",
            "description": "Attainment compares successful docs.yml execution times while requiring completed-run reliability to be preserved.",
            "disclosure": "essential",
            "data": {
              "source": "operational-values",
              "filters": {
                "workflow": [
                  ".github/workflows/self-care-docs-build-time-investigator.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "empty-message": "No matured build-speed attainment evidence is available.",
            "encoding": {
              "href": {
                "field": "evidence-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "operational-case",
                  "type": "nominal",
                  "title": "Performance opportunity"
                },
                {
                  "field": "operational-value",
                  "type": "quantitative",
                  "title": "Attainment"
                },
                {
                  "field": "maturity-status",
                  "type": "nominal",
                  "title": "Maturity",
                  "display": "status"
                },
                {
                  "field": "evidence-cutoff",
                  "type": "temporal",
                  "title": "Evidence cutoff"
                }
              ]
            }
          },
          {
            "id": "self-care-build-value-trend",
            "title": "Build-speed operational-value trend",
            "description": "Mean attainment summarizes repeated observations under the same frozen evaluator and does not establish causation.",
            "disclosure": "essential",
            "data": {
              "source": "operational-values",
              "time": {
                "range": "90d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/self-care-docs-build-time-investigator.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "line",
            "encoding": {
              "x": {
                "field": "observed-at",
                "type": "temporal",
                "time-unit": "day"
              },
              "y": {
                "field": "operational-value",
                "type": "quantitative",
                "aggregate": "mean"
              },
              "color": {
                "field": "operational-value-definition",
                "type": "nominal"
              }
            }
          },
          {
            "id": "self-care-dashboard-performance-runs",
            "title": "Dashboard performance runs",
            "description": "Run conclusions for trace-backed CFO, CTO, and CSO Lighthouse evaluations.",
            "disclosure": "essential",
            "data": {
              "source": "runs",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/self-care-dashboard-performance.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "bar",
            "encoding": {
              "x": {
                "field": "run-conclusion",
                "type": "nominal"
              },
              "y": {
                "field": "run",
                "type": "quantitative",
                "aggregate": "count"
              },
              "color": {
                "field": "run-conclusion",
                "type": "nominal"
              }
            }
          },
          {
            "id": "self-care-dashboard-performance-outcomes",
            "title": "Dashboard performance improvements",
            "description": "Draft pull requests for one trace-backed Lighthouse bottleneck at a time; publication does not establish realized performance improvement.",
            "disclosure": "essential",
            "data": {
              "source": "outcomes",
              "filters": {
                "workflow": [
                  ".github/workflows/self-care-dashboard-performance.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "empty-message": "No dashboard performance improvements were retained.",
            "encoding": {
              "href": {
                "field": "external-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "outcome-title",
                  "type": "nominal",
                  "title": "Improvement"
                },
                {
                  "field": "outcome-state",
                  "type": "nominal",
                  "title": "Disposition",
                  "display": "status"
                },
                {
                  "field": "published-at",
                  "type": "temporal",
                  "title": "Published"
                }
              ]
            }
          },
          {
              "id": "self-care-public-failure-runs",
              "title": "Public-project failure scans",
              "description": "Run conclusions for the worker that clusters failures represented in the CAO dashboard activity snapshot.",
              "disclosure": "essential",
              "data": {
                "source": "runs",
                "time": {
                  "range": "30d"
                },
                "filters": {
                  "workflow": [
                    ".github/workflows/self-care-open-source-failures.md"
                  ]
                }
              },
              "mark": "chart",
              "chart": "bar",
              "encoding": {
                "x": {
                  "field": "run-conclusion",
                  "type": "nominal"
                },
                "y": {
                  "field": "run",
                  "type": "quantitative",
                  "aggregate": "count"
                },
                "color": {
                  "field": "run-conclusion",
                  "type": "nominal"
                }
              }
            },
            {
              "id": "self-care-public-failure-outcomes",
              "title": "Public-project failure findings",
              "description": "Retained digests and remediation issues for clustered failures across public projects represented in the dashboard.",
              "disclosure": "essential",
              "data": {
                "source": "outcomes",
                "filters": {
                  "workflow": [
                    ".github/workflows/self-care-open-source-failures.md"
                  ]
                },
                "limit": 50
              },
              "mark": "table",
              "empty-message": "No public-project failure findings were retained.",
              "encoding": {
                "href": {
                  "field": "external-link",
                  "type": "nominal"
                },
                "columns": [
                  {
                    "field": "repository",
                    "type": "nominal"
                  },
                  {
                    "field": "outcome-title",
                    "type": "nominal",
                    "title": "Finding"
                  },
                  {
                    "field": "outcome-state",
                    "type": "nominal",
                    "title": "Disposition",
                    "display": "status"
                  },
                  {
                    "field": "published-at",
                    "type": "temporal",
                    "title": "Published"
                  }
                ]
              }
            }
        ]
      }
    ],
    "navigation": [
      {
        "label": "Package operations",
        "experimental": true,
        "pages": [
          "self-care-dashboard"
        ]
      }
    ]
  }
}
