[
  {
    "name": "campaigns",
    "stores": ["campaigns"],
    "from": "$campaigns",
    "compute": [
      {
        "as": "campaign-registration",
        "function": "if",
        "args": [
          { "field": "enabled" },
          { "value": "true" },
          { "value": "false" }
        ]
      }
    ],
    "select": [
      { "field": "id" },
      { "field": "slug", "as": "campaign" },
      { "field": "name", "as": "campaign-name" },
      { "field": "description", "as": "campaign-description" },
      { "field": "icon", "as": "campaign-icon" },
      { "field": "mode", "as": "campaign-mode" },
      { "field": "enabled", "as": "campaign-enabled" },
      { "field": "campaign-registration" },
      { "field": "maxRepositories", "as": "campaign-max-repositories" },
      { "field": "rolloutPercent", "as": "campaign-rollout-percent" },
      { "field": "monthlyAiCreditBudget", "as": "campaign-monthly-ai-credit-budget" },
      { "field": "aiCreditAllowance", "as": "campaign-aic-allowance" },
      { "field": "workerCount", "as": "campaign-worker-count" },
      { "field": "inventoryWarnings", "as": "campaign-inventory-warnings" },
      { "field": "workers", "as": "campaign-workers" },
      { "field": "targets", "as": "campaign-targets" },
      { "field": "minVersion", "as": "campaign-min-version" },
      { "field": "version", "as": "campaign-version" },
      { "field": "currentVersion", "as": "campaign-current-version" },
      { "field": "updateState", "as": "campaign-update-state" },
      { "field": "experimental", "as": "campaign-experimental" },
      { "field": "readmePath", "as": "campaign-readme-path" },
      { "field": "readme", "as": "campaign-readme" },
      { "field": "observedAt", "as": "observed-at" },
      { "field": "campaignLink", "as": "campaign-link" }
    ]
  },
  {
    "name": "repositories",
    "stores": ["repositories"],
    "from": "$repositories",
    "compute": [
      {
        "as": "repository-coordinate",
        "function": "concat",
        "args": [
          { "field": "owner" },
          { "value": "/" },
          { "field": "name" }
        ]
      }
    ],
    "select": [
      { "field": "id" },
      { "field": "owner", "as": "organization" },
      { "field": "name", "as": "repository" },
      { "field": "name", "as": "repository-name" },
      { "field": "repository-coordinate" },
      { "field": "visibility" },
      { "field": "rolloutMode", "as": "rollout-mode" },
      { "field": "observedAt", "as": "observed-at" },
      { "field": "organizationLink", "as": "organization-link" },
      { "field": "repositoryLink", "as": "repository-link" }
    ]
  },
  {
    "name": "workflows",
    "stores": ["repositories", "workflows"],
    "from": "$workflows",
    "joins": [
      {
        "source": "$repositories",
        "type": "left",
        "on": [{ "left": "repositoryId", "right": "id" }],
        "fields": [
          { "field": "owner", "as": "organization" },
          { "field": "name", "as": "repository" }
        ]
      }
    ],
    "compute": [
      {
        "as": "_workflow-active",
        "function": "equals-any",
        "args": [{ "field": "state" }, { "value": "active" }]
      },
      {
        "as": "_workflow-disabled",
        "function": "equals-any",
        "args": [{ "field": "state" }, { "value": "disabled" }]
      },
      {
        "as": "_workflow-inactive-label",
        "function": "if",
        "args": [
          { "field": "_workflow-disabled" },
          { "value": "false" },
          { "value": "unknown" }
        ]
      },
      {
        "as": "workflow-active",
        "function": "if",
        "args": [
          { "field": "_workflow-active" },
          { "value": "true" },
          { "field": "_workflow-inactive-label" }
        ]
      }
    ],
    "select": [
      { "field": "id" },
      { "field": "organization" },
      { "field": "repository" },
      { "field": "path", "as": "workflow" },
      { "field": "githubId", "as": "workflow-id" },
      { "field": "name", "as": "workflow-name" },
      { "field": "workflow-active" },
      { "field": "registryState", "as": "workflow-registry-state" },
      { "field": "admissionStatus", "as": "admission-status" },
      { "field": "admissionReason", "as": "admission-reason" },
      { "field": "createdAt", "as": "created-at" },
      { "field": "updatedAt", "as": "updated-at" },
      { "field": "campaign" },
      { "field": "campaignName", "as": "campaign-name" },
      { "field": "campaignIcon", "as": "campaign-icon" },
      { "field": "campaignReadmePath", "as": "campaign-readme-path" },
      { "field": "role", "as": "workflow-role" },
      { "field": "rolloutMode", "as": "rollout-mode" },
      { "field": "maxAiCredits", "as": "max-ai-credits" },
      { "field": "observedAt", "as": "observed-at" },
      { "field": "ghAwVersion", "as": "gh-aw-version" },
      { "field": "ghAwCurrentVersion", "as": "gh-aw-current-version" },
      { "field": "ghAwVersionLabel", "as": "gh-aw-version-label" },
      { "field": "ghAwUpdateState", "as": "gh-aw-update-state" },
      { "field": "ghAwMetadata", "as": "gh-aw-metadata" },
      { "field": "ghAwManifest", "as": "gh-aw-manifest" },
      { "field": "campaignAiCreditAllowance", "as": "campaign-aic-allowance" },
      { "field": "campaignWorkerCount", "as": "campaign-worker-count" },
      { "field": "campaignInventoryWarnings", "as": "campaign-inventory-warnings" },
      { "field": "inventoryReady", "as": "inventory-ready" },
      { "field": "organizationLink", "as": "organization-link" },
      { "field": "repositoryLink", "as": "repository-link" },
      { "field": "workflowLink", "as": "workflow-link" },
      { "field": "externalLink", "as": "external-link" }
    ]
  },
  {
    "name": "runs",
    "stores": ["workflows", "runs"],
    "from": "$runs",
    "joins": [
      {
        "source": "$workflows",
        "type": "left",
        "on": [{ "left": "workflowId", "right": "id" }],
        "fields": [
          { "field": "path", "as": "_workflow-path" },
          { "field": "rolloutMode", "as": "_workflow-rollout-mode" }
        ]
      }
    ],
    "compute": [
      {
        "as": "workflow",
        "function": "coalesce",
        "args": [{ "field": "workflowPath" }, { "field": "_workflow-path" }]
      },
      {
        "as": "run",
        "function": "concat",
        "args": [{ "field": "githubRunId" }]
      },
      {
        "as": "_rollout-unknown",
        "function": "equals-any",
        "args": [{ "field": "rolloutMode" }, { "value": "unknown" }, { "value": null }]
      },
      {
        "as": "effective-rollout-mode",
        "function": "if",
        "args": [
          { "field": "_rollout-unknown" },
          { "field": "_workflow-rollout-mode" },
          { "field": "rolloutMode" }
        ]
      }
    ],
    "select": [
      { "field": "id" },
      { "field": "owner", "as": "organization" },
      { "field": "repository" },
      { "field": "workflow" },
      { "field": "run" },
      { "field": "attempt", "as": "run-attempt" },
      { "field": "title", "as": "run-title" },
      { "field": "targetRepository", "as": "target-repository" },
      { "field": "event" },
      { "field": "branch" },
      { "field": "headSha", "as": "head-sha" },
      { "field": "createdAt", "as": "created-at" },
      { "field": "startedAt", "as": "started-at" },
      { "field": "completedAt", "as": "ended-at" },
      { "field": "updatedAt", "as": "updated-at" },
      { "field": "status", "as": "run-status" },
      { "field": "conclusion", "as": "run-conclusion" },
      { "field": "classification" },
      { "field": "failureKind", "as": "failure-kind" },
      { "field": "terminalOutcome", "as": "terminal-outcome" },
      { "field": "terminalOutcomeDetail", "as": "terminal-outcome-detail" },
      { "field": "duration" },
      { "field": "actionMinutes", "as": "action-minutes" },
      { "field": "githubApiCalls", "as": "github-api-calls" },
      { "field": "safeItemsCount", "as": "safe-items-count" },
      { "field": "errorCount", "as": "error-count" },
      { "field": "admissionStatus", "as": "admission-status" },
      { "field": "admissionReason", "as": "admission-reason" },
      { "field": "failureJob", "as": "failure-job" },
      { "field": "failureMessage", "as": "failure-message" },
      { "field": "failureStep", "as": "failure-step" },
      { "field": "failureLog", "as": "failure-log" },
      { "field": "failureDetail", "as": "failure-detail" },
      { "field": "resource" },
      { "field": "resourceResetAt", "as": "resource-reset-at" },
      { "field": "resourceWaitHours", "as": "resource-wait-hours" },
      { "field": "runLink", "as": "run-link" },
      { "field": "effective-rollout-mode", "as": "rollout-mode" },
      { "field": "agentId", "as": "agent-id" },
      { "field": "agentVersion", "as": "agent-version" },
      { "field": "modelId", "as": "model-id" },
      { "field": "ghAwVersion", "as": "gh-aw-version" },
      { "field": "aicTotal", "as": "aic-total" },
      { "field": "inputTokens", "as": "input-tokens" },
      { "field": "outputTokens", "as": "output-tokens" },
      { "field": "cacheReadTokens", "as": "cache-read-tokens" },
      { "field": "cacheWriteTokens", "as": "cache-write-tokens" },
      { "field": "reasoningTokens", "as": "reasoning-tokens" },
      { "field": "engine" },
      { "field": "engineId", "as": "engine-id" },
      { "field": "engineVersion", "as": "engine-version" },
      { "field": "requestedModel", "as": "requested-model" },
      { "field": "resolvedModel", "as": "resolved-model" },
      { "field": "agentRuntime", "as": "agent-runtime" },
      { "field": "firewallVersion", "as": "firewall-version" },
      { "field": "gatewayVersion", "as": "gateway-version" },
      { "field": "data" },
      { "field": "logsPayload", "as": "logs-payload" },
      { "field": "organizationLink", "as": "organization-link" },
      { "field": "repositoryLink", "as": "repository-link" },
      { "field": "workflowLink", "as": "workflow-link" }
    ]
  },
  {
    "name": "operational-values",
    "stores": ["repositories", "campaigns", "operationalValues"],
    "from": "$operationalValues",
    "joins": [
      {
        "source": "$repositories",
        "type": "left",
        "on": [{ "left": "repositoryId", "right": "id" }],
        "fields": [
          { "field": "owner", "as": "organization" },
          { "field": "name", "as": "repository" },
          { "field": "name", "as": "repository-name" },
          { "field": "organizationLink", "as": "organization-link" },
          { "field": "repositoryLink", "as": "repository-link" }
        ]
      },
      {
        "source": "$campaigns",
        "type": "left",
        "on": [{ "left": "campaign", "right": "slug" }],
        "fields": [
          { "field": "name", "as": "campaign-name" },
          { "field": "icon", "as": "campaign-icon" },
          { "field": "campaignLink", "as": "campaign-link" }
        ]
      }
    ],
    "select": [
      { "field": "id" },
      { "field": "organization" },
      { "field": "repository" },
      { "field": "repository-name" },
      { "field": "campaign" },
      { "field": "campaign-name" },
      { "field": "campaign-icon" },
      { "field": "workflow" },
      { "field": "run" },
      { "field": "run-attempt" },
      { "field": "observation-id" },
      { "field": "experiment" },
      { "field": "operational-case" },
      { "field": "evaluator-digest" },
      { "field": "rollout-mode" },
      { "field": "value", "as": "operational-value" },
      { "field": "valueId", "as": "operational-value-definition" },
      { "field": "operational-value-role" },
      { "field": "operational-value-name" },
      { "field": "operational-value-unit" },
      { "field": "operational-value-direction" },
      { "field": "requested-evidence-at" },
      { "field": "evidence-cutoff" },
      { "field": "maturity-at" },
      { "field": "maturity-status" },
      { "field": "adoption-at" },
      { "field": "evaluation-mode" },
      { "field": "workflow-slug" },
      { "field": "workflow-name" },
      { "field": "rollup-numerator" },
      { "field": "rollup-denominator" },
      { "field": "baseline-value" },
      { "field": "delta-from-baseline" },
      { "field": "accepted-evidence-provenance" },
      { "field": "diagnostics" },
      { "field": "diagnostic-definitions" },
      { "field": "timestamp", "as": "observed-at" },
      { "field": "evidence-link" },
      { "field": "organization-link" },
      { "field": "repository-link" },
      { "field": "campaign-link" },
      { "field": "workflow-link" },
      { "field": "run-link" }
    ]
  },
  {
    "name": "run-records",
    "stores": ["runs"],
    "stores-by-source": {
      "domains": ["runs", "domains"],
      "tools": ["runs", "tools"],
      "audits": ["runs", "audits"],
      "issues": ["runs", "issues"]
    },
    "from": "$records",
    "joins": [
      {
        "source": "$runs",
        "type": "left",
        "on": [{ "left": "runId", "right": "id" }],
        "fields": [
          { "field": "owner", "as": "organization" },
          { "field": "repository", "as": "repository" },
          { "field": "workflowPath", "as": "workflow" },
          { "field": "githubRunId", "as": "_github-run-id" },
          { "field": "attempt", "as": "run-attempt" },
          { "field": "runLink", "as": "run-link" },
          { "field": "engine", "as": "engine" },
          { "field": "engineVersion", "as": "engine-version" },
          { "field": "requestedModel", "as": "requested-model" },
          { "field": "resolvedModel", "as": "resolved-model" },
          { "field": "modelId", "as": "model-id" },
          { "field": "rolloutMode", "as": "rollout-mode" },
          { "field": "ghAwVersion", "as": "gh-aw-version" },
          { "field": "conclusion", "as": "run-conclusion" },
          { "field": "agentId", "as": "agent-id" },
          { "field": "agentVersion", "as": "agent-version" },
          { "field": "agentRuntime", "as": "agent-runtime" },
          { "field": "organizationLink", "as": "organization-link" },
          { "field": "repositoryLink", "as": "repository-link" },
          { "field": "workflowLink", "as": "workflow-link" }
        ]
      }
    ],
    "compute": [
      {
        "as": "run",
        "function": "concat",
        "args": [{ "field": "_github-run-id" }]
      },
      {
        "as": "_firewall-allowed",
        "function": "equals-any",
        "args": [{ "field": "type" }, { "value": "net_allowed" }]
      },
      {
        "as": "_firewall-blocked",
        "function": "equals-any",
        "args": [{ "field": "type" }, { "value": "net_blocked" }]
      },
      {
        "as": "_allowed-event-type",
        "function": "if",
        "args": [
          { "field": "_firewall-allowed" },
          { "value": "firewall.request.allowed" },
          { "field": "type" }
        ]
      },
      {
        "as": "event-type",
        "function": "if",
        "args": [
          { "field": "_firewall-blocked" },
          { "value": "firewall.request.blocked" },
          { "field": "_allowed-event-type" }
        ]
      }
    ],
    "select": [
      { "field": "id" },
      { "field": "organization" },
      { "field": "repository" },
      { "field": "workflow" },
      { "field": "run" },
      { "field": "run-attempt" },
      { "field": "id", "as": "event" },
      { "field": "timestamp", "as": "event-timestamp" },
      { "field": "source", "as": "event-source" },
      { "field": "event-type" },
      { "field": "summary", "as": "event-summary" },
      { "field": "status", "as": "event-status" },
      { "field": "code" },
      { "field": "requestCount", "as": "request-count" },
      { "field": "correlationId", "as": "correlation-id" },
      { "field": "payloadRef", "as": "payload-ref" },
      { "field": "mcpServer", "as": "mcp-server" },
      { "field": "mcpServerVersion", "as": "mcp-server-version" },
      { "field": "mcpProtocolVersion", "as": "mcp-protocol-version" },
      { "field": "mcpTool", "as": "mcp-tool" },
      { "field": "responseBytes", "as": "response-bytes" },
      { "field": "safeOutputType", "as": "safe-output-type" },
      { "field": "githubEntityType", "as": "github-entity-type" },
      { "field": "isPullRequest", "as": "is-pull-request" },
      { "field": "state", "as": "issue-state" },
      { "field": "closed", "as": "issue-closed" },
      { "field": "stateReason", "as": "issue-state-reason" },
      { "field": "closedAt", "as": "issue-closed-at" },
      { "field": "statusObservedAt", "as": "issue-status-observed-at" },
      { "field": "number" },
      { "field": "toolType", "as": "tool-type" },
      { "field": "isSkill", "as": "is-skill" },
      { "field": "name" },
      { "field": "domain" },
      { "field": "decision" },
      { "field": "sourceSequence", "as": "source-sequence" },
      { "field": "observedAt", "as": "observed-at" },
      { "field": "run-link" },
      { "field": "engine" },
      { "field": "engine-version" },
      { "field": "requested-model" },
      { "field": "resolved-model" },
      { "field": "model-id" },
      { "field": "rollout-mode" },
      { "field": "gh-aw-version" },
      { "field": "run-conclusion" },
      { "field": "agent-id" },
      { "field": "agent-version" },
      { "field": "agent-runtime" },
      { "field": "organization-link" },
      { "field": "repository-link" },
      { "field": "workflow-link" },
      { "field": "targetRepo", "as": "target-repo" },
      { "field": "targetOrganization", "as": "target-organization" },
      { "field": "targetRepository", "as": "target-repository" },
      { "field": "targetWorkflowPath", "as": "target-workflow-path" },
      { "field": "optimizerRunAttempt", "as": "optimizer-run-attempt" },
      { "field": "optimizerWorkflowPath", "as": "optimizer-workflow-path" },
      { "field": "optimizerWorkflowName", "as": "optimizer-workflow-name" },
      { "field": "claimRunId", "as": "claim-run-id" },
      { "field": "claimRunAttempt", "as": "claim-run-attempt" },
      { "field": "actor" },
      { "field": "sourceProvenance", "as": "source-provenance" },
      { "field": "opportunityId", "as": "opportunity-id" },
      { "field": "opportunityKind", "as": "opportunity-kind" },
      { "field": "assignmentRunId", "as": "assignment-run" },
      { "field": "experimentId", "as": "experiment" },
      { "field": "evidenceWindowStart", "as": "evidence-window-start" },
      { "field": "evidenceWindowEnd", "as": "evidence-window-end" },
      { "field": "evidenceState", "as": "evidence-state" },
      { "field": "evidenceConfidence", "as": "evidence-confidence" },
      { "field": "costGrain", "as": "cost-grain" },
      { "field": "evidenceProvenance", "as": "evidence-provenance" },
      { "field": "attributableRunIds", "as": "attributable-run-ids" },
      { "field": "interventionId", "as": "intervention-id" },
      { "field": "lifecycleObservationId", "as": "lifecycle-observation-id" },
      { "field": "previousInterventionState", "as": "previous-intervention-state" },
      { "field": "interventionState", "as": "intervention-state" },
      { "field": "previousRecommendationDisposition", "as": "previous-recommendation-disposition" },
      { "field": "recommendationDisposition", "as": "recommendation-disposition" },
      { "field": "supersedesInterventionId", "as": "supersedes-intervention-id" },
      { "field": "supersededByInterventionId", "as": "superseded-by-intervention-id" },
      { "field": "recommendationChurnCount", "as": "recommendation-churn-count" },
      { "field": "recommendationChurnRate", "as": "recommendation-churn-rate" },
      { "field": "controlVariant", "as": "control-variant" },
      { "field": "optimizedVariant", "as": "optimized-variant" },
      { "field": "proposedSavingsAic", "as": "proposed-savings-aic" },
      { "field": "missingReason", "as": "missing-reason" },
      { "field": "safeOutputId", "as": "safe-output-id" },
      { "field": "safeOutputUrl", "as": "safe-output-url" },
      { "field": "implementationChangeId", "as": "implementation-change-id" },
      { "field": "implementationPullRequestUrl", "as": "implementation-pull-request-url" },
      { "field": "implementationRunIds", "as": "implementation-run-ids" },
      { "field": "acceptedAt", "as": "accepted-at" },
      { "field": "implementationStartedAt", "as": "implementation-started-at" },
      { "field": "implementationCompletedAt", "as": "implementation-completed-at" },
      { "field": "rejectedAt", "as": "rejected-at" },
      { "field": "supersededAt", "as": "superseded-at" }
    ]
  },
  {
    "name": "outcomes",
    "stores": ["issues", "runs", "workflows", "repositories"],
    "from": "run-records",
    "filter": {
      "predicates": [
        { "field": "event-type", "equals": "safe_output.created" }
      ]
    },
    "joins": [
      {
        "source": "workflows",
        "type": "left",
        "on": [
          { "left": "organization", "right": "organization" },
          { "left": "repository", "right": "repository" },
          { "left": "workflow", "right": "workflow" }
        ],
        "fields": [
          { "field": "campaign", "as": "campaign" },
          { "field": "campaign-name", "as": "campaign-name" },
          { "field": "workflow-name", "as": "workflow-name" },
          { "field": "workflow-role", "as": "workflow-role" },
          { "field": "workflow-link", "as": "workflow-link" },
          { "field": "organization-link", "as": "organization-link" },
          { "field": "repository-link", "as": "repository-link" }
        ]
      }
    ],
    "compute": [
      {
        "as": "outcome-category",
        "function": "if",
        "args": [{ "field": "is-pull-request" }, { "value": "pull-request" }, { "value": "issue" }]
      },
      {
        "as": "_safe-output-is-issue",
        "function": "equals-any",
        "args": [{ "field": "safe-output-type" }, { "value": "create_issue" }]
      },
      {
        "as": "_safe-output-is-pull-request",
        "function": "equals-any",
        "args": [{ "field": "safe-output-type" }, { "value": "create_pull_request" }]
      },
      {
        "as": "_safe-output-kind-issue",
        "function": "if",
        "args": [
          { "field": "_safe-output-is-issue" },
          { "value": "create-issue" },
          { "field": "safe-output-type" }
        ]
      },
      {
        "as": "safe-output-kind",
        "function": "if",
        "args": [
          { "field": "_safe-output-is-pull-request" },
          { "value": "create-pull-request" },
          { "field": "_safe-output-kind-issue" }
        ]
      },
      {
        "as": "outcome-status",
        "function": "coalesce",
        "args": [{ "field": "event-status" }, { "value": "unknown" }]
      },
      {
        "as": "outcome-state",
        "function": "coalesce",
        "args": [{ "field": "event-status" }, { "value": "unknown" }]
      },
      {
        "as": "_issue-state-open",
        "function": "equals-any",
        "args": [{ "field": "issue-state" }, { "value": "OPEN" }]
      },
      {
        "as": "_issue-state-closed",
        "function": "equals-any",
        "args": [{ "field": "issue-state" }, { "value": "CLOSED" }]
      },
      {
        "as": "_issue-open-status",
        "function": "if",
        "args": [{ "field": "_issue-state-open" }, { "value": "Open" }, { "value": "Unknown" }]
      },
      {
        "as": "issue-status",
        "function": "if",
        "args": [{ "field": "_issue-state-closed" }, { "value": "Closed" }, { "field": "_issue-open-status" }]
      },
      {
        "as": "_issue-closing-reason",
        "function": "coalesce",
        "args": [{ "field": "issue-state-reason" }, { "value": "unknown" }]
      },
      {
        "as": "_issue-closing-reason-normalized",
        "function": "lower",
        "args": [{ "field": "_issue-closing-reason" }]
      },
      {
        "as": "issue-closing-status",
        "function": "title-case",
        "args": [{ "field": "_issue-closing-reason-normalized" }]
      },
      {
        "as": "_issue-closed-status-detail",
        "function": "concat",
        "args": [{ "value": "Closed: " }, { "field": "issue-closing-status" }]
      },
      {
        "as": "issue-status-detail",
        "function": "if",
        "args": [{ "field": "_issue-state-closed" }, { "field": "_issue-closed-status-detail" }, { "field": "issue-status" }]
      }
    ],
    "select": [
      { "field": "id", "as": "safe-output" },
      { "field": "organization" },
      { "field": "repository" },
      { "field": "campaign" },
      { "field": "campaign-name" },
      { "field": "repository", "as": "runtime-repository" },
      { "field": "workflow" },
      { "field": "workflow-name" },
      { "field": "workflow-role" },
      { "field": "run" },
      { "field": "run-conclusion" },
      { "field": "safe-output-kind" },
      { "field": "number", "as": "outcome-number" },
      { "field": "event-summary", "as": "outcome-title" },
      { "field": "event-summary", "as": "outcome-summary" },
      { "field": "outcome-body-html" },
      { "field": "outcome-category" },
      { "field": "outcome-status" },
      { "field": "outcome-state" },
      { "field": "issue-state" },
      { "field": "issue-closed" },
      { "field": "issue-state-reason" },
      { "field": "issue-status" },
      { "field": "issue-closing-status" },
      { "field": "issue-status-detail" },
      { "field": "issue-closed-at" },
      { "field": "issue-status-observed-at" },
      { "field": "outcome-warning" },
      { "field": "evidence-strength" },
      { "field": "rollout-mode" },
      { "field": "engine" },
      { "field": "engine-version" },
      { "field": "requested-model" },
      { "field": "resolved-model" },
      { "field": "event-timestamp", "as": "published-at" },
      { "field": "observed-at" },
      { "field": "issue-link" },
