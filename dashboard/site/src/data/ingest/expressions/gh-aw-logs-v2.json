{
  "contract": "gh-aw-cao.jsonl-ingestion",
  "version": 1,
  "source": "gh-aw-logs",
  "sourceSchemaVersion": 2,
  "variants": {
    "workflow_runs": {
      "payloadPath": "payload",
      "emits": ["repository", "workflow", "run"],
      "identity": ["databaseId", "attempt"]
    },
    "run": {
      "payloadPath": "run",
      "emits": ["repository", "workflow", "run", "job", "session", "event"],
      "identity": ["run_id", "run_attempt"]
    },
    "token_efficiency_run_context": {
      "payloadPath": "run",
      "emits": ["repository", "workflow", "run", "session", "event"],
      "identity": ["run_id", "run_attempt"]
    },
    "safe_output_item": {
      "payloadPath": "safe_output",
      "emits": ["event"],
      "identity": ["run_id", "type", "url", "timestamp"]
    },
    "token_efficiency_observation": {
      "payloadPath": "observation",
      "emits": ["event"],
      "identity": ["optimizerRunId", "runAttempt", "opportunityId", "interventionId"]
    },
    "token_efficiency_lifecycle_observation": {
      "payloadPath": "observation",
      "emits": ["event"],
      "identity": ["optimizerRunId", "lifecycleObservationId"]
    },
    "github_api_rate_limit": {
      "payloadPath": "rate_limit",
      "emits": ["event"],
      "requiresContext": ["repository", "workflow", "run", "observedAt"]
    }
  }
}
