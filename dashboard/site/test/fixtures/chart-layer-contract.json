{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "chart-layers",
    "title": "Chart layers",
    "queries": [
      {
        "name": "layer-observations",
        "subject": "Ordered retained AI-credit observations with an illustrative reference field.",
        "from": "usage",
        "select": [
          { "field": "observed-at" },
          { "field": "aic" },
          { "field": "estimated-usd" },
          { "field": "run-link" }
        ],
        "order-by": [{ "field": "observed-at", "direction": "asc" }],
        "limit": 100
      }
    ],
    "pages": [
      {
        "id": "layers",
        "kind": "custom",
        "title": "Layered observations",
        "views": [
          {
            "id": "observations",
            "title": "AI credits",
            "mark": "chart",
            "data": { "source": "layer-observations" },
            "encoding": {
              "x": { "field": "observed-at", "type": "temporal" },
              "y": { "field": "aic", "type": "quantitative", "title": "AI credits" },
              "href": { "field": "run-link" }
            },
            "layer": [
              { "chart": "area" },
              { "layer": [{ "chart": "line" }, { "chart": "dot" }] },
              {
                "chart": "rule",
                "encoding": {
                  "y": { "field": "estimated-usd", "type": "quantitative", "title": "Reference" }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
