{
  "tabs": [
    { "id": "repositories", "label": "Repositories", "icon": "repo", "page": "maintenance" },
    { "id": "campaigns", "label": "Campaigns", "icon": "workflow", "page": "maintenance-campaigns" }
  ],
  "sources": ["maintenance-repositories", "campaigns"],
  "repository-upgrade": {
    "action": "upgrade-repository",
    "action-context": ["repository"]
  },
  "repository-drill": { "type": "external", "field": "repository-url" },
  "repository-upgrade-action": {
    "action": "upgrade-target-repository",
    "context": ["repository"],
    "when": { "field": "upgrade-action-visible", "equals": true }
  },
  "campaign-update": {
    "action": "update-repository",
    "action-context": ["campaign"]
  },
  "repository-workflows": [
