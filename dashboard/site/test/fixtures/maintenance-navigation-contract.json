    { "repository": "octo/unknown", "repository-url": "https://github.com/octo/unknown", "upgrade-required": 0, "upgrade-action-visible": true },
    { "repository": "octo/unreleased", "repository-url": "https://github.com/octo/unreleased", "upgrade-required": 0, "upgrade-action-visible": true },
    { "repository": "other/second", "repository-url": "https://github.com/other/second", "upgrade-required": 1, "upgrade-action-visible": true }
  ]
