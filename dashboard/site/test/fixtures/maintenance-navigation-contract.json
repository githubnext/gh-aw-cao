    { "organization": "octo", "repository": "first", "workflow": "b.md", "gh-aw-version": "v0.92.0", "gh-aw-current-version": "v0.92.0", "gh-aw-update-state": "current" },
    { "organization": "octo", "repository": "first", "workflow": "historical.md", "gh-aw-update-state": "unknown" },
    { "organization": "other", "repository": "second", "workflow": "c.md", "gh-aw-version": "v0.91.5", "gh-aw-current-version": "v0.92.0", "gh-aw-update-state": "update-available" },
    { "organization": "octo", "repository": "unknown", "workflow": "d.md", "gh-aw-update-state": "unknown" },
