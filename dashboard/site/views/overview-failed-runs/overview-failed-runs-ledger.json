{
  "id": "overview-failed-runs-ledger",
  "title": "Failed run evidence",
  "description": "Open a run on GitHub to inspect its jobs, logs, and retained evidence.",
  "data": {
    "source": "failed-runs",
    "filters": {
      "run-conclusion": [
        "failure",
        "startup-failure",
        "stale",
        "timed-out"
      ]
    },
    "order-by": [
      {
        "field": "started-at",
        "direction": "desc"
      }
    ]
  },
  "mark": "table",
  "controls": "interactive",
  "column-summaries": true,
  "empty-message": "No failed runs were observed in the selected horizon.",
  "layout": "full-view",
  "encoding": {
    "columns": [
      {
        "field": "started-at",
        "type": "temporal",
        "title": "Date"
      },
      {
        "field": "repository",
        "type": "nominal",
        "title": "Repository"
      },
      {
        "field": "failure-detail",
        "type": "nominal",
        "title": "Error",
        "display": "run-link"
      }
    ]
  }
}
