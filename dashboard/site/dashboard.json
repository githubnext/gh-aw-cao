    "cli-actions": [
      {
        "id": "update-repository",
        "level": "operate",
        "label": "Update all",
        "description": "Queue an individual update for every listed campaign, then open Commands.",
        "icon": "sync",
        "command": "./cao.sh update --campaign {{campaign}} --pr-message 'This pull request was requested through [Central Agentic Ops (CAO)](https://github.com/githubnext/gh-aw-cao) to update the {{campaign}} campaign from its upstream source, keeping installed workflows current with published fixes and improvements. Return to the [CAO dashboard](https://githubnext.github.io/gh-aw-cao/cao/#page-maintenance-campaigns).'",
        "placement": "view",
        "arguments": [
          {
            "id": "create-pull-request",
            "label": "Create pull request",
            "description": "Create a pull request with the workflow campaign updates.",
            "type": "boolean",
            "flag": "--create-pull-request",
            "default": true
          },
          {
            "id": "auto-merge",
            "label": "Auto merge",
            "description": "Enable auto-merge on the created pull request. Requires Create pull request.",
            "type": "boolean",
            "flag": "--auto-merge",
            "default": false
          }
        ]
      },
      {
        "id": "upgrade-repository",
        "level": "operate",
        "label": "Upgrade all",
        "description": "Queue an individual Agentic Workflows upgrade for every listed repository, then open Commands.",
        "icon": "download",
        "command": "gh aw upgrade --repo {{repository}} --pr-message 'This pull request was requested through [Central Agentic Ops (CAO)](https://github.com/githubnext/gh-aw-cao) to upgrade GitHub Agentic Workflows in {{repository}}, refreshing workflow tooling, action versions, and generated lock files. Return to the [CAO dashboard](https://githubnext.github.io/gh-aw-cao/cao/#page-maintenance).'",
        "placement": "view",
        "arguments": [
          {
            "id": "create-pull-request",
            "label": "Create pull request",
            "description": "Create a pull request with the generated workflow upgrades.",
            "type": "boolean",
            "flag": "--create-pull-request",
            "default": true
          },
          {
            "id": "pre-releases",
            "label": "Include pre-releases",
            "description": "Allow upgrades to pre-release versions of GitHub Agentic Workflows.",
            "type": "boolean",
            "flag": "--pre-releases",
            "default": false
          },
          {
            "id": "auto-merge",
            "label": "Auto merge",
            "description": "Enable auto-merge on the created pull request. Requires Create pull request.",
            "type": "boolean",
            "flag": "--auto-merge",
            "default": false
          }
        ]
      },
      {
        "id": "upgrade-target-repository",
        "level": "operate",
        "label": "Upgrade",
        "description": "Upgrade Agentic Workflows in the selected repository and create a pull request.",
        "icon": "download",
        "command": "gh aw upgrade --repo {{repository}} --pr-message 'This pull request was requested through [Central Agentic Ops (CAO)](https://github.com/githubnext/gh-aw-cao) to upgrade GitHub Agentic Workflows in {{repository}}, refreshing workflow tooling, action versions, and generated lock files. Return to the [CAO dashboard](https://githubnext.github.io/gh-aw-cao/cao/#page-maintenance).'",
        "placement": "row",
        "arguments": [
          {
