    "cli-actions": [
      {
        "id": "update-repository",
        "label": "Update all",
        "description": "Update all installed Agentic Workflow campaigns in this repository.",
        "icon": "sync",
        "command": "./cao.sh update --repo {{repository}}",
        "placement": "view",
        "arguments": [
          {
            "id": "create-pull-request",
            "label": "Create pull request",
            "description": "Create a pull request with the workflow campaign updates.",
            "type": "boolean",
            "flag": "--create-pull-request",
            "default": true
          }
        ]
      },
      {
        "id": "upgrade-repository",
        "label": "Upgrade all",
        "description": "Upgrade the gh-aw compiler version across this repository's Agentic Workflows files.",
        "icon": "download",
        "command": "gh aw upgrade --repo {{repository}}",
        "placement": "view",
        "arguments": [
          {
            "id": "create-pull-request",
            "label": "Create pull request",
            "description": "Create a pull request with the generated workflow upgrades.",
            "type": "boolean",
            "flag": "--create-pull-request",
            "default": true
          },
          {
            "id": "pre-releases",
            "label": "Include pre-releases",
            "description": "Allow upgrades to pre-release versions of GitHub Agentic Workflows.",
            "type": "boolean",
            "flag": "--pre-releases",
            "default": false
          }
        ]
      },
      {
        "id": "upgrade-target-repository",
        "label": "Upgrade repository",
        "description": "Upgrade Agentic Workflows in the selected repository and create a pull request.",
        "icon": "download",
        "command": "gh aw upgrade --repo {{repository}}",
        "placement": "row",
        "arguments": [
          {
            "id": "create-pull-request",
            "label": "Create pull request",
            "description": "Create a pull request with the generated workflow upgrades.",
            "type": "boolean",
            "flag": "--create-pull-request",
            "default": true
          },
          {
            "id": "pre-releases",
            "label": "Include pre-releases",
            "description": "Allow upgrades to pre-release versions of GitHub Agentic Workflows.",
            "type": "boolean",
            "flag": "--pre-releases",
            "default": false
          }
        ]
      },
      {
        "id": "update-campaign",
        "label": "Update campaign",
        "description": "Update this campaign's agentic workflow.",
        "icon": "sync",
        "command": "./cao.sh update {{campaign}}",
        "placement": "row"
      },
      {
        "id": "set-campaign-live",
        "label": "Switch to live",
        "description": "Switch this campaign's workflows to live mode.",
        "icon": "play",
        "command": "./cao.sh mode live {{campaign}}",
        "placement": "row"
      },
      {
        "id": "set-campaign-preview",
        "label": "Switch to preview",
        "description": "Switch this campaign's workflows to preview mode.",
        "icon": "eye",
        "command": "./cao.sh mode preview {{campaign}}",
        "placement": "row"
      },
      {
        "id": "enable-campaign",
        "label": "Enable campaign",
        "description": "Enable this campaign's orchestrator and worker workflows.",
        "icon": "play",
        "command": "./cao.sh enable {{campaign}}",
        "placement": "row"
      },
      {
        "id": "disable-campaign",
        "label": "Pause campaign",
        "description": "Disable future campaign workflow runs. Active runs continue until separately cancelled on GitHub.",
        "icon": "pause",
        "command": "./cao.sh disable {{campaign}}",
        "placement": "row"
      },
      {
        "id": "create-agent-task",
        "label": "Start agent task",
        "description": "Start a GitHub Copilot coding agent task from the reviewed prompt.",
        "icon": "copilot",
        "command": "gh agent-task create --from-file -",
        "placement": "row"
      }
    ],
    "horizon": {
      "label": "Horizon",
      "tooltip": {
        "label": "Horizon details",
        "description": "Dashboard data is included from the start time up to, but not including, the end time.",
        "icon": "question"
      }
    },
    "units": {
      "aic": {
        "name": "AICc($)",
        "symbol": "cAIC",
        "significant": 2,
        "format": "aicc"
      },
      "aic-per-run": {
        "name": "AICc($)",
        "symbol": "cAIC/run",
        "significant": 2,
        "format": "aicc"
      },
      "usd": {
        "name": "US dollars",
        "symbol": "USD",
        "significant": 0.001,
        "format": "number"
      },
      "ops-grader": {
        "name": "Operational grader",
