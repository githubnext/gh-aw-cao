{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "central-agentic-ops-dashboard",
    "title": "Central Agentic Ops Dashboard",
    "description": "Authoritative declarative dashboard document for built-in and custom pages in the presenter prototype.",
    "repository": "githubnext/gh-aw-cao",
    "callouts": [
      {
        "id": "partial-data-rate-limit",
        "title": "Dashboard data is partial",
        "description": "Data Health reports a collection gap caused by a GitHub API rate limit.",
        "icon": "alert",
        "navigation-page": "data-health",
        "visible-when": {
          "source": "data-health-collections",
          "field": "failure-class",
          "equals": "rate-limit"
        }
      }
    ],
    "horizon": {
      "label": "Horizon",
      "tooltip": {
        "label": "Horizon details",
        "description": "Dashboard data is included from the start time up to, but not including, the end time.",
        "icon": "question"
      }
    },
    "defaults": {
      "time": {
        "range": "1w"
      }
    },
    "units": {
      "aic": {
        "name": "AI Credits",
        "symbol": "AIC",
        "significant": 1
      },
      "grade": {
        "name": "Grade",
        "symbol": "grade",
        "significant": 0.01
      },
      "percent": {
        "name": "Percent",
        "symbol": "%",
        "significant": 0.1
      },
      "seconds": {
        "name": "Seconds",
        "symbol": "s",
        "significant": 1
      },
      "human-duration": {
        "name": "Human-friendly duration",
        "symbol": "s",
        "significant": 1,
        "format": "duration"
      },
      "minutes": {
        "name": "Minutes",
        "symbol": "min",
        "significant": 0.1
      },
      "requests-per-minute": {
        "name": "Requests per minute",
        "symbol": "req/min",
        "significant": 0.001
      }
    },
    "pages": [
      {
        "id": "operations",
        "kind": "built-in",
        "page": "overview",
        "title": "Operational health",
        "icon": "server",
        "class-name": "overview-page",
        "description": "Current operational attention across runtime, controls, value, episodes, cost, and evidence.",
        "definition": {
          "data-state": {
            "availability": true,
            "completeness": true,
            "freshness": true
          },
          "views": [
            {
              "$ref": "./views/operations/overview-run-health.json"
