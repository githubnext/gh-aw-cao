{
  "queries": [
    {
      "name": "entity-workflow-run-totals",
      "intent": "Summarize run outcomes and AI Credit consumption for reusable workflow cards.",
      "from": "runs",
      "compute": [
        {
          "as": "run-attempt-identity",
          "function": "concat",
          "args": [
            {
              "field": "run"
            },
            {
              "value": ":"
            },
            {
              "field": "run-attempt"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "organization",
          "repository",
          "workflow"
        ],
        "values": [
          {
            "field": "run-attempt-identity",
            "as": "runs",
            "reducer": "distinct-count"
          },
          {
            "field": "run-conclusion",
            "as": "successful-runs",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "run-conclusion",
                  "equals": "success"
                }
              ]
            }
          },
          {
            "field": "run-conclusion",
            "as": "failed-runs",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "run-conclusion",
                  "in": [
                    "failure",
                    "startup-failure",
                    "stale",
                    "timed-out"
                  ]
                }
              ]
            }
          },
          {
            "field": "aic-total",
            "as": "aic",
            "reducer": "sum"
          }
        ]
      }
    },
    {
      "name": "entity-workflows",
      "intent": "Project workflow entities for reusable workflow cards and repository drill-down.",
      "from": "workflows",
      "joins": [
        {
          "source": "entity-workflow-run-totals",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            }
          ],
          "fields": [
            {
              "field": "runs",
              "as": "observed-runs"
            },
            {
              "field": "successful-runs",
              "as": "observed-successful-runs"
            },
            {
              "field": "failed-runs",
              "as": "observed-failed-runs"
            },
            {
              "field": "aic",
              "as": "observed-aic"
            }
          ]
        }
      ],
      "compute": [
        {
          "as": "runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "successful-runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-successful-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "failed-runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-failed-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "aic",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-aic"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "aic-per-run",
          "function": "quotient",
          "args": [
            {
              "field": "aic"
            },
            {
              "field": "runs"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "workflow"
        },
        {
          "field": "workflow-name"
        },
        {
          "field": "workflow-role"
        },
        {
          "field": "workflow-active"
        },
        {
          "field": "campaign-name"
        },
        {
          "field": "observed-at"
        },
        {
          "field": "runs"
        },
        {
          "field": "successful-runs"
        },
        {
          "field": "failed-runs"
        },
        {
          "field": "aic-per-run"
        },
        {
          "field": "workflow-link"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        },
        {
          "field": "workflow",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "repository-runs",
      "intent": "Project canonical runs into repository-addressable run evidence.",
      "description": "Workflow runs with a stable repository route key.",
      "from": "runs",
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate"
        },
        {
          "field": "workflow"
        },
        {
          "field": "run"
        },
        {
          "field": "run-title"
        },
        {
          "field": "event"
        },
        {
          "field": "started-at"
        },
        {
          "field": "run-status"
        },
        {
          "field": "run-conclusion"
        },
        {
          "field": "rollout-mode"
        },
        {
          "field": "aic-total"
        },
        {
          "field": "run-link"
        }
      ],
      "order-by": [
        {
          "field": "started-at",
          "direction": "desc"
        },
        {
          "field": "run",
          "direction": "desc"
        }
      ]
    },
    {
      "name": "repository-workflow-totals",
      "intent": "Summarize declared and disabled workflow counts by repository.",
      "description": "Declared and disabled workflow totals for each repository.",
      "from": "workflows",
      "aggregate": {
        "by": [
          "organization",
          "repository"
        ],
        "values": [
          {
            "field": "workflow",
            "as": "workflows",
            "reducer": "count"
          },
          {
            "field": "workflow",
            "as": "disabled",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "workflow-active",
                  "equals": "false"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "repository-report-totals",
      "intent": "Summarize published outcome report counts by repository.",
      "description": "Published report totals for each repository.",
      "from": "outcomes",
      "aggregate": {
        "by": [
          "organization",
          "repository"
        ],
        "values": [
          {
            "field": "repository",
            "as": "reports",
            "reducer": "count"
          }
        ]
      }
    },
    {
      "name": "repository-run-totals",
      "intent": "Summarize distinct runs, failures, and approval-required runs by repository.",
      "description": "Distinct run and conclusion totals for each repository.",
      "from": "run-import-status",
      "aggregate": {
        "by": [
          "organization",
          "repository"
        ],
        "values": [
          {
            "field": "run",
            "as": "runs",
            "reducer": "distinct-count"
          },
          {
            "field": "run-conclusion",
            "as": "failed",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "run-conclusion",
                  "in": [
                    "failure",
                    "startup-failure",
                    "timed-out"
                  ]
                }
              ]
            }
          },
          {
            "field": "run-conclusion",
            "as": "action-required",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "run-conclusion",
                  "equals": "action-required"
                }
              ]
            }
          },
          {
            "field": "imported",
            "as": "imported-runs",
            "reducer": "sum"
          }
        ]
      }
    },
    {
      "name": "repository-activity-core",
      "intent": "Join each repository with its workflow, report, evaluation, and run totals.",
      "description": "Repository inventory joined with workflow, report, evaluation, and run totals.",
      "from": "repositories",
      "joins": [
        {
          "source": "repository-workflow-totals",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            }
          ],
          "fields": [
            {
              "field": "workflows",
              "as": "observed-workflows"
            },
            {
              "field": "disabled",
              "as": "observed-disabled"
            }
          ]
        },
        {
          "source": "repository-report-totals",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            }
          ],
          "fields": [
            {
              "field": "reports",
              "as": "observed-reports"
            }
          ]
        },
        {
          "source": "repository-run-totals",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            }
          ],
          "fields": [
            {
              "field": "runs",
              "as": "observed-runs"
            },
            {
              "field": "failed",
              "as": "observed-failed"
            },
            {
              "field": "action-required",
              "as": "observed-action-required"
            },
            {
              "field": "imported-runs",
              "as": "observed-imported-runs"
            }
          ]
        }
      ]
    },
    {
      "name": "repository-activity",
      "intent": "Show repository-level execution health, outcome activity, and AI Credit usage in an actionable inventory.",
      "description": "Repository-local execution health and attributed outcome totals.",
      "from": "repository-activity-core",
      "joins": [
        {
          "source": "repository-aic-totals",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            }
          ],
          "fields": [
            {
              "field": "aic",
              "as": "observed-aic"
            }
          ]
        }
      ],
      "compute": [
        {
          "as": "repository-slug",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "workflows",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-workflows"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "disabled",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-disabled"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "failed",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-failed"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "imported-runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-imported-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "ingestion-rate",
          "function": "quotient",
          "args": [
            {
              "field": "imported-runs"
            },
            {
              "field": "runs"
            }
          ]
        },
        {
          "as": "ingestion",
          "function": "format-percent",
          "args": [
            {
              "field": "ingestion-rate"
            }
          ]
        },
        {
          "as": "action-required",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-action-required"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "aic",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-aic"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "has-failures",
          "function": "greater-than",
          "args": [
            {
              "field": "failed"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "has-action-required",
          "function": "greater-than",
          "args": [
            {
              "field": "action-required"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "has-runs",
          "function": "greater-than",
          "args": [
            {
              "field": "runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "has-disabled",
          "function": "greater-than",
          "args": [
            {
              "field": "disabled"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "outcomes-observed",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-reports"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "has-outcomes",
          "function": "greater-than",
          "args": [
            {
              "field": "outcomes-observed"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "failure-rate",
          "function": "quotient",
          "args": [
            {
              "field": "failed"
            },
            {
              "field": "runs"
            }
          ]
        },
        {
          "as": "failure-percent",
          "function": "format-percent",
          "args": [
            {
              "field": "failure-rate"
            }
          ]
        },
        {
          "as": "failure-count",
          "function": "format-count",
          "args": [
            {
              "field": "failed"
            }
          ]
        },
        {
          "as": "observed-failure-summary",
          "function": "concat",
          "args": [
            {
              "field": "failure-percent"
            },
            {
              "value": " · "
            },
            {
              "field": "failure-count"
            },
            {
              "value": " failed"
            }
          ]
        },
        {
          "as": "failure-summary",
          "function": "if",
          "args": [
            {
              "field": "has-runs"
            },
            {
              "field": "observed-failure-summary"
            },
            {
              "value": "—"
            }
          ]
        },
        {
          "as": "outcome-status",
          "function": "if",
          "args": [
            {
              "field": "has-outcomes"
            },
            {
              "value": "Outcomes observed"
            },
            {
              "value": "No recent activity"
            }
          ]
        },
        {
          "as": "disabled-status",
          "function": "if",
          "args": [
            {
              "field": "has-disabled"
            },
            {
              "value": "Disabled workflows"
            },
            {
              "field": "outcome-status"
            }
          ]
        },
        {
          "as": "run-status",
          "function": "if",
          "args": [
            {
              "field": "has-runs"
            },
            {
              "value": "No failures observed"
            },
            {
              "field": "disabled-status"
            }
          ]
        },
        {
          "as": "action-status",
          "function": "if",
          "args": [
            {
              "field": "has-action-required"
            },
            {
              "value": "Approval required"
            },
            {
              "field": "run-status"
            }
          ]
        },
        {
          "as": "status",
          "function": "if",
          "args": [
            {
              "field": "has-failures"
            },
            {
              "value": "Needs attention"
            },
            {
              "field": "action-status"
            }
          ]
        },
        {
          "as": "encoded-repository",
          "function": "url-encode",
          "args": [
            {
              "field": "repository-slug"
            }
          ]
        },
        {
          "as": "repository-dashboard-href",
          "function": "concat",
          "args": [
            {
              "value": "#page-repository-detail?repository="
            },
            {
              "field": "encoded-repository"
            }
          ]
        },
        {
          "as": "repository-dashboard-label",
          "function": "concat",
          "args": [
            {
              "value": "View "
            },
            {
              "field": "repository-slug"
            },
            {
              "value": " repository dashboard"
            }
          ]
        },
        {
          "as": "repository-dashboard-link",
          "function": "dashboard-link",
          "args": [
            {
              "field": "repository-link"
            },
            {
              "field": "repository-dashboard-href"
            },
            {
              "field": "repository-dashboard-label"
            },
            {
              "field": "repository-slug"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "organization"
        },
        {
          "field": "repository",
          "as": "repository-name"
        },
        {
          "field": "repository-slug",
          "as": "repository"
        },
        {
          "field": "workflows"
        },
        {
          "field": "observed-reports",
          "as": "reports"
        },
        {
          "field": "runs"
        },
        {
          "field": "ingestion"
        },
        {
          "field": "failure-summary"
        },
        {
          "field": "aic"
        },
        {
          "field": "status"
        },
        {
          "field": "repository-dashboard-link",
          "as": "repository-link"
        },
        {
          "field": "failed"
        }
      ],
      "order-by": [
        {
          "field": "failed",
          "direction": "desc"
        },
        {
          "field": "runs",
          "direction": "desc"
        },
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    }
  ],
  "views": [
    {
      "id": "repository-workflows",
      "title": "Workflows",
      "description": "Declared workflows for the selected repository.",
      "data": {
        "source": "entity-workflows",
        "arguments": [
          {
            "name": "organization",
            "field": "organization"
          },
          {
            "name": "repository",
            "field": "repository"
          }
        ]
      },
      "mark": "list",
      "list": {
        "style": "entity-cards",
        "card": "workflow",
        "icon": "workflow",
        "drill": {
          "type": "query",
          "page": "workflow-run-cards",
          "query": "entity-runs",
          "title-field": "workflow",
          "arguments": [
            {
              "name": "organization",
              "field": "organization"
            },
            {
              "name": "repository",
              "field": "repository"
            },
            {
              "name": "workflow",
              "field": "workflow"
            }
          ]
        }
      },
      "empty-message": "No workflows were observed for this repository.",
      "layout": "full-view",
      "encoding": {
        "columns": [
          {
            "field": "workflow",
            "type": "nominal",
            "title": "Workflow",
            "format": "workflow-relative-path"
          },
          {
            "field": "workflow-role",
            "type": "nominal",
            "title": "Role"
          },
          {
            "field": "workflow-active",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "repository",
            "type": "nominal",
            "title": "Repository"
          },
          {
            "field": "campaign-name",
            "type": "nominal",
            "title": "Campaign"
          },
          {
            "field": "observed-at",
            "type": "temporal",
            "title": "Observed",
            "format": "human-friendly-timestamp"
          },
          {
            "field": "organization",
            "type": "nominal",
            "title": "Organization"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "id": "repositories",
      "kind": "built-in",
      "page": "repositories",
      "title": "Repositories",
      "description": "Repository-owned workflow health and AI Credit usage across the configured repository scope.",
      "icon": "repo",
      "class-name": "repositories-page",
      "definition": {
        "data-state": {
          "availability": true
        },
        "views": [
          {
            "id": "repositories-issues",
            "title": "Top repositories with issues",
            "description": "The share of retained issues attributed to the ten repositories with the most issue safe outputs.",
            "data": {
              "source": "issue-repository-totals"
            },
            "mark": "chart",
            "chart": "pie",
            "layout": "full",
            "empty-message": "No issue safe outputs were retained in the current report.",
            "encoding": {
              "x": {
                "field": "repository-coordinate",
                "type": "nominal",
                "title": "Repository"
              },
              "y": {
                "field": "issues",
                "type": "quantitative",
                "title": "Issues"
              }
            }
          },
          {
            "id": "repositories-activity",
            "title": "Repositories",
            "description": "Repository-local execution health and all attributed campaign or local-workflow outcomes.",
            "data": {
              "source": "repository-activity"
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No repositories discovered.",
            "encoding": {
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal",
                  "title": "Repository"
                },
                {
                  "field": "runs",
                  "type": "quantitative",
                  "title": "Runs"
                },
                {
                  "field": "ingestion",
                  "type": "nominal",
                  "title": "Ingestion %"
                },
                {
                  "field": "failure-summary",
                  "type": "nominal",
                  "title": "Failure rate",
                  "filter": false
                },
                {
                  "field": "aic",
                  "type": "quantitative",
                  "title": "AIC",
                  "unit": "aic"
                },
                {
                  "field": "workflows",
                  "type": "quantitative",
                  "title": "AWs"
                },
                {
                  "field": "status",
                  "type": "nominal",
                  "title": "Status",
                  "display": "status"
                }
              ],
              "href": {
                "field": "repository-link",
                "type": "nominal"
              }
            }
          }
        ]
      }
    },
    {
      "id": "repository-workflows",
      "kind": "custom",
      "title": "Repository workflows",
      "description": "Declared workflows for the selected repository.",
      "icon": "workflow",
      "route": {
        "hash-query-parameter": "repository",
        "navigation-page": "repositories"
      },
      "views": [
        "repository-workflows"
      ]
    },
    {
      "id": "repository-detail",
