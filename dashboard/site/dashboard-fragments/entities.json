          "mark": "table",
          "controls": "interactive",
          "lazy-list": true,
          "column-summaries": true,
          "layout": "full-view",
          "empty-message": "No related runs are available.",
          "encoding": {
            "columns": [
              {
                "field": "run",
                "type": "nominal",
                "title": "Run",
                "display": "run-link"
              },
              {
                "field": "repository",
                "type": "nominal",
