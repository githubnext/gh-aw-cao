{
  "queries": [
    {
      "name": "domain-entity-insights",
      "intent": "Summarize one domain entity for its dedicated Insights view.",
      "from": "domains",
      "aggregate": {
        "by": [
          "domain",
          "decision"
        ],
        "values": [
          {
            "field": "request-count",
            "as": "requests",
            "reducer": "sum"
          }
        ]
      },
      "order-by": [
        {
          "field": "requests",
          "direction": "desc"
        },
        {
          "field": "decision",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "tool-entity-insights",
      "intent": "Summarize one tool entity for its dedicated Insights view.",
      "from": "mcp-tool-calls",
      "aggregate": {
        "by": [
          "mcp-tool-label",
          "mcp-server",
          "mcp-tool",
          "mcp-status"
        ],
        "values": [
          {
            "field": "mcp-observation",
            "as": "observations",
            "reducer": "count"
          }
        ]
      },
      "order-by": [
        {
          "field": "observations",
          "direction": "desc"
        },
        {
          "field": "mcp-status",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "audit-entity-insights",
      "intent": "Summarize one audit event entity for its dedicated Insights view.",
      "from": "audits",
      "aggregate": {
        "by": [
          "event-summary",
          "event-status"
        ],
        "values": [
          {
            "field": "id",
            "as": "observations",
            "reducer": "count"
          }
        ]
      },
      "order-by": [
        {
          "field": "observations",
          "direction": "desc"
        },
        {
          "field": "event-status",
          "direction": "asc"
        }
      ]
    }
  ],
  "pages": [
    {
      "id": "domain-insights",
      "kind": "custom",
      "title": "Domain",
      "icon": "graph",
      "description": "Insights for the selected domain entity.",
      "route": {
        "hash-query-parameter": "domain",
        "navigation-page": "firewall",
        "tab": "insights",
        "tabs": [
          {
            "id": "insights",
            "label": "Insights",
            "icon": "graph",
            "page": "domain-insights"
          },
          {
            "id": "runs",
            "label": "Runs",
            "icon": "play",
            "page": "domain-runs"
          }
        ]
      },
      "views": [
        {
          "id": "domain-route-chrome",
          "title": "Domain insights",
          "data": {
            "sources": [
              "domains"
            ],
            "arguments": [
              {
                "name": "domain",
                "field": "domain"
              }
            ]
          },
          "mark": "element",
          "element": "entity-route",
          "layout": "full",
          "title-link": {
            "href-field": "run-link",
            "identifier-field": "domain"
          }
        },
        {
          "id": "domain-insights-chart",
          "title": "Requests by firewall decision",
          "data": {
            "source": "domain-entity-insights",
            "arguments": [
              {
                "name": "domain",
                "field": "domain"
              }
            ]
          },
          "mark": "chart",
          "chart": "bar",
          "layout": "full",
          "encoding": {
            "x": {
              "field": "decision",
              "type": "nominal",
              "title": "Decision"
            },
            "y": {
              "field": "requests",
              "type": "quantitative",
              "title": "Requests"
            }
          }
        }
      ]
    },
