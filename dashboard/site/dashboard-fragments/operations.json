{
  "queries": [
    {
      "name": "marketplace-package-detail",
      "intent": "Select one normalized marketplace package by its resolver-produced source coordinate.",
      "from": "marketplace-packages"
    },
    {
      "name": "indexing-daily-records",
      "intent": "Aggregate records committed from CAO Activity by ingestion UTC day.",
      "from": "transactions",
      "filter": {
        "predicates": [
          {
            "field": "kind",
            "in": [
              "ingest-jsonl",
              "ingest-normalized-jsonl"
            ]
          }
        ]
      },
      "compute": [
        {
          "as": "day",
          "function": "date-day",
          "args": [
            {
              "field": "createdAt"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "day"
        ],
        "values": [
          {
            "field": "committedRecords",
            "as": "records",
            "reducer": "sum"
          }
        ]
      },
      "order-by": [
        {
          "field": "day",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "indexing-daily-workflow-runs",
      "intent": "Aggregate workflow runs ingested from CAO Activity by UTC day.",
      "from": "transactions",
      "filter": {
        "predicates": [
          {
            "field": "kind",
            "in": [
              "ingest-jsonl",
              "ingest-normalized-jsonl"
            ]
          }
        ]
      },
      "compute": [
        {
          "as": "day",
          "function": "date-day",
          "args": [
            {
              "field": "createdAt"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "day"
        ],
        "values": [
          {
            "field": "rawRuns",
            "as": "workflow-runs",
            "reducer": "sum"
          }
        ]
      },
      "order-by": [
        {
          "field": "day",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "indexing-campaigns-table-count",
      "intent": "Count retained campaigns rows in the dashboard database.",
      "from": "campaigns",
      "compute": [
