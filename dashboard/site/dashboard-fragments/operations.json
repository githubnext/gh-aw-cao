          }
        ]
      }
    },
    {
      "name": "indexing-database-table-counts",
      "intent": "Count retained canonical dashboard database rows by table.",
      "from": "indexing-campaigns-table-count",
      "union": [
        "indexing-repositories-table-count",
        "indexing-workflows-table-count",
        "indexing-runs-table-count",
        "indexing-domains-table-count",
        "indexing-tools-table-count",
        "indexing-audits-table-count",
        "indexing-issues-table-count",
        "indexing-operational-values-table-count",
        "indexing-transactions-table-count"
      ],
      "order-by": [
        {
          "field": "records",
          "direction": "desc"
        },
        {
          "field": "table",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "indexing-transactions",
      "intent": "Prepare retained ingestion transactions for card presentation.",
      "from": "transactions",
      "select": [
        {
          "field": "id"
        },
        {
          "field": "kind"
        },
        {
          "field": "createdAt",
          "as": "created-at"
        },
        {
          "field": "committedRecords",
          "as": "committed-records"
        },
        {
          "field": "payloadHash",
          "as": "payload-hash"
        }
      ]
    },
    {
      "name": "engines-models-usage",
      "intent": "Summarize run-level AIC and token usage by agent and model identifiers without treating unavailable telemetry as zero.",
      "description": "Observed workflow runs grouped by agent ID and model ID. Each AIC and token statistic uses only runs that reported that metric.",
      "from": "runs",
      "compute": [
        {
          "as": "summary",
          "function": "concat",
          "args": [
            {
              "field": "agent-id"
            },
            {
              "value": " / "
            },
            {
              "field": "model-id"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "summary"
        ],
        "values": [
          {
            "field": "run",
            "as": "runs",
            "reducer": "count"
          },
          {
            "field": "aic-total",
            "as": "minimum-aic-per-run",
            "reducer": "min"
          },
          {
            "field": "aic-total",
            "as": "average-aic-per-run",
            "reducer": "mean"
          },
          {
            "field": "aic-total",
            "as": "maximum-aic-per-run",
            "reducer": "max"
          },
          {
            "field": "input-tokens",
            "as": "minimum-input-tokens-per-run",
            "reducer": "min"
          },
          {
            "field": "input-tokens",
            "as": "average-input-tokens-per-run",
            "reducer": "mean"
          },
          {
            "field": "input-tokens",
            "as": "maximum-input-tokens-per-run",
            "reducer": "max"
          },
          {
            "field": "output-tokens",
            "as": "minimum-output-tokens-per-run",
            "reducer": "min"
          },
          {
            "field": "output-tokens",
            "as": "average-output-tokens-per-run",
            "reducer": "mean"
          },
          {
            "field": "output-tokens",
            "as": "maximum-output-tokens-per-run",
            "reducer": "max"
          },
          {
            "field": "cache-read-tokens",
            "as": "minimum-cache-read-tokens-per-run",
            "reducer": "min"
          },
          {
            "field": "cache-read-tokens",
            "as": "average-cache-read-tokens-per-run",
            "reducer": "mean"
          },
          {
            "field": "cache-read-tokens",
            "as": "maximum-cache-read-tokens-per-run",
            "reducer": "max"
          },
          {
            "field": "cache-write-tokens",
            "as": "minimum-cache-write-tokens-per-run",
            "reducer": "min"
          },
          {
            "field": "cache-write-tokens",
            "as": "average-cache-write-tokens-per-run",
            "reducer": "mean"
          },
          {
            "field": "cache-write-tokens",
            "as": "maximum-cache-write-tokens-per-run",
            "reducer": "max"
          },
          {
            "field": "reasoning-tokens",
            "as": "minimum-reasoning-tokens-per-run",
            "reducer": "min"
          },
          {
            "field": "reasoning-tokens",
            "as": "average-reasoning-tokens-per-run",
            "reducer": "mean"
          },
          {
            "field": "reasoning-tokens",
            "as": "maximum-reasoning-tokens-per-run",
            "reducer": "max"
          }
        ]
      },
      "select": [
        {
          "field": "summary"
        },
        {
          "field": "runs"
        },
        {
          "field": "average-aic-per-run"
        },
        {
          "field": "minimum-aic-per-run"
        },
        {
          "field": "maximum-aic-per-run"
        },
        {
          "field": "minimum-input-tokens-per-run"
        },
        {
          "field": "average-input-tokens-per-run"
        },
        {
          "field": "maximum-input-tokens-per-run"
        },
        {
          "field": "minimum-output-tokens-per-run"
        },
        {
          "field": "average-output-tokens-per-run"
        },
        {
          "field": "maximum-output-tokens-per-run"
        },
        {
          "field": "minimum-cache-read-tokens-per-run"
        },
        {
          "field": "average-cache-read-tokens-per-run"
        },
        {
          "field": "maximum-cache-read-tokens-per-run"
        },
        {
          "field": "minimum-cache-write-tokens-per-run"
        },
        {
          "field": "average-cache-write-tokens-per-run"
        },
        {
          "field": "maximum-cache-write-tokens-per-run"
        },
        {
          "field": "minimum-reasoning-tokens-per-run"
        },
        {
          "field": "average-reasoning-tokens-per-run"
        },
        {
          "field": "maximum-reasoning-tokens-per-run"
        }
      ],
      "order-by": [
        {
          "field": "runs",
          "direction": "desc"
        },
        {
          "field": "summary",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "skill-invocations",
      "intent": "Select observed skill invocations for skill usage analytics.",
      "from": "tools",
      "filter": {
        "predicates": [
          {
            "field": "is-skill",
            "equals": true
          }
        ]
      },
      "select": [
        {
          "field": "event",
          "as": "id"
        },
        {
          "field": "name",
          "as": "skill"
        },
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "workflow"
        }
      ]
    },
    {
      "name": "skill-invocations-by-skill",
      "intent": "Rank skills by their observed invocation count.",
      "from": "skill-invocations",
      "aggregate": {
        "by": [
          "skill"
        ],
        "values": [
          {
            "field": "id",
            "as": "invocations",
            "reducer": "count"
          }
        ]
      },
      "order-by": [
        {
          "field": "invocations",
          "direction": "desc"
        },
        {
          "field": "skill",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "skill-invocations-by-workflow-totals",
      "intent": "Rank workflows by their observed skill invocation count.",
      "from": "skill-invocations",
      "aggregate": {
        "by": [
          "organization",
          "repository",
          "workflow"
        ],
        "values": [
          {
            "field": "id",
            "as": "invocations",
            "reducer": "count"
          }
        ]
      }
    },
    {
      "name": "skill-invocations-by-workflow",
      "intent": "Present workflow skill invocation totals with drill-through navigation to the workflow dashboard.",
      "from": "skill-invocations-by-workflow-totals",
      "compute": [
        {
          "as": "workflow-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            },
            {
              "value": ":"
            },
            {
              "field": "workflow"
            }
          ]
        },
        {
          "as": "encoded-workflow",
          "function": "url-encode",
          "args": [
            {
              "field": "workflow-coordinate"
            }
          ]
        },
        {
          "as": "workflow-dashboard-href",
          "function": "concat",
          "args": [
            {
              "value": "#page-workflow-runtime?workflow="
            },
            {
              "field": "encoded-workflow"
            }
          ]
        },
        {
          "as": "workflow-dashboard-label",
          "function": "concat",
          "args": [
            {
              "value": "View "
            },
            {
              "field": "workflow-coordinate"
            },
            {
              "value": " workflow dashboard"
            }
          ]
        },
        {
          "as": "workflow-link",
          "function": "dashboard-link",
          "args": [
            {
              "value": ""
            },
            {
              "field": "workflow-dashboard-href"
            },
            {
              "field": "workflow-dashboard-label"
            },
            {
              "field": "workflow-coordinate"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "workflow-coordinate"
        },
        {
          "field": "workflow-link"
        },
        {
          "field": "invocations"
        }
      ],
      "order-by": [
        {
          "field": "invocations",
          "direction": "desc"
        },
        {
          "field": "workflow-coordinate",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "skill-workflow-totals",
      "intent": "Count observed invocations for each skill and workflow.",
      "from": "skill-invocations",
      "aggregate": {
        "by": [
          "skill",
          "organization",
          "repository",
          "workflow"
        ],
        "values": [
          {
            "field": "id",
            "as": "invocations",
            "reducer": "count"
          }
        ]
      }
    },
    {
      "name": "skill-workflow-inventory",
      "intent": "List observed skills by workflow with drill-through navigation to the workflow dashboard.",
      "from": "skill-workflow-totals",
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "workflow-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            },
            {
              "value": ":"
            },
            {
              "field": "workflow"
            }
          ]
        },
        {
          "as": "encoded-workflow",
          "function": "url-encode",
          "args": [
            {
              "field": "workflow-coordinate"
            }
          ]
        },
        {
          "as": "workflow-dashboard-href",
          "function": "concat",
          "args": [
            {
              "value": "#page-workflow-runtime?workflow="
            },
            {
              "field": "encoded-workflow"
            }
          ]
        },
        {
          "as": "workflow-dashboard-label",
          "function": "concat",
          "args": [
            {
              "value": "View "
            },
            {
              "field": "workflow-coordinate"
            },
            {
              "value": " workflow dashboard"
            }
          ]
        },
        {
          "as": "workflow-link",
          "function": "dashboard-link",
          "args": [
            {
              "value": ""
            },
            {
              "field": "workflow-dashboard-href"
            },
            {
              "field": "workflow-dashboard-label"
            },
            {
              "field": "workflow-coordinate"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "skill"
        },
        {
          "field": "repository-coordinate"
        },
        {
          "field": "workflow"
        },
        {
          "field": "workflow-link"
        },
        {
          "field": "invocations"
        }
      ],
      "order-by": [
        {
          "field": "invocations",
          "direction": "desc"
        },
        {
          "field": "skill",
          "direction": "asc"
        },
        {
          "field": "workflow",
          "direction": "asc"
        }
      ]
    }
  ],
  "pages": [
    {
      "id": "marketplace",
      "kind": "custom",
      "title": "Marketplace",
      "navigation-label": "Marketplace",
      "icon": "archive",
      "experimental": true,
      "description": "Browse read-only CAO campaign packages from the configured registries.",
      "views": [
        {
          "id": "marketplace-packages",
          "title": "Campaign packages",
          "description": "Registry metadata is resolved by the trusted CAO backend. Select a package for details and its add command.",
          "data": {
            "source": "marketplace-packages",
            "order-by": [
              {
                "field": "package-name",
                "direction": "asc"
              }
            ]
          },
          "mark": "list",
          "list": {
            "style": "entity-cards",
            "layout": "grid",
            "icon": "archive",
            "card": "marketplace-package",
            "drill": {
              "type": "query",
              "page": "marketplace-package",
              "query": "marketplace-package-detail",
              "title-field": "package-name",
              "arguments": [
                {
                  "name": "package-source",
                  "field": "package-source"
                }
              ]
            }
          },
          "encoding": {
            "columns": [
              {
                "field": "package-name",
                "type": "nominal",
                "title": "Package"
              },
              {
                "field": "package-description",
                "type": "nominal",
                "title": "Description"
              },
              {
                "field": "registry-name",
                "type": "nominal",
                "title": "Registry"
              }
            ]
          },
          "layout": "full",
          "empty-message": "No marketplace packages were resolved."
        }
      ]
    },
    {
      "id": "marketplace-package",
      "kind": "custom",
      "title": "Package",
      "icon": "archive",
      "description": "Review normalized package metadata and copy the canonical CAO add command.",
      "route": {
        "hash-query-parameter": "package-source",
        "navigation-page": "marketplace"
      },
      "views": [
        {
          "id": "marketplace-package-detail",
          "title": "Package details",
          "data": {
            "source": "marketplace-package-detail",
            "arguments": [
              {
                "name": "package-source",
                "field": "package-source"
              }
            ]
          },
          "mark": "list",
          "list": {
            "style": "entity-cards",
            "appearance": "grouped",
            "icon": "archive",
            "card": "marketplace-package"
          },
          "encoding": {
            "columns": [
              {
                "field": "package-name",
                "type": "nominal",
                "title": "Package"
              },
              {
                "field": "package-source",
                "type": "nominal",
                "title": "Source"
              },
              {
                "field": "package-contents",
                "type": "nominal",
                "title": "Contents"
              }
            ]
          },
          "layout": "full",
          "empty-message": "The selected package is unavailable."
        }
      ]
    },
    {
      "id": "indexing",
      "kind": "custom",
      "title": "Indexing",
      "navigation-label": "Indexing",
      "icon": "database",
      "experimental": true,
      "description": "Monitor CAO Activity ingestion and inspect retained dashboard transactions.",
      "views": [
        {
