{
  "queries": [
    {
      "name": "audit-event-summary-buckets",
      "subject": "Aggregate high- and medium-severity audit events with the same severity and summary by workflow.",
      "objective": "Select recurring high- or medium-severity audit summaries for run-level investigation.",
      "acceptance": "Each bucket's event count is traceable to retained audit or tool observations with the same campaign, severity, workflow, and summary; missing workflow attribution stays unknown, and a count alone does not verify impact.",
      "description": "High- and medium-severity audit event counts grouped by severity, workflow, and shared summary.",
      "from": "audits",
      "union": [
        "tools"
      ],
      "filter": {
        "predicates": [
          {
            "field": "event-type",
            "in": [
              "audit.finding",
              "audit.observability",
              "audit.recommendation",
              "audit.missing_tool",
              "audit.missing_data",
              "audit.noop",
              "audit.mcp_failure",
              "audit.skill_activation"
            ]
          },
          {
            "field": "event-status",
            "in": [
              "high",
              "medium"
            ]
          }
        ]
      },
      "joins": [
        {
          "source": "workflows",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            }
          ],
          "fields": [
            {
              "field": "campaign",
              "as": "campaign"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "campaign",
          "event-status",
          "workflow",
          "event-summary"
        ],
        "values": [
          {
            "field": "event",
            "as": "events",
            "reducer": "count"
          }
        ]
      },
      "select": [
        {
          "field": "campaign"
        },
        {
          "field": "event-status"
        },
        {
          "field": "workflow"
        },
        {
          "field": "event-summary"
        },
        {
          "field": "events"
        }
      ],
      "order-by": [
        {
          "field": "event-status",
          "direction": "asc"
        },
        {
          "field": "events",
          "direction": "desc"
        },
        {
          "field": "workflow",
          "direction": "asc"
        },
        {
          "field": "event-summary",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "campaign-workflows",
      "subject": "List campaign-owned orchestrator and worker workflows with database-backed execution totals.",
      "objective": "Choose an active campaign workflow whose observed execution warrants inspection.",
      "acceptance": "Listed workflows match active declared orchestrator or worker inventory entries; runs and AI Credits agree with the selected-horizon inventory, and absence is not evidence of disabled authority or no executions. Rollout mode is context, not permission to change policy.",
      "description": "Campaign workflows projected from lean canonical inventory, with display names and drill-down links computed only for the active list.",
      "from": "campaign-workflow-inventory",
      "filter": {
        "predicates": [
          {
            "field": "workflow-role",
            "in": [
              "orchestrator",
              "worker"
            ]
          },
          {
            "field": "workflow-active",
            "equals": "true"
          }
        ]
      },
      "compute": [
        {
          "as": "campaign-title",
          "function": "title-case",
          "args": [{ "field": "campaign" }]
        },
        {
          "as": "campaign-display-name",
          "function": "coalesce",
          "args": [{ "field": "campaign-name" }, { "field": "campaign-title" }, { "value": "Repository-owned" }]
        },
        {
          "as": "workflow-display-name",
          "function": "coalesce",
          "args": [{ "field": "workflow-name" }, { "field": "workflow" }]
        },
        {
          "as": "encoded-repository",
          "function": "url-encode",
          "args": [{ "field": "repository" }]
        },
        {
          "as": "repository-dashboard-href",
          "function": "concat",
          "args": [{ "value": "#page-repository-detail?repository=" }, { "field": "encoded-repository" }]
        },
        {
          "as": "repository-dashboard-label",
          "function": "concat",
          "args": [{ "value": "View " }, { "field": "repository" }, { "value": " repository dashboard" }]
        },
        {
          "as": "repository-dashboard-link",
          "function": "dashboard-link",
          "args": [
            { "field": "repository-link" }, { "field": "repository-dashboard-href" },
            { "field": "repository-dashboard-label" }, { "field": "repository" }
          ]
        },
        {
          "as": "workflow-identity",
          "function": "concat",
          "args": [{ "field": "repository" }, { "value": ":" }, { "field": "workflow" }]
        },
        {
          "as": "encoded-workflow",
          "function": "url-encode",
          "args": [{ "field": "workflow-identity" }]
        },
        {
          "as": "workflow-dashboard-href",
          "function": "concat",
          "args": [{ "value": "#page-workflow-runtime?workflow=" }, { "field": "encoded-workflow" }]
        },
        {
          "as": "workflow-dashboard-label",
          "function": "concat",
          "args": [{ "value": "View " }, { "field": "workflow-display-name" }, { "value": " workflow dashboard" }]
        },
        {
          "as": "workflow-dashboard-link",
          "function": "dashboard-link",
          "args": [
            { "field": "workflow-link" }, { "field": "workflow-dashboard-href" },
            { "field": "workflow-dashboard-label" }, { "field": "workflow-identity" }
          ]
        }
      ],
      "select": [
        {
          "field": "campaign"
        },
        {
          "field": "campaign-display-name",
          "as": "campaign-name"
        },
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "workflow"
        },
        {
          "field": "workflow-display-name",
          "as": "workflow-name"
        },
        {
          "field": "workflow-role"
        },
        {
          "field": "rollout-mode"
        },
        {
          "field": "workflow-active"
        },
        {
          "field": "runs"
        },
        {
          "field": "aic"
        },
        {
          "field": "repository-dashboard-link",
          "as": "repository-link"
        },
        {
          "field": "workflow-dashboard-link",
          "as": "workflow-link"
        }
      ],
      "order-by": [
        {
          "field": "campaign-name",
          "direction": "asc"
        },
        {
          "field": "workflow-role",
          "direction": "asc"
        },
        {
          "field": "workflow-name",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "campaign-reports",
      "subject": "Project retained outcomes into campaign-addressable report evidence.",
      "objective": "Identify a campaign report whose durable outcome record needs follow-up.",
      "acceptance": "Each report's campaign, title, source link, observation time, and disposition match its retained outcome; missing status is labeled unknown rather than accepted or resolved, and report production is not verified impact.",
      "description": "Campaign outcome reports with database-backed disposition fields.",
      "from": "outcomes",
      "compute": [
        {
          "as": "report-status",
          "function": "coalesce",
          "args": [
            {
              "field": "outcome-status"
            },
            {
              "field": "outcome-state"
            },
            {
              "value": "unknown"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "campaign"
        },
        {
          "field": "safe-output"
        },
        {
          "field": "outcome-title"
        },
        {
          "field": "outcome-summary"
        },
        {
          "field": "report-status",
          "as": "outcome-status"
        },
        {
          "field": "rollout-mode"
        },
        {
          "field": "engine"
        },
        {
          "field": "engine-version"
        },
        {
          "field": "requested-model"
        },
        {
          "field": "resolved-model"
        },
        {
          "field": "outcome-category"
        },
        {
          "field": "observed-at"
        },
        {
          "field": "external-link"
        }
      ],
      "order-by": [
        {
          "field": "observed-at",
          "direction": "desc"
        },
        {
          "field": "outcome-title",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "campaign-worker-issues",
      "subject": "Project issue outcomes created by campaign worker workflows.",
      "objective": "Choose a campaign worker issue whose current recorded disposition needs review.",
      "acceptance": "Every included issue outcome joins a declared worker on organization, repository, and workflow and retains its issue, run, and status evidence; missing closing details remain unknown and closure is not proof of resolution.",
      "description": "Campaign-addressable issue outcomes restricted to declared worker workflows.",
      "from": "outcomes",
      "joins": [
        {
          "source": "workflows",
          "type": "inner",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            }
          ],
          "fields": [
            {
              "field": "workflow-role",
              "as": "declared-workflow-role"
            }
          ]
        }
      ],
      "filter": {
        "predicates": [
          {
            "field": "outcome-category",
            "equals": "issue"
          },
          {
            "field": "declared-workflow-role",
            "equals": "worker"
          }
        ]
      },
      "select": [
        {
          "field": "campaign"
        },
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "safe-output"
        },
        {
          "field": "outcome-number"
        },
        {
          "field": "outcome-title",
          "as": "event-summary"
        },
        {
          "field": "outcome-title"
        },
        {
          "field": "outcome-summary"
        },
        {
          "field": "outcome-status"
        },
        {
          "field": "outcome-state"
        },
        {
          "field": "issue-state"
        },
        {
          "field": "issue-closed"
        },
        {
          "field": "issue-state-reason"
        },
        {
          "field": "issue-status"
        },
        {
          "field": "issue-closing-status"
        },
        {
          "field": "issue-status-detail"
        },
        {
          "field": "issue-closed-at"
        },
        {
          "field": "issue-status-observed-at"
        },
        {
          "field": "outcome-category",
          "as": "safe-output-type"
        },
        {
          "field": "workflow"
        },
        {
          "field": "workflow-name"
        },
        {
          "field": "run"
        },
        {
          "field": "observed-at"
        },
        {
          "field": "issue-link"
        },
        {
          "field": "external-link"
        },
        {
          "field": "run-link"
        }
      ],
      "order-by": [
        {
          "field": "observed-at",
          "direction": "desc"
        }
      ]
    },
    {
      "name": "campaign-issue-tab-counts",
      "subject": "Count the retained worker issues available for each campaign Reports tab.",
      "objective": "Decide whether a campaign has retained worker issue reports to inspect.",
      "acceptance": "For each returned campaign, items equals the number of rows in campaign-worker-issues for that campaign in the same horizon; missing campaigns are not treated as zero issues or verified resolution.",
      "description": "One campaign row with the number of retained issue outcomes produced by campaign workers.",
      "from": "campaign-worker-issues",
      "aggregate": {
        "by": [
          "campaign"
        ],
        "values": [
          {
            "field": "campaign",
            "as": "items",
            "reducer": "count"
          }
        ]
      }
    },
    {
      "name": "campaign-readme-orchestrators",
      "subject": "Resolve one repository link for each campaign README from its declared orchestrator workflow.",
      "objective": "Locate the declared orchestrator repository to contextualize a campaign README.",
      "acceptance": "Each returned campaign and repository link traces to a declared orchestrator workflow; missing or multiple declarations are reported as uncertain rather than inventing a canonical repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow-role",
            "equals": "orchestrator"
          }
        ]
      },
      "select": [
        {
          "field": "campaign"
        },
        {
          "field": "repository-link"
        }
      ]
    },
    {
      "name": "campaign-readme-details",
      "subject": "Present retained campaign README content with its repository-relative link context.",
      "objective": "Open the campaign's retained README in its declared repository context before relying on its guidance.",
      "acceptance": "The README text and path match the campaign record and any repository link resolves through a declared orchestrator; absent content or repository linkage remains unavailable, not inferred.",
      "from": "campaigns",
      "joins": [
        {
          "source": "campaign-readme-orchestrators",
          "type": "left",
          "on": [
            {
              "left": "campaign",
              "right": "campaign"
            }
          ],
          "fields": [
            {
              "field": "repository-link",
              "as": "repository-link"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "campaign"
        },
        {
          "field": "campaign-readme"
        },
        {
          "field": "campaign-readme-path"
        },
        {
          "field": "repository-link"
        }
      ]
    },
    {
      "name": "campaign-memory-campaigns",
      "subject": "Provide the registered campaigns whose repository memory can be browsed together.",
      "objective": "Choose a registered campaign for repository-memory inspection.",
      "acceptance": "Each campaign identity and display name matches the retained campaign registry in the selected scope; listing a campaign does not establish that memory observations exist or are complete.",
      "description": "Registered campaigns ordered for the all-campaign repository-memory browser.",
      "from": "campaigns",
      "select": [
        {
          "field": "campaign"
        },
        {
          "field": "campaign-name"
        }
      ],
      "order-by": [
        {
          "field": "campaign-name",
          "direction": "asc"
        }
      ]
    }
  ],
  "pages": [
    {
      "id": "campaigns",
      "kind": "built-in",
      "page": "campaigns",
      "title": "Campaigns",
      "icon": "goal",
      "class-name": "campaigns-page",
      "description": "Activity from centrally managed campaigns.",
      "mode-indicator": true,
      "definition": {
        "data-state": {
          "availability": true
        },
        "views": [
          {
            "id": "campaigns-dispatches",
            "title": "Dispatches by campaign",
            "subject": "Compare observed dispatch volume across managed campaigns.",
            "objective": "Identify campaigns to inspect for unexpectedly high or low activity.",
            "acceptance": "The comparison uses the selected horizon and does not equate dispatch count with successful outcomes.",
            "description": "The share of observed dispatches handled by each centrally managed campaign.",
            "data": {
              "source": "campaign-inventory"
            },
            "mark": "chart",
            "chart": "pie",
            "layout": "horizontal",
            "empty-message": "No campaign dispatches were observed in the selected horizon.",
            "encoding": {
              "x": {
                "field": "campaign-name",
                "type": "nominal",
                "title": "Campaign"
              },
              "y": {
                "field": "dispatches",
                "type": "quantitative",
                "aggregate": "sum",
                "as": "total-dispatches",
                "title": "Dispatches"
              },
              "href": {
                "field": "campaign-dashboard-link",
                "type": "nominal"
              }
            }
          },
          {
            "id": "campaigns-repository-coverage",
            "title": "Repository coverage by campaign",
            "subject": "Compare registered repositories reached by successful worker dispatches across campaigns.",
            "objective": "Find campaigns whose observed reach needs closer inspection.",
            "acceptance": "Coverage is interpreted within the selected horizon, not as proof that every eligible repository has been reached.",
            "description": "Distinct registered repositories reached by successful worker dispatches in the selected horizon.",
            "data": {
              "source": "campaign-inventory",
              "order-by": [
                {
                  "field": "covered-repositories",
                  "direction": "desc"
                },
                {
                  "field": "campaign-name",
                  "direction": "asc"
                }
              ],
              "limit": 100
            },
            "mark": "chart",
            "chart": "horizontal-bar",
            "layout": "full",
            "empty-message": "No campaign repository coverage was observed in the selected horizon.",
            "encoding": {
              "x": {
                "field": "campaign-name",
                "type": "nominal",
                "title": "Campaign"
              },
              "color": {
                "field": "campaign-name",
                "type": "nominal",
                "title": "Campaign"
              },
              "y": {
                "field": "covered-repositories",
                "type": "quantitative",
                "title": "Covered repositories"
              }
            }
          },
          {
            "id": "campaigns-inventory",
            "title": "Campaigns",
            "description": "Centrally managed campaign inventory and observed execution totals.",
            "data": {
              "source": "campaign-inventory"
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "column-summaries": true,
            "layout": "full-view",
            "empty-message": "No campaigns discovered.",
            "encoding": {
              "href": {
                "field": "campaign-dashboard-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "campaign-name",
                  "type": "nominal",
                  "title": "Campaign"
                },
                {
                  "field": "workflows",
                  "type": "quantitative",
                  "title": "Workflows"
                },
                {
                  "field": "roles",
                  "type": "nominal",
                  "title": "Roles"
                },
                {
                  "field": "modes",
                  "type": "nominal",
                  "title": "Modes",
                  "display": "mode"
                },
                {
                  "field": "runs",
                  "type": "quantitative",
                  "title": "Runs"
                },
                {
                  "field": "dispatches",
                  "type": "quantitative",
                  "title": "Dispatches"
                },
                {
                  "field": "aic",
                  "type": "quantitative",
                  "title": "AIC",
                  "unit": "aic"
                },
                {
                  "field": "registration",
                  "type": "nominal",
                  "title": "Registration",
                  "display": "active-state"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "memory",
      "kind": "custom",
      "title": "Memory",
      "navigation-label": "Memory",
      "icon": "archive",
      "class-name": "memory-page",
      "description": "Browse repository memory published by centrally managed campaigns.",
      "views": [
        {
          "id": "campaign-memory-browser",
          "title": "Campaign memory",
          "subject": "Let operators browse published repository memory from every registered campaign in a compact file tree, with Raw and Table tabs for JSONL files using shared table controls.",
          "description": "The file browser owns JSONL tabs because memory files have dynamic schemas outside canonical dashboard sources. The data worker parses records, and the shared table presents their fields.",
          "data": {
            "sources": [
              "campaign-memory-campaigns"
            ]
          },
          "mark": "element",
          "element": "all-campaign-memory",
          "layout": "full-view"
        }
      ]
    },
    {
      "id": "campaign-detail",
      "kind": "custom",
      "title": "Campaign",
      "description": "Operational activity for this campaign.",
      "icon": "goal",
      "class-name": "campaign-detail-page",
      "route": {
        "hash-query-parameter": "campaign",
        "title-format": "title-case",
        "tabs-class-name": "campaign-tabs",
        "tabs": [
          {
            "id": "insights",
            "label": "Operational Value",
            "icon": "graph",
            "page": "campaign-insights"
          },
          {
            "id": "problems",
            "label": "Failures",
            "icon": "alert",
            "page": "campaign-problems"
          },
          {
            "id": "issues",
            "label": "Reports",
            "icon": "issue-opened",
            "page": "campaign-issues"
          },
          {
            "id": "memory",
            "label": "Memory",
            "icon": "archive",
            "page": "campaign-memory"
          }
        ]
      },
      "views": [
        {
          "id": "campaign-overview-navigation",
          "title": "Campaign overview",
          "data": {
            "sources": [
              "workflows",
              "campaign-insight-tab-counts",
              "campaign-problem-tab-counts",
              "campaign-issue-tab-counts"
            ],
            "arguments": [
              {
                "name": "campaign",
                "field": "campaign"
              }
            ]
          },
          "mark": "element",
          "element": "campaign-route",
          "layout": "full",
          "config": {
            "body": "overview"
          }
        },
        {
          "id": "campaign-readme",
          "title": "README",
          "data": {
            "limit": 1,
            "sources": [
              "campaign-readme-details"
            ],
            "arguments": [
              {
                "name": "campaign",
                "field": "campaign"
              }
            ]
          },
          "mark": "element",
          "element": "markdown",
          "config": {
            "content-field": "campaign-readme",
            "path-field": "campaign-readme-path",
            "base-link-field": "repository-link",
            "empty-message": "Campaign README content is unavailable in this inventory."
          },
          "layout": "full"
        },
        {
          "id": "campaign-settings",
          "title": "Settings",
          "data": {
            "source": "campaigns",
            "arguments": [
              {
                "name": "campaign",
                "field": "campaign"
              }
            ]
          },
          "mark": "table",
          "encoding": {
            "columns": [
              {
                "field": "campaign-description",
                "type": "nominal",
                "title": "Description"
              },
              {
                "field": "campaign-enabled",
                "type": "nominal",
                "title": "State",
                "display": "active-state"
              },
              {
                "field": "campaign-mode",
                "type": "nominal",
                "title": "Rollout",
                "display": "mode"
              },
              {
                "field": "campaign-worker-count",
                "type": "quantitative",
                "title": "Workers"
              }
            ],
            "actions": [
              {
                "action": "set-campaign-preview",
                "presentation": "cli-action",
                "icon": "eye",
                "label": "Switch to preview",
                "context": [
                  "campaign"
                ],
                "when": {
                  "field": "campaign-mode",
                  "equals": "live"
                }
              },
              {
                "action": "set-campaign-live",
                "presentation": "cli-action",
                "icon": "play",
                "label": "Switch to live",
                "context": [
                  "campaign"
                ],
                "when": {
                  "field": "campaign-mode",
                  "equals": "review"
                }
              },
              {
                "action": "disable-campaign",
                "presentation": "cli-action",
                "icon": "pause",
                "label": "Pause campaign",
                "context": [
                  "campaign"
                ],
                "when": {
                  "field": "campaign-enabled",
                  "equals": true
                }
              },
              {
                "action": "enable-campaign",
                "presentation": "cli-action",
                "icon": "play",
                "label": "Enable campaign",
                "context": [
                  "campaign"
                ],
                "when": {
                  "field": "campaign-enabled",
                  "equals": false
                }
              }
            ]
          },
          "layout": "full"
        }
      ]
    },
    {
      "id": "campaign-workflows",
      "kind": "custom",
      "title": "Campaign",
      "description": "Operational activity for this campaign.",
      "icon": "workflow",
      "class-name": "campaign-workflows-page",
      "route": {
        "hash-query-parameter": "campaign",
        "title-format": "title-case",
        "tabs-class-name": "campaign-tabs",
        "tabs": [
