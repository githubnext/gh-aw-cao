{
  "queries": [
    {
      "name": "campaign-operational-value-repository-run-day-totals",
      "intent": "Summarize concluded campaign run outcomes by repository and UTC day as aligned context for operational-value history.",
      "objective": "Identify repository-days with failed or missing concluded run activity to inspect beside operational-value observations.",
      "acceptance": "For each campaign, repository, and UTC started-at day, distinct concluded, successful, and failed attempt counts reconcile to retained completed campaign runs under their declared statuses; other conclusions remain separate, and temporal alignment is not causal evidence.",
      "description": "Daily repository success, failure, and other concluded-run counts for visual association only; these observations do not establish causation.",
      "from": "campaign-runs",
      "filter": {
        "predicates": [
          {
            "field": "run-status",
            "equals": "completed"
          }
        ]
      },
      "compute": [
        {
          "as": "run-day",
          "function": "date-day",
          "args": [
            {
              "field": "started-at"
            }
          ]
        },
        {
          "as": "run-attempt-identity",
          "function": "concat",
          "args": [
            {
              "field": "run"
            },
            {
              "value": ":"
            },
            {
              "field": "run-attempt"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "campaign",
          "repository",
          "run-day"
        ],
        "values": [
          {
            "field": "run-attempt-identity",
            "as": "concluded-runs",
            "reducer": "distinct-count"
          },
          {
            "field": "run-attempt-identity",
            "as": "successful-runs",
            "reducer": "distinct-count",
            "filter": {
              "predicates": [
                {
                  "field": "status",
                  "equals": "success"
                }
              ]
            }
          },
          {
            "field": "run-attempt-identity",
            "as": "failed-runs",
            "reducer": "distinct-count",
            "filter": {
              "predicates": [
                {
                  "field": "status",
                  "in": [
                    "failure",
                    "startup-failure",
                    "timed_out",
                    "cancelled",
                    "stale"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "campaign-operational-value-repository-run-days",
      "intent": "Provide daily repository run outcomes as nearby context for operational-value observations.",
      "objective": "Spot repository-day reliability changes worth checking against the underlying run attempts.",
      "acceptance": "The percent equals 100 times successful-runs divided by concluded-runs for the same repository-day when the denominator exists; zero or missing denominators remain undefined, and the rate is not operational value.",
      "description": "Repository success and failure counts for temporal proximity only, without converting run outcomes into operational value or implying causation.",
      "from": "campaign-operational-value-repository-run-day-totals",
      "compute": [
        {
          "as": "success-rate-ratio",
          "function": "quotient",
          "args": [
            {
              "field": "successful-runs"
            },
            {
              "field": "concluded-runs"
            }
          ]
        },
        {
          "as": "success-rate-percent",
          "function": "product",
          "args": [
            {
              "field": "success-rate-ratio"
            },
            {
              "value": 100
            }
          ]
        }
      ]
    },
    {
      "name": "campaign-operational-value-run-day-totals",
      "intent": "Summarize concluded campaign run outcomes by UTC day as aligned context for weighted campaign operational-value history.",
      "objective": "Identify campaign-days with changed run-outcome counts for follow-up at repository level.",
      "acceptance": "Each campaign-day's concluded, successful, and failed counts equal sums of its retained repository-day counts; absent repository days are not assumed to be zero, and aggregate run success does not establish operational impact.",
      "description": "Daily campaign-wide success context aggregated from repository run-day counts without implying a causal relationship.",
      "from": "campaign-operational-value-repository-run-days",
      "aggregate": {
        "by": [
          "campaign",
          "run-day"
        ],
        "values": [
          {
            "field": "concluded-runs",
            "as": "concluded-runs",
            "reducer": "sum"
          },
          {
            "field": "successful-runs",
            "as": "successful-runs",
            "reducer": "sum"
          },
          {
            "field": "failed-runs",
            "as": "failed-runs",
            "reducer": "sum"
          }
        ]
      }
    },
    {
      "name": "campaign-operational-value-run-days",
      "intent": "Provide daily campaign-wide run outcomes as nearby context for weighted operational-value observations.",
      "objective": "Compare campaign-day runtime reliability with nearby value observations before selecting days to investigate.",
      "acceptance": "Success rate is successful-runs divided by concluded-runs, expressed as a percent only where the denominator exists; the numerator and denominator remain inspectable, and co-occurrence does not establish causality or operational value.",
      "description": "Campaign success and failure counts for temporal proximity only, without implying a causal relationship.",
      "from": "campaign-operational-value-run-day-totals",
      "compute": [
        {
          "as": "success-rate-ratio",
          "function": "quotient",
          "args": [
            {
              "field": "successful-runs"
            },
            {
              "field": "concluded-runs"
            }
          ]
        },
        {
          "as": "success-rate-percent",
          "function": "product",
          "args": [
            {
              "field": "success-rate-ratio"
            },
            {
              "value": 100
            }
          ]
        }
      ]
    },
    {
      "name": "campaign-performance-baseline-totals",
      "intent": "Establish a selected-horizon campaign baseline from concluded run attempts while keeping reliability, unverified production, and efficiency as separate facts.",
      "objective": "Select campaigns whose retained run reliability, output production, or AI Credit efficiency merits closer examination.",
      "acceptance": "Concluded and successful attempts, outputs, and mean AI Credits reconcile to filtered retained runs; absent denominators or costs stay unknown. Produced outputs are unverified, not operational value.",
      "description": "Canonical campaign run attempts aggregated into bounded selected-horizon baseline totals without treating runtime success or produced outputs as operational value.",
      "from": "campaign-runs",
      "compute": [
        {
          "as": "run-attempt-identity",
          "function": "concat",
          "args": [
            {
              "field": "run"
            },
            {
              "value": ":"
            },
            {
              "field": "run-attempt"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "campaign"
        ],
        "values": [
          {
            "field": "run-attempt-identity",
            "as": "concluded-runs",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "status",
                  "in": [
                    "success",
                    "failure",
                    "cancelled",
                    "timed-out",
                    "action-required",
                    "neutral",
                    "skipped",
                    "stale",
                    "startup-failure"
                  ]
                }
              ]
            }
          },
          {
            "field": "run-attempt-identity",
            "as": "successful-runs",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "status",
                  "equals": "success"
                }
              ]
            }
          },
          {
            "field": "safe-items-count",
            "as": "runs-with-output-evidence",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "status",
                  "equals": "success"
                }
              ]
            }
          },
          {
            "field": "safe-items-count",
            "as": "produced-outputs",
            "reducer": "sum",
            "filter": {
              "predicates": [
                {
                  "field": "status",
                  "equals": "success"
                }
              ]
            }
          },
          {
            "field": "aic-total",
            "as": "aic-per-successful-run",
            "reducer": "mean",
            "filter": {
              "predicates": [
                {
                  "field": "status",
                  "equals": "success"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "campaign-performance-baseline",
      "intent": "Turn each campaign's selected-horizon baseline totals into deterministic reliability and production signals with an explicit successful-run efficiency fact.",
      "objective": "Decide which campaign baseline signal needs run- or output-level verification next.",
      "acceptance": "Success-rate and signal labels follow the retained totals and their explicit denominators; no concluded attempts or output evidence is distinguished from zero verified impact, and AI Credits per successful run remain a separate cost fact rather than a value score.",
      "description": "A bounded, explainable baseline that distinguishes runtime reliability, unverified output production, and AI Credit efficiency.",
      "from": "campaign-performance-baseline-totals",
      "compute": [
        {
          "as": "success-rate",
          "function": "quotient",
          "args": [
            {
              "field": "successful-runs"
            },
            {
              "field": "concluded-runs"
            }
          ]
        },
        {
          "as": "success-rate-display",
          "function": "format-percent",
          "args": [
            {
              "field": "success-rate"
            }
          ]
        },
        {
          "as": "success-rate-percent",
          "function": "product",
          "args": [
            {
              "field": "success-rate"
            },
            {
              "value": 100
            }
          ]
        },
        {
          "as": "has-concluded-runs",
          "function": "greater-than",
          "args": [
            {
              "field": "concluded-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "has-unsuccessful-runs",
          "function": "greater-than",
          "args": [
            {
              "field": "concluded-runs"
            },
            {
              "field": "successful-runs"
            }
          ]
        },
        {
          "as": "observed-reliability-signal",
          "function": "if",
          "args": [
            {
              "field": "has-unsuccessful-runs"
            },
            {
              "value": "Unsuccessful runs observed"
            },
            {
              "value": "No unsuccessful runs observed"
            }
          ]
        },
        {
          "as": "reliability-signal",
          "function": "if",
          "args": [
            {
              "field": "has-concluded-runs"
            },
            {
              "field": "observed-reliability-signal"
            },
            {
              "value": "No concluded runs observed"
            }
          ]
        },
        {
          "as": "has-output-evidence",
          "function": "greater-than",
          "args": [
            {
              "field": "runs-with-output-evidence"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "has-produced-outputs",
          "function": "greater-than",
          "args": [
            {
              "field": "produced-outputs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "observed-production-signal",
          "function": "if",
          "args": [
            {
              "field": "has-produced-outputs"
            },
            {
              "value": "Outputs produced; acceptance unverified"
            },
            {
              "value": "No outputs observed"
            }
          ]
        },
        {
          "as": "production-signal",
          "function": "if",
          "args": [
            {
              "field": "has-output-evidence"
            },
            {
              "field": "observed-production-signal"
            },
            {
              "value": "Output evidence unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "campaign"
        },
        {
          "field": "concluded-runs"
        },
        {
          "field": "successful-runs"
        },
        {
          "field": "success-rate"
        },
        {
          "field": "success-rate-display"
        },
        {
          "field": "success-rate-percent"
        },
        {
          "field": "reliability-signal"
        },
        {
          "field": "produced-outputs"
        },
        {
          "field": "production-signal"
        },
        {
          "field": "aic-per-successful-run"
        }
      ]
    }
  ],
  "pages": [
