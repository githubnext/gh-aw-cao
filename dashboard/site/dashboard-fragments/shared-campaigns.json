{
  "queries": [
    {
      "name": "run-incomplete-outcomes",
      "subject": "Project retained report-incomplete terminal outcomes as concise run diagnoses.",
      "objective": "Find retained report_incomplete safe outputs that can explain a specific run's incomplete reporting.",
      "acceptance": "Include only matching audit safe_output.created records with run-attempt identity, outcome kind, and recorded diagnosis; absence is not proof that reporting completed.",
      "description": "One retained incomplete-evidence diagnosis per workflow Run when the agent explicitly reported that required evidence or access was unavailable.",
      "from": "audits",
      "filter": {
        "predicates": [
          {
            "field": "event-type",
            "equals": "safe_output.created"
          },
          {
            "field": "safe-output-type",
            "equals": "report_incomplete"
          }
        ]
      },
      "select": [
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "workflow"
        },
        {
          "field": "run"
        },
        {
          "field": "run-attempt"
        },
        {
          "field": "safe-output-type",
          "as": "outcome-kind"
        },
        {
          "field": "event-summary",
          "as": "outcome-diagnosis"
        }
      ]
    },
    {
      "name": "campaign-runs",
      "subject": "Project workflow runs with campaign attribution and retained failure evidence.",
      "objective": "Connect retained run status and failure details to declared campaign/workflow identity for run-level diagnosis.",
      "acceptance": "Expose run and attempt identity, declared attribution, runtime and target repositories, status, failure and incomplete-outcome evidence, timestamps, and drill-down links; do not infer an outcome from runtime success or missing details.",
      "description": "Canonical workflow runs joined to their declared campaign and workflow identity.",
      "from": "runs",
      "joins": [
        {
          "source": "workflows",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            }
          ],
          "fields": [
            {
              "field": "campaign",
              "as": "declared-campaign"
            },
            {
              "field": "campaign-name",
              "as": "declared-campaign-name"
            },
            {
              "field": "workflow-name",
              "as": "declared-workflow-name"
            },
            {
              "field": "workflow-role",
              "as": "declared-workflow-role"
            },
            {
              "field": "workflow-link",
              "as": "declared-workflow-link"
            }
          ]
        },
        {
          "source": "run-incomplete-outcomes",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            },
            {
              "left": "run",
              "right": "run"
            },
            {
              "left": "run-attempt",
              "right": "run-attempt"
            }
          ],
          "fields": [
            {
              "field": "outcome-kind",
              "as": "outcome-kind"
            },
            {
              "field": "outcome-diagnosis",
              "as": "outcome-diagnosis"
            }
          ]
        }
      ],
      "compute": [
        {
          "as": "status",
          "function": "coalesce",
          "args": [
            {
              "field": "run-conclusion"
            },
            {
              "field": "run-status"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "effective-outcome-kind",
          "function": "coalesce",
          "args": [
            {
              "field": "outcome-kind"
            },
            {
              "field": "terminal-outcome"
            },
            {
              "value": ""
            }
          ]
        },
        {
          "as": "is-incomplete-outcome",
          "function": "equals-any",
          "args": [
            {
              "field": "effective-outcome-kind"
            },
            {
              "value": "report_incomplete"
            }
          ]
        },
        {
          "as": "diagnosis-kind",
          "function": "if",
          "args": [
            {
              "field": "is-incomplete-outcome"
            },
            {
              "value": "incomplete_evidence"
            },
            {
              "value": ""
            }
          ]
        },
        {
          "as": "error-signature",
          "function": "coalesce",
          "args": [
            {
              "field": "diagnosis-kind"
            },
            {
              "field": "failure-kind"
            },
            {
              "field": "classification"
            },
            {
              "field": "status"
            }
          ]
        },
        {
          "as": "_error-signature-default-label",
          "function": "title-case",
          "args": [
            {
              "field": "error-signature"
            }
          ]
        },
        {
          "as": "_is-driver-exit",
          "function": "equals-any",
          "args": [
            {
              "field": "error-signature"
            },
            {
              "value": "driver_exit"
            },
            {
              "value": "driver-exit"
            }
          ]
        },
        {
          "as": "error-signature-label",
          "function": "if",
          "args": [
            {
              "field": "_is-driver-exit"
            },
            {
              "value": "Agent process exited unexpectedly"
            },
            {
              "field": "_error-signature-default-label"
            }
          ]
        },
        {
          "as": "status-detail",
          "function": "coalesce",
          "args": [
            {
              "field": "outcome-diagnosis"
            },
            {
              "field": "terminal-outcome-detail"
            },
            {
              "field": "failure-detail"
            },
            {
              "field": "failure-message"
            },
            {
              "field": "failure-step"
            },
            {
              "field": "admission-reason"
            },
            {
              "value": ""
            }
          ]
        },
        {
          "as": "runtime-repository",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "is-worker",
          "function": "equals-any",
          "args": [
            {
              "field": "declared-workflow-role"
            },
            {
              "value": "worker"
            }
          ]
        },
        {
          "as": "is-orchestrator",
          "function": "equals-any",
          "args": [
            {
              "field": "declared-workflow-role"
            },
            {
              "value": "orchestrator"
            }
          ]
        },
        {
          "as": "root-dispatch-type",
          "function": "if",
          "args": [
            {
              "field": "is-orchestrator"
            },
            {
              "value": "Campaign orchestrator"
            },
            {
              "value": "Standalone workflow"
            }
          ]
        },
        {
          "as": "dispatch-type",
          "function": "if",
          "args": [
            {
              "field": "is-worker"
            },
            {
              "value": "Campaign worker"
            },
            {
              "field": "root-dispatch-type"
            }
          ]
        },
        {
          "as": "campaign-display-name",
          "function": "coalesce",
          "args": [
            {
              "field": "declared-campaign-name"
            },
            {
              "field": "declared-campaign"
            }
          ]
        },
        {
          "as": "workflow-display-name",
          "function": "coalesce",
          "args": [
            {
              "field": "declared-workflow-name"
            },
            {
              "field": "workflow"
            }
          ]
        },
        {
          "as": "encoded-campaign",
          "function": "url-encode",
          "args": [
            {
              "field": "declared-campaign"
            }
          ]
        },
        {
          "as": "campaign-dashboard-href",
          "function": "concat",
          "args": [
            {
              "value": "#page-campaign-insights?campaign="
            },
            {
              "field": "encoded-campaign"
            }
          ]
        },
        {
          "as": "campaign-dashboard-label",
          "function": "concat",
          "args": [
            {
              "value": "View "
            },
            {
              "field": "campaign-display-name"
            },
            {
              "value": " campaign dashboard"
            }
          ]
        },
        {
          "as": "campaign-dashboard-link",
          "function": "dashboard-link",
          "args": [
            {
              "field": "repository-link"
            },
            {
              "field": "campaign-dashboard-href"
            },
            {
              "field": "campaign-dashboard-label"
            },
            {
              "field": "declared-campaign"
            }
          ]
        },
        {
          "as": "encoded-repository",
          "function": "url-encode",
          "args": [
            {
              "field": "runtime-repository"
            }
          ]
        },
        {
          "as": "repository-dashboard-href",
          "function": "concat",
          "args": [
            {
              "value": "#page-repository-detail?repository="
            },
            {
              "field": "encoded-repository"
            }
          ]
        },
        {
          "as": "repository-dashboard-label",
          "function": "concat",
          "args": [
            {
              "value": "View "
            },
            {
              "field": "runtime-repository"
            },
            {
              "value": " repository dashboard"
            }
          ]
        },
        {
          "as": "repository-dashboard-link",
          "function": "dashboard-link",
          "args": [
            {
              "field": "repository-link"
            },
            {
              "field": "repository-dashboard-href"
            },
            {
              "field": "repository-dashboard-label"
            },
            {
              "field": "runtime-repository"
            }
          ]
        },
        {
          "as": "workflow-identity",
          "function": "concat",
          "args": [
            {
              "field": "runtime-repository"
            },
            {
              "value": ":"
            },
            {
              "field": "workflow"
            }
          ]
        },
        {
          "as": "encoded-workflow",
          "function": "url-encode",
          "args": [
            {
              "field": "workflow-identity"
            }
          ]
        },
        {
          "as": "workflow-dashboard-href",
          "function": "concat",
          "args": [
            {
              "value": "#page-workflow-runtime?workflow="
            },
            {
              "field": "encoded-workflow"
            }
          ]
        },
        {
          "as": "workflow-dashboard-label",
          "function": "concat",
          "args": [
            {
              "value": "View "
            },
            {
              "field": "workflow-display-name"
            },
            {
              "value": " workflow dashboard"
            }
          ]
        },
        {
          "as": "workflow-dashboard-link",
          "function": "dashboard-link",
          "args": [
            {
              "field": "workflow-link"
            },
            {
              "field": "workflow-dashboard-href"
            },
            {
              "field": "workflow-dashboard-label"
            },
            {
              "field": "workflow-identity"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "started-at"
        },
        {
          "field": "dispatch-type"
        },
        {
          "field": "declared-campaign",
          "as": "campaign"
        },
        {
          "field": "declared-campaign-name",
          "as": "campaign-name"
        },
        {
          "field": "declared-workflow-name",
          "as": "workflow-name"
        },
        {
          "field": "run"
        },
        {
          "field": "run-attempt"
        },
        {
          "field": "run-title"
        },
        {
          "field": "event"
        },
        {
          "field": "runtime-repository"
        },
        {
          "field": "target-repository"
        },
        {
          "field": "rollout-mode"
        },
        {
          "field": "status"
        },
        {
          "field": "run-status"
        },
        {
          "field": "error-signature"
        },
        {
          "field": "error-signature-label"
        },
        {
          "field": "status-detail"
        },
        {
          "field": "outcome-kind"
        },
        {
          "field": "outcome-diagnosis"
        },
        {
          "field": "declared-workflow-role",
          "as": "workflow-role"
        },
        {
          "field": "failure-job"
        },
        {
          "field": "failure-message"
        },
        {
          "field": "failure-step"
        },
        {
          "field": "failure-log"
        },
        {
          "field": "engine"
        },
        {
          "field": "engine-version"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "requested-model"
        },
        {
          "field": "resolved-model"
        },
        {
          "field": "aic-total"
        },
        {
          "field": "safe-items-count"
        },
        {
          "field": "resource-reset-at",
          "as": "status-detail-at"
        },
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "workflow"
        },
        {
          "field": "declared-workflow-link",
          "as": "workflow-source-link"
        },
        {
          "field": "run-link"
        },
        {
          "field": "campaign-dashboard-link",
          "as": "campaign-link"
        },
        {
          "field": "repository-dashboard-link",
          "as": "repository-link"
        },
        {
          "field": "workflow-dashboard-link",
          "as": "workflow-link"
        }
      ],
      "order-by": [
        {
          "field": "started-at",
          "direction": "desc"
        }
      ]
    },
    {
      "name": "campaign-runtime-health-runs",
      "subject": "Project only the run and workflow fields required to classify current campaign runtime health.",
      "objective": "Provide the retained run identity, timing, role, dispatch type, repository, and status needed to assess campaign runtime-health groups.",
      "acceptance": "Project the selected fields from overview-runs without converting missing statuses or unattributed workflows into failures; unavailable run history leaves health assessment incomplete.",
      "description": "A bounded runtime-health input that excludes audit outcomes and presentation-only campaign run fields.",
      "from": "overview-runs",
      "compute": [
        {
          "as": "status",
          "function": "coalesce",
          "args": [
            {
              "field": "run-conclusion"
            },
            {
              "field": "run-status"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "runtime-repository",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "is-worker",
          "function": "equals-any",
          "args": [
            {
              "field": "workflow-role"
            },
            {
              "value": "worker"
            }
          ]
        },
        {
          "as": "is-orchestrator",
          "function": "equals-any",
          "args": [
            {
              "field": "workflow-role"
            },
            {
              "value": "orchestrator"
            }
          ]
        },
        {
          "as": "root-dispatch-type",
          "function": "if",
          "args": [
            {
              "field": "is-orchestrator"
            },
            {
              "value": "Campaign orchestrator"
            },
            {
              "value": "Standalone workflow"
            }
          ]
        },
        {
          "as": "dispatch-type",
          "function": "if",
          "args": [
            {
              "field": "is-worker"
            },
            {
              "value": "Campaign worker"
            },
            {
              "field": "root-dispatch-type"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "started-at"
        },
        {
          "field": "campaign"
        },
        {
          "field": "campaign-name"
        },
        {
          "field": "workflow"
        },
        {
          "field": "workflow-name"
        },
        {
          "field": "workflow-role"
        },
        {
          "field": "dispatch-type"
        },
        {
          "field": "runtime-repository"
        },
        {
          "field": "run"
        },
        {
          "field": "run-status"
        },
        {
          "field": "status"
        }
      ]
    },
    {
      "name": "campaign-runtime-health-groups",
      "subject": "Compute each campaign workflow and runtime repository's latest consecutive failure streak in the selected horizon.",
      "objective": "Locate campaign workflow/runtime-repository groups whose most recent retained completed runs have consecutive runtime failures.",
      "acceptance": "Group completed runs by campaign, workflow, role, dispatch type, and runtime repository; failure-count is the latest retained failure streak, not a rate or a claim about runs outside the available horizon.",
      "description": "Current retained failure streaks grouped by campaign workflow and runtime repository, considering only concluded Runs so an in-flight retry cannot mask an active failure streak.",
      "from": "campaign-runtime-health-runs",
      "filter": {
        "predicates": [
          {
            "field": "run-status",
            "equals": "completed"
          }
        ]
      },
      "compute": [
        {
          "as": "is-runtime-failure",
          "function": "equals-any",
          "args": [
            {
              "field": "status"
            },
            {
              "value": "failure"
            },
            {
              "value": "startup-failure"
            },
            {
              "value": "stale"
            },
            {
              "value": "timed-out"
            }
          ]
        },
        {
          "as": "runtime-failure-streak-point",
          "function": "failure-streak-point",
          "args": [
            {
              "field": "started-at"
            },
            {
              "field": "run"
            },
            {
              "field": "is-runtime-failure"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "campaign",
          "campaign-name",
          "workflow",
          "workflow-name",
          "workflow-role",
          "dispatch-type",
          "runtime-repository"
        ],
        "values": [
          {
            "field": "runtime-failure-streak-point",
            "as": "failure-count",
            "reducer": "latest-failure-streak"
          }
        ]
      }
    },
    {
      "name": "campaign-runtime-problem-candidates",
      "subject": "Mark campaign workflow and runtime repository partitions whose latest retained run streak is failing.",
      "objective": "Flag runtime-health groups with a nonzero latest retained failure streak for focused investigation.",
      "acceptance": "Preserve the group identity and failure-count; has-current-failure reflects only failure-count greater than zero, while absent or incomplete run evidence cannot establish health.",
      "description": "Campaign runtime partitions annotated with whether their current retained streak contains failures.",
      "from": "campaign-runtime-health-groups",
      "compute": [
        {
          "as": "has-current-failure",
          "function": "greater-than",
          "args": [
            {
              "field": "failure-count"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "problem-kind",
          "function": "coalesce",
          "args": [
            {
              "value": "failure"
            },
            {
              "value": "failure"
            }
          ]
        }
      ]
    },
    {
      "name": "campaign-current-runtime-failures",
      "subject": "Show only campaign workflow and runtime repository partitions whose latest retained run streak is failing.",
      "objective": "Select failing retained runtime-health partitions for review of their underlying runs.",
      "acceptance": "Return only groups flagged has-current-failure with their identity and streak count in declared order; no rows mean no matching observed streak, not verified healthy operation.",
      "description": "Campaign runtime partitions with one or more consecutive failures after their latest retained success.",
      "from": "campaign-runtime-problem-candidates",
      "filter": {
        "predicates": [
          {
            "field": "has-current-failure",
            "equals": true
          }
        ]
      },
      "order-by": [
        {
          "field": "failure-count",
          "direction": "desc"
        },
        {
          "field": "workflow-name",
          "direction": "asc"
        },
        {
          "field": "runtime-repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "workflow-run-observation-counts",
      "subject": "Count retained Runs for each workflow identity in the selected horizon.",
      "objective": "Measure retained run presence by workflow identity to compare with active orchestrator declarations.",
      "acceptance": "Count overview-runs by organization, repository, and workflow; a missing group indicates no retained matching run in the available horizon, not proof of no executions.",
      "description": "One row per organization, repository, and workflow with retained Run counts, safe to join without row multiplication.",
      "from": "overview-runs",
      "aggregate": {
        "by": [
          "organization",
          "repository",
          "workflow"
        ],
        "values": [
          {
            "field": "run",
            "as": "observed-run-count",
            "reducer": "count"
          }
        ]
      }
    },
    {
      "name": "campaign-active-orchestrator-run-presence",
      "subject": "Count retained Runs for each active campaign orchestrator in the selected horizon.",
      "objective": "Compare active orchestrator declarations with retained run observations to identify missing visibility.",
      "acceptance": "Keep only workflows declared active with orchestrator role and expose their identity, runtime repository, and observed-run-count; a zero joined count means no retained match, not necessarily a stopped schedule.",
      "description": "Active campaign orchestrators annotated with retained Run presence.",
      "from": "workflows",
      "joins": [
        {
          "source": "workflow-run-observation-counts",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            }
          ],
          "fields": [
            {
              "field": "observed-run-count",
              "as": "joined-observed-run-count"
            }
          ]
        }
      ],
      "filter": {
        "predicates": [
          {
            "field": "workflow-role",
            "equals": "orchestrator"
          },
          {
            "field": "workflow-active",
            "equals": "true"
          }
        ]
      },
      "compute": [
        {
          "as": "runtime-repository",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "observed-run-count",
          "function": "coalesce",
          "args": [
            {
              "field": "joined-observed-run-count"
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "select": [
        {
          "field": "campaign"
        },
        {
          "field": "campaign-name"
        },
        {
          "field": "workflow"
        },
        {
          "field": "workflow-name"
        },
        {
          "field": "workflow-role"
        },
        {
          "field": "runtime-repository"
        },
        {
          "field": "observed-run-count"
        }
      ]
    },
    {
      "name": "campaign-unobserved-orchestrator-candidates",
      "subject": "Mark active campaign orchestrators with no retained Runs in the selected horizon.",
      "objective": "Mark active orchestrators lacking retained run evidence for bounded telemetry or schedule review.",
      "acceptance": "Preserve active orchestrator identity and observed-run-count; is-unobserved marks zero retained matches and must not be interpreted as a runtime failure or evidence that dispatch was expected.",
      "description": "Active orchestrators annotated with whether runtime evidence is absent.",
      "from": "campaign-active-orchestrator-run-presence",
      "compute": [
        {
          "as": "is-unobserved",
