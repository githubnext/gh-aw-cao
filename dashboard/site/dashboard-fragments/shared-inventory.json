{
  "queries": [
    {
      "name": "issue-safe-outputs",
      "subject": "List retained GitHub issue safe outputs.",
      "objective": "Inspect retained issue safe outputs and their observed closure state before deciding which items need follow-up.",
      "acceptance": "Include only safe_output.created issue records, not pull requests; preserve issue and run links, timestamps, state, and status detail. Unknown or unobserved closure state must not be presented as closed.",
      "description": "Issue-only projection of retained safe-output items.",
      "from": "issues",
      "filter": {
        "predicates": [
          {
            "field": "event-type",
            "equals": "safe_output.created"
          },
          {
            "field": "is-pull-request",
            "equals": false
          }
        ]
      },
      "joins": [
        {
          "source": "runs",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            },
            {
              "left": "run",
              "right": "run"
            },
            {
              "left": "run-attempt",
              "right": "run-attempt"
            }
          ],
          "fields": [
            {
              "field": "run-link",
              "as": "linked-run"
            }
          ]
        }
      ],
      "compute": [
        {
          "as": "_issue-state-open",
          "function": "equals-any",
          "args": [
            {
              "field": "issue-state"
            },
            {
              "value": "OPEN"
            }
          ]
        },
        {
          "as": "_issue-state-closed",
          "function": "equals-any",
          "args": [
            {
              "field": "issue-state"
            },
            {
              "value": "CLOSED"
            }
          ]
        },
        {
          "as": "_issue-open-status",
          "function": "if",
          "args": [
            {
              "field": "_issue-state-open"
            },
            {
              "value": "Open"
            },
            {
              "value": "Unknown"
            }
          ]
        },
        {
          "as": "issue-status",
          "function": "if",
          "args": [
            {
              "field": "_issue-state-closed"
            },
            {
              "value": "Closed"
            },
            {
              "field": "_issue-open-status"
            }
          ]
        },
        {
          "as": "_issue-closing-reason",
          "function": "coalesce",
          "args": [
            {
              "field": "issue-state-reason"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "_issue-closing-reason-normalized",
          "function": "lower",
          "args": [
            {
              "field": "_issue-closing-reason"
            }
          ]
        },
        {
          "as": "issue-closing-status",
          "function": "title-case",
          "args": [
            {
              "field": "_issue-closing-reason-normalized"
            }
          ]
        },
        {
          "as": "_issue-closed-status-detail",
          "function": "concat",
          "args": [
            {
              "value": "Closed: "
            },
            {
              "field": "issue-closing-status"
            }
          ]
        },
        {
          "as": "issue-status-detail",
          "function": "if",
          "args": [
            {
              "field": "_issue-state-closed"
            },
            {
              "field": "_issue-closed-status-detail"
            },
            {
              "field": "issue-status"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "event-timestamp",
          "as": "observed-at"
        },
        {
          "field": "github-entity-type"
        },
        {
          "field": "is-pull-request"
        },
        {
          "field": "safe-output-type"
        },
        {
          "field": "issue-state"
        },
        {
          "field": "issue-closed"
        },
        {
          "field": "issue-state-reason"
        },
        {
          "field": "issue-status"
        },
        {
          "field": "issue-closing-status"
        },
        {
          "field": "issue-status-detail"
        },
        {
          "field": "issue-closed-at"
        },
        {
          "field": "issue-status-observed-at"
        },
        {
          "field": "event-summary"
        },
        {
          "field": "correlation-id",
          "as": "entity-url"
        },
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "workflow"
        },
        {
          "field": "run"
        },
        {
          "field": "linked-run",
          "as": "run-link"
        }
      ],
      "order-by": [
        {
          "field": "observed-at",
          "direction": "desc"
        },
        {
          "field": "entity-url",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "issue-safe-output-label-options",
      "subject": "List observed safe-output badges for the issue list Labels filter.",
      "objective": "Choose retained safe-output types without scanning or filtering presented cards.",
      "acceptance": "Return distinct observed badge values in ascending order; missing evidence is not an empty label inventory.",
      "from": "issue-safe-outputs",
      "aggregate": {
        "by": ["safe-output-type"],
        "values": [{ "field": "entity-url", "as": "items", "reducer": "count" }]
      },
      "order-by": [{ "field": "safe-output-type", "direction": "asc" }]
    },
    {
      "name": "issue-status-label-options",
      "subject": "List observed status badges for the issue list Labels filter.",
      "objective": "Choose retained issue states and closing reasons without inferring resolution.",
      "acceptance": "Return distinct observed status details in ascending order; Unknown remains distinct from Open and Closed.",
      "from": "issue-safe-outputs",
      "aggregate": {
        "by": ["issue-status-detail"],
        "values": [{ "field": "entity-url", "as": "items", "reducer": "count" }]
      },
      "order-by": [{ "field": "issue-status-detail", "direction": "asc" }]
    },
    {
      "name": "issue-repository-totals",
      "subject": "Rank the ten repositories with the most retained GitHub issue safe outputs.",
      "objective": "Locate repositories with the largest observed issue-safe-output volume for a bounded review of linked records.",
      "acceptance": "Return at most ten repository coordinates ordered by retained issue-record count; ties or missing issue evidence must not imply a complete fleet ranking or unique issue count.",
      "description": "Top repositories by retained issue safe-output count.",
      "from": "issue-safe-outputs",
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "entity-url",
            "as": "issues",
            "reducer": "count"
          }
        ]
      },
      "order-by": [
        {
          "field": "issues",
          "direction": "desc"
        },
        {
          "field": "repository-coordinate",
          "direction": "asc"
        }
      ],
      "limit": 10
    },
    {
      "name": "campaign-workflow-import-evidence",
      "subject": "Summarize retained import evidence at workflow grain for campaign inventory quality.",
      "objective": "Preserve import-evidence provenance without materializing per-run ingestion indicators.",
      "acceptance": "Compose all four retained event sources with the same availability, freshness, and completeness as event-runs; counts describe retained records, not executions or outcomes.",
      "from": "audit-event-runs",
      "union": ["domain-event-runs", "tool-event-runs", "issue-event-runs"],
      "aggregate": {
        "by": ["organization", "repository", "workflow"],
        "values": [
          { "field": "events", "as": "events", "reducer": "sum" }
        ]
      }
    },
    {
      "name": "campaign-workflow-execution-base",
      "subject": "Summarize retained run attempts and AI Credits before campaign workflow enrichment.",
      "objective": "Read run identity and recorded AI Credits together instead of enriching every run with import status.",
      "acceptance": "Count distinct run-attempt identities and sum aic-total per organization, repository, and workflow; missing retained evidence is not proof of no execution or cost.",
      "from": "runs",
      "compute": [
        {
          "as": "run-attempt-identity",
          "function": "concat",
          "args": [{ "field": "run" }, { "value": ":" }, { "field": "run-attempt" }]
        }
      ],
      "aggregate": {
        "by": ["organization", "repository", "workflow"],
        "values": [
          { "field": "run-attempt-identity", "as": "runs", "reducer": "distinct-count" },
          { "field": "aic-total", "as": "aic", "reducer": "sum" }
        ]
      }
    },
    {
      "name": "campaign-workflow-execution-totals",
      "subject": "Attach retained import-evidence quality to compact workflow execution totals.",
      "objective": "Preserve the public inventory's run and import availability composition after aggregating run evidence.",
      "acceptance": "Keep runs and AI Credits unchanged; unavailable run evidence fails closed and optional import evidence degrades quality exactly as in run-import-status.",
      "description": "The import-evidence join preserves inventory provenance without per-run ingestion indicators. It follows run aggregation so unavailable run evidence retains the original failure-quality semantics.",
      "from": "campaign-workflow-execution-base",
      "joins": [
        {
          "source": "campaign-workflow-import-evidence",
          "type": "left",
          "on": [
            { "left": "organization", "right": "organization" },
            { "left": "repository", "right": "repository" },
            { "left": "workflow", "right": "workflow" }
          ],
          "fields": [{ "field": "events", "as": "imported-events" }]
        }
      ],
      "select": [
        { "field": "organization" },
        { "field": "repository" },
        { "field": "workflow" },
        { "field": "runs" },
        { "field": "aic" }
      ]
    },
    {
      "name": "campaign-workflow-inventory",
      "subject": "Project declared campaign workflows with lean execution and configuration evidence.",
      "objective": "Provide campaign totals and lists without unused ingestion, failure, or dashboard-link computations.",
      "acceptance": "Keep all declared orchestrators and workers, including inactive and unobserved entries; preserve inventory ordering, configuration defaults, execution totals, and import-evidence quality.",
      "description": "Lean campaign inventory with execution totals that retain the public workflow inventory's evidence-quality dependencies.",
      "from": "workflows",
      "joins": [
        {
          "source": "campaign-workflow-execution-totals",
          "type": "left",
          "on": [
            { "left": "organization", "right": "organization" },
            { "left": "repository", "right": "repository" },
            { "left": "workflow", "right": "workflow" }
          ],
          "fields": [
            { "field": "runs", "as": "observed-runs" },
            { "field": "aic", "as": "observed-aic" }
          ]
        }
      ],
      "filter": {
        "predicates": [
          { "field": "workflow-role", "in": ["orchestrator", "worker"] }
        ]
      },
      "compute": [
        {
          "as": "repository-slug",
          "function": "concat",
          "args": [{ "field": "organization" }, { "value": "/" }, { "field": "repository" }]
        },
        {
          "as": "declared-mode",
          "function": "coalesce",
          "args": [{ "field": "rollout-mode" }, { "value": "unknown" }]
        },
        {
          "as": "declared-registration",
          "function": "coalesce",
          "args": [{ "field": "workflow-active" }, { "value": "unknown" }]
        },
        {
          "as": "total-runs",
          "function": "coalesce",
          "args": [{ "field": "observed-runs" }, { "value": 0 }]
        },
        {
          "as": "total-aic",
          "function": "coalesce",
          "args": [{ "field": "observed-aic" }, { "value": 0 }]
        }
      ],
      "select": [
        { "field": "campaign" },
        { "field": "campaign-name" },
        { "field": "organization" },
        { "field": "repository-slug", "as": "repository" },
        { "field": "workflow" },
        { "field": "workflow-name" },
        { "field": "workflow-role" },
        { "field": "declared-mode", "as": "rollout-mode" },
        { "field": "declared-registration", "as": "workflow-active" },
        { "field": "total-runs", "as": "runs" },
        { "field": "total-aic", "as": "aic" },
        { "field": "repository-link" },
        { "field": "workflow-link" }
      ],
      "order-by": [
        { "field": "repository", "direction": "asc" },
        { "field": "workflow", "direction": "asc" }
      ]
    },
    {
      "name": "workflow-inventory",
      "subject": "List declared workflows with their campaign, repository, configuration, and observed execution totals.",
      "objective": "Compare declared workflow configuration with retained run, import-coverage, and AI Credit evidence to select a workflow for closer inspection.",
      "acceptance": "Keep one row per declared workflow with identity, role, mode, registration, links, observed totals, and ingestion indicator; zero joined totals and missing evidence must not be treated as proof of no execution or complete ingestion.",
      "description": "Central campaign and repository-owned workflow inventory with observed execution totals.",
      "from": "workflows",
      "joins": [
        {
          "source": "workflow-run-totals",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            }
          ],
          "fields": [
            {
              "field": "runs",
              "as": "observed-runs"
            },
            {
              "field": "successful-runs",
              "as": "observed-successful-runs"
            },
            {
              "field": "failed-runs",
              "as": "observed-failed-runs"
            },
            {
              "field": "imported-runs",
              "as": "observed-imported-runs"
            }
          ]
        },
        {
          "source": "workflow-aic-totals",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            }
          ],
          "fields": [
            {
              "field": "aic",
              "as": "observed-aic"
            }
          ]
        }
      ],
      "compute": [
        {
          "as": "campaign-title",
          "function": "title-case",
          "args": [
            {
              "field": "campaign"
            }
          ]
        },
        {
          "as": "campaign-display-name",
          "function": "coalesce",
          "args": [
            {
              "field": "campaign-name"
            },
            {
              "field": "campaign-title"
            },
            {
              "value": "Repository-owned"
            }
          ]
        },
        {
          "as": "repository-slug",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "workflow-display-name",
          "function": "coalesce",
          "args": [
            {
              "field": "workflow-name"
            },
            {
              "field": "workflow"
            }
          ]
        },
        {
          "as": "declared-role",
          "function": "coalesce",
          "args": [
            {
              "field": "workflow-role"
            },
            {
              "value": "standalone"
            }
          ]
        },
        {
          "as": "declared-mode",
          "function": "coalesce",
          "args": [
            {
              "field": "rollout-mode"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "declared-registration",
          "function": "coalesce",
          "args": [
            {
              "field": "workflow-active"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "total-runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "total-successful-runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-successful-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "has-observed-runs",
          "function": "greater-than",
          "args": [
            {
              "field": "total-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "total-failed-runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-failed-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "total-aic",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-aic"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "aic-per-run",
          "function": "quotient",
          "args": [
            {
              "field": "total-aic"
            },
            {
              "field": "total-runs"
            }
          ]
        },
        {
          "as": "total-imported-runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-imported-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "ingestion-rate",
          "function": "quotient",
          "args": [
            {
              "field": "total-imported-runs"
            },
            {
              "field": "total-runs"
            }
          ]
        },
        {
          "as": "ingestion",
          "function": "format-percent",
          "args": [
            {
              "field": "ingestion-rate"
            }
          ]
        },
        {
          "as": "encoded-campaign",
          "function": "url-encode",
          "args": [
            {
              "field": "campaign"
            }
          ]
        },
        {
          "as": "campaign-dashboard-href",
          "function": "concat",
          "args": [
            {
              "value": "#page-campaign-insights?campaign="
            },
            {
              "field": "encoded-campaign"
            }
          ]
        },
        {
          "as": "campaign-dashboard-label",
          "function": "concat",
          "args": [
            {
              "value": "View "
            },
            {
              "field": "campaign-display-name"
            },
            {
              "value": " campaign dashboard"
            }
          ]
        },
        {
          "as": "campaign-dashboard-link",
          "function": "dashboard-link",
          "args": [
            {
              "field": "repository-link"
            },
            {
              "field": "campaign-dashboard-href"
            },
            {
              "field": "campaign-dashboard-label"
            },
            {
              "field": "campaign"
            }
          ]
        },
        {
          "as": "encoded-repository",
          "function": "url-encode",
          "args": [
            {
              "field": "repository-slug"
            }
          ]
        },
        {
          "as": "repository-dashboard-href",
          "function": "concat",
          "args": [
            {
              "value": "#page-repository-detail?repository="
            },
            {
              "field": "encoded-repository"
            }
          ]
        },
        {
          "as": "repository-dashboard-label",
          "function": "concat",
          "args": [
            {
              "value": "View "
            },
            {
              "field": "repository-slug"
            },
            {
              "value": " repository dashboard"
            }
          ]
        },
        {
          "as": "repository-dashboard-link",
          "function": "dashboard-link",
          "args": [
            {
              "field": "repository-link"
            },
            {
              "field": "repository-dashboard-href"
            },
            {
              "field": "repository-dashboard-label"
            },
            {
              "field": "repository-slug"
            }
          ]
        },
        {
          "as": "workflow-identity",
          "function": "concat",
          "args": [
            {
              "field": "repository-slug"
            },
            {
              "value": ":"
            },
            {
              "field": "workflow"
            }
          ]
        },
        {
          "as": "encoded-workflow",
          "function": "url-encode",
          "args": [
            {
              "field": "workflow-identity"
            }
          ]
        },
        {
          "as": "workflow-dashboard-href",
          "function": "concat",
          "args": [
            {
              "value": "#page-workflow-runtime?workflow="
            },
            {
              "field": "encoded-workflow"
            }
          ]
        },
        {
          "as": "workflow-dashboard-label",
          "function": "concat",
          "args": [
            {
              "value": "View "
            },
            {
              "field": "workflow-display-name"
            },
            {
              "value": " workflow dashboard"
            }
          ]
        },
        {
          "as": "workflow-dashboard-link",
          "function": "dashboard-link",
          "args": [
            {
              "field": "workflow-link"
            },
            {
              "field": "workflow-dashboard-href"
            },
            {
              "field": "workflow-dashboard-label"
            },
            {
              "field": "workflow-identity"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "campaign"
        },
        {
          "field": "campaign-display-name",
          "as": "campaign-name"
        },
        {
          "field": "organization"
        },
        {
          "field": "repository-slug",
          "as": "repository"
        },
        {
          "field": "workflow"
        },
        {
          "field": "workflow-display-name",
          "as": "workflow-name"
        },
        {
          "field": "workflow-identity",
          "as": "workflow-label"
        },
        {
          "field": "declared-role",
          "as": "workflow-role"
        },
        {
          "field": "declared-mode",
          "as": "rollout-mode"
        },
        {
          "field": "declared-registration",
          "as": "workflow-active"
        },
        {
          "field": "total-aic",
          "as": "aic"
        },
        {
          "field": "total-runs",
          "as": "runs"
        },
        {
          "field": "total-successful-runs",
          "as": "successful-runs"
        },
        {
          "field": "total-failed-runs",
          "as": "failed-runs"
        },
        {
          "field": "aic-per-run"
        },
        {
          "field": "has-observed-runs"
        },
        {
          "field": "ingestion"
        },
        {
          "field": "campaign-dashboard-link",
          "as": "campaign-link"
        },
        {
          "field": "repository-dashboard-link",
          "as": "repository-link"
        },
        {
          "field": "workflow-dashboard-link",
          "as": "workflow-link"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        },
        {
          "field": "workflow",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "repository-aic-totals",
      "subject": "Summarize observed AI Credit usage by repository.",
      "objective": "Provide repository-level retained AI Credit totals for comparing observed usage with run activity.",
      "acceptance": "Sum recorded aic-total by organization and repository; an absent or partial run history does not support a claim of zero actual consumption.",
      "description": "Observed AI Credit totals for each repository.",
      "from": "runs",
      "aggregate": {
        "by": [
          "organization",
          "repository"
        ],
        "values": [
          {
            "field": "aic-total",
            "as": "aic",
            "reducer": "sum"
          }
        ]
      }
    },
    {
      "name": "maintenance-repository-versions",
      "subject": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "objective": "Identify repositories with declared Markdown workflows whose retained compiler-version evidence warrants upgrade review.",
      "acceptance": "Group Markdown workflow declarations by repository coordinate and return distinct recorded installed/current version lists plus upgrade-required and unknown flags; inspect absent or mixed version evidence rather than inferring a repository-wide installed version.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "subject": "List each repository with recorded compiler versions and computed upgrade state.",
      "objective": "Expose recorded compiler versions and computed upgrade state per repository so an operator can inspect update signals and gaps.",
      "acceptance": "Return repository, recorded version lists, upgrade-required flag, and computed upgrade-state; mixed or absent version evidence requires inspection before any decision, and an upgrade label does not authorize a rollout or policy change.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "subject": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "objective": "Determine whether retained campaign metadata contains an update-available signal for the Updates indicator.",
      "acceptance": "Return zero or one campaign-update-state row only when it equals update-available; an empty result means no matching retained signal, not that every campaign is current.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "subject": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "objective": "Determine whether repository compiler metadata contains an upgrade-required signal for the Updates indicator.",
      "acceptance": "Return zero or one upgrade-required row only when the retained value is 1; no row does not establish that all repositories are current when version data is missing.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    }
  ],
