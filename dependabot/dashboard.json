{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "dependabot-dashboard",
    "title": "Dependabot",
    "description": "See whether Dependabot planning works, what it produced, and whether people or coding agents consume its issues.",
    "repository": "githubnext/gh-aw-cao",
    "queries": [
      {
        "name": "dependabot-run-observations",
        "intent": "Show Dependabot orchestrator and update-planner runs so operators can verify activation and investigate execution failures.",
        "from": "runs",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "in": [
                ".github/workflows/dependabot.md",
                ".github/workflows/dependabot-update-planner.md"
              ]
            }
          ]
        },
        "order-by": [
          {
            "field": "started-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "dependabot-update-planner-outcomes",
        "intent": "Show the durable plan issue produced for each repository so operators can inspect the concrete output.",
        "from": "outcomes",
        "filter": {
          "predicates": [
            {
              "field": "campaign",
              "equals": "dependabot"
            }
          ]
        },
        "order-by": [
          {
            "field": "published-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "dependabot-plan-consumption",
        "intent": "Show whether each durable Dependabot plan issue was assigned, discussed, progressed, linked to a pull request, or closed without treating missing or immature evidence as zero.",
        "from": "operational-values",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "equals": ".github/workflows/dependabot-update-planner.md"
            }
          ]
        },
        "order-by": [
          {
            "field": "observed-at",
            "direction": "desc"
          }
        ]
      }
    ],
    "pages": [
      {
        "id": "dependabot-dashboard",
        "kind": "custom",
        "title": "Dependabot",
        "description": "See whether Dependabot planning works, what it produced, and whether people or coding agents consume its issues.",
        "icon": "dependabot",
        "views": [
          {
            "id": "dependabot-runs",
            "title": "Does Dependabot work?",
            "description": "Orchestrator and update-planner conclusions over the last 30 days.",
            "disclosure": "essential",
            "data": {
              "source": "dependabot-run-observations",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/dependabot.md",
                  ".github/workflows/dependabot-update-planner.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "pie",
            "layout": "half",
            "encoding": {
              "x": {
                "field": "run-conclusion",
                "type": "nominal"
              },
              "y": {
                "field": "run",
                "type": "quantitative",
                "aggregate": "count"
              }
            }
          },
          {
            "id": "dependabot-outcomes",
            "title": "What did Dependabot produce?",
            "description": "Each repository keeps one human-reviewed issue with a complete checklist for an assigned coding agent.",
            "disclosure": "essential",
            "data": {
              "source": "dependabot-update-planner-outcomes",
              "filters": {
                "campaign": [
                  "dependabot"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No Dependabot plan issues were retained.",
            "encoding": {
              "href": {
                "field": "external-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "outcome-title",
                  "type": "nominal",
                  "title": "Update plan",
                  "display": "outcome-link"
                },
                {
                  "field": "outcome-state",
                  "type": "nominal",
                  "title": "Disposition",
                  "display": "status"
                },
                {
                  "field": "published-at",
                  "type": "temporal",
                  "format": "human-friendly-timestamp",
                  "title": "Published"
                }
              ],
              "actions": [
                {
                  "intent": "Review this Dependabot update plan, verify its checklist and evidence, and recommend the safest next action.",
                  "presentation": "copy-prompt",
                  "icon": "search",
                  "label": "Review",
                  "context": [
                    "repository",
                    "outcome-title",
                    "outcome-summary",
                    "outcome-state",
                    "published-at",
                    "external-link"
                  ]
                }
              ]
            }
          },
          {
            "id": "dependabot-attainment",
            "disclosure-label": "Are plan issues being consumed?",
            "description": "Consumption means assignment, outside participation, checklist progress, a linked pull request, or closure. Unconsumed issues mature after 14 days; missing evidence remains unknown.",
            "disclosure": "supplemental",
            "data": {
              "source": "dependabot-plan-consumption",
              "filters": {
                "workflow": [
                  ".github/workflows/dependabot-update-planner.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No Dependabot attainment evidence is available.",
            "encoding": {
              "href": {
                "field": "evidence-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "operational-case",
                  "type": "nominal",
                  "title": "Plan issue"
                },
                {
                  "field": "operational-value",
                  "type": "quantitative",
                  "title": "Consumed"
                },
                {
                  "field": "maturity-status",
                  "type": "nominal",
                  "title": "Maturity",
                  "display": "status"
                },
                {
                  "field": "evidence-cutoff",
                  "type": "temporal",
                  "format": "human-friendly-timestamp",
                  "title": "Evidence cutoff"
                }
              ]
            }
          },
          {
            "id": "dependabot-value-trend",
            "title": "Plan issue consumption trend",
            "description": "Mean consumption across mature plan issues; interim and missing evidence is not treated as zero.",
            "disclosure": "essential",
            "data": {
              "source": "dependabot-plan-consumption",
              "time": {
                "range": "90d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/dependabot-update-planner.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "line",
            "layout": "full",
            "encoding": {
              "x": {
                "field": "observed-at",
                "type": "temporal",
                "format": "human-friendly-timestamp",
                "time-unit": "day"
              },
              "y": {
                "field": "operational-value",
                "type": "quantitative",
                "aggregate": "mean"
              },
              "color": {
                "field": "operational-value-definition",
                "type": "nominal"
              }
            }
          }
        ]
      }
    ],
    "navigation": [
      {
        "label": "Campaign operations",
        "experimental": true,
        "pages": [
          "dependabot-dashboard"
        ]
      }
    ]
  }
}
