{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "dependabot-dashboard",
    "title": "Dependabot",
    "description": "Track manifest-aware dependency update runs, proposed release trains, and validated merged resolutions.",
    "repository": "githubnext/gh-aw-cao",
    "queries": [
      {
        "name": "dependabot-run-observations",
        "intent": "Show Dependabot orchestrator and release-train worker runs so operators can verify activation and investigate execution failures.",
        "from": "runs",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "in": [
                ".github/workflows/dependabot.md",
                ".github/workflows/dependabot-release-train-updater.md"
              ]
            }
          ]
        },
        "order-by": [
          {
            "field": "started-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "dependabot-release-train-outcomes",
        "intent": "List retained Dependabot release-train proposals so reviewers can inspect their disposition and repository evidence.",
        "from": "outcomes",
        "filter": {
          "predicates": [
            {
              "field": "package",
              "equals": "dependabot"
            }
          ]
        },
        "order-by": [
          {
            "field": "published-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "dependabot-resolution-attainment",
        "intent": "Show validated dependency-resolution observations for assigned release-train pull requests without treating missing or immature evidence as zero.",
        "from": "operational-values",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "equals": ".github/workflows/dependabot-release-train-updater.md"
            }
          ]
        },
        "order-by": [
          {
            "field": "observed-at",
            "direction": "desc"
          }
        ]
      }
    ],
    "pages": [
      {
        "id": "dependabot-dashboard",
        "kind": "custom",
        "title": "Dependabot",
        "description": "Track manifest-aware dependency update runs, proposed release trains, and validated merged resolutions.",
        "icon": "dependabot",
        "views": [
          {
            "id": "dependabot-runs",
            "title": "Release-train runs by conclusion",
            "disclosure": "essential",
            "data": {
              "source": "dependabot-run-observations",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/dependabot.md",
                  ".github/workflows/dependabot-release-train-updater.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "pie",
            "layout": "half",
            "encoding": {
              "x": {
                "field": "run-conclusion",
                "type": "nominal"
              },
              "y": {
                "field": "run",
                "type": "quantitative",
                "aggregate": "count"
              }
            }
          },
          {
            "id": "dependabot-outcomes",
            "title": "Dependency release trains",
            "description": "Repository-linked proposals remain human-reviewed and are never treated as successful until accepted evidence matures.",
            "disclosure": "essential",
            "data": {
              "source": "dependabot-release-train-outcomes",
              "filters": {
                "package": [
                  "dependabot"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No dependency release-train outputs were retained.",
            "encoding": {
              "href": {
                "field": "external-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "outcome-title",
                  "type": "nominal",
                  "title": "Release train",
                  "display": "outcome-link"
                },
                {
                  "field": "outcome-state",
                  "type": "nominal",
                  "title": "Disposition",
                  "display": "status"
                },
                {
                  "field": "published-at",
                  "type": "temporal",
                  "title": "Published"
                }
              ],
              "actions": [
                {
                  "intent": "Review this dependency release train, verify its retained evidence, and recommend the safest next action.",
                  "presentation": "copy-prompt",
                  "icon": "search",
                  "label": "Review",
                  "context": [
                    "repository",
                    "outcome-title",
                    "outcome-summary",
                    "outcome-state",
                    "published-at",
                    "external-link"
                  ]
                }
              ]
            }
          },
          {
            "id": "dependabot-attainment",
            "disclosure-label": "Validated resolution evidence",
            "description": "Each opportunity is an assigned dependency pull request; validated merge evidence matures after 14 days.",
            "disclosure": "supplemental",
            "data": {
              "source": "dependabot-resolution-attainment",
              "filters": {
                "workflow": [
                  ".github/workflows/dependabot-release-train-updater.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No Dependabot attainment evidence is available.",
            "encoding": {
              "href": {
                "field": "evidence-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "operational-case",
                  "type": "nominal",
                  "title": "Opportunity"
                },
                {
                  "field": "operational-value",
                  "type": "quantitative",
                  "title": "Validated resolution share"
                },
                {
                  "field": "maturity-status",
                  "type": "nominal",
                  "title": "Maturity",
                  "display": "status"
                },
                {
                  "field": "evidence-cutoff",
                  "type": "temporal",
                  "title": "Evidence cutoff"
                }
              ]
            }
          },
          {
            "id": "dependabot-value-trend",
            "title": "Validated resolution trend",
            "description": "Mean attainment groups only the release-train evaluator definition and does not imply causal impact.",
            "disclosure": "essential",
            "data": {
              "source": "dependabot-resolution-attainment",
              "time": {
                "range": "90d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/dependabot-release-train-updater.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "line",
            "layout": "full",
            "encoding": {
              "x": {
                "field": "observed-at",
                "type": "temporal",
                "time-unit": "day"
              },
              "y": {
                "field": "operational-value",
                "type": "quantitative",
                "aggregate": "mean"
              },
              "color": {
                "field": "operational-value-definition",
                "type": "nominal"
              }
            }
          }
        ]
      }
    ],
    "navigation": [
      {
        "label": "Package operations",
        "experimental": true,
        "pages": [
          "dependabot-dashboard"
        ]
      }
    ]
  }
}
