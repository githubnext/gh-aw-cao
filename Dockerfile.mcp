FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1

ARG VERSION=dev
ARG REVISION=unknown
ARG CREATED=unknown
LABEL org.opencontainers.image.title="Central Agentic Ops MCP server" \
      org.opencontainers.image.description="Read-only MCP access to named CAO dashboard queries" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.source="https://github.com/githubnext/gh-aw-cao"

# The server executes named Dashboard Language queries over a local SQLite
# projection, so the image carries only the CLI, the dashboard definitions, and
# the dashboard data layer. It needs no third-party JavaScript dependency, no
# GitHub credentials, and no outbound network access.
RUN addgroup -S -g 65532 cao \
    && adduser -S -D -H -u 65532 -G cao cao \
    && mkdir -p /app /data \
    && chown -R cao:cao /app

WORKDIR /app
COPY --chown=cao:cao package.json /app/package.json
COPY --chown=cao:cao activity /app/activity
COPY --chown=cao:cao dashboard/report /app/dashboard/report
COPY --chown=cao:cao dashboard/site/dashboard.json /app/dashboard/site/dashboard.json
COPY --chown=cao:cao dashboard/site/dashboard-fragments /app/dashboard/site/dashboard-fragments
COPY --chown=cao:cao dashboard/site/src /app/dashboard/site/src
COPY --chown=cao:cao scripts/cao-mcp-entrypoint.sh /app/cao-mcp-entrypoint.sh
RUN chmod +x /app/cao-mcp-entrypoint.sh

USER 65532:65532
EXPOSE 8765
VOLUME ["/data"]
ENV NODE_ENV=production
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "const t=require('node:net').connect(Number(process.env.CAO_MCP_PORT||8765),'127.0.0.1');t.on('connect',()=>{t.end();process.exit(0)});t.on('error',()=>process.exit(1))"
ENTRYPOINT ["/app/cao-mcp-entrypoint.sh"]
