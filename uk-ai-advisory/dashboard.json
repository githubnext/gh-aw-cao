{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "uk-ai-advisory-dashboard",
    "title": "UK AI Advisory",
    "description": "Track resilience-review activation, frozen advisory reports, and explicit human acceptance of non-binding findings.",
    "repository": "githubnext/gh-aw-cao",
    "queries": [
      {
        "name": "uk-ai-advisory-runs",
        "intent": "Show UK AI Advisory orchestrator, maintainer, and resilience-review runs so operators can verify package activation.",
        "from": "runs",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "in": [
                ".github/workflows/uk-ai-advisory.md",
                ".github/workflows/uk-ai-advisory-package-maintainer.md",
                ".github/workflows/uk-ai-advisory-operational-resilience.md"
              ]
            }
          ]
        },
        "order-by": [
          {
            "field": "started-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "uk-ai-advisory-reports",
        "intent": "List frozen non-binding UK AI resilience reports so humans can review findings and their disposition.",
        "from": "outcomes",
        "filter": {
          "predicates": [
            {
              "field": "package",
              "equals": "uk-ai-advisory"
            }
          ]
        },
        "order-by": [
          {
            "field": "published-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "uk-ai-advisory-acceptance",
        "intent": "Show explicit non-bot acceptance observations for frozen resilience reports while preserving maturity and missing-evidence states.",
        "from": "operational-values",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "equals": ".github/workflows/uk-ai-advisory-operational-resilience.md"
            }
          ]
        },
        "order-by": [
          {
            "field": "observed-at",
            "direction": "desc"
          }
        ]
      }
    ],
    "pages": [
      {
        "id": "uk-ai-advisory-dashboard",
        "kind": "custom",
        "title": "UK AI Advisory",
        "navigation-label": "UK AI advisory",
        "description": "Track resilience-review activation, frozen advisory reports, and explicit human acceptance of non-binding findings.",
        "icon": "eye",
        "views": [
          {
            "id": "advisory-runs",
            "title": "Advisory runs by conclusion",
            "disclosure": "essential",
            "data": {
              "source": "uk-ai-advisory-runs",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/uk-ai-advisory.md",
                  ".github/workflows/uk-ai-advisory-package-maintainer.md",
                  ".github/workflows/uk-ai-advisory-operational-resilience.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "pie",
            "layout": "half",
            "encoding": {
              "x": {
                "field": "run-conclusion",
                "type": "nominal"
              },
              "y": {
                "field": "run",
                "type": "quantitative",
                "aggregate": "count"
              }
            }
          },
          {
            "id": "advisory-outcomes",
            "title": "Operational resilience reports",
            "description": "Reports are non-binding evidence frozen at a target commit and require human review.",
            "disclosure": "essential",
            "data": {
              "source": "uk-ai-advisory-reports",
              "filters": {
                "package": [
                  "uk-ai-advisory"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No UK AI advisory reports were retained.",
            "encoding": {
              "href": {
                "field": "external-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "outcome-title",
                  "type": "nominal",
                  "title": "Advisory report",
                  "display": "outcome-link"
                },
                {
                  "field": "outcome-state",
                  "type": "nominal",
                  "title": "Disposition",
                  "display": "status"
                },
                {
                  "field": "published-at",
                  "type": "temporal",
                  "title": "Published"
                }
              ],
              "actions": [
                {
                  "intent": "Review this non-binding resilience report, verify its frozen evidence and limitations, and identify the next human decision.",
                  "presentation": "copy-prompt",
                  "icon": "search",
                  "label": "Review",
                  "context": [
                    "repository",
                    "outcome-title",
                    "outcome-summary",
                    "outcome-state",
                    "evidence-strength",
                    "published-at",
                    "external-link"
                  ]
                }
              ]
            }
          },
          {
            "id": "advisory-attainment",
            "disclosure-label": "Human acceptance evidence",
            "description": "Attainment records explicit non-bot acceptance of a frozen report after the 30-day maturation window.",
            "disclosure": "supplemental",
            "data": {
              "source": "uk-ai-advisory-acceptance",
              "filters": {
                "workflow": [
                  ".github/workflows/uk-ai-advisory-operational-resilience.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No UK AI advisory acceptance evidence is available.",
            "encoding": {
              "href": {
                "field": "evidence-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "operational-case",
                  "type": "nominal",
                  "title": "Opportunity"
                },
                {
                  "field": "operational-value",
                  "type": "quantitative",
                  "title": "Human acceptance"
                },
                {
                  "field": "maturity-status",
                  "type": "nominal",
                  "title": "Maturity",
                  "display": "status"
                },
                {
                  "field": "evidence-cutoff",
                  "type": "temporal",
                  "title": "Evidence cutoff"
                }
              ]
            }
          },
          {
            "id": "advisory-value-trend",
            "title": "Human acceptance trend",
            "description": "Mean acceptance attainment is diagnostic and does not convert advisory evidence into a legal or causal conclusion.",
            "disclosure": "essential",
            "data": {
              "source": "uk-ai-advisory-acceptance",
              "time": {
                "range": "90d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/uk-ai-advisory-operational-resilience.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "line",
            "layout": "full",
            "encoding": {
              "x": {
                "field": "observed-at",
                "type": "temporal",
                "time-unit": "day"
              },
              "y": {
                "field": "operational-value",
                "type": "quantitative",
                "aggregate": "mean"
              },
              "color": {
                "field": "operational-value-definition",
                "type": "nominal"
              }
            }
          }
        ]
      }
    ],
    "navigation": [
      {
        "label": "Package operations",
        "experimental": true,
        "pages": [
          "uk-ai-advisory-dashboard"
        ]
      }
    ]
  }
}
