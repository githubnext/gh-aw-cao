{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "eslint-rules-dashboard",
    "title": "ESLint Factory",
    "description": "Track ESLint Factory orchestration, worker runs, and the adoption requests raised for enrolled JavaScript and TypeScript repositories.",
    "repository": "githubnext/gh-aw-cao",
    "queries": [
      {
        "name": "eslint-rules-run-observations",
        "intent": "Show ESLint Factory orchestrator and worker runs so operators can verify activation and investigate execution failures.",
        "from": "runs",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "in": [
                ".github/workflows/eslint-rules.md",
                ".github/workflows/eslint-rules-inventory.md",
                ".github/workflows/eslint-rules-miner.md",
                ".github/workflows/eslint-rules-refiner.md",
                ".github/workflows/eslint-rules-applier.md",
                ".github/workflows/eslint-rules-librarian.md"
              ]
            }
          ]
        },
        "order-by": [
          {
            "field": "started-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "eslint-rules-worker-activity",
        "intent": "Compare how much work each ESLint Factory worker performed so operators can see whether mining, refinement, and adoption stay balanced.",
        "from": "runs",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "in": [
                ".github/workflows/eslint-rules-inventory.md",
                ".github/workflows/eslint-rules-miner.md",
                ".github/workflows/eslint-rules-refiner.md",
                ".github/workflows/eslint-rules-applier.md",
                ".github/workflows/eslint-rules-librarian.md"
              ]
            }
          ]
        },
        "order-by": [
          {
            "field": "started-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "eslint-rules-adoption-outcomes",
        "intent": "List retained ESLint Factory adoption requests so reviewers can inspect each proposed rule and its repository evidence.",
        "from": "outcomes",
        "filter": {
          "predicates": [
            {
              "field": "package",
              "equals": "eslint-rules"
            }
          ]
        },
        "order-by": [
          {
            "field": "published-at",
            "direction": "desc"
          }
        ]
      }
    ],
    "pages": [
      {
        "id": "eslint-rules-dashboard",
        "kind": "custom",
        "title": "ESLint Factory",
        "description": "Track ESLint Factory orchestration, worker runs, and the adoption requests raised for enrolled JavaScript and TypeScript repositories.",
        "icon": "codescan",
        "views": [
          {
            "id": "eslint-rules-runs",
            "title": "ESLint Factory runs by conclusion",
            "disclosure": "essential",
            "data": {
              "source": "eslint-rules-run-observations",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/eslint-rules.md",
                  ".github/workflows/eslint-rules-inventory.md",
                  ".github/workflows/eslint-rules-miner.md",
                  ".github/workflows/eslint-rules-refiner.md",
                  ".github/workflows/eslint-rules-applier.md",
                  ".github/workflows/eslint-rules-librarian.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "pie",
            "layout": "half",
            "encoding": {
              "x": {
                "field": "run-conclusion",
                "type": "nominal"
              },
              "y": {
                "field": "run",
                "type": "quantitative",
                "aggregate": "count"
              }
            }
          },
          {
            "id": "eslint-rules-worker-mix",
            "title": "Worker runs by workflow",
            "description": "Mining, refinement, and adoption should stay proportionate; a factory that only mines never produces adoptable rules.",
            "disclosure": "essential",
            "data": {
              "source": "eslint-rules-worker-activity",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/eslint-rules-inventory.md",
                  ".github/workflows/eslint-rules-miner.md",
                  ".github/workflows/eslint-rules-refiner.md",
                  ".github/workflows/eslint-rules-applier.md",
                  ".github/workflows/eslint-rules-librarian.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "pie",
            "layout": "half",
            "encoding": {
              "x": {
                "field": "workflow",
                "type": "nominal"
              },
              "y": {
                "field": "run",
                "type": "quantitative",
                "aggregate": "count"
              }
            }
          },
          {
            "id": "eslint-rules-outcomes",
            "title": "Rule adoption requests",
            "description": "Adoption requests are warning-only proposals that stay human-reviewed; the control plane never edits a target repository.",
            "disclosure": "essential",
            "data": {
              "source": "eslint-rules-adoption-outcomes",
              "filters": {
                "package": [
                  "eslint-rules"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No ESLint Factory adoption requests were retained.",
            "encoding": {
              "href": {
                "field": "external-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "outcome-title",
                  "type": "nominal",
                  "title": "Adoption request",
                  "display": "outcome-link"
                },
                {
                  "field": "outcome-state",
                  "type": "nominal",
                  "title": "Disposition",
                  "display": "status"
                },
                {
                  "field": "published-at",
                  "type": "temporal",
                  "format": "human-friendly-timestamp",
                  "title": "Published"
                }
              ],
              "actions": [
                {
                  "intent": "Review this ESLint rule adoption request, verify the evidence behind the rule, and recommend whether the repository should adopt it.",
                  "presentation": "copy-prompt",
                  "icon": "search",
                  "label": "Review",
                  "context": [
                    "repository",
                    "outcome-title",
                    "outcome-summary",
                    "outcome-state",
                    "published-at",
                    "external-link"
                  ]
                }
              ]
            }
          }
        ]
      }
    ],
    "navigation": [
      {
        "label": "Package operations",
        "experimental": true,
        "pages": ["eslint-rules-dashboard"]
      }
    ]
  }
}
