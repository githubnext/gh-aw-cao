{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "cao-evolution-optimization-dashboard",
    "title": "CAO Evolution / Optimization",
    "description": "Track CAO Evolution AI Credit and ambient context runs, retained recommendations, and matured accuracy and efficiency evidence.",
    "repository": "githubnext/gh-aw-cao",
    "queries": [
      {
        "name": "cao-evolution-optimization-run-observations",
        "intent": "Show CAO Evolution orchestrator and optimization worker runs so operators can verify activation across AI Credit and ambient-context operations.",
        "from": "runs",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "in": [
                ".github/workflows/cao-evolution.md",
                ".github/workflows/cao-evolution-ai-credit-auditor.md",
                ".github/workflows/cao-evolution-ai-credit-optimizer.md",
                ".github/workflows/cao-evolution-agents-md-curator.md",
                ".github/workflows/cao-evolution-skills-curator.md"
              ]
            }
          ]
        },
        "order-by": [
          {
            "field": "started-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "cao-evolution-optimization-retained-outcomes",
        "intent": "List retained CAO Evolution optimization audits and recommendations without presenting proposed savings or context changes as realized value.",
        "from": "outcomes",
        "filter": {
          "predicates": [
            {
              "field": "package",
              "in": [
                "cao-evolution",
                "optimization"
              ]
            },
            {
              "field": "workflow",
              "in": [
                ".github/workflows/cao-evolution-ai-credit-auditor.md",
                ".github/workflows/cao-evolution-ai-credit-optimizer.md",
                ".github/workflows/cao-evolution-agents-md-curator.md",
                ".github/workflows/cao-evolution-skills-curator.md"
              ]
            }
          ]
        },
        "order-by": [
          {
            "field": "published-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "cao-evolution-optimization-attainment-observations",
        "intent": "Show matured accuracy and efficiency observations for graded CAO Evolution optimization workers while preserving each evaluator definition.",
        "from": "operational-values",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "in": [
                ".github/workflows/cao-evolution-ai-credit-auditor.md",
                ".github/workflows/cao-evolution-ai-credit-optimizer.md",
                ".github/workflows/cao-evolution-agents-md-curator.md"
              ]
            }
          ]
        },
        "order-by": [
          {
            "field": "observed-at",
            "direction": "desc"
          }
        ]
      }
    ],
    "pages": [
      {
        "id": "cao-evolution-optimization-dashboard",
        "kind": "custom",
        "title": "CAO Evolution / Optimization",
        "description": "Track CAO Evolution AI Credit and ambient context runs, retained recommendations, and matured accuracy and efficiency evidence.",
        "icon": "meter",
        "views": [
          {
            "id": "cao-evolution-optimization-runs",
            "title": "Optimization runs by conclusion",
            "disclosure": "essential",
            "data": {
              "source": "cao-evolution-optimization-run-observations",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/cao-evolution.md",
                  ".github/workflows/cao-evolution-ai-credit-auditor.md",
                  ".github/workflows/cao-evolution-ai-credit-optimizer.md",
                  ".github/workflows/cao-evolution-agents-md-curator.md",
                  ".github/workflows/cao-evolution-skills-curator.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "pie",
            "layout": "half",
            "encoding": {
              "x": {
                "field": "run-conclusion",
                "type": "nominal"
              },
              "y": {
                "field": "run",
                "type": "quantitative",
                "aggregate": "count"
              }
            }
          },
          {
            "id": "cao-evolution-optimization-outcomes",
            "title": "Audit and optimization outputs",
            "description": "Retained snapshots and recommendations expose repository evidence without treating a recommendation as realized savings or context improvement.",
            "disclosure": "essential",
            "data": {
              "source": "cao-evolution-optimization-retained-outcomes",
              "filters": {
                "package": [
                  "cao-evolution",
                  "optimization"
                ],
                "workflow": [
                  ".github/workflows/cao-evolution-ai-credit-auditor.md",
                  ".github/workflows/cao-evolution-ai-credit-optimizer.md",
                  ".github/workflows/cao-evolution-agents-md-curator.md",
                  ".github/workflows/cao-evolution-skills-curator.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No optimization outputs were retained.",
            "encoding": {
              "href": {
                "field": "external-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "outcome-title",
                  "type": "nominal",
                  "title": "Audit or recommendation",
                  "display": "outcome-link"
                },
                {
                  "field": "outcome-state",
                  "type": "nominal",
                  "title": "Disposition",
                  "display": "status"
                },
                {
                  "field": "published-at",
                  "type": "temporal",
                  "format": "human-friendly-timestamp",
                  "title": "Published"
                }
              ],
              "actions": [
                {
                  "intent": "Review this optimization output, verify its retained evidence, and identify the safest next action.",
                  "presentation": "copy-prompt",
                  "icon": "search",
                  "label": "Review",
                  "context": [
                    "repository",
                    "outcome-title",
                    "outcome-summary",
                    "outcome-state",
                    "published-at",
                    "external-link"
                  ]
                }
              ]
            }
          },
          {
            "id": "cao-evolution-optimization-attainment",
            "disclosure-label": "Accuracy and efficiency evidence",
            "description": "AI Credit and ambient context evidence matures on each worker's frozen evaluation schedule.",
            "disclosure": "supplemental",
            "data": {
              "source": "cao-evolution-optimization-attainment-observations",
              "filters": {
                "workflow": [
                  ".github/workflows/cao-evolution-ai-credit-auditor.md",
                  ".github/workflows/cao-evolution-ai-credit-optimizer.md",
                  ".github/workflows/cao-evolution-agents-md-curator.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No optimization attainment evidence is available.",
            "encoding": {
              "href": {
                "field": "evidence-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "operational-value-definition",
                  "type": "nominal",
                  "title": "Evaluator"
                },
                {
                  "field": "operational-case",
                  "type": "nominal",
                  "title": "Opportunity"
                },
                {
                  "field": "operational-value",
                  "type": "quantitative",
                  "title": "Attainment"
                },
                {
                  "field": "maturity-status",
                  "type": "nominal",
                  "title": "Maturity",
                  "display": "status"
                },
                {
                  "field": "evidence-cutoff",
                  "type": "temporal",
                  "format": "human-friendly-timestamp",
                  "title": "Evidence cutoff"
                }
              ]
            }
          },
          {
            "id": "cao-evolution-optimization-value-trend",
            "title": "Operational-value trend",
            "description": "AI Credit and ambient context attainment remain separate evaluator series and are not inferred from activity totals alone.",
            "disclosure": "essential",
            "data": {
              "source": "cao-evolution-optimization-attainment-observations",
              "time": {
                "range": "90d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/cao-evolution-ai-credit-auditor.md",
                  ".github/workflows/cao-evolution-ai-credit-optimizer.md",
                  ".github/workflows/cao-evolution-agents-md-curator.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "line",
            "layout": "full",
            "encoding": {
              "x": {
                "field": "observed-at",
                "type": "temporal",
                "format": "human-friendly-timestamp",
                "time-unit": "day"
              },
              "y": {
                "field": "operational-value",
                "type": "quantitative",
                "aggregate": "mean"
              },
              "color": {
                "field": "operational-value-definition",
                "type": "nominal"
              }
            }
          }
        ]
      }
    ],
    "navigation": [
      {
        "label": "Package operations",
        "experimental": true,
        "pages": [
          "cao-evolution-optimization-dashboard"
        ]
      }
    ]
  }
}
