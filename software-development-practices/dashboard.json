{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "software-development-practices-dashboard",
    "title": "Dev Practices",
    "description": "Track framework review runs, evidence-backed guidance, and explicit human acceptance for frozen repository snapshots.",
    "repository": "githubnext/gh-aw-cao",
    "queries": [
      {
        "name": "development-practices-review-runs",
        "intent": "Show framework-review orchestrator and worker runs so operators can verify activation for GitHub Well-Architected and NIST SSDF guidance.",
        "from": "runs",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "in": [
                ".github/workflows/software-development-practices.md",
                ".github/workflows/software-development-practices-github-well-architected.md",
                ".github/workflows/software-development-practices-nist-ssdf.md"
              ]
            }
          ]
        },
        "order-by": [
          {
            "field": "started-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "development-practices-guidance",
        "intent": "List retained framework guidance with official-source provenance and evidence limitations for human review.",
        "from": "outcomes",
        "filter": {
          "predicates": [
            {
              "field": "package",
              "equals": "software-development-practices"
            }
          ]
        },
        "order-by": [
          {
            "field": "published-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "development-practices-acceptance",
        "intent": "Show explicit human-acceptance observations for Well-Architected and NIST SSDF guidance without inferring framework conformance.",
        "from": "operational-values",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "in": [
                ".github/workflows/software-development-practices-github-well-architected.md",
                ".github/workflows/software-development-practices-nist-ssdf.md"
              ]
            }
          ]
        },
        "order-by": [
          {
            "field": "observed-at",
            "direction": "desc"
          }
        ]
      }
    ],
    "pages": [
      {
        "id": "software-development-practices-dashboard",
        "kind": "custom",
        "title": "Dev Practices",
        "navigation-label": "Development practices",
        "description": "Track framework review runs, evidence-backed guidance, and explicit human acceptance for frozen repository snapshots.",
        "icon": "code",
        "views": [
          {
            "id": "software-development-practices-runs",
            "title": "Framework reviews by conclusion",
            "disclosure": "essential",
            "data": {
              "source": "development-practices-review-runs",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/software-development-practices.md",
                  ".github/workflows/software-development-practices-github-well-architected.md",
                  ".github/workflows/software-development-practices-nist-ssdf.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "pie",
            "layout": "half",
            "encoding": {
              "x": {
                "field": "run-conclusion",
                "type": "nominal"
              },
              "y": {
                "field": "run",
                "type": "quantitative",
                "aggregate": "count"
              }
            }
          },
          {
            "id": "software-development-practices-outcomes",
            "title": "Repository guidance",
            "description": "Guidance retains official source provenance, evidence limitations, and prioritized recommendations for human review.",
            "disclosure": "essential",
            "data": {
              "source": "development-practices-guidance",
              "filters": {
                "package": [
                  "software-development-practices"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No Software Development Practices guidance was retained.",
            "encoding": {
              "href": {
                "field": "external-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "outcome-title",
                  "type": "nominal",
                  "title": "Guidance",
                  "display": "outcome-link"
                },
                {
                  "field": "outcome-state",
                  "type": "nominal",
                  "title": "Disposition",
                  "display": "status"
                },
                {
                  "field": "published-at",
                  "type": "temporal",
                  "format": "human-friendly-timestamp",
                  "title": "Published"
                }
              ],
              "actions": [
                {
                  "intent": "Review this framework guidance, verify its source evidence and limitations, and identify the next human decision.",
                  "presentation": "copy-prompt",
                  "icon": "search",
                  "label": "Review",
                  "context": [
                    "repository",
                    "workflow-name",
                    "outcome-title",
                    "outcome-summary",
                    "outcome-state",
                    "evidence-strength",
                    "published-at",
                    "external-link"
                  ]
                }
              ]
            }
          },
          {
            "id": "software-development-practices-attainment",
            "disclosure-label": "Human-accepted guidance evidence",
            "description": "Each framework preserves its stable target-commit opportunity, acceptance evidence, maturity state, and repository link.",
            "disclosure": "supplemental",
            "data": {
              "source": "development-practices-acceptance",
              "filters": {
                "workflow": [
                  ".github/workflows/software-development-practices-github-well-architected.md",
                  ".github/workflows/software-development-practices-nist-ssdf.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No Software Development Practices acceptance evidence is available.",
            "encoding": {
              "href": {
                "field": "evidence-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "operational-value-definition",
                  "type": "nominal",
                  "title": "Framework"
                },
                {
                  "field": "operational-case",
                  "type": "nominal",
                  "title": "Opportunity"
                },
                {
                  "field": "operational-value",
                  "type": "quantitative",
                  "title": "Human acceptance"
                },
                {
                  "field": "maturity-status",
                  "type": "nominal",
                  "title": "Maturity",
                  "display": "status"
                },
                {
                  "field": "evidence-cutoff",
                  "type": "temporal",
                  "format": "human-friendly-timestamp",
                  "title": "Evidence cutoff"
                }
              ]
            }
          },
          {
            "id": "software-development-practices-value-trend",
            "title": "Framework guidance acceptance trend",
            "description": "Mean attainment remains separated by evaluator definition and does not imply causation, certification, security, or framework conformance.",
            "disclosure": "essential",
            "data": {
              "source": "development-practices-acceptance",
              "time": {
                "range": "90d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/software-development-practices-github-well-architected.md",
                  ".github/workflows/software-development-practices-nist-ssdf.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "line",
            "layout": "full",
            "encoding": {
              "x": {
                "field": "observed-at",
                "type": "temporal",
                "format": "human-friendly-timestamp",
                "time-unit": "day"
              },
              "y": {
                "field": "operational-value",
                "type": "quantitative",
                "aggregate": "mean"
              },
              "color": {
                "field": "operational-value-definition",
                "type": "nominal"
              }
            }
          }
        ]
      }
    ],
    "navigation": [
      {
        "label": "Package operations",
        "experimental": true,
        "pages": [
          "software-development-practices-dashboard"
        ]
      }
    ]
  }
}
