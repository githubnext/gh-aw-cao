{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "SessionCompaction.json",
    "type": "object",
    "properties": {
        "version": {
            "type": "number",
            "const": 1
        },
        "included_events": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
        },
        "omitted_events": {
            "type": "string",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "oversized_lines": {
            "type": "string",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "scan_truncated": {
            "type": "boolean"
        },
        "truncated": {
            "type": "boolean"
        }
    },
    "required": [
        "version",
        "included_events",
        "omitted_events",
        "oversized_lines",
        "scan_truncated",
        "truncated"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Loss/coverage metadata for compact unified-session profile 1, not a completeness or billing assertion. Counters are nonnegative JavaScript-safe integers."
}