{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "QueryRequest.json",
    "type": "object",
    "properties": {
        "sourceNames": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "queries": {
            "type": "array",
            "items": {
                "$ref": "QueryDefinition.json"
            }
        },
        "compiledQueries": {
            "type": "array",
            "items": {
                "$ref": "QueryDefinition.json"
            }
        },
        "aliases": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "replacedSources": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "pagination": {
            "$ref": "#/$defs/RecordPaginationRequest"
        },
        "pageId": {
            "type": "string"
        },
        "viewId": {
            "type": "string"
        },
        "routeParameters": {
            "$ref": "#/$defs/RecordUnknown"
        },
        "queryContext": {
            "$ref": "#/$defs/RecordUnknown"
        },
        "context": {
            "$ref": "#/$defs/RecordUnknown"
        },
        "evaluatedAt": {
            "type": "string"
        }
    },
    "examples": [
        {
            "sourceNames": [
                "runs"
            ],
            "aliases": [],
            "pagination": {
                "runs": {
                    "limit": 50
                }
            }
        }
    ],
    "description": "Requests may supply query definitions or use server-configured definitions.",
    "$defs": {
        "RecordPaginationRequest": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {
                "$ref": "#/$defs/PaginationRequest"
            }
        },
        "RecordUnknown": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {}
        },
        "PaginationRequest": {
            "type": "object",
            "properties": {
                "limit": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                },
                "continuationToken": {
                    "type": "string"
                }
            },
            "required": [
                "limit"
            ]
        }
    }
}