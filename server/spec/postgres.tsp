/**
 * Physical PostgreSQL storage contract, separate from the public HTTP canonical
 * row contract. Optional presence is tracked independently from SQL NULL.
 */
namespace Cao.Postgres;

/** Source registry and resource accounting, scoped to a tenant. */
model Source {
  `namespace`: string;
  sourceName: string;
  estimatedBytes?: int64;
  /** Only explicitly registered canonical sources use the native row table. */
  isCanonical: boolean;
  /** Native canonical source metadata; presence distinguishes missing and null. */
  metadataPresent: string[];
  metadataSourceId?: string | null;
  metadataSourceRevision?: string | null;
  metadataSourceKind?: string | null;
  metadataAvailability?: string | null;
  metadataRowCountNull: boolean;
  metadataMigrated: boolean;
  /** Only unknown metadata keys; absent when the metadata schema is closed. */
  metadataExtension?: Record<unknown> | null;
  /** Field/type diagnostic for a canonical source retaining legacy storage. */
  storageFallbackReason?: string | null;
}

/** Known canonical columns are never copied into the extension object. */
model CanonicalRow {
  `namespace`: string;
  sourceName: string;
  ordinal: int64;
  /** Names of present known fields; distinguishes missing from explicit null. */
  present: string[];
  /** Open fields only; SQL NULL when no extension fields exist. */
  extension?: Record<unknown> | null;
  /** Canonical identity; indexed with the namespace and source. */
  id?: string | null;
  idKind?: "string" | "number" | null;
  /** Owning run relationship; indexed with the namespace and source. */
  runId?: string | null;
  /** Owning session relationship; indexed with the namespace and source. */
  sessionId?: string | null;
  /** Owning repository relationship; indexed with namespace and source. */
  repositoryId?: string | null;
  /** Optional worker target repository; indexed with namespace and source, distinct from the execution repository. */
  targetRepositoryId?: string | null;
  /** Owning workflow relationship; indexed with namespace and source. */
  workflowId?: string | null;
  owner?: string | null;
  repository?: string | null;
  name?: string | null;
  fullName?: string | null;
  path?: string | null;
