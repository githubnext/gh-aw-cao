          "variables": {
            "lakePremium": "[startsWith(parameters('lakeStorageSku'), 'Premium')]",
            "lakeStorageAccountName": "[format('{0}lake{1}', toLower(take(replace(parameters('namePrefix'), '-', ''), 7)), uniqueString(resourceGroup().id, parameters('namePrefix')))]",
            "streamKey": "[format('{0}:collect:tasks', parameters('redisNamespace'))]",
            "consumerGroup": "collectors",
            "collectionEnvironment": [
              {
                "name": "CAO_REDIS_URL",
                "secretRef": "cao-redis-url"
              },
              {
                "name": "CAO_REDIS_NAMESPACE",
                "value": "[parameters('redisNamespace')]"
              },
              {
                "name": "CAO_COLLECT_APP_ID",
                "value": "[parameters('githubAppId')]"
              },
              {
                "name": "CAO_COLLECT_PRIVATE_KEY",
                "secretRef": "cao-collect-private-key"
              },
              {
                "name": "CAO_COLLECT_LAKE_DIRECTORY",
                "value": "/evidence"
              },
              {
                "name": "CAO_COLLECT_CATALOG_ROOT",
                "value": "/app"
              },
              {
                "name": "CAO_COLLECT_CONTROL_REPOSITORY",
                "value": "[parameters('controlRepository')]"
              },
              {
                "name": "CAO_COLLECT_QUEUE_MAX_LENGTH",
                "value": "[string(parameters('queueMaxLength'))]"
              },
              {
                "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                "secretRef": "application-insights-connection-string"
              },
              {
                "name": "OTEL_SERVICE_NAME",
                "value": "[format('{0}-collector', parameters('namePrefix'))]"
              },
              {
                "name": "DEBUG",
                "value": "cao:collect:*"
              }
            ],
            "collectionSecrets": [
              {
                "name": "cao-redis-url",
                "keyVaultUrl": "[format('{0}secrets/cao-redis-url', parameters('keyVaultUri'))]",
                "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-collector-identity', parameters('namePrefix')))]"
              },
              {
                "name": "cao-collect-private-key",
                "keyVaultUrl": "[format('{0}secrets/cao-collect-private-key', parameters('keyVaultUri'))]",
                "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-collector-identity', parameters('namePrefix')))]"
              },
              {
                "name": "cao-redis-password",
                "keyVaultUrl": "[format('{0}secrets/cao-redis-password', parameters('keyVaultUri'))]",
                "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-collector-identity', parameters('namePrefix')))]"
              },
              {
                "name": "application-insights-connection-string",
                "value": "[parameters('applicationInsightsConnectionString')]"
              }
            ]
          },
          "resources": [
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "apiVersion": "2023-01-31",
              "name": "[format('{0}-collector-identity', parameters('namePrefix'))]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]"
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
              "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-collector-identity', parameters('namePrefix'))), 'Key Vault Secrets User')]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-collector-identity', parameters('namePrefix'))), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-collector-identity', parameters('namePrefix')))]"
              ]
            },
            {
              "type": "Microsoft.App/managedEnvironments",
              "apiVersion": "2024-03-01",
              "name": "[format('{0}-collectors', parameters('namePrefix'))]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "appLogsConfiguration": "[if(empty(parameters('logAnalyticsWorkspaceResourceId')), createObject(), createObject('destination', 'azure-monitor'))]",
                "zoneRedundant": false
              }
            },
            {
              "condition": "[not(empty(parameters('logAnalyticsWorkspaceResourceId')))]",
              "type": "Microsoft.Insights/diagnosticSettings",
              "apiVersion": "2021-05-01-preview",
              "scope": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-collectors', parameters('namePrefix')))]",
              "name": "collection-logs",
              "properties": {
                "workspaceId": "[parameters('logAnalyticsWorkspaceResourceId')]",
                "logs": [
                  {
                    "categoryGroup": "allLogs",
                    "enabled": true
                  }
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments', format('{0}-collectors', parameters('namePrefix')))]"
              ]
            },
            {
              "type": "Microsoft.Storage/storageAccounts",
              "apiVersion": "2023-05-01",
              "name": "[variables('lakeStorageAccountName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "kind": "[if(variables('lakePremium'), 'FileStorage', 'StorageV2')]",
              "sku": {
                "name": "[parameters('lakeStorageSku')]"
              },
              "properties": {
                "accessTier": "[if(variables('lakePremium'), 'Premium', 'Hot')]",
                "minimumTlsVersion": "TLS1_2",
                "supportsHttpsTrafficOnly": true,
                "allowBlobPublicAccess": false,
                "allowCrossTenantReplication": false,
                "publicNetworkAccess": "Enabled",
                "networkAcls": {
                  "bypass": "AzureServices",
                  "defaultAction": "Allow"
                },
                "encryption": {
                  "requireInfrastructureEncryption": true,
                  "keySource": "Microsoft.Storage",
                  "services": {
                    "file": {
                      "enabled": true,
                      "keyType": "Account"
                    }
                  }
                }
              }
            },
            {
              "type": "Microsoft.Storage/storageAccounts/fileServices",
              "apiVersion": "2023-05-01",
              "name": "[format('{0}/{1}', variables('lakeStorageAccountName'), 'default')]",
              "properties": {
                "shareDeleteRetentionPolicy": {
                  "enabled": true,
                  "days": 30
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', variables('lakeStorageAccountName'))]"
              ]
            },
            {
              "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
              "apiVersion": "2023-05-01",
              "name": "[format('{0}/{1}/{2}', variables('lakeStorageAccountName'), 'default', 'evidence-lake')]",
              "properties": {
                "shareQuota": "[if(variables('lakePremium'), max(parameters('lakeQuotaGigabytes'), 100), parameters('lakeQuotaGigabytes'))]",
                "enabledProtocols": "SMB"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts/fileServices', variables('lakeStorageAccountName'), 'default')]"
              ]
            },
            {
              "type": "Microsoft.App/managedEnvironments/storages",
              "apiVersion": "2024-03-01",
              "name": "[format('{0}/{1}', format('{0}-collectors', parameters('namePrefix')), 'evidence-lake')]",
              "properties": {
                "azureFile": {
                  "accountName": "[variables('lakeStorageAccountName')]",
                  "shareName": "evidence-lake",
                  "accessMode": "ReadWrite",
                  "accountKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('lakeStorageAccountName')), '2023-05-01').keys[0].value]"
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments', format('{0}-collectors', parameters('namePrefix')))]",
                "[resourceId('Microsoft.Storage/storageAccounts', variables('lakeStorageAccountName'))]",
                "[resourceId('Microsoft.Storage/storageAccounts/fileServices/shares', variables('lakeStorageAccountName'), 'default', 'evidence-lake')]"
              ]
            },
            {
              "type": "Microsoft.App/containerApps",
              "apiVersion": "2024-03-01",
              "name": "[format('{0}-collector', parameters('namePrefix'))]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-collector-identity', parameters('namePrefix'))))]": {}
                }
              },
              "properties": {
                "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-collectors', parameters('namePrefix')))]",
                "configuration": {
                  "activeRevisionsMode": "Single",
                  "secrets": "[variables('collectionSecrets')]"
                },
                "template": {
                  "containers": [
                    {
                      "name": "collector",
                      "image": "[parameters('collectorImage')]",
                      "command": [
                        "/app/cao-dashboard"
                      ],
                      "args": [
                        "collect"
                      ],
                      "env": "[variables('collectionEnvironment')]",
                      "resources": {
                        "cpu": "[json('1.0')]",
                        "memory": "2Gi"
                      },
                      "volumeMounts": [
                        {
                          "volumeName": "evidence",
                          "mountPath": "/evidence"
                        }
                      ]
                    }
                  ],
                  "volumes": [
                    {
                      "name": "evidence",
                      "storageType": "AzureFile",
                      "storageName": "evidence-lake"
                    }
                  ],
                  "scale": {
                    "minReplicas": "[parameters('minimumWorkers')]",
                    "maxReplicas": "[parameters('maximumWorkers')]",
                    "rules": [
                      {
                        "name": "collection-backlog",
                        "custom": {
                          "type": "redis-streams",
                          "metadata": {
                            "address": "[format('{0}:{1}', parameters('redisHost'), parameters('redisPort'))]",
                            "stream": "[variables('streamKey')]",
                            "consumerGroup": "[variables('consumerGroup')]",
                            "pendingEntriesCount": "[string(parameters('backlogPerWorker'))]",
                            "enableTLS": "true"
                          },
                          "auth": [
                            {
                              "secretRef": "cao-redis-password",
                              "triggerParameter": "password"
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-collector-identity', parameters('namePrefix')))]",
                "[resourceId('Microsoft.App/managedEnvironments', format('{0}-collectors', parameters('namePrefix')))]",
                "[resourceId('Microsoft.App/managedEnvironments/storages', format('{0}-collectors', parameters('namePrefix')), 'evidence-lake')]"
              ]
            },
            {
              "type": "Microsoft.App/jobs",
              "apiVersion": "2024-03-01",
              "name": "[format('{0}-backfill', parameters('namePrefix'))]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-collector-identity', parameters('namePrefix'))))]": {}
                }
              },
              "properties": {
                "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-collectors', parameters('namePrefix')))]",
                "configuration": {
                  "triggerType": "Manual",
                  "replicaTimeout": 7200,
                  "replicaRetryLimit": 1,
                  "manualTriggerConfig": {
                    "parallelism": 1,
                    "replicaCompletionCount": 1
                  },
                  "secrets": "[variables('collectionSecrets')]"
                },
                "template": {
                  "containers": [
                    {
                      "name": "backfill",
                      "image": "[parameters('collectorImage')]",
                      "command": [
                        "/app/cao-dashboard"
                      ],
                      "args": [
                        "backfill"
                      ],
                      "env": "[variables('collectionEnvironment')]",
                      "resources": {
                        "cpu": "[json('1.0')]",
                        "memory": "2Gi"
                      },
                      "volumeMounts": [
                        {
                          "volumeName": "evidence",
                          "mountPath": "/evidence"
                        }
                      ]
                    }
                  ],
                  "volumes": [
                    {
                      "name": "evidence",
                      "storageType": "AzureFile",
                      "storageName": "evidence-lake"
                    }
                  ]
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-collector-identity', parameters('namePrefix')))]",
                "[resourceId('Microsoft.App/managedEnvironments', format('{0}-collectors', parameters('namePrefix')))]",
                "[resourceId('Microsoft.App/managedEnvironments/storages', format('{0}-collectors', parameters('namePrefix')), 'evidence-lake')]"
              ]
            }
          ],
          "outputs": {
            "collectorIdentityPrincipalId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-collector-identity', parameters('namePrefix'))), '2023-01-31').principalId]"
            },
            "collectorAppName": {
              "type": "string",
              "value": "[format('{0}-collector', parameters('namePrefix'))]"
            },
            "backfillJobName": {
              "type": "string",
              "value": "[format('{0}-backfill', parameters('namePrefix'))]"
            },
            "taskStreamKey": {
              "type": "string",
              "value": "[variables('streamKey')]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults/secrets', parameters('keyVaultName'), 'cao-collect-private-key')]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', parameters('keyVaultName'), 'cao-redis-password')]",
        "[resourceId('Microsoft.Insights/components', format('{0}-ai', parameters('functionAppName')))]",
        "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', parameters('keyVaultName'), 'cao-redis-url')]",
        "[resourceId('Microsoft.Cache/redisEnterprise', parameters('redisEnterpriseName'))]"
      ]
    }
  ],
  "outputs": {
    "collectionEnabled": {
      "type": "bool",
      "value": "[variables('collectionEnabled')]"
    },
    "functionHostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2023-12-01').defaultHostName]"
    },
    "githubOAuthRedirectUri": {
      "type": "string",
      "value": "[variables('githubRedirectUri')]"
    },
    "redisEnterpriseHostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Cache/redisEnterprise', parameters('redisEnterpriseName')), '2024-11-01').hostName]"
    },
    "redisDatabaseName": {
      "type": "string",
      "value": "default"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri]"
    }
  }
}