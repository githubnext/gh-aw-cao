{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "9745313363914066832"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all dashboard resources."
      }
    },
    "functionAppName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique Function App name."
      }
    },
    "hostingPlanName": {
      "type": "string",
      "defaultValue": "[format('{0}-plan', parameters('functionAppName'))]",
      "metadata": {
        "description": "Azure App Service plan name for the Function App."
      }
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique storage account name for Azure Functions runtime state."
      }
    },
    "keyVaultName": {
      "type": "string",
      "metadata": {
        "description": "Key Vault name used for GitHub OAuth, session, and Redis connection secrets."
      }
    },
    "redisEnterpriseName": {
      "type": "string",
      "metadata": {
        "description": "Redis Enterprise cache name. The default database enables RediSearch."
      }
    },
    "redisSkuName": {
      "type": "string",
      "defaultValue": "Enterprise_E10",
      "allowedValues": [
        "Enterprise_E10",
        "Enterprise_E20",
        "Enterprise_E50",
        "Enterprise_E100",
        "EnterpriseFlash_F300",
        "EnterpriseFlash_F700",
        "EnterpriseFlash_F1500"
      ],
      "metadata": {
        "description": "Redis Enterprise SKU with module support. Basic/Standard/Premium Azure Cache for Redis are not valid for this dashboard because RediSearch is required."
      }
    },
    "redisCapacity": {
      "type": "int",
      "defaultValue": 2,
      "minValue": 2,
      "metadata": {
        "description": "Redis Enterprise capacity. Production deployments should size this from retained dashboard data volume."
      }
    },
    "allowedHosts": {
      "type": "array",
      "metadata": {
        "description": "Public host names that Azure Front Door/App Service is allowed to forward to the Go dashboard handler."
      }
    },
    "githubAllowedOrganizations": {
      "type": "array",
      "metadata": {
        "description": "GitHub organizations whose active members are authorized."
      }
    },
    "githubAllowedTeams": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "GitHub teams whose active members are authorized, expressed as org/team-slug."
      }
    },
    "githubClientId": {
      "type": "string",
      "metadata": {
        "description": "GitHub OAuth App client ID. Do not use a PAT; the server only supports the OAuth authorization-code flow."
      }
    },
    "githubClientSecret": {
      "type": "securestring",
      "metadata": {
        "description": "GitHub OAuth App client secret. It is written only to Key Vault and consumed by the Function App through a Key Vault reference."
      }
    },
    "sessionSecret": {
      "type": "securestring",
      "minLength": 32,
      "metadata": {
        "description": "At least 32 characters of random session secret material used to encrypt server-side OAuth sessions."
      }
    },
    "redisConnectionString": {
      "type": "securestring",
      "metadata": {
        "description": "TLS Redis URL, for example rediss://:<access-key>@cache.region.redisenterprise.cache.azure.net:10000/0. Store a rotated value here rather than outputting Redis keys."
      }
    },
    "logAnalyticsWorkspaceResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Log Analytics workspace resource ID for Application Insights. Leave empty to create classic component-only telemetry."
      }
    }
  },
  "variables": {
    "tags": {
      "workload": "gh-aw-cao-dashboard",
      "hostingMode": "azure-functions"
    },
    "githubRedirectUri": "[format('https://{0}.azurewebsites.net/auth/callback', parameters('functionAppName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[parameters('keyVaultName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enabledForTemplateDeployment": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 90,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', parameters('keyVaultName'), 'github-oauth-client-secret')]",
      "properties": {
        "value": "[parameters('githubClientSecret')]",
        "contentType": "GitHub OAuth client secret for CAO dashboard Azure Functions mode"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', parameters('keyVaultName'), 'cao-session-secret')]",
      "properties": {
        "value": "[parameters('sessionSecret')]",
        "contentType": "CAO dashboard session encryption secret"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', parameters('keyVaultName'), 'cao-redis-url')]",
      "properties": {
        "value": "[parameters('redisConnectionString')]",
        "contentType": "CAO dashboard Redis Enterprise rediss URL"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.Cache/redisEnterprise",
      "apiVersion": "2024-11-01",
      "name": "[parameters('redisEnterpriseName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "[parameters('redisSkuName')]",
        "capacity": "[parameters('redisCapacity')]"
      },
      "properties": {
        "minimumTlsVersion": "1.2",
        "publicNetworkAccess": "Disabled"
      }
    },
    {
      "type": "Microsoft.Cache/redisEnterprise/databases",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', parameters('redisEnterpriseName'), 'default')]",
      "properties": {
        "clientProtocol": "Encrypted",
        "clusteringPolicy": "EnterpriseCluster",
        "evictionPolicy": "NoEviction",
        "modules": [
          {
            "name": "RediSearch"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cache/redisEnterprise', parameters('redisEnterpriseName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[parameters('hostingPlanName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "elastic",
      "sku": {
        "name": "EP1",
        "tier": "ElasticPremium"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[format('{0}-ai', parameters('functionAppName'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[if(empty(parameters('logAnalyticsWorkspaceResourceId')), null(), parameters('logAnalyticsWorkspaceResourceId'))]"
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('functionAppName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('hostingPlanName'))]",
        "httpsOnly": true,
        "clientAffinityEnabled": false,
        "siteConfig": {
          "alwaysOn": true,
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "http20Enabled": true,
          "appSettings": [
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "custom"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', format('{0}-ai', parameters('functionAppName'))), '2020-02-02').ConnectionString]"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};EndpointSuffix={1};AccountKey={2}', parameters('storageAccountName'), environment().suffixes.storage, listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-05-01').keys[0].value)]"
            },
            {
              "name": "CAO_DASHBOARD_HOSTING",
              "value": "azure-functions"
            },
            {
              "name": "CAO_AZURE_ALLOWED_HOSTS",
              "value": "[join(parameters('allowedHosts'), ',')]"
            },
            {
              "name": "CAO_AZURE_REQUIRE_HTTPS",
              "value": "true"
            },
            {
              "name": "CAO_REDIS_NAMESPACE",
              "value": "azure-dashboard"
            },
            {
              "name": "CAO_REDIS_URL",
              "value": "[format('@Microsoft.KeyVault(SecretUri={0})', reference(resourceId('Microsoft.KeyVault/vaults/secrets', parameters('keyVaultName'), 'cao-redis-url'), '2023-07-01').secretUriWithVersion)]"
            },
            {
              "name": "CAO_GITHUB_CLIENT_ID",
              "value": "[parameters('githubClientId')]"
            },
            {
              "name": "CAO_GITHUB_CLIENT_SECRET",
              "value": "[format('@Microsoft.KeyVault(SecretUri={0})', reference(resourceId('Microsoft.KeyVault/vaults/secrets', parameters('keyVaultName'), 'github-oauth-client-secret'), '2023-07-01').secretUriWithVersion)]"
            },
            {
              "name": "CAO_GITHUB_REDIRECT_URL",
              "value": "[variables('githubRedirectUri')]"
            },
            {
              "name": "CAO_GITHUB_ALLOWED_ORGS",
              "value": "[join(parameters('githubAllowedOrganizations'), ',')]"
            },
            {
              "name": "CAO_GITHUB_ALLOWED_TEAMS",
              "value": "[join(parameters('githubAllowedTeams'), ',')]"
            },
            {
              "name": "CAO_SESSION_SECRET",
              "value": "[format('@Microsoft.KeyVault(SecretUri={0})', reference(resourceId('Microsoft.KeyVault/vaults/secrets', parameters('keyVaultName'), 'cao-session-secret'), '2023-07-01').secretUriWithVersion)]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults/secrets', parameters('keyVaultName'), 'github-oauth-client-secret')]",
        "[resourceId('Microsoft.Insights/components', format('{0}-ai', parameters('functionAppName')))]",
        "[resourceId('Microsoft.Web/serverfarms', parameters('hostingPlanName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', parameters('keyVaultName'), 'cao-redis-url')]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', parameters('keyVaultName'), 'cao-session-secret')]",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), parameters('functionAppName'), 'Key Vault Secrets User')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6c')]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2023-12-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]",
        "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]"
      ]
    }
  ],
  "outputs": {
    "functionHostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2023-12-01').defaultHostName]"
    },
    "githubOAuthRedirectUri": {
      "type": "string",
      "value": "[variables('githubRedirectUri')]"
    },
    "redisEnterpriseHostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Cache/redisEnterprise', parameters('redisEnterpriseName')), '2024-11-01').hostName]"
    },
    "redisDatabaseName": {
      "type": "string",
      "value": "default"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri]"
    }
  }
}