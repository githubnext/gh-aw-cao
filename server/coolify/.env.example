# Coolify marks a variable Required when compose.yml declares it as ${NAME:?...}.
# Set every value below for each Coolify environment you deploy, including Preview.
# See docs/deployment-coolify.md#setting-the-variables-in-coolify.

CAO_ARTIFACT_VOLUME=cao-dashboard-artifact
CAO_COLLECT_EVIDENCE_VOLUME=cao-collector-evidence

# Non-secret routing settings.
CAO_ALLOWED_HOSTS=dashboard.example.com
CAO_TRUSTED_PROXY_CIDRS=10.42.0.0/24
REDIS_NAMESPACE=coolify-dashboard
CAO_GITHUB_REDIRECT_URL=https://dashboard.example.com/auth/callback
# Set at least one of the two allow lists, or no one can sign in.
CAO_GITHUB_ALLOWED_ORGS=
CAO_GITHUB_ALLOWED_TEAMS=
CAO_GITHUB_ADMIN_USERS=
CAO_MCP_ACTIONS_REPOSITORY=OWNER/REPO
CAO_COLLECT_APP_ID=
CAO_COLLECT_CONTROL_REPOSITORY=OWNER/REPO
# Fail closed if the App is installed on more repositories than intended.
CAO_COLLECT_INVENTORY_LIMIT=
# Optional collection tuning.
CAO_COLLECT_WINDOW_DAYS=30
CAO_COLLECT_RUN_LIMIT=10000
CAO_COLLECT_MAX_STORAGE_MB=1200
CAO_COLLECT_REQUEST_TIMEOUT_MINUTES=10
CAO_COLLECT_RATE_LIMIT_FLOOR=2000
CAO_COLLECT_QUEUE_MAX_LENGTH=200000
CAO_COLLECT_PROJECTION_INTERVAL=5m
CAO_COLLECT_TIMEOUT=30m
CAO_COLLECT_OTEL_SERVICE_NAME=cao-collector
# Optional log download; enabled by default in Coolify.
CAO_SERVER_LOGS_ENABLED=true

# Set these as Coolify secrets, not in this file or repository.
# Generate CAO_SESSION_SECRET and CAO_GITHUB_WEBHOOK_SECRET separately, each with
# at least 32 characters, for example with: openssl rand -hex 32
CAO_POSTGRES_URL=
REDIS_URL=
CAO_GITHUB_CLIENT_ID=
CAO_GITHUB_CLIENT_SECRET_ROTATED=
CAO_SESSION_SECRET_ROTATED=
CAO_SESSION_SECRET_PREVIOUS=
CAO_GITHUB_WEBHOOK_SECRET_ROTATED=
CAO_COLLECT_PRIVATE_KEY_ROTATED=
