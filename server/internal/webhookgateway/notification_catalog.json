      "filters":{
        "number":{"path":["issue","number"],"type":"integer"},
        "labels":{"path":["issue","labels","*","name"],"type":"string"},
        "author":{"path":["comment","user","login"],"type":"string"}
      }
    },
    "pull_request_comment": {
      "native_event":"issue_comment","actions":["created","edited","deleted"],
      "path":"pull","anchor":"issuecomment-","url_path":["comment","html_url"],"issue_kind":"pull_request",
      "filters":{
        "number":{"path":["issue","number"],"type":"integer"},
        "labels":{"path":["issue","labels","*","name"],"type":"string"},
        "author":{"path":["comment","user","login"],"type":"string"}
      }
    },
    "pull_request_review": {
      "native_event":"pull_request_review","actions":["submitted","edited","dismissed"],
      "path":"pull","anchor":"pullrequestreview-","url_path":["review","html_url"],
      "filters":{
        "number":{"path":["pull_request","number"],"type":"integer"},
        "state":{"path":["review","state"],"type":"string","enum":["approved","changes_requested","commented","dismissed","pending"]},
        "author":{"path":["review","user","login"],"type":"string"}
      }
    },
    "pull_request_review_comment": {
      "native_event":"pull_request_review_comment","actions":["created","edited","deleted"],
      "path":"pull","anchor":"discussion_r","url_path":["comment","html_url"],
