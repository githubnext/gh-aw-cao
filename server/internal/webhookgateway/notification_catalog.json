        "number":{"path":["pull_request","number"],"type":"integer"},
        "path":{"path":["comment","path"],"type":"string"},
        "author":{"path":["comment","user","login"],"type":"string"}
      }
    },
    "pull_request_review_thread": {
      "native_event":"pull_request_review_thread","actions":["resolved","unresolved"],
      "path":"pull","anchor":"discussion_r","url_path":["thread","comments","0","html_url"],
