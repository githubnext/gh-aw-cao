      "path":"commit","anchor":"commitcomment-","url_path":["comment","html_url"],
      "filters":{
        "commit":{"path":["comment","commit_id"],"type":"string"},
        "path":{"path":["comment","path"],"type":"string"},
        "author":{"path":["comment","user","login"],"type":"string"}
      }
    }
  }
