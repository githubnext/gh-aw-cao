{
  "common_filters": {
    "sender": {"path":["sender","login"],"type":"string"},
    "organization": {"path":["organization","login"],"type":"string"},
    "repository": {"path":["repository","full_name"],"type":"string"}
  },
  "events": {
    "issues": {
      "native_event":"issues","actions":["opened","edited","deleted","transferred","pinned","unpinned","closed","reopened","assigned","unassigned","labeled","unlabeled","locked","unlocked","milestoned","demilestoned","typed","untyped","field_added","field_removed"],
      "path":"issues","anchor":"","url_path":["issue","html_url"],"issue_kind":"issue",
      "filters":{
        "number":{"path":["issue","number"],"type":"integer"},
        "state":{"path":["issue","state"],"type":"string","enum":["open","closed"]},
        "labels":{"path":["issue","labels","*","name"],"type":"string"},
        "label":{"path":["label","name"],"type":"string","actions":["labeled","unlabeled"]},
        "author":{"path":["issue","user","login"],"type":"string"},
        "assignee":{"path":["issue","assignees","*","login"],"type":"string"}
      }
    },
    "pull_request": {
      "native_event":"pull_request","actions":["assigned","unassigned","labeled","unlabeled","opened","edited","closed","reopened","synchronize","converted_to_draft","locked","unlocked","enqueued","dequeued","milestoned","demilestoned","ready_for_review","review_requested","review_request_removed","auto_merge_enabled","auto_merge_disabled"],
      "path":"pull","anchor":"","url_path":["pull_request","html_url"],
      "filters":{
        "number":{"path":["pull_request","number"],"type":"integer"},
        "state":{"path":["pull_request","state"],"type":"string","enum":["open","closed"]},
        "labels":{"path":["pull_request","labels","*","name"],"type":"string"},
        "label":{"path":["label","name"],"type":"string","actions":["labeled","unlabeled"]},
        "author":{"path":["pull_request","user","login"],"type":"string"},
        "draft":{"path":["pull_request","draft"],"type":"boolean"},
        "merged":{"path":["pull_request","merged"],"type":"boolean"},
        "base":{"path":["pull_request","base","ref"],"type":"string"},
        "head":{"path":["pull_request","head","ref"],"type":"string"}
      }
    },
    "discussion": {
      "native_event":"discussion","actions":["created","edited","deleted","transferred","pinned","unpinned","labeled","unlabeled","locked","unlocked","category_changed","answered","unanswered"],
      "path":"discussions","anchor":"","url_path":["discussion","html_url"],
      "filters":{
        "number":{"path":["discussion","number"],"type":"integer"},
        "category":{"path":["discussion","category","slug"],"type":"string"},
        "labels":{"path":["discussion","labels","*","name"],"type":"string"},
        "label":{"path":["label","name"],"type":"string","actions":["labeled","unlabeled"]},
        "author":{"path":["discussion","user","login"],"type":"string"}
      }
    },
    "issue_comment": {
      "native_event":"issue_comment","actions":["created","edited","deleted"],
