{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "aw-doctor-dashboard",
    "title": "AW Doctor",
    "description": "Track upgrade, compiler-security, and failure-triage activation, durable maintenance issues, and matured resolution evidence.",
    "repository": "githubnext/gh-aw-cao",
    "pages": [
      {
        "id": "aw-doctor-dashboard",
        "kind": "custom",
        "title": "AW Doctor",
        "description": "Track upgrade, compiler-security, and failure-triage activation, durable maintenance issues, and matured resolution evidence.",
        "icon": "gear",
        "views": [
          {
            "id": "aw-doctor-value-trend",
            "title": "Operational-value trend",
            "description": "Mean failure-recovery and clean-scan attainment is diagnostic and does not infer that a worker caused the observed state.",
            "disclosure": "essential",
            "data": {
              "source": "operational-values",
              "time": {
                "range": "90d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/aw-failures-investigator.md",
                  ".github/workflows/aw-maintenance-compiler-security.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "line",
            "encoding": {
              "x": {
                "field": "observed-at",
                "type": "temporal",
                "time-unit": "day"
              },
              "y": {
                "field": "operational-value",
                "type": "quantitative",
                "aggregate": "mean"
              },
              "color": {
                "field": "operational-value-definition",
                "type": "nominal"
              }
            }
          },
          {
            "id": "aw-doctor-runs",
            "title": "Maintenance workflow runs",
            "description": "Answers which AW Doctor failures need attention first; use the run link for detailed evidence.",
            "disclosure": "essential",
            "data": {
              "source": "runs",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/aw-doctor.md",
                  ".github/workflows/aw-maintenance-compiler-security.md",
                  ".github/workflows/aw-maintenance-upgrade.md",
                  ".github/workflows/aw-failures-investigator.md"
                ]
              }
            },
            "mark": "table",
            "controls": "interactive",
            "empty-message": "No AW maintenance workflow runs were observed in the last 30 days.",
            "encoding": {
              "href": {
                "field": "run-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "run",
                  "type": "nominal",
                  "title": "Run"
                },
                {
                  "field": "run-status",
                  "type": "nominal",
                  "title": "Status",
                  "display": "status"
                },
                {
                  "field": "run-conclusion",
                  "type": "nominal",
                  "title": "Conclusion",
                  "display": "status"
                },
                {
                  "field": "organization",
                  "type": "nominal",
                  "title": "Organization"
                },
                {
                  "field": "repository",
                  "type": "nominal",
                  "title": "Repository"
                },
                {
                  "field": "workflow",
                  "type": "nominal",
                  "title": "Workflow"
                },
                {
                  "field": "rollout-mode",
                  "type": "nominal",
                  "title": "Mode",
                  "display": "mode"
                },
                {
                  "field": "engine",
                  "type": "nominal",
                  "title": "Engine"
                },
                {
                  "field": "requested-model",
                  "type": "nominal",
                  "title": "Requested model"
                },
                {
                  "field": "resolved-model",
                  "type": "nominal",
                  "title": "Resolved model"
                },
                {
                  "field": "started-at",
                  "type": "temporal",
                  "title": "Started"
                }
              ]
            }
          },
          {
            "id": "aw-doctor-outcomes",
            "title": "Upgrade, compiler-security, and failure-triage issues",
            "description": "Retained maintenance outputs identify actionable upgrades, compiler-security findings, or investigated failures; clean repositories may correctly produce no output.",
            "disclosure": "supplemental",
            "data": {
              "source": "outcomes",
              "filters": {
                "package": [
                  "aw-doctor"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "empty-message": "No AW maintenance outputs were retained.",
            "encoding": {
              "href": {
                "field": "external-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "outcome-title",
                  "type": "nominal",
                  "title": "Maintenance output"
                },
                {
                  "field": "outcome-state",
                  "type": "nominal",
                  "title": "Disposition",
                  "display": "status"
                },
                {
                  "field": "published-at",
                  "type": "temporal",
                  "title": "Published"
                }
              ]
            }
          },
          {
            "id": "aw-doctor-attainment",
            "title": "Maintenance attainment evidence",
            "description": "Failure-recovery and compiler-security observations preserve maturity and evidence cutoffs; unavailable or incomplete evidence is not scored as zero.",
            "disclosure": "supplemental",
            "data": {
              "source": "operational-values",
              "filters": {
                "workflow": [
                  ".github/workflows/aw-failures-investigator.md",
                  ".github/workflows/aw-maintenance-compiler-security.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "empty-message": "No AW maintenance attainment evidence is available.",
            "encoding": {
              "href": {
                "field": "evidence-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "operational-case",
                  "type": "nominal",
                  "title": "Opportunity"
                },
                {
                  "field": "operational-value",
                  "type": "quantitative",
                  "title": "Attainment"
                },
                {
                  "field": "maturity-status",
                  "type": "nominal",
                  "title": "Maturity",
                  "display": "status"
                },
                {
                  "field": "evidence-cutoff",
                  "type": "temporal",
                  "title": "Evidence cutoff"
                }
              ]
            }
          }
        ]
      }
    ],
    "navigation": [
      {
        "label": "Package operations",
        "experimental": true,
        "pages": [
          "aw-doctor-dashboard"
        ]
      }
    ]
  }
}
