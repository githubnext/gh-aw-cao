{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "optimization-dashboard",
    "title": "AW Optimization",
    "description": "Track AI Credit and ambient context optimization runs, retained recommendations, and matured accuracy and efficiency evidence.",
    "repository": "githubnext/gh-aw-cao",
    "pages": [
      {
        "id": "optimization-dashboard",
        "kind": "custom",
        "title": "AW Optimization",
        "description": "Track AI Credit and ambient context optimization runs, retained recommendations, and matured accuracy and efficiency evidence.",
        "icon": "meter",
        "views": [
          {
            "id": "optimization-runs",
            "title": "AW Optimization runs by conclusion",
            "disclosure": "essential",
            "data": {
              "source": "runs",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/optimization.md",
                  ".github/workflows/optimization-ai-credit-auditor.md",
                  ".github/workflows/optimization-ai-credit-optimizer.md",
                  ".github/workflows/optimization-agents-md-curator.md",
                  ".github/workflows/optimization-skills-curator.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "pie",
            "encoding": {
              "x": {
                "field": "run-conclusion",
                "type": "nominal"
              },
              "y": {
                "field": "run",
                "type": "quantitative",
                "aggregate": "count"
              }
            }
          },
          {
            "id": "optimization-outcomes",
            "title": "Audit and optimization outputs",
            "description": "Retained snapshots and recommendations expose repository evidence without treating a recommendation as realized savings or context improvement.",
            "disclosure": "essential",
            "data": {
              "source": "outcomes",
              "filters": {
                "package": [
                  "optimization"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "empty-message": "No optimization outputs were retained.",
            "encoding": {
              "href": {
                "field": "external-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "outcome-title",
                  "type": "nominal",
                  "title": "Audit or recommendation"
                },
                {
                  "field": "outcome-state",
                  "type": "nominal",
                  "title": "Disposition",
                  "display": "status"
                },
                {
                  "field": "published-at",
                  "type": "temporal",
                  "title": "Published"
                }
              ]
            }
          },
          {
            "id": "optimization-attainment",
            "title": "Accuracy and efficiency evidence",
            "description": "AI Credit and ambient context evidence matures on each worker's frozen evaluation schedule.",
            "disclosure": "supplemental",
            "data": {
              "source": "operational-values",
              "filters": {
                "workflow": [
                  ".github/workflows/optimization-ai-credit-auditor.md",
                  ".github/workflows/optimization-ai-credit-optimizer.md",
                  ".github/workflows/optimization-agents-md-curator.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "empty-message": "No optimization attainment evidence is available.",
            "encoding": {
              "href": {
                "field": "evidence-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "operational-value-definition",
                  "type": "nominal",
                  "title": "Evaluator"
                },
                {
                  "field": "operational-case",
                  "type": "nominal",
                  "title": "Opportunity"
                },
                {
                  "field": "operational-value",
                  "type": "quantitative",
                  "title": "Attainment"
                },
                {
                  "field": "maturity-status",
                  "type": "nominal",
                  "title": "Maturity",
                  "display": "status"
                },
                {
                  "field": "evidence-cutoff",
                  "type": "temporal",
                  "title": "Evidence cutoff"
                }
              ]
            }
          },
          {
            "id": "optimization-value-trend",
            "title": "Operational-value trend",
            "description": "AI Credit and ambient context attainment remain separate evaluator series and are not inferred from activity totals alone.",
            "disclosure": "essential",
            "data": {
              "source": "operational-values",
              "time": {
                "range": "90d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/optimization-ai-credit-auditor.md",
                  ".github/workflows/optimization-ai-credit-optimizer.md",
                  ".github/workflows/optimization-agents-md-curator.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "line",
            "encoding": {
              "x": {
                "field": "observed-at",
                "type": "temporal",
                "time-unit": "day"
              },
              "y": {
                "field": "operational-value",
                "type": "quantitative",
                "aggregate": "mean"
              },
              "color": {
                "field": "operational-value-definition",
                "type": "nominal"
              }
            }
          }
        ]
      }
    ],
    "navigation": [
      {
        "label": "Package operations",
        "experimental": true,
        "pages": [
          "optimization-dashboard"
        ]
      }
    ]
  }
}
