  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "engines-models-usage",
      "intent": "Summarize run-level AIC and token usage by agent and model identifiers without treating unavailable telemetry as zero.",
      "description": "Observed workflow runs grouped by agent ID and model ID. Each AIC and token statistic uses only runs that reported that metric.",
      "from": "runs",
      "compute": [
        {
          "as": "summary",
          "function": "concat",
          "args": [
            {
              "field": "agent-id"
            },
            {
              "value": " / "
            },
            {
              "field": "model-id"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "summary"
        ],
        "values": [
          {
            "field": "run",
            "as": "runs",
            "reducer": "count"
          },
          {
            "field": "aic-total",
            "as": "minimum-aic-per-run",
            "reducer": "min"
          },
          {
            "field": "aic-total",
            "as": "average-aic-per-run",
            "reducer": "mean"
          },
          {
            "field": "aic-total",
            "as": "maximum-aic-per-run",
            "reducer": "max"
          },
          {
            "field": "input-tokens",
            "as": "minimum-input-tokens-per-run",
            "reducer": "min"
          },
          {
            "field": "input-tokens",
            "as": "average-input-tokens-per-run",
            "reducer": "mean"
          },
          {
            "field": "input-tokens",
            "as": "maximum-input-tokens-per-run",
            "reducer": "max"
          },
          {
            "field": "output-tokens",
            "as": "minimum-output-tokens-per-run",
            "reducer": "min"
          },
          {
            "field": "output-tokens",
            "as": "average-output-tokens-per-run",
            "reducer": "mean"
          },
          {
            "field": "output-tokens",
            "as": "maximum-output-tokens-per-run",
            "reducer": "max"
          },
          {
            "field": "cache-read-tokens",
            "as": "minimum-cache-read-tokens-per-run",
            "reducer": "min"
          },
          {
            "field": "cache-read-tokens",
            "as": "average-cache-read-tokens-per-run",
            "reducer": "mean"
          },
          {
            "field": "cache-read-tokens",
            "as": "maximum-cache-read-tokens-per-run",
            "reducer": "max"
          },
          {
            "field": "cache-write-tokens",
            "as": "minimum-cache-write-tokens-per-run",
            "reducer": "min"
          },
          {
            "field": "cache-write-tokens",
            "as": "average-cache-write-tokens-per-run",
            "reducer": "mean"
          },
          {
            "field": "cache-write-tokens",
            "as": "maximum-cache-write-tokens-per-run",
            "reducer": "max"
          },
          {
            "field": "reasoning-tokens",
            "as": "minimum-reasoning-tokens-per-run",
            "reducer": "min"
          },
          {
            "field": "reasoning-tokens",
            "as": "average-reasoning-tokens-per-run",
            "reducer": "mean"
          },
          {
            "field": "reasoning-tokens",
            "as": "maximum-reasoning-tokens-per-run",
            "reducer": "max"
          }
        ]
      },
      "select": [
        {
          "field": "summary"
        },
        {
          "field": "runs"
        },
        {
          "field": "average-aic-per-run"
        },
        {
          "field": "minimum-aic-per-run"
        },
        {
          "field": "maximum-aic-per-run"
        },
        {
          "field": "minimum-input-tokens-per-run"
        },
        {
          "field": "average-input-tokens-per-run"
        },
        {
          "field": "maximum-input-tokens-per-run"
        },
        {
          "field": "minimum-output-tokens-per-run"
        },
        {
          "field": "average-output-tokens-per-run"
        },
        {
          "field": "maximum-output-tokens-per-run"
        },
        {
          "field": "minimum-cache-read-tokens-per-run"
        },
        {
          "field": "average-cache-read-tokens-per-run"
        },
        {
          "field": "maximum-cache-read-tokens-per-run"
        },
        {
          "field": "minimum-cache-write-tokens-per-run"
        },
        {
          "field": "average-cache-write-tokens-per-run"
        },
        {
          "field": "maximum-cache-write-tokens-per-run"
        },
        {
          "field": "minimum-reasoning-tokens-per-run"
        },
        {
          "field": "average-reasoning-tokens-per-run"
        },
        {
          "field": "maximum-reasoning-tokens-per-run"
        }
      ],
      "order-by": [
        {
          "field": "runs",
          "direction": "desc"
        },
        {
          "field": "summary",
          "direction": "asc"
        }
      ]
    }
  ]
}
