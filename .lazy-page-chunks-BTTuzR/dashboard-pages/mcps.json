{
  "page": {
    "id": "mcps",
    "kind": "custom",
    "title": "MCP activity",
    "navigation-label": "MCPs",
    "icon": "mcp",
    "class-name": "mcps-page",
    "description": "Diagnose MCP tool reliability across agentic workflow runs.",
    "views": [
      {
        "id": "mcp-top-tools",
        "title": "Top MCP tools",
        "description": "The ten most frequently called MCP tools, excluding the internal safe outputs server.",
        "data": {
          "source": "mcp-top-tools"
        },
        "mark": "chart",
        "chart": "pie",
        "layout": "full",
        "empty-message": "No MCP tool activity was observed.",
        "encoding": {
          "x": {
            "field": "mcp-tool-label",
            "type": "nominal",
            "title": "MCP tool"
          },
          "y": {
            "field": "calls",
            "type": "quantitative",
            "title": "Calls"
          }
        }
      },
      {
        "id": "mcp-tool-inventory",
        "title": "MCP tools",
        "description": "Observed MCP activity grouped by tool, excluding the internal safe outputs server.",
        "data": {
          "source": "mcp-tool-totals"
        },
        "mark": "table",
        "controls": "interactive",
        "lazy-list": true,
        "empty-message": "No MCP tool activity was observed.",
        "layout": "full-view",
        "encoding": {
          "columns": [
            {
              "field": "mcp-tool-label",
              "type": "nominal",
              "title": "MCP tool"
            },
            {
              "field": "mcp-server",
              "type": "nominal",
              "title": "MCP server"
            },
            {
              "field": "calls",
              "type": "quantitative",
              "title": "Calls"
            },
            {
              "field": "workflows",
              "type": "quantitative",
              "title": "Workflows"
            },
            {
              "field": "request-bytes",
              "type": "quantitative",
              "title": "Request bytes"
            },
            {
              "field": "response-bytes",
              "type": "quantitative",
              "title": "Response bytes"
            }
          ]
        }
      }
    ]
  },
  "queries": [
    {
      "name": "mcp-tool-calls",
      "intent": "Prepare MCP tool calls for aggregation while excluding calls to the safe outputs server.",
      "description": "Observed MCP tool calls labeled with whether they belong to the internal safe outputs server.",
      "from": "mcp-calls",
      "compute": [
        {
          "as": "safe-output-server",
          "function": "equals-any",
          "args": [
            {
              "field": "mcp-server"
            },
            {
              "value": "safe_outputs"
            }
          ]
        },
        {
          "as": "mcp-tool-label",
          "function": "concat",
          "args": [
            {
              "field": "mcp-server"
            },
            {
              "value": "/"
            },
            {
              "field": "mcp-tool"
            }
          ]
        },
        {
          "as": "workflow-key",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            },
            {
              "value": ":"
            },
            {
              "field": "workflow"
            }
          ]
        }
      ]
    },
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "mcp-tool-totals",
      "intent": "Group observed MCP activity by tool and count calls and calling workflows, excluding the internal safe outputs server.",
      "description": "Observed MCP tool-call totals grouped by MCP server and tool, with the number of distinct calling workflows.",
      "from": "mcp-tool-calls",
      "filter": {
        "predicates": [
          {
            "field": "safe-output-server",
            "equals": false
          }
        ]
      },
      "aggregate": {
        "by": [
          "mcp-tool-label",
          "mcp-server",
          "mcp-tool"
        ],
        "values": [
          {
            "field": "mcp-observation",
            "as": "calls",
            "reducer": "count"
          },
          {
            "field": "workflow-key",
            "as": "workflows",
            "reducer": "distinct-count"
          },
          {
            "field": "request-bytes",
            "as": "request-bytes",
            "reducer": "sum"
          },
          {
            "field": "response-bytes",
            "as": "response-bytes",
            "reducer": "sum"
          }
        ]
      },
      "select": [
        {
          "field": "mcp-tool-label"
        },
        {
          "field": "mcp-tool"
        },
        {
          "field": "mcp-server"
        },
        {
          "field": "calls"
        },
        {
          "field": "workflows"
        },
        {
          "field": "request-bytes"
        },
        {
          "field": "response-bytes"
        }
      ],
      "order-by": [
        {
          "field": "calls",
          "direction": "desc"
        },
        {
          "field": "mcp-tool-label",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "mcp-top-tools",
      "intent": "Show the ten most frequently called MCP tools.",
      "description": "The ten MCP tools with the most observed calls, excluding the internal safe outputs server.",
      "from": "mcp-tool-totals",
      "order-by": [
        {
          "field": "calls",
          "direction": "desc"
        },
        {
          "field": "mcp-tool-label",
          "direction": "asc"
        }
      ],
      "limit": 10
    }
  ]
}
