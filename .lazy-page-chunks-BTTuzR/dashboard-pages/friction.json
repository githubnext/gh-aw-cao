{
  "page": {
    "id": "friction",
    "kind": "custom",
    "title": "Friction",
    "navigation-label": "Friction",
    "icon": "pulse",
    "experimental": true,
    "description": "Avoidable execution cost attributed by gh aw audit across observed workflow runs.",
    "views": [
      {
        "id": "friction-by-workflow",
        "title": "Friction cost by workflow",
        "description": "The share of measured avoidable AI Credit cost attributed to each workflow.",
        "data": {
          "source": "friction-by-workflow",
          "limit": 10
        },
        "mark": "chart",
        "chart": "pie",
        "layout": "full",
        "empty-message": "No gh-aw audit friction measurements were observed.",
        "encoding": {
          "x": {
            "field": "workflow-coordinate",
            "type": "nominal",
            "title": "Workflow"
          },
          "y": {
            "field": "friction-aic",
            "type": "quantitative",
            "title": "Friction AIC",
            "unit": "aic"
          }
        }
      },
      {
        "id": "friction-observations",
        "title": "Friction observations",
        "description": "Run-level gh-aw audit measurements, including attribution coverage and native friction ratio.",
        "data": {
          "source": "friction-observations",
          "limit": 100
        },
        "mark": "table",
        "controls": "interactive",
        "lazy-list": true,
        "column-summaries": true,
        "layout": "full-view",
        "empty-message": "No gh-aw audit friction measurements were observed.",
        "encoding": {
          "columns": [
            {
              "field": "observed-at",
              "type": "temporal",
              "title": "Observed",
              "format": "human-friendly-timestamp"
            },
            {
              "field": "repository-coordinate",
              "type": "nominal",
              "title": "Repository"
            },
            {
              "field": "workflow",
              "type": "nominal",
              "title": "Workflow",
              "format": "workflow-relative-path"
            },
            {
              "field": "run",
              "type": "nominal",
              "title": "Run",
              "display": "run-link"
            },
            {
              "field": "measurement-state",
              "type": "nominal",
              "title": "Measurement",
              "display": "status"
            },
            {
              "field": "aic",
              "type": "quantitative",
              "title": "Friction AIC",
              "unit": "aic"
            },
            {
              "field": "total-run-aic",
              "type": "quantitative",
              "title": "Run AIC",
              "unit": "aic"
            },
            {
              "field": "friction-percent",
              "type": "nominal",
              "title": "Friction ratio"
            },
            {
              "field": "counted-occurrences",
              "type": "quantitative",
              "title": "Counted"
            },
            {
              "field": "suppressed-occurrences",
              "type": "quantitative",
              "title": "Suppressed"
            },
            {
              "field": "unattributed-occurrences",
              "type": "quantitative",
              "title": "Unattributed"
            }
          ]
        }
      }
    ]
  },
  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "friction-by-workflow",
      "intent": "Identify workflows with the greatest measured avoidable AI Credit cost.",
      "description": "Total gh-aw audit friction cost grouped by repository and workflow.",
      "from": "friction",
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "workflow-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            },
            {
              "value": ":"
            },
            {
              "field": "workflow"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "workflow-coordinate",
          "repository-coordinate",
          "workflow"
        ],
        "values": [
          {
            "field": "aic",
            "as": "friction-aic",
            "reducer": "sum"
          },
          {
            "field": "run",
            "as": "runs",
            "reducer": "distinct-count"
          }
        ]
      },
      "order-by": [
        {
          "field": "friction-aic",
          "direction": "desc"
        },
        {
          "field": "workflow-coordinate",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "friction-observations",
      "intent": "List retained gh-aw audit friction measurements with their run context and attribution totals.",
      "description": "Newest friction measurements first, preserving the native audit values and uncertainty state.",
      "from": "friction",
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "friction-percent",
          "function": "format-percent",
          "args": [
            {
              "field": "friction-ratio"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "event-timestamp",
          "as": "observed-at"
        },
        {
          "field": "repository-coordinate"
        },
        {
          "field": "workflow"
        },
        {
          "field": "run"
        },
        {
          "field": "run-link"
        },
        {
          "field": "measurement-state"
        },
        {
          "field": "aic"
        },
        {
          "field": "total-run-aic"
        },
        {
          "field": "friction-percent"
        },
        {
          "field": "counted-occurrences"
        },
        {
          "field": "suppressed-occurrences"
        },
        {
          "field": "unattributed-occurrences"
        }
      ],
      "order-by": [
        {
          "field": "observed-at",
          "direction": "desc"
        },
        {
          "field": "run",
          "direction": "desc"
        }
      ]
    }
  ]
}
