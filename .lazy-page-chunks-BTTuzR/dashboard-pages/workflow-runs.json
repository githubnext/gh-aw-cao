{
  "page": {
    "id": "workflow-runs",
    "kind": "custom",
    "title": "Workflow runs",
    "description": "Observed GitHub Actions runs for this authored workflow.",
    "icon": "play",
    "class-name": "workflow-runs-page",
    "route": {
      "hash-query-parameter": "workflow"
    },
    "views": [
      {
        "id": "workflow-run-health",
        "title": "Run health trend",
        "description": "Daily conclusions show this workflow's execution health at a glance.",
        "data": {
          "source": "workflow-runs",
          "route-field": "workflow-route"
        },
        "mark": "chart",
        "chart": "line",
        "layout": "full",
        "encoding": {
          "x": {
            "field": "started-at",
            "type": "temporal",
            "format": "human-friendly-timestamp",
            "time-unit": "day"
          },
          "y": {
            "field": "run",
            "type": "quantitative",
            "aggregate": "count"
          },
          "color": {
            "field": "run-conclusion",
            "type": "nominal"
          }
        }
      },
      {
        "id": "workflow-runs-route",
        "title": "Workflow runs",
        "data": {
          "sources": [
            "workflows"
          ]
        },
        "mark": "element",
        "element": "workflow-route-page",
        "config": {
          "body": "runs"
        },
        "layout": "full"
      },
      {
        "id": "workflow-runs-table",
        "disclosure-label": "Runs",
        "description": "Answers which recent workflow runs succeeded, failed, or remain in progress.",
        "data": {
          "source": "workflow-runs",
          "route-field": "workflow-route"
        },
        "mark": "table",
        "disclosure": "supplemental",
        "controls": "static",
        "empty-message": "No runs have been observed for this workflow.",
        "encoding": {
          "columns": [
            {
              "field": "run",
              "type": "nominal",
              "title": "Run"
            },
            {
              "field": "run-status",
              "type": "nominal",
              "title": "Status",
              "display": "status"
            },
            {
              "field": "run-conclusion",
              "type": "nominal",
              "title": "Conclusion",
              "display": "status"
            },
            {
              "field": "rollout-mode",
              "type": "nominal",
              "title": "Mode",
              "display": "mode"
            }
          ],
          "href": {
            "field": "run-link",
            "type": "nominal"
          },
          "actions": [
            {
              "intent": "Open the precise GitHub Actions run page without executing an action.",
              "presentation": "external-link",
              "icon": "mark-github",
              "label": "Open run on GitHub",
              "context": [
                "run-link"
              ]
            }
          ]
        },
        "layout": "full"
      },
      {
        "id": "workflow-run-details",
        "disclosure-label": "Run details",
        "description": "Supplemental metadata for deeper evidence review after the run-status table answers the current state.",
        "disclosure": "supplemental",
        "data": {
          "source": "workflow-runs",
          "route-field": "workflow-route"
        },
        "mark": "table",
        "controls": "static",
        "empty-message": "No runs have been observed for this workflow.",
        "encoding": {
          "columns": [
            {
              "field": "run",
              "type": "nominal",
              "title": "Run"
            },
            {
              "field": "run-title",
              "type": "nominal",
              "title": "Title"
            },
            {
              "field": "event",
              "type": "nominal",
              "title": "Trigger"
            },
            {
              "field": "engine",
              "type": "nominal",
              "title": "Engine"
            },
            {
              "field": "gh-aw-version",
              "type": "nominal",
              "title": "gh-aw version"
            },
            {
              "field": "requested-model",
              "type": "nominal",
              "title": "Requested model"
            },
            {
              "field": "resolved-model",
              "type": "nominal",
              "title": "Resolved model"
            },
            {
              "field": "started-at",
              "type": "temporal",
              "format": "human-friendly-timestamp",
              "title": "Started"
            },
            {
              "field": "ended-at",
              "type": "temporal",
              "format": "human-friendly-timestamp",
              "title": "Ended"
            }
          ],
          "actions": [
            {
              "action": "create-agent-task",
              "intent": "Investigate this failed workflow run.",
              "presentation": "copy-prompt",
              "icon": "search",
              "label": "Investigate",
              "context": [
                "run",
                "run-title",
                "repository",
                "workflow",
                "run-conclusion",
                "failure-job",
                "failure-message",
                "failure-step",
                "run-link"
              ],
              "when": {
                "field": "run-conclusion",
                "equals": "failure"
              }
            }
          ],
          "href": {
            "field": "run-link",
            "type": "nominal"
          }
        },
        "layout": "full"
      }
    ]
  },
  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "workflow-runs",
      "intent": "Project canonical runs into route-addressable workflow run evidence.",
      "description": "Workflow runs with a stable repository and workflow route key.",
      "from": "runs",
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "workflow-route",
          "function": "concat",
          "args": [
            {
              "field": "repository-coordinate"
            },
            {
              "value": ":"
            },
            {
              "field": "workflow"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "workflow-route"
        },
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "workflow"
        },
        {
          "field": "run"
        },
        {
          "field": "run-title"
        },
        {
          "field": "event"
        },
        {
          "field": "started-at"
        },
        {
          "field": "ended-at"
        },
        {
          "field": "run-status"
        },
        {
          "field": "run-conclusion"
        },
        {
          "field": "failure-job"
        },
        {
          "field": "failure-message"
        },
        {
          "field": "failure-step"
        },
        {
          "field": "failure-log"
        },
        {
          "field": "rollout-mode"
        },
        {
          "field": "engine"
        },
        {
          "field": "engine-version"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "requested-model"
        },
        {
          "field": "resolved-model"
        },
        {
          "field": "run-link"
        }
      ],
      "order-by": [
        {
          "field": "started-at",
          "direction": "desc"
        },
        {
          "field": "run",
          "direction": "desc"
        }
      ]
    }
  ]
}
