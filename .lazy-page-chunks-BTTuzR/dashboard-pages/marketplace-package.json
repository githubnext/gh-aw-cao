{
  "page": {
    "id": "marketplace-package",
    "kind": "custom",
    "title": "Package",
    "icon": "archive",
    "class-name": "marketplace-detail-page",
    "description": "Review normalized package metadata and copy the canonical CAO add command.",
    "route": {
      "hash-query-parameter": "package-source",
      "navigation-page": "marketplace"
    },
    "views": [
      {
        "id": "marketplace-package-detail",
        "title": "Package details",
        "data": {
          "source": "marketplace-package-detail",
          "arguments": [
            {
              "name": "package-source",
              "field": "package-source"
            }
          ]
        },
        "mark": "list",
        "list": {
          "style": "entity-cards",
          "appearance": "marketplace",
          "icon": "archive",
          "card": "marketplace-package"
        },
        "encoding": {
          "columns": [
            {
              "field": "package-name",
              "type": "nominal",
              "title": "Package"
            },
            {
              "field": "package-source",
              "type": "nominal",
              "title": "Source"
            },
            {
              "field": "package-contents",
              "type": "nominal",
              "title": "Contents"
            }
          ]
        },
        "layout": "full",
        "empty-message": "The selected package is unavailable."
      },
      {
        "id": "marketplace-package-readme",
        "title": "README",
        "data": {
          "sources": [
            "marketplace-package-detail"
          ],
          "arguments": [
            {
              "name": "package-source",
              "field": "package-source"
            }
          ]
        },
        "mark": "element",
        "element": "markdown",
        "config": {
          "content-field": "package-readme",
          "path-field": "package-readme-path",
          "empty-message": "This package does not publish a README."
        },
        "layout": "full"
      },
      {
        "id": "marketplace-package-about",
        "title": "About",
        "data": {
          "source": "marketplace-package-detail",
          "arguments": [
            {
              "name": "package-source",
              "field": "package-source"
            }
          ]
        },
        "mark": "list",
        "list": {
          "style": "entity-cards",
          "appearance": "grouped",
          "icon": "info",
          "card": "marketplace-package-about"
        },
        "encoding": {
          "columns": [
            {
              "field": "publisher",
              "type": "nominal",
              "title": "By"
            },
            {
              "field": "registry-name",
              "type": "nominal",
              "title": "Registry"
            },
            {
              "field": "package-version",
              "type": "nominal",
              "title": "Version"
            }
          ]
        },
        "layout": "full",
        "empty-message": "The selected package is unavailable."
      }
    ],
    "sections": [
      {
        "id": "package",
        "title": "Package",
        "layout": "full",
        "views": [
          "marketplace-package-detail"
        ]
      },
      {
        "id": "readme",
        "title": "README",
        "layout": "wide",
        "views": [
          "marketplace-package-readme"
        ]
      },
      {
        "id": "about",
        "title": "About",
        "layout": "narrow",
        "views": [
          "marketplace-package-about"
        ]
      }
    ]
  },
  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "marketplace-package-detail",
      "intent": "Select one normalized marketplace package by its resolver-produced source coordinate.",
      "from": "marketplace-packages"
    }
  ]
}
