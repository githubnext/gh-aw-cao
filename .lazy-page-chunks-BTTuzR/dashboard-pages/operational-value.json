{
  "page": {
    "id": "operational-value",
    "kind": "built-in",
    "page": "operational-value",
    "title": "Operational Value",
    "description": "Computed package-defined operational value for each repository.",
    "icon": "graph",
    "class-name": "value-page",
    "definition": {
      "data-state": {
        "availability": true
      },
      "views": [
        {
          "id": "operational-value-history",
          "title": "Operational value over time",
          "description": "Each line tracks one package-defined value ID across retained repository observations.",
          "data": {
            "source": "operational-values"
          },
          "mark": "chart",
          "chart": "line",
          "layout": "full",
          "empty-message": "No operational-value observations are available.",
          "encoding": {
            "x": {
              "field": "observed-at",
              "type": "temporal",
              "format": "human-friendly-timestamp",
              "time-unit": "day",
              "title": "Observed"
            },
            "y": {
              "field": "operational-value",
              "type": "quantitative",
              "aggregate": "mean",
              "title": "Operational value"
            },
            "color": {
              "field": "operational-value-definition",
              "type": "nominal",
              "title": "Value ID"
            }
          }
        },
        {
          "id": "operational-value-observations",
          "description": "Time-ordered computed values with their repository and campaign context.",
          "data": {
            "source": "operational-values",
            "order-by": [
              {
                "field": "observed-at",
                "direction": "desc"
              }
            ],
            "limit": 100
          },
          "mark": "table",
          "controls": "interactive",
          "layout": "full-view",
          "empty-message": "No operational-value observations are available.",
          "encoding": {
            "columns": [
              {
                "field": "observed-at",
                "type": "temporal",
                "title": "Observed",
                "format": "human-friendly-timestamp"
              },
              {
                "field": "operational-value-definition",
                "type": "nominal",
                "title": "Value ID"
              },
              {
                "field": "operational-value",
                "type": "quantitative",
                "title": "Value"
              },
              {
                "field": "repository",
                "type": "nominal",
                "title": "Repository",
                "display": "repository-link"
              },
              {
                "field": "campaign",
                "type": "nominal",
                "title": "Campaign"
              }
            ]
          },
          "lazy-list": true
        }
      ],
      "sections": [
        {
          "id": "insights",
          "title": "Insights",
          "description": "Trends in computed operational value by value ID.",
          "layout": "full",
          "views": [
            "operational-value-history"
          ]
        },
        {
          "id": "observations",
          "title": "Observations",
          "description": "The retained evidence behind the operational-value trends.",
          "layout": "full",
          "views": [
            "operational-value-observations"
          ]
        }
      ]
    }
  },
  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    }
  ]
}
