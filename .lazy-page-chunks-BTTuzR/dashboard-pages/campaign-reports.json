{
  "page": {
    "id": "campaign-reports",
    "kind": "custom",
    "title": "Campaign",
    "description": "Operational activity for this campaign.",
    "icon": "goal",
    "class-name": "campaign-reports-page",
    "route": {
      "hash-query-parameter": "campaign",
      "title-format": "title-case",
      "tabs-class-name": "campaign-tabs",
      "tabs": [
        {
          "id": "insights",
          "label": "Operational Value",
          "icon": "graph",
          "page": "campaign-insights"
        },
        {
          "id": "problems",
          "label": "Failures",
          "icon": "alert",
          "page": "campaign-problems"
        },
        {
          "id": "issues",
          "label": "Reports",
          "icon": "issue-opened",
          "page": "campaign-issues"
        },
        {
          "id": "memory",
          "label": "Memory",
          "icon": "archive",
          "page": "campaign-memory"
        }
      ]
    },
    "views": [
      {
        "id": "campaign-report-status",
        "title": "Report status",
        "description": "The disposition of durable outputs is the leading outcome signal for this campaign.",
        "data": {
          "source": "campaign-reports",
          "route-field": "campaign"
        },
        "mark": "chart",
        "chart": "pie",
        "layout": "full",
        "encoding": {
          "x": {
            "field": "outcome-status",
            "type": "nominal",
            "title": "Status"
          },
          "y": {
            "field": "safe-output",
            "type": "quantitative",
            "aggregate": "count",
            "title": "Reports"
          }
        }
      },
      {
        "id": "campaign-report-navigation",
        "title": "Campaign reports",
        "data": {
          "sources": [
            "workflows"
          ]
        },
        "mark": "element",
        "element": "campaign-route",
        "layout": "full",
        "config": {
          "body": "reports"
        }
      },
      {
        "id": "campaign-report-table",
        "data": {
          "source": "campaign-reports",
          "route-field": "campaign"
        },
        "mark": "table",
        "controls": "interactive",
        "empty-message": "No reports have been attributed to this campaign.",
        "encoding": {
          "columns": [
            {
              "field": "outcome-title",
              "type": "nominal",
              "title": "Report",
              "display": "outcome-link"
            },
            {
              "field": "outcome-status",
              "type": "nominal",
              "title": "Status",
              "display": "status"
            },
            {
              "field": "rollout-mode",
              "type": "nominal",
              "title": "Mode",
              "display": "mode"
            },
            {
              "field": "outcome-category",
              "type": "nominal",
              "title": "Type"
            },
            {
              "field": "observed-at",
              "type": "temporal",
              "format": "human-friendly-timestamp",
              "title": "Updated"
            }
          ]
        },
        "layout": "full"
      }
    ]
  },
  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "campaign-reports",
      "intent": "Project retained outcomes into campaign-addressable report evidence.",
      "description": "Campaign outcome reports with database-backed disposition fields.",
      "from": "outcomes",
      "compute": [
        {
          "as": "report-status",
          "function": "coalesce",
          "args": [
            {
              "field": "outcome-status"
            },
            {
              "field": "outcome-state"
            },
            {
              "value": "unknown"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "campaign"
        },
        {
          "field": "safe-output"
        },
        {
          "field": "outcome-title"
        },
        {
          "field": "outcome-summary"
        },
        {
          "field": "report-status",
          "as": "outcome-status"
        },
        {
          "field": "rollout-mode"
        },
        {
          "field": "engine"
        },
        {
          "field": "engine-version"
        },
        {
          "field": "requested-model"
        },
        {
          "field": "resolved-model"
        },
        {
          "field": "outcome-category"
        },
        {
          "field": "observed-at"
        },
        {
          "field": "external-link"
        }
      ],
      "order-by": [
        {
          "field": "observed-at",
          "direction": "desc"
        },
        {
          "field": "outcome-title",
          "direction": "asc"
        }
      ]
    }
  ]
}
