{
  "page": {
    "id": "notifications",
    "kind": "custom",
    "class-name": "notifications-page",
    "title": "Notifications",
    "navigation-label": "Notifications",
    "icon": "bell",
    "description": "Grouped repeated workflow failures and unresolved outputs explicitly awaiting human review in the selected snapshot horizon.",
    "route": {
      "navigation-page": "overview"
    },
    "views": [
      {
        "id": "notifications-list",
        "title": "Notifications",
        "description": "Open the retained GitHub evidence to investigate or complete the indicated review. Opening a link does not execute an action.",
        "data": {
          "source": "overview-needs-attention"
        },
        "mark": "list",
        "list": {
          "style": "entity-cards",
          "appearance": "grouped",
          "card": "attention-signal",
          "icon": "bell",
          "drill": {
            "type": "external",
            "field": "evidence-link"
          }
        },
        "empty-message": "No notifications require attention.",
        "layout": "full-view",
        "encoding": {
          "columns": [
            {
              "field": "title",
              "type": "nominal",
              "title": "Signal"
            },
            {
              "field": "kind",
              "type": "nominal",
              "title": "Kind"
            },
            {
              "field": "scope",
              "type": "nominal",
              "title": "Scope"
            },
            {
              "field": "reason",
              "type": "nominal",
              "title": "Reason"
            },
            {
              "field": "action",
              "type": "nominal",
              "title": "Next step"
            },
            {
              "field": "observed-at",
              "type": "temporal",
              "title": "Observed",
              "format": "human-friendly-timestamp"
            },
            {
              "field": "evidence-link",
              "type": "nominal",
              "title": "Evidence"
            }
          ]
        }
      }
    ]
  },
  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "failure-run-base",
      "intent": "Reuse shared query stages for failed-runs, overview-failing-runs",
      "from": "runs",
      "filter": {
        "predicates": [
          {
            "field": "run-conclusion",
            "in": [
              "failure",
              "startup-failure",
              "stale",
              "timed-out"
            ]
          }
        ]
      }
    },
    {
      "name": "overview-failing-runs",
      "intent": "Identify failed runs in the selected snapshot horizon so subsequent streak logic can use the same declarative failure definition.",
      "from": "failure-run-base",
      "aggregate": {
        "by": [
          "organization",
          "repository",
          "workflow",
          "run"
        ],
        "values": [
          {
            "field": "run",
            "as": "failing-runs",
            "reducer": "distinct-count"
          }
        ]
      }
    },
    {
      "name": "overview-failing-workflows",
      "intent": "Identify only workflows that have at least one failed run in the selected snapshot horizon before computing streaks.",
      "from": "overview-failing-runs",
      "aggregate": {
        "by": [
          "organization",
          "repository",
          "workflow"
        ],
        "values": [
          {
            "field": "run",
            "as": "failing-runs",
            "reducer": "distinct-count"
          }
        ]
      }
    },
    {
      "name": "overview-repeated-failure-groups",
      "intent": "Group each workflow's latest consecutive failing run sequence in the selected snapshot horizon, resetting the group after any successful run.",
      "from": "runs",
      "joins": [
        {
          "source": "overview-failing-workflows",
          "type": "inner",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            }
          ],
          "fields": [
            {
              "field": "failing-runs",
              "as": "failing-runs"
            }
          ]
        },
        {
          "source": "overview-failing-runs",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            },
            {
              "left": "run",
              "right": "run"
            }
          ],
          "fields": [
            {
              "field": "failing-runs",
              "as": "run-failing-count"
            }
          ]
        }
      ],
      "compute": [
        {
          "as": "failure-streak-point",
          "function": "failure-streak-point",
          "args": [
            {
              "field": "started-at"
            },
            {
              "field": "run"
            },
            {
              "field": "run-failing-count"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "organization",
          "repository",
          "workflow"
        ],
        "values": [
          {
            "field": "failure-streak-point",
            "as": "failure-count",
            "reducer": "latest-failure-streak"
          }
        ]
      }
    },
    {
      "name": "overview-repeated-failure-candidates",
      "intent": "Attach selected-horizon failure counts to each workflow's latest canonical work item.",
      "from": "work-items",
      "joins": [
        {
          "source": "overview-repeated-failure-groups",
          "type": "inner",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            }
          ],
          "fields": [
            {
              "field": "failure-count",
              "as": "failure-count"
            }
          ]
        }
      ],
      "filter": {
        "predicates": [
          {
            "field": "lifecycle-state",
            "equals": "blocked"
          }
        ]
      },
      "compute": [
        {
          "as": "is-repeated",
          "function": "greater-than",
          "args": [
            {
              "field": "failure-count"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "attention-signal-id",
          "function": "concat",
          "args": [
            {
              "value": "repeated-failure:"
            },
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            },
            {
              "value": ":"
            },
            {
              "field": "workflow"
            }
          ]
        },
        {
          "as": "kind",
          "function": "coalesce",
          "args": [
            {
              "value": "Repeated workflow failures"
            },
            {
              "value": "Repeated workflow failures"
            }
          ]
        },
        {
          "as": "title",
          "function": "coalesce",
          "args": [
            {
              "field": "workflow"
            },
            {
              "value": "Workflow"
            }
          ]
        },
        {
          "as": "attention-reason",
          "function": "concat",
          "args": [
            {
              "field": "failure-count"
            },
            {
              "value": " failed runs in the selected horizon"
            }
          ]
        },
        {
          "as": "action",
          "function": "coalesce",
          "args": [
            {
              "value": "Open latest failed run on GitHub"
            },
            {
              "value": "Open latest failed run on GitHub"
            }
          ]
        },
        {
          "as": "icon",
          "function": "coalesce",
          "args": [
            {
              "value": "x-circle"
            },
            {
              "value": "x-circle"
            }
          ]
        },
        {
          "as": "tone",
          "function": "coalesce",
          "args": [
            {
              "value": "critical"
            },
            {
              "value": "critical"
            }
          ]
        },
        {
          "as": "priority",
          "function": "number",
          "args": [
            {
              "value": 0
            }
          ]
        }
      ],
      "select": [
        {
          "field": "is-repeated"
        },
        {
          "field": "attention-signal-id"
        },
        {
          "field": "kind"
        },
        {
          "field": "title"
        },
        {
          "field": "scope"
        },
        {
          "field": "attention-reason",
          "as": "reason"
        },
        {
          "field": "observed-at"
        },
        {
          "field": "action"
        },
        {
          "field": "evidence-link"
        },
        {
          "field": "run-link"
        },
        {
          "field": "icon"
        },
        {
          "field": "tone"
        },
        {
          "field": "priority"
        },
        {
          "field": "failure-count"
        }
      ]
    },
    {
      "name": "overview-repeated-failure-attention",
      "intent": "Keep only unresolved workflows with two or more failures in the selected horizon.",
      "from": "overview-repeated-failure-candidates",
      "filter": {
        "predicates": [
          {
            "field": "is-repeated",
            "equals": true
          }
        ]
      },
      "select": [
        {
          "field": "attention-signal-id"
        },
        {
          "field": "kind"
        },
        {
          "field": "title"
        },
        {
          "field": "scope"
        },
        {
          "field": "reason"
        },
        {
          "field": "observed-at"
        },
        {
          "field": "action"
        },
        {
          "field": "evidence-link"
        },
        {
          "field": "run-link"
        },
        {
          "field": "icon"
        },
        {
          "field": "tone"
        },
        {
          "field": "priority"
        },
        {
          "field": "failure-count"
        }
      ]
    },
    {
      "name": "overview-review-attention",
      "intent": "Select only unresolved outputs explicitly awaiting human review with their retained GitHub evidence destination.",
      "from": "work-items",
      "filter": {
        "predicates": [
          {
            "field": "lifecycle-state",
            "equals": "review"
          }
        ]
      },
      "compute": [
        {
          "as": "kind",
          "function": "coalesce",
          "args": [
            {
              "value": "Human review required"
            },
            {
              "value": "Human review required"
            }
          ]
        },
        {
          "as": "title",
          "function": "coalesce",
          "args": [
            {
              "field": "objective"
            },
            {
              "value": "Produced output"
            }
          ]
        },
        {
          "as": "action",
          "function": "coalesce",
          "args": [
            {
              "value": "Open review item on GitHub"
            },
            {
              "value": "Open review item on GitHub"
            }
          ]
        },
        {
          "as": "icon",
          "function": "coalesce",
          "args": [
            {
              "value": "eye"
            },
            {
              "value": "eye"
            }
          ]
        },
        {
          "as": "tone",
          "function": "coalesce",
          "args": [
            {
              "value": "action"
            },
            {
              "value": "action"
            }
          ]
        },
        {
          "as": "priority",
          "function": "number",
          "args": [
            {
              "value": 1
            }
          ]
        }
      ],
      "select": [
        {
          "field": "work-item-id",
          "as": "attention-signal-id"
        },
        {
          "field": "kind"
        },
        {
          "field": "title"
        },
        {
          "field": "scope"
        },
        {
          "field": "reason"
        },
        {
          "field": "observed-at"
        },
        {
          "field": "action"
        },
        {
          "field": "evidence-link"
        },
        {
          "field": "run-link"
        },
        {
          "field": "icon"
        },
        {
          "field": "tone"
        },
        {
          "field": "priority"
        }
      ]
    },
    {
      "name": "overview-needs-attention",
      "intent": "Combine grouped repeated failures and unresolved review outputs without introducing ordinary activity or duplicate work items.",
      "from": "overview-repeated-failure-attention",
      "union": [
        "overview-review-attention"
      ],
      "order-by": [
        {
          "field": "priority",
          "direction": "asc"
        },
        {
          "field": "observed-at",
          "direction": "desc"
        },
        {
          "field": "attention-signal-id",
          "direction": "asc"
        }
      ]
    }
  ]
}
