{
  "page": {
    "id": "tool-insights",
    "kind": "custom",
    "title": "Tool",
    "icon": "graph",
    "description": "Insights for the selected tool entity.",
    "route": {
      "hash-query-parameter": "tool",
      "navigation-page": "mcps",
      "tab": "insights",
      "tabs": [
        {
          "id": "insights",
          "label": "Insights",
          "icon": "graph",
          "page": "tool-insights"
        },
        {
          "id": "runs",
          "label": "Runs",
          "icon": "play",
          "page": "tool-runs"
        }
      ]
    },
    "views": [
      {
        "id": "tool-route-chrome",
        "title": "Tool insights",
        "data": {
          "sources": [
            "mcp-tool-calls"
          ],
          "arguments": [
            {
              "name": "tool",
              "field": "mcp-tool-label"
            }
          ]
        },
        "mark": "element",
        "element": "entity-route",
        "layout": "full",
        "title-link": {
          "href-field": "run-link",
          "identifier-field": "mcp-tool-label"
        }
      },
      {
        "id": "tool-insights-chart",
        "title": "Calls by status",
        "data": {
          "source": "tool-entity-insights",
          "arguments": [
            {
              "name": "tool",
              "field": "mcp-tool-label"
            }
          ]
        },
        "mark": "chart",
        "chart": "bar",
        "layout": "full",
        "encoding": {
          "x": {
            "field": "mcp-status",
            "type": "nominal",
            "title": "Status"
          },
          "y": {
            "field": "observations",
            "type": "quantitative",
            "title": "Observations"
          }
        }
      }
    ]
  },
  "queries": [
    {
      "name": "mcp-tool-calls",
      "intent": "Prepare MCP tool calls for aggregation while excluding calls to the safe outputs server.",
      "description": "Observed MCP tool calls labeled with whether they belong to the internal safe outputs server.",
      "from": "mcp-calls",
      "compute": [
        {
          "as": "safe-output-server",
          "function": "equals-any",
          "args": [
            {
              "field": "mcp-server"
            },
            {
              "value": "safe_outputs"
            }
          ]
        },
        {
          "as": "mcp-tool-label",
          "function": "concat",
          "args": [
            {
              "field": "mcp-server"
            },
            {
              "value": "/"
            },
            {
              "field": "mcp-tool"
            }
          ]
        },
        {
          "as": "workflow-key",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            },
            {
              "value": ":"
            },
            {
              "field": "workflow"
            }
          ]
        }
      ]
    },
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "tool-entity-insights",
      "intent": "Summarize one tool entity for its dedicated Insights view.",
      "from": "mcp-tool-calls",
      "aggregate": {
        "by": [
          "mcp-tool-label",
          "mcp-server",
          "mcp-tool",
          "mcp-status"
        ],
        "values": [
          {
            "field": "mcp-observation",
            "as": "observations",
            "reducer": "count"
          }
        ]
      },
      "order-by": [
        {
          "field": "observations",
          "direction": "desc"
        },
        {
          "field": "mcp-status",
          "direction": "asc"
        }
      ]
    }
  ]
}
