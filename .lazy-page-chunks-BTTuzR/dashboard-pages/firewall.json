{
  "page": {
    "id": "firewall",
    "kind": "custom",
    "title": "Firewall",
    "navigation-label": "Firewall",
    "icon": "globe",
    "class-name": "firewall-page",
    "description": "Observed firewall domains and accepted and blocked request totals for agent egress.",
    "views": [
      {
        "id": "security-firewall-most-blocked-domains",
        "title": "Most blocked domains",
        "description": "The ten domains with the highest observed blocked request totals.",
        "data": {
          "source": "firewall-most-blocked-domains"
        },
        "mark": "chart",
        "chart": "pie",
        "layout": "full",
        "empty-message": "No blocked firewall domains are available for this selection.",
        "encoding": {
          "x": {
            "field": "domain",
            "type": "nominal",
            "title": "Domain"
          },
          "y": {
            "field": "blocked",
            "type": "quantitative",
            "title": "Blocked requests"
          }
        }
      },
      {
        "id": "security-firewall-least-used-domains",
        "title": "Least used domains",
        "description": "Uncommon domains observed in the fewest distinct runs.",
        "data": {
          "source": "firewall-least-used-domains"
        },
        "mark": "table",
        "layout": "full",
        "empty-message": "No uncommon firewall domains are available for this selection.",
        "encoding": {
          "columns": [
            {
              "field": "domain",
              "type": "nominal",
              "title": "Domain"
            },
            {
              "field": "run",
              "type": "quantitative",
              "title": "Runs"
            },
            {
              "field": "accepted",
              "type": "quantitative",
              "title": "Allowed"
            },
            {
              "field": "blocked",
              "type": "quantitative",
              "title": "Blocked"
            }
          ]
        }
      },
      {
        "id": "security-firewall-domains",
        "disclosure-label": "All observed domains",
        "disclosure": "supplemental",
        "description": "Observed runs and accepted and blocked requests by normalized domain.",
        "data": {
          "source": "firewall-domain-totals",
          "order-by": [
            {
              "field": "blocked",
              "direction": "desc"
            },
            {
              "field": "accepted",
              "direction": "desc"
            },
            {
              "field": "domain",
              "direction": "asc"
            }
          ]
        },
        "mark": "table",
        "controls": "interactive",
        "lazy-list": true,
        "column-summaries": true,
        "layout": "full-view",
        "empty-message": "No observed firewall domains are available for this selection.",
        "encoding": {
          "columns": [
            {
              "field": "domain",
              "type": "nominal",
              "title": "Domain"
            },
            {
              "field": "run",
              "type": "quantitative",
              "title": "Runs"
            },
            {
              "field": "accepted",
              "type": "quantitative",
              "title": "Allowed"
            },
            {
              "field": "blocked",
              "type": "quantitative",
              "title": "Blocked"
            }
          ]
        }
      }
    ]
  },
  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "firewall-domain-totals",
      "intent": "Show each observed firewall domain with the number of runs and total accepted and blocked requests.",
      "description": "Distinct runs and accepted and blocked request totals by firewall domain.",
      "from": "firewall-observations",
      "filter": {
        "predicates": [
          {
            "field": "decision",
            "in": [
              "allowed",
              "denied"
            ]
          }
        ]
      },
      "aggregate": {
        "by": [
          "domain"
        ],
        "values": [
          {
            "field": "run",
            "as": "run",
            "reducer": "distinct-count"
          },
          {
            "field": "request-count",
            "as": "accepted",
            "reducer": "sum",
            "filter": {
              "predicates": [
                {
                  "field": "decision",
                  "equals": "allowed"
                }
              ]
            }
          },
          {
            "field": "request-count",
            "as": "blocked",
            "reducer": "sum",
            "filter": {
              "predicates": [
                {
                  "field": "decision",
                  "equals": "denied"
                }
              ]
            }
          }
        ]
      },
      "order-by": [
        {
          "field": "blocked",
          "direction": "desc"
        },
        {
          "field": "accepted",
          "direction": "desc"
        },
        {
          "field": "domain",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "firewall-most-blocked-domains",
      "intent": "Highlight the domains with the most blocked firewall requests.",
      "description": "The ten domains with the highest observed blocked request totals.",
      "from": "firewall-domain-totals",
      "order-by": [
        {
          "field": "blocked",
          "direction": "desc"
        },
        {
          "field": "domain",
          "direction": "asc"
        }
      ],
      "limit": 10
    },
    {
      "name": "firewall-least-used-domains",
      "intent": "Highlight uncommon firewall domains observed in the fewest runs.",
      "description": "The ten domains observed in the fewest distinct runs.",
      "from": "firewall-domain-totals",
      "order-by": [
        {
          "field": "run",
          "direction": "asc"
        },
        {
          "field": "domain",
          "direction": "asc"
        }
      ],
      "limit": 10
    }
  ]
}
