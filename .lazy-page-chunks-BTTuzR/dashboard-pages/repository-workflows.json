{
  "page": {
    "id": "repository-workflows",
    "kind": "custom",
    "title": "Repository workflows",
    "description": "Declared workflows for the selected repository.",
    "icon": "workflow",
    "route": {
      "hash-query-parameter": "repository",
      "navigation-page": "repositories"
    },
    "views": [
      "repository-workflows"
    ]
  },
  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "entity-workflow-run-totals",
      "intent": "Summarize run outcomes and AI Credit consumption for reusable workflow cards.",
      "from": "runs",
      "compute": [
        {
          "as": "run-attempt-identity",
          "function": "concat",
          "args": [
            {
              "field": "run"
            },
            {
              "value": ":"
            },
            {
              "field": "run-attempt"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "organization",
          "repository",
          "workflow"
        ],
        "values": [
          {
            "field": "run-attempt-identity",
            "as": "runs",
            "reducer": "distinct-count"
          },
          {
            "field": "run-conclusion",
            "as": "successful-runs",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "run-conclusion",
                  "equals": "success"
                }
              ]
            }
          },
          {
            "field": "run-conclusion",
            "as": "failed-runs",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "run-conclusion",
                  "in": [
                    "failure",
                    "startup-failure",
                    "stale",
                    "timed-out"
                  ]
                }
              ]
            }
          },
          {
            "field": "aic-total",
            "as": "aic",
            "reducer": "sum"
          }
        ]
      }
    },
    {
      "name": "entity-workflows",
      "intent": "Project workflow entities for reusable workflow cards and repository drill-down.",
      "from": "workflows",
      "joins": [
        {
          "source": "entity-workflow-run-totals",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            }
          ],
          "fields": [
            {
              "field": "runs",
              "as": "observed-runs"
            },
            {
              "field": "successful-runs",
              "as": "observed-successful-runs"
            },
            {
              "field": "failed-runs",
              "as": "observed-failed-runs"
            },
            {
              "field": "aic",
              "as": "observed-aic"
            }
          ]
        }
      ],
      "compute": [
        {
          "as": "runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "successful-runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-successful-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "failed-runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-failed-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "aic",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-aic"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "aic-per-run",
          "function": "quotient",
          "args": [
            {
              "field": "aic"
            },
            {
              "field": "runs"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "workflow"
        },
        {
          "field": "workflow-name"
        },
        {
          "field": "workflow-role"
        },
        {
          "field": "workflow-active"
        },
        {
          "field": "campaign-name"
        },
        {
          "field": "observed-at"
        },
        {
          "field": "runs"
        },
        {
          "field": "successful-runs"
        },
        {
          "field": "failed-runs"
        },
        {
          "field": "aic-per-run"
        },
        {
          "field": "workflow-link"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        },
        {
          "field": "workflow",
          "direction": "asc"
        }
      ]
    }
  ]
}
