{
  "page": {
    "id": "runs",
    "kind": "built-in",
    "page": "runs",
    "title": "Runs",
    "icon": "play",
    "definition": {
      "data-state": {
        "availability": true
      },
      "views": [
        {
          "id": "runs-last-week",
          "title": "Runs in the last week",
          "description": "Workflow run conclusions observed during the last seven days.",
          "data": {
            "source": "runs-daily-conclusions",
            "time": {
              "range": "7d"
            }
          },
          "mark": "chart",
          "chart": "area",
          "layout": "horizontal",
          "encoding": {
            "x": {
              "field": "day",
              "type": "temporal",
              "format": "human-friendly-timestamp",
              "title": "Started"
            },
            "y": {
              "field": "runs",
              "type": "quantitative",
              "title": "Runs"
            },
            "color": {
              "field": "run-conclusion",
              "type": "nominal"
            }
          }
        },
        {
          "id": "runs-runs-source",
          "title": "Runs",
          "description": "Observed workflow runs across the configured repository scope.",
          "data": {
            "source": "runs-table"
          },
          "mark": "table",
          "controls": "interactive",
          "lazy-list": true,
          "column-summaries": true,
          "layout": "full-view",
          "empty-message": "No runs observed.",
          "encoding": {
            "href": {
              "field": "run-link",
              "type": "nominal"
            },
            "columns": [
              {
                "field": "run",
                "type": "nominal",
                "display": "run-link"
              },
              {
                "field": "run-status",
                "type": "nominal",
                "display": "status"
              },
              {
                "field": "run-conclusion",
                "type": "nominal",
                "display": "status"
              },
              {
                "field": "repository-coordinate",
                "type": "nominal",
                "title": "Repository",
                "display": "repository-link"
              },
              {
                "field": "workflow",
                "type": "nominal",
                "display": "workflow-link"
              },
              {
                "field": "rollout-mode",
                "type": "nominal",
                "display": "mode"
              },
              {
                "field": "engine",
                "type": "nominal"
              },
              {
                "field": "engine-version",
                "type": "nominal"
              },
              {
                "field": "requested-model",
                "type": "nominal"
              },
              {
                "field": "resolved-model",
                "type": "nominal"
              },
              {
                "field": "started-at",
                "type": "temporal",
                "format": "human-friendly-timestamp"
              }
            ]
          }
        }
      ]
    }
  },
  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "runs-daily-conclusions",
      "intent": "Aggregate workflow run conclusions by UTC day for the Runs stacked area graph.",
      "from": "runs",
      "compute": [
        {
          "as": "day",
          "function": "date-day",
          "args": [
            {
              "field": "started-at"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "day",
          "run-conclusion"
        ],
        "values": [
          {
            "field": "run",
            "as": "runs",
            "reducer": "count"
          }
        ]
      }
    },
    {
      "name": "runs-table",
      "intent": "Show observed workflow runs in a table with execution, repository, workflow, engine, model, and navigation details.",
      "description": "Observed workflow runs ordered from newest to oldest.",
      "from": "runs",
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "run"
        },
        {
          "field": "run-status"
        },
        {
          "field": "run-conclusion"
        },
        {
          "field": "repository-coordinate"
        },
        {
          "field": "workflow"
        },
        {
          "field": "rollout-mode"
        },
        {
          "field": "engine"
        },
        {
          "field": "engine-version"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "requested-model"
        },
        {
          "field": "resolved-model"
        },
        {
          "field": "started-at"
        },
        {
          "field": "repository-link"
        },
        {
          "field": "workflow-link"
        },
        {
          "field": "run-link"
        }
      ],
      "order-by": [
        {
          "field": "started-at",
          "direction": "desc"
        }
      ]
    }
  ]
}
