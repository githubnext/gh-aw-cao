{
  "page": {
    "id": "issues",
    "kind": "built-in",
    "page": "issues",
    "title": "Issues",
    "icon": "issue-opened",
    "experimental": true,
    "description": "Retained GitHub issues created by agentic workflow safe outputs.",
    "definition": {
      "data-state": {
        "availability": true
      },
      "views": [
        {
          "id": "issues-by-repository",
          "title": "Top repositories with issues",
          "description": "The share of retained issues attributed to the ten repositories with the most issue safe outputs.",
          "data": {
            "source": "issue-repository-totals"
          },
          "mark": "chart",
          "chart": "pie",
          "layout": "full",
          "empty-message": "No issue safe outputs were retained in the current report.",
          "encoding": {
            "x": {
              "field": "repository-coordinate",
              "type": "nominal",
              "title": "Repository"
            },
            "y": {
              "field": "issues",
              "type": "quantitative",
              "title": "Issues"
            }
          }
        },
        {
          "id": "issues-by-status",
          "title": "Open and closed issues",
          "description": "The current split of retained issue safe outputs by open state or closing reason.",
          "data": {
            "source": "issue-safe-outputs"
          },
          "mark": "chart",
          "chart": "pie",
          "layout": "full",
          "empty-message": "No issue status data was retained in the current report.",
          "encoding": {
            "x": {
              "field": "issue-status-detail",
              "type": "nominal",
              "title": "Current status"
            },
            "y": {
              "field": "entity-url",
              "type": "quantitative",
              "aggregate": "count",
              "title": "Issues"
            }
          }
        },
        {
          "id": "issues-source",
          "title": "Issues",
          "description": "Retained issue safe outputs with their repository, producing workflow, and workflow run.",
          "data": {
            "source": "issue-safe-outputs",
            "limit": 100,
            "order-by": [
              {
                "field": "observed-at",
                "direction": "desc"
              }
            ]
          },
          "mark": "table",
          "controls": "interactive",
          "lazy-list": true,
          "column-summaries": true,
          "layout": "full-view",
          "empty-message": "No issue safe outputs were retained in the current report.",
          "encoding": {
            "href": {
              "field": "entity-url",
              "type": "nominal"
            },
            "columns": [
              {
                "field": "event-summary",
                "type": "nominal",
                "title": "Issue"
              },
              {
                "field": "issue-status-detail",
                "type": "nominal",
                "title": "Current status",
                "display": "status"
              },
              {
                "field": "issue-state",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "issue-closing-status",
                "type": "nominal",
                "title": "Closing status"
              },
              {
                "field": "issue-closed-at",
                "type": "temporal",
                "format": "human-friendly-timestamp",
                "title": "Closed"
              },
              {
                "field": "issue-status-observed-at",
                "type": "temporal",
                "format": "human-friendly-timestamp",
                "title": "Status observed"
              },
              {
                "field": "safe-output-type",
                "type": "nominal",
                "title": "Safe output",
                "display": "label"
              },
              {
                "field": "github-entity-type",
                "type": "nominal",
                "title": "Entity type"
              },
              {
                "field": "entity-url",
                "type": "nominal",
                "title": "Entity URL"
              },
              {
                "field": "repository",
                "type": "nominal",
                "title": "Repository"
              },
              {
                "field": "workflow",
                "type": "nominal",
                "title": "Workflow",
                "format": "workflow-relative-path"
              },
              {
                "field": "run",
                "type": "nominal",
                "title": "Run",
                "display": "run-link"
              },
              {
                "field": "run-link",
                "type": "nominal",
                "title": "Run link"
              },
              {
                "field": "observed-at",
                "type": "temporal",
                "format": "human-friendly-timestamp",
                "title": "Opened"
              }
            ]
          }
        }
      ]
    }
  },
  "queries": [
    {
      "name": "issue-safe-outputs",
      "intent": "List retained GitHub issue safe outputs.",
      "description": "Issue-only projection of retained safe-output items.",
      "from": "issues",
      "filter": {
        "predicates": [
          {
            "field": "event-type",
            "equals": "safe_output.created"
          },
          {
            "field": "is-pull-request",
            "equals": false
          }
        ]
      },
      "joins": [
        {
          "source": "runs",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            },
            {
              "left": "run",
              "right": "run"
            },
            {
              "left": "run-attempt",
              "right": "run-attempt"
            }
          ],
          "fields": [
            {
              "field": "run-link",
              "as": "linked-run"
            }
          ]
        }
      ],
      "compute": [
        {
          "as": "_issue-state-open",
          "function": "equals-any",
          "args": [
            {
              "field": "issue-state"
            },
            {
              "value": "OPEN"
            }
          ]
        },
        {
          "as": "_issue-state-closed",
          "function": "equals-any",
          "args": [
            {
              "field": "issue-state"
            },
            {
              "value": "CLOSED"
            }
          ]
        },
        {
          "as": "_issue-open-status",
          "function": "if",
          "args": [
            {
              "field": "_issue-state-open"
            },
            {
              "value": "Open"
            },
            {
              "value": "Unknown"
            }
          ]
        },
        {
          "as": "issue-status",
          "function": "if",
          "args": [
            {
              "field": "_issue-state-closed"
            },
            {
              "value": "Closed"
            },
            {
              "field": "_issue-open-status"
            }
          ]
        },
        {
          "as": "_issue-closing-reason",
          "function": "coalesce",
          "args": [
            {
              "field": "issue-state-reason"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "_issue-closing-reason-normalized",
          "function": "lower",
          "args": [
            {
              "field": "_issue-closing-reason"
            }
          ]
        },
        {
          "as": "issue-closing-status",
          "function": "title-case",
          "args": [
            {
              "field": "_issue-closing-reason-normalized"
            }
          ]
        },
        {
          "as": "_issue-closed-status-detail",
          "function": "concat",
          "args": [
            {
              "value": "Closed: "
            },
            {
              "field": "issue-closing-status"
            }
          ]
        },
        {
          "as": "issue-status-detail",
          "function": "if",
          "args": [
            {
              "field": "_issue-state-closed"
            },
            {
              "field": "_issue-closed-status-detail"
            },
            {
              "field": "issue-status"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "event-timestamp",
          "as": "observed-at"
        },
        {
          "field": "github-entity-type"
        },
        {
          "field": "is-pull-request"
        },
        {
          "field": "safe-output-type"
        },
        {
          "field": "issue-state"
        },
        {
          "field": "issue-closed"
        },
        {
          "field": "issue-state-reason"
        },
        {
          "field": "issue-status"
        },
        {
          "field": "issue-closing-status"
        },
        {
          "field": "issue-status-detail"
        },
        {
          "field": "issue-closed-at"
        },
        {
          "field": "issue-status-observed-at"
        },
        {
          "field": "event-summary"
        },
        {
          "field": "correlation-id",
          "as": "entity-url"
        },
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "workflow"
        },
        {
          "field": "run"
        },
        {
          "field": "linked-run",
          "as": "run-link"
        }
      ],
      "order-by": [
        {
          "field": "observed-at",
          "direction": "desc"
        },
        {
          "field": "entity-url",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "issue-repository-totals",
      "intent": "Rank the ten repositories with the most retained GitHub issue safe outputs.",
      "description": "Top repositories by retained issue safe-output count.",
      "from": "issue-safe-outputs",
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "entity-url",
            "as": "issues",
            "reducer": "count"
          }
        ]
      },
      "order-by": [
        {
          "field": "issues",
          "direction": "desc"
        },
        {
          "field": "repository-coordinate",
          "direction": "asc"
        }
      ],
      "limit": 10
    },
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    }
  ]
}
