{
  "page": {
    "id": "outcome-detail",
    "kind": "custom",
    "title": "Outcome",
    "description": "Published safe-output outcome details and provenance.",
    "icon": "issue-opened",
    "class-name": "outcome-detail-page",
    "route": {
      "hash-query-parameter": "outcome"
    },
    "views": [
      {
        "id": "outcome-disposition",
        "title": "Outcome disposition",
        "description": "The current disposition is the leading signal for this retained outcome.",
        "data": {
          "source": "outcomes",
          "route-field": "safe-output"
        },
        "mark": "chart",
        "chart": "pie",
        "layout": "full",
        "encoding": {
          "x": {
            "field": "outcome-state",
            "type": "nominal",
            "title": "Disposition"
          },
          "y": {
            "field": "safe-output",
            "type": "quantitative",
            "aggregate": "count",
            "title": "Outcomes"
          }
        }
      },
      {
        "id": "outcome-record",
        "title": "Outcome",
        "description": "Rendered from reusable discussion and metadata sections bound to the selected outcome.",
        "title-link": {
          "href-field": "external-link",
          "identifier-field": "outcome-number"
        },
        "mark": "element",
        "element": "outcome-detail",
        "data": {
          "sources": [
            "outcomes"
          ]
        },
        "layout": "full"
      },
      {
        "id": "outcome-discussion",
        "title": "Outcome discussion",
        "data": {
          "sources": [
            "outcomes"
          ]
        },
        "mark": "element",
        "element": "outcome-detail-section",
        "config": {
          "body": "discussion"
        },
        "layout": "full"
      },
      {
        "id": "outcome-metadata",
        "title": "Outcome metadata",
        "data": {
          "sources": [
            "outcomes"
          ]
        },
        "mark": "element",
        "element": "outcome-detail-section",
        "config": {
          "body": "metadata"
        },
        "layout": "full"
      }
    ],
    "sections": [
      {
        "id": "outcome-summary",
        "title": "Outcome",
        "layout": "full",
        "views": [
          "outcome-disposition",
          "outcome-record",
          "outcome-discussion",
          "outcome-metadata"
        ]
      }
    ]
  },
  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    }
  ]
}
