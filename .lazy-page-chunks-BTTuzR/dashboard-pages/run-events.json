{
  "page": {
    "id": "run-events",
    "kind": "custom",
    "title": "Run",
    "icon": "pulse",
    "description": "Observed events for the selected workflow run.",
    "route": {
      "hash-query-parameter": "run",
      "navigation-page": "runs"
    },
    "views": [
      "run-events"
    ]
  },
  "queries": [
    {
      "name": "event-base",
      "intent": "Reuse shared query stages for entity-events, event-runs",
      "from": "audits",
      "union": [
        "domains",
        "tools",
        "issues"
      ]
    },
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "entity-events",
      "intent": "Project all run-owned records for reusable cards and run drill-down.",
      "from": "event-base",
      "compute": [
        {
          "as": "event-url",
          "function": "coalesce",
          "args": [
            {
              "field": "safe-output-url"
            },
            {
              "field": "correlation-id"
            },
            {
              "field": "implementation-pull-request-url"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "workflow"
        },
        {
          "field": "run"
        },
        {
          "field": "run-attempt"
        },
        {
          "field": "event"
        },
        {
          "field": "event-source"
        },
        {
          "field": "event-type"
        },
        {
          "field": "event-summary"
        },
        {
          "field": "event-status"
        },
        {
          "field": "github-entity-type"
        },
        {
          "field": "safe-output-type"
        },
        {
          "field": "event-url"
        },
        {
          "field": "event-timestamp",
          "as": "observed-at"
        },
        {
          "field": "run-link"
        }
      ],
      "order-by": [
        {
          "field": "observed-at",
          "direction": "desc"
        },
        {
          "field": "event",
          "direction": "asc"
        }
      ]
    }
  ]
}
