{
  "page": {
    "id": "skills",
    "kind": "custom",
    "title": "Skills",
    "navigation-label": "Skills",
    "icon": "tools",
    "experimental": true,
    "description": "Analyze observed skill invocations and drill into the workflows that invoked them.",
    "views": [
      {
        "id": "skills-most-invoked",
        "title": "Most invoked skills",
        "description": "Skills ranked by observed invocation count.",
        "data": {
          "source": "skill-invocations-by-skill",
          "order-by": [
            {
              "field": "invocations",
              "direction": "desc"
            }
          ],
          "limit": 10
        },
        "mark": "chart",
        "chart": "horizontal-bar",
        "layout": "full",
        "empty-message": "No skill invocations were observed.",
        "encoding": {
          "x": {
            "field": "skill",
            "type": "nominal",
            "title": "Skill"
          },
          "y": {
            "field": "invocations",
            "type": "quantitative",
            "title": "Invocations"
          }
        }
      },
      {
        "id": "skills-by-workflow",
        "title": "Skill invocations per workflow",
        "description": "Workflows ranked by their observed skill invocation count.",
        "data": {
          "source": "skill-invocations-by-workflow",
          "order-by": [
            {
              "field": "invocations",
              "direction": "desc"
            }
          ],
          "limit": 100
        },
        "mark": "chart",
        "chart": "horizontal-bar",
        "layout": "full",
        "empty-message": "No workflow skill invocations were observed.",
        "encoding": {
          "x": {
            "field": "workflow-coordinate",
            "type": "nominal",
            "title": "Workflow"
          },
          "y": {
            "field": "invocations",
            "type": "quantitative",
            "title": "Invocations"
          },
          "href": {
            "field": "workflow-link"
          }
        }
      },
      {
        "id": "skills-workflow-inventory",
        "title": "Skills by workflow",
        "description": "Observed skills and invocation counts for each workflow.",
        "data": {
          "source": "skill-workflow-inventory"
        },
        "mark": "table",
        "controls": "interactive",
        "lazy-list": true,
        "column-summaries": true,
        "layout": "full-view",
        "empty-message": "No skill invocations were observed.",
        "encoding": {
          "href": {
            "field": "workflow-link"
          },
          "columns": [
            {
              "field": "skill",
              "type": "nominal",
              "title": "Skill"
            },
            {
              "field": "workflow",
              "type": "nominal",
              "title": "Workflow",
              "display": "workflow-link",
              "format": "workflow-relative-path"
            },
            {
              "field": "repository-coordinate",
              "type": "nominal",
              "title": "Repository"
            },
            {
              "field": "invocations",
              "type": "quantitative",
              "title": "Invocations"
            }
          ]
        }
      }
    ]
  },
  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "skill-invocations",
      "intent": "Select observed skill invocations for skill usage analytics.",
      "from": "skills",
      "select": [
        {
          "field": "event",
          "as": "id"
        },
        {
          "field": "name",
          "as": "skill"
        },
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "workflow"
        },
        {
          "field": "invocation-count"
        },
        {
          "field": "failed-count"
        }
      ]
    },
    {
      "name": "skill-invocations-by-skill",
      "intent": "Rank skills by their observed invocation count.",
      "from": "skill-invocations",
      "aggregate": {
        "by": [
          "skill"
        ],
        "values": [
          {
            "field": "invocation-count",
            "as": "invocations",
            "reducer": "sum"
          }
        ]
      },
      "order-by": [
        {
          "field": "invocations",
          "direction": "desc"
        },
        {
          "field": "skill",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "skill-invocations-by-workflow-totals",
      "intent": "Rank workflows by their observed skill invocation count.",
      "from": "skill-invocations",
      "aggregate": {
        "by": [
          "organization",
          "repository",
          "workflow"
        ],
        "values": [
          {
            "field": "invocation-count",
            "as": "invocations",
            "reducer": "sum"
          }
        ]
      }
    },
    {
      "name": "skill-invocations-by-workflow",
      "intent": "Present workflow skill invocation totals with drill-through navigation to the workflow dashboard.",
      "from": "skill-invocations-by-workflow-totals",
      "compute": [
        {
          "as": "workflow-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            },
            {
              "value": ":"
            },
            {
              "field": "workflow"
            }
          ]
        },
        {
          "as": "encoded-workflow",
          "function": "url-encode",
          "args": [
            {
              "field": "workflow-coordinate"
            }
          ]
        },
        {
          "as": "workflow-dashboard-href",
          "function": "concat",
          "args": [
            {
              "value": "#page-workflow-runtime?workflow="
            },
            {
              "field": "encoded-workflow"
            }
          ]
        },
        {
          "as": "workflow-dashboard-label",
          "function": "concat",
          "args": [
            {
              "value": "View "
            },
            {
              "field": "workflow-coordinate"
            },
            {
              "value": " workflow dashboard"
            }
          ]
        },
        {
          "as": "workflow-link",
          "function": "dashboard-link",
          "args": [
            {
              "value": ""
            },
            {
              "field": "workflow-dashboard-href"
            },
            {
              "field": "workflow-dashboard-label"
            },
            {
              "field": "workflow-coordinate"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "workflow-coordinate"
        },
        {
          "field": "workflow-link"
        },
        {
          "field": "invocations"
        }
      ],
      "order-by": [
        {
          "field": "invocations",
          "direction": "desc"
        },
        {
          "field": "workflow-coordinate",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "skill-workflow-totals",
      "intent": "Count observed invocations for each skill and workflow.",
      "from": "skill-invocations",
      "aggregate": {
        "by": [
          "skill",
          "organization",
          "repository",
          "workflow"
        ],
        "values": [
          {
            "field": "invocation-count",
            "as": "invocations",
            "reducer": "sum"
          }
        ]
      }
    },
    {
      "name": "skill-workflow-inventory",
      "intent": "List observed skills by workflow with drill-through navigation to the workflow dashboard.",
      "from": "skill-workflow-totals",
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "workflow-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            },
            {
              "value": ":"
            },
            {
              "field": "workflow"
            }
          ]
        },
        {
          "as": "encoded-workflow",
          "function": "url-encode",
          "args": [
            {
              "field": "workflow-coordinate"
            }
          ]
        },
        {
          "as": "workflow-dashboard-href",
          "function": "concat",
          "args": [
            {
              "value": "#page-workflow-runtime?workflow="
            },
            {
              "field": "encoded-workflow"
            }
          ]
        },
        {
          "as": "workflow-dashboard-label",
          "function": "concat",
          "args": [
            {
              "value": "View "
            },
            {
              "field": "workflow-coordinate"
            },
            {
              "value": " workflow dashboard"
            }
          ]
        },
        {
          "as": "workflow-link",
          "function": "dashboard-link",
          "args": [
            {
              "value": ""
            },
            {
              "field": "workflow-dashboard-href"
            },
            {
              "field": "workflow-dashboard-label"
            },
            {
              "field": "workflow-coordinate"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "skill"
        },
        {
          "field": "repository-coordinate"
        },
        {
          "field": "workflow"
        },
        {
          "field": "workflow-link"
        },
        {
          "field": "invocations"
        }
      ],
      "order-by": [
        {
          "field": "invocations",
          "direction": "desc"
        },
        {
          "field": "skill",
          "direction": "asc"
        },
        {
          "field": "workflow",
          "direction": "asc"
        }
      ]
    }
  ]
}
