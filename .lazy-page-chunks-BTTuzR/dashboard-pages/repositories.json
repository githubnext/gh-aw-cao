{
  "page": {
    "id": "repositories",
    "kind": "built-in",
    "page": "repositories",
    "title": "Repositories",
    "description": "Repository-owned workflow health and AI Credit usage across the configured repository scope.",
    "icon": "repo",
    "class-name": "repositories-page",
    "definition": {
      "data-state": {
        "availability": true
      },
      "views": [
        {
          "id": "repositories-issues",
          "title": "Top repositories with issues",
          "description": "The share of retained issues attributed to the ten repositories with the most issue safe outputs.",
          "data": {
            "source": "issue-repository-totals"
          },
          "mark": "chart",
          "chart": "pie",
          "layout": "full",
          "empty-message": "No issue safe outputs were retained in the current report.",
          "encoding": {
            "x": {
              "field": "repository-coordinate",
              "type": "nominal",
              "title": "Repository"
            },
            "y": {
              "field": "issues",
              "type": "quantitative",
              "title": "Issues"
            }
          }
        },
        {
          "id": "repositories-activity",
          "title": "Repositories",
          "description": "Repository-local execution health and all attributed campaign or local-workflow outcomes.",
          "data": {
            "source": "repository-activity"
          },
          "mark": "table",
          "controls": "interactive",
          "lazy-list": true,
          "layout": "full-view",
          "empty-message": "No repositories discovered.",
          "encoding": {
            "columns": [
              {
                "field": "repository",
                "type": "nominal",
                "title": "Repository"
              },
              {
                "field": "runs",
                "type": "quantitative",
                "title": "Runs"
              },
              {
                "field": "ingestion",
                "type": "nominal",
                "title": "Ingestion %"
              },
              {
                "field": "failure-summary",
                "type": "nominal",
                "title": "Failure rate",
                "filter": false
              },
              {
                "field": "aic",
                "type": "quantitative",
                "title": "AIC",
                "unit": "aic"
              },
              {
                "field": "workflows",
                "type": "quantitative",
                "title": "AWs"
              },
              {
                "field": "status",
                "type": "nominal",
                "title": "Status",
                "display": "status"
              }
            ],
            "href": {
              "field": "repository-link",
              "type": "nominal"
            }
          }
        }
      ]
    }
  },
  "queries": [
    {
      "name": "event-base",
      "intent": "Reuse shared query stages for entity-events, event-runs",
      "from": "audits",
      "union": [
        "domains",
        "tools",
        "issues"
      ]
    },
    {
      "name": "event-runs",
      "intent": "Identify each workflow run that has one or more imported run-owned records.",
      "description": "Distinct workflow runs represented by imported domain, tool, audit, or issue records.",
      "from": "event-base",
      "aggregate": {
        "by": [
          "organization",
          "repository",
          "workflow",
          "run",
          "run-attempt"
        ],
        "values": [
          {
            "field": "event",
            "as": "events",
            "reducer": "count"
          }
        ]
      }
    },
    {
      "name": "run-import-status",
      "intent": "Identify observed runs that have one or more imported run-owned records.",
      "description": "Observed runs enriched with imported-record status.",
      "from": "runs",
      "joins": [
        {
          "source": "event-runs",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            },
            {
              "left": "run",
              "right": "run"
            },
            {
              "left": "run-attempt",
              "right": "run-attempt"
            }
          ],
          "fields": [
            {
              "field": "events",
              "as": "imported-events"
            }
          ]
        }
      ],
      "compute": [
        {
          "as": "imported-event-count",
          "function": "coalesce",
          "args": [
            {
              "field": "imported-events"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "imported",
          "function": "greater-than",
          "args": [
            {
              "field": "imported-event-count"
            },
            {
              "value": 0
            }
          ]
        }
      ]
    },
    {
      "name": "issue-safe-outputs",
      "intent": "List retained GitHub issue safe outputs.",
      "description": "Issue-only projection of retained safe-output items.",
      "from": "issues",
      "filter": {
        "predicates": [
          {
            "field": "event-type",
            "equals": "safe_output.created"
          },
          {
            "field": "is-pull-request",
            "equals": false
          }
        ]
      },
      "joins": [
        {
          "source": "runs",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            },
            {
              "left": "run",
              "right": "run"
            },
            {
              "left": "run-attempt",
              "right": "run-attempt"
            }
          ],
          "fields": [
            {
              "field": "run-link",
              "as": "linked-run"
            }
          ]
        }
      ],
      "compute": [
        {
          "as": "_issue-state-open",
          "function": "equals-any",
          "args": [
            {
              "field": "issue-state"
            },
            {
              "value": "OPEN"
            }
          ]
        },
        {
          "as": "_issue-state-closed",
          "function": "equals-any",
          "args": [
            {
              "field": "issue-state"
            },
            {
              "value": "CLOSED"
            }
          ]
        },
        {
          "as": "_issue-open-status",
          "function": "if",
          "args": [
            {
              "field": "_issue-state-open"
            },
            {
              "value": "Open"
            },
            {
              "value": "Unknown"
            }
          ]
        },
        {
          "as": "issue-status",
          "function": "if",
          "args": [
            {
              "field": "_issue-state-closed"
            },
            {
              "value": "Closed"
            },
            {
              "field": "_issue-open-status"
            }
          ]
        },
        {
          "as": "_issue-closing-reason",
          "function": "coalesce",
          "args": [
            {
              "field": "issue-state-reason"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "_issue-closing-reason-normalized",
          "function": "lower",
          "args": [
            {
              "field": "_issue-closing-reason"
            }
          ]
        },
        {
          "as": "issue-closing-status",
          "function": "title-case",
          "args": [
            {
              "field": "_issue-closing-reason-normalized"
            }
          ]
        },
        {
          "as": "_issue-closed-status-detail",
          "function": "concat",
          "args": [
            {
              "value": "Closed: "
            },
            {
              "field": "issue-closing-status"
            }
          ]
        },
        {
          "as": "issue-status-detail",
          "function": "if",
          "args": [
            {
              "field": "_issue-state-closed"
            },
            {
              "field": "_issue-closed-status-detail"
            },
            {
              "field": "issue-status"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "event-timestamp",
          "as": "observed-at"
        },
        {
          "field": "github-entity-type"
        },
        {
          "field": "is-pull-request"
        },
        {
          "field": "safe-output-type"
        },
        {
          "field": "issue-state"
        },
        {
          "field": "issue-closed"
        },
        {
          "field": "issue-state-reason"
        },
        {
          "field": "issue-status"
        },
        {
          "field": "issue-closing-status"
        },
        {
          "field": "issue-status-detail"
        },
        {
          "field": "issue-closed-at"
        },
        {
          "field": "issue-status-observed-at"
        },
        {
          "field": "event-summary"
        },
        {
          "field": "correlation-id",
          "as": "entity-url"
        },
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "workflow"
        },
        {
          "field": "run"
        },
        {
          "field": "linked-run",
          "as": "run-link"
        }
      ],
      "order-by": [
        {
          "field": "observed-at",
          "direction": "desc"
        },
        {
          "field": "entity-url",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "issue-repository-totals",
      "intent": "Rank the ten repositories with the most retained GitHub issue safe outputs.",
      "description": "Top repositories by retained issue safe-output count.",
      "from": "issue-safe-outputs",
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "entity-url",
            "as": "issues",
            "reducer": "count"
          }
        ]
      },
      "order-by": [
        {
          "field": "issues",
          "direction": "desc"
        },
        {
          "field": "repository-coordinate",
          "direction": "asc"
        }
      ],
      "limit": 10
    },
    {
      "name": "repository-aic-totals",
      "intent": "Summarize observed AI Credit usage by repository.",
      "description": "Observed AI Credit totals for each repository.",
      "from": "runs",
      "aggregate": {
        "by": [
          "organization",
          "repository"
        ],
        "values": [
          {
            "field": "aic-total",
            "as": "aic",
            "reducer": "sum"
          }
        ]
      }
    },
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "repository-workflow-totals",
      "intent": "Summarize declared and disabled workflow counts by repository.",
      "description": "Declared and disabled workflow totals for each repository.",
      "from": "workflows",
      "aggregate": {
        "by": [
          "organization",
          "repository"
        ],
        "values": [
          {
            "field": "workflow",
            "as": "workflows",
            "reducer": "count"
          },
          {
            "field": "workflow",
            "as": "disabled",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "workflow-active",
                  "equals": "false"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "repository-report-totals",
      "intent": "Summarize published outcome report counts by repository.",
      "description": "Published report totals for each repository.",
      "from": "outcomes",
      "aggregate": {
        "by": [
          "organization",
          "repository"
        ],
        "values": [
          {
            "field": "repository",
            "as": "reports",
            "reducer": "count"
          }
        ]
      }
    },
    {
      "name": "repository-run-totals",
      "intent": "Summarize distinct runs, failures, and approval-required runs by repository.",
      "description": "Distinct run and conclusion totals for each repository.",
      "from": "run-import-status",
      "aggregate": {
        "by": [
          "organization",
          "repository"
        ],
        "values": [
          {
            "field": "run",
            "as": "runs",
            "reducer": "distinct-count"
          },
          {
            "field": "run-conclusion",
            "as": "failed",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "run-conclusion",
                  "in": [
                    "failure",
                    "startup-failure",
                    "timed-out"
                  ]
                }
              ]
            }
          },
          {
            "field": "run-conclusion",
            "as": "action-required",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "run-conclusion",
                  "equals": "action-required"
                }
              ]
            }
          },
          {
            "field": "imported",
            "as": "imported-runs",
            "reducer": "sum"
          }
        ]
      }
    },
    {
      "name": "repository-activity-core",
      "intent": "Join each repository with its workflow, report, evaluation, and run totals.",
      "description": "Repository inventory joined with workflow, report, evaluation, and run totals.",
      "from": "repositories",
      "joins": [
        {
          "source": "repository-workflow-totals",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            }
          ],
          "fields": [
            {
              "field": "workflows",
              "as": "observed-workflows"
            },
            {
              "field": "disabled",
              "as": "observed-disabled"
            }
          ]
        },
        {
          "source": "repository-report-totals",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            }
          ],
          "fields": [
            {
              "field": "reports",
              "as": "observed-reports"
            }
          ]
        },
        {
          "source": "repository-run-totals",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            }
          ],
          "fields": [
            {
              "field": "runs",
              "as": "observed-runs"
            },
            {
              "field": "failed",
              "as": "observed-failed"
            },
            {
              "field": "action-required",
              "as": "observed-action-required"
            },
            {
              "field": "imported-runs",
              "as": "observed-imported-runs"
            }
          ]
        }
      ]
    },
    {
      "name": "repository-activity",
      "intent": "Show repository-level execution health, outcome activity, and AI Credit usage in an actionable inventory.",
      "description": "Repository-local execution health and attributed outcome totals.",
      "from": "repository-activity-core",
      "joins": [
        {
          "source": "repository-aic-totals",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            }
          ],
          "fields": [
            {
              "field": "aic",
              "as": "observed-aic"
            }
          ]
        }
      ],
      "compute": [
        {
          "as": "repository-slug",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "workflows",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-workflows"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "disabled",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-disabled"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "failed",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-failed"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "imported-runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-imported-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "ingestion-rate",
          "function": "quotient",
          "args": [
            {
              "field": "imported-runs"
            },
            {
              "field": "runs"
            }
          ]
        },
        {
          "as": "ingestion",
          "function": "format-percent",
          "args": [
            {
              "field": "ingestion-rate"
            }
          ]
        },
        {
          "as": "action-required",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-action-required"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "aic",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-aic"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "has-failures",
          "function": "greater-than",
          "args": [
            {
              "field": "failed"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "has-action-required",
          "function": "greater-than",
          "args": [
            {
              "field": "action-required"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "has-runs",
          "function": "greater-than",
          "args": [
            {
              "field": "runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "has-disabled",
          "function": "greater-than",
          "args": [
            {
              "field": "disabled"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "outcomes-observed",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-reports"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "has-outcomes",
          "function": "greater-than",
          "args": [
            {
              "field": "outcomes-observed"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "failure-rate",
          "function": "quotient",
          "args": [
            {
              "field": "failed"
            },
            {
              "field": "runs"
            }
          ]
        },
        {
          "as": "failure-percent",
          "function": "format-percent",
          "args": [
            {
              "field": "failure-rate"
            }
          ]
        },
        {
          "as": "failure-count",
          "function": "format-count",
          "args": [
            {
              "field": "failed"
            }
          ]
        },
        {
          "as": "observed-failure-summary",
          "function": "concat",
          "args": [
            {
              "field": "failure-percent"
            },
            {
              "value": " · "
            },
            {
              "field": "failure-count"
            },
            {
              "value": " failed"
            }
          ]
        },
        {
          "as": "failure-summary",
          "function": "if",
          "args": [
            {
              "field": "has-runs"
            },
            {
              "field": "observed-failure-summary"
            },
            {
              "value": "—"
            }
          ]
        },
        {
          "as": "outcome-status",
          "function": "if",
          "args": [
            {
              "field": "has-outcomes"
            },
            {
              "value": "Outcomes observed"
            },
            {
              "value": "No recent activity"
            }
          ]
        },
        {
          "as": "disabled-status",
          "function": "if",
          "args": [
            {
              "field": "has-disabled"
            },
            {
              "value": "Disabled workflows"
            },
            {
              "field": "outcome-status"
            }
          ]
        },
        {
          "as": "run-status",
          "function": "if",
          "args": [
            {
              "field": "has-runs"
            },
            {
              "value": "No failures observed"
            },
            {
              "field": "disabled-status"
            }
          ]
        },
        {
          "as": "action-status",
          "function": "if",
          "args": [
            {
              "field": "has-action-required"
            },
            {
              "value": "Approval required"
            },
            {
              "field": "run-status"
            }
          ]
        },
        {
          "as": "status",
          "function": "if",
          "args": [
            {
              "field": "has-failures"
            },
            {
              "value": "Needs attention"
            },
            {
              "field": "action-status"
            }
          ]
        },
        {
          "as": "encoded-repository",
          "function": "url-encode",
          "args": [
            {
              "field": "repository-slug"
            }
          ]
        },
        {
          "as": "repository-dashboard-href",
          "function": "concat",
          "args": [
            {
              "value": "#page-repository-detail?repository="
            },
            {
              "field": "encoded-repository"
            }
          ]
        },
        {
          "as": "repository-dashboard-label",
          "function": "concat",
          "args": [
            {
              "value": "View "
            },
            {
              "field": "repository-slug"
            },
            {
              "value": " repository dashboard"
            }
          ]
        },
        {
          "as": "repository-dashboard-link",
          "function": "dashboard-link",
          "args": [
            {
              "field": "repository-link"
            },
            {
              "field": "repository-dashboard-href"
            },
            {
              "field": "repository-dashboard-label"
            },
            {
              "field": "repository-slug"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "organization"
        },
        {
          "field": "repository",
          "as": "repository-name"
        },
        {
          "field": "repository-slug",
          "as": "repository"
        },
        {
          "field": "workflows"
        },
        {
          "field": "observed-reports",
          "as": "reports"
        },
        {
          "field": "runs"
        },
        {
          "field": "ingestion"
        },
        {
          "field": "failure-summary"
        },
        {
          "field": "aic"
        },
        {
          "field": "status"
        },
        {
          "field": "repository-dashboard-link",
          "as": "repository-link"
        },
        {
          "field": "failed"
        }
      ],
      "order-by": [
        {
          "field": "failed",
          "direction": "desc"
        },
        {
          "field": "runs",
          "direction": "desc"
        },
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    }
  ]
}
