{
  "page": {
    "id": "indexing",
    "kind": "custom",
    "title": "Indexing",
    "navigation-label": "Indexing",
    "icon": "database",
    "experimental": true,
    "description": "Monitor CAO Activity ingestion and inspect retained dashboard transactions.",
    "views": [
      {
        "id": "indexing-database-table-counts",
        "title": "Database table counts",
        "description": "Rows retained by dashboard database table, including ingestion transactions.",
        "data": {
          "source": "indexing-database-table-counts",
          "limit": 100
        },
        "mark": "chart",
        "chart": "horizontal-bar",
        "layout": "full",
        "empty-message": "No canonical dashboard rows have been retained.",
        "encoding": {
          "x": {
            "field": "table",
            "type": "nominal",
            "title": "Table"
          },
          "y": {
            "field": "records",
            "type": "quantitative",
            "title": "Rows"
          }
        }
      },
      {
        "id": "indexing-size",
        "title": "Indexed data over time",
        "description": "New workflow runs and records retained from CAO Activity each day.",
        "data": {
          "source": "indexing-daily-records"
        },
        "mark": "chart",
        "chart": "bar",
        "layout": "full",
        "empty-message": "No CAO Activity ingestion history has been retained.",
        "encoding": {
          "x": {
            "field": "day",
            "type": "nominal",
            "title": "Indexed"
          },
          "y": {
            "field": "records",
            "type": "quantitative",
            "title": "New records"
          }
        }
      },
      {
        "id": "indexing-workflow-runs",
        "title": "Workflow runs indexed",
        "description": "New workflow runs retained from CAO Activity each day.",
        "data": {
          "source": "indexing-daily-workflow-runs"
        },
        "mark": "chart",
        "chart": "bar",
        "layout": "full",
        "empty-message": "No CAO Activity workflow-run history has been retained.",
        "encoding": {
          "x": {
            "field": "day",
            "type": "nominal",
            "title": "Indexed"
          },
          "y": {
            "field": "workflow-runs",
            "type": "quantitative",
            "title": "New workflow runs"
          }
        }
      },
      {
        "id": "transaction-entries",
        "title": "Ingestion transactions",
        "description": "Retained transactions show the time, committed record volume, and payload hash for each ingestion operation.",
        "data": {
          "source": "indexing-transactions",
          "order-by": [
            {
              "field": "created-at",
              "direction": "desc"
            }
          ]
        },
        "mark": "list",
        "list": {
          "style": "entity-cards",
          "card": "ingestion-transaction",
          "icon": "database"
        },
        "layout": "full",
        "empty-message": "No ingestion transactions have been retained.",
        "encoding": {
          "columns": [
            {
              "field": "created-at",
              "type": "temporal",
              "title": "Committed at",
              "format": "human-friendly-timestamp"
            },
            {
              "field": "committed-records",
              "type": "quantitative",
              "title": "Committed records"
            },
            {
              "field": "payload-hash",
              "type": "nominal",
              "title": "Payload hash"
            }
          ]
        }
      }
    ]
  },
  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "indexing-daily-records",
      "intent": "Aggregate records committed from CAO Activity by ingestion UTC day.",
      "from": "transactions",
      "filter": {
        "predicates": [
          {
            "field": "kind",
            "in": [
              "ingest-jsonl",
              "ingest-normalized-jsonl"
            ]
          }
        ]
      },
      "compute": [
        {
          "as": "day",
          "function": "date-day",
          "args": [
            {
              "field": "createdAt"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "day"
        ],
        "values": [
          {
            "field": "committedRecords",
            "as": "records",
            "reducer": "sum"
          }
        ]
      },
      "order-by": [
        {
          "field": "day",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "indexing-daily-workflow-runs",
      "intent": "Aggregate workflow runs ingested from CAO Activity by UTC day.",
      "from": "transactions",
      "filter": {
        "predicates": [
          {
            "field": "kind",
            "in": [
              "ingest-jsonl",
              "ingest-normalized-jsonl"
            ]
          }
        ]
      },
      "compute": [
        {
          "as": "day",
          "function": "date-day",
          "args": [
            {
              "field": "createdAt"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "day"
        ],
        "values": [
          {
            "field": "rawRuns",
            "as": "workflow-runs",
            "reducer": "sum"
          }
        ]
      },
      "order-by": [
        {
          "field": "day",
          "direction": "asc"
        }
      ]
    },
