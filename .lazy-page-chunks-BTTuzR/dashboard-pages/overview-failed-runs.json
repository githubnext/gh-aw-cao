{
  "page": {
    "id": "overview-failed-runs",
    "kind": "custom",
    "title": "Failed runs",
    "icon": "x-circle",
    "description": "Runs in the selected horizon that ended in a failure state and need investigation.",
    "route": {
      "navigation-page": "overview"
    },
    "views": [
      {
        "id": "overview-failed-runs-ledger",
        "title": "Failed run evidence",
        "description": "Open a run on GitHub to inspect its jobs, logs, and retained evidence.",
        "data": {
          "source": "failed-runs",
          "filters": {
            "run-conclusion": [
              "failure",
              "startup-failure",
              "stale",
              "timed-out"
            ]
          },
          "order-by": [
            {
              "field": "started-at",
              "direction": "desc"
            }
          ]
        },
        "mark": "table",
        "controls": "interactive",
        "lazy-list": true,
        "column-summaries": true,
        "empty-message": "No failed runs were observed in the selected horizon.",
        "layout": "full-view",
        "encoding": {
          "columns": [
            {
              "field": "started-at",
              "type": "temporal",
              "format": "human-friendly-timestamp",
              "title": "Date"
            },
            {
              "field": "repository",
              "type": "nominal",
              "title": "Repository"
            },
            {
              "field": "run",
              "type": "nominal",
              "title": "Workflow run"
            },
            {
              "field": "failure-detail",
              "type": "nominal",
              "title": "Error"
            }
          ]
        }
      }
    ]
  },
  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "failure-run-base",
      "intent": "Reuse shared query stages for failed-runs, overview-failing-runs",
      "from": "runs",
      "filter": {
        "predicates": [
          {
            "field": "run-conclusion",
            "in": [
              "failure",
              "startup-failure",
              "stale",
              "timed-out"
            ]
          }
        ]
      }
    },
    {
      "name": "failed-runs",
      "intent": "List failed workflow runs that need operator attention.",
      "from": "failure-run-base",
      "order-by": [
        {
          "field": "started-at",
          "direction": "desc"
        }
      ]
    }
  ]
}
