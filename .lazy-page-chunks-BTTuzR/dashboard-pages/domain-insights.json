{
  "page": {
    "id": "domain-insights",
    "kind": "custom",
    "title": "Domain",
    "icon": "graph",
    "description": "Insights for the selected domain entity.",
    "route": {
      "hash-query-parameter": "domain",
      "navigation-page": "firewall",
      "tab": "insights",
      "tabs": [
        {
          "id": "insights",
          "label": "Insights",
          "icon": "graph",
          "page": "domain-insights"
        },
        {
          "id": "runs",
          "label": "Runs",
          "icon": "play",
          "page": "domain-runs"
        }
      ]
    },
    "views": [
      {
        "id": "domain-route-chrome",
        "title": "Domain insights",
        "data": {
          "sources": [
            "domains"
          ],
          "arguments": [
            {
              "name": "domain",
              "field": "domain"
            }
          ]
        },
        "mark": "element",
        "element": "entity-route",
        "layout": "full",
        "title-link": {
          "href-field": "run-link",
          "identifier-field": "domain"
        }
      },
      {
        "id": "domain-insights-chart",
        "title": "Requests by firewall decision",
        "data": {
          "source": "domain-entity-insights",
          "arguments": [
            {
              "name": "domain",
              "field": "domain"
            }
          ]
        },
        "mark": "chart",
        "chart": "bar",
        "layout": "full",
        "encoding": {
          "x": {
            "field": "decision",
            "type": "nominal",
            "title": "Decision"
          },
          "y": {
            "field": "requests",
            "type": "quantitative",
            "title": "Requests"
          }
        }
      }
    ]
  },
  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "domain-entity-insights",
      "intent": "Summarize one domain entity for its dedicated Insights view.",
      "from": "domains",
      "aggregate": {
        "by": [
          "domain",
          "decision"
        ],
        "values": [
          {
            "field": "request-count",
            "as": "requests",
            "reducer": "sum"
          }
        ]
      },
      "order-by": [
        {
          "field": "requests",
          "direction": "desc"
        },
        {
          "field": "decision",
          "direction": "asc"
        }
      ]
    }
  ]
}
