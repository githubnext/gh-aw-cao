{
  "page": {
    "id": "maintenance",
    "kind": "custom",
    "title": "Updates",
    "navigation-label": "Updates",
    "navigation-indicator": {
      "label": "updates available",
      "any": [
        "maintenance-campaign-updates",
        "maintenance-repository-upgrades"
      ]
    },
    "icon": "tools",
    "class-name": "maintenance-page",
    "description": "Review CAO campaign packages and gh-aw compiler versions. Active describes registration only; update confidence is reported separately. If version provenance is unknown, run CAO Activity to refresh inventory, then inspect Indexing diagnostics.",
    "views": [
      {
        "id": "maintenance-campaigns",
        "title": "CAO packages",
        "description": "Installed campaign revisions and the latest catalog revisions observed for this control repository. Unknown update confidence does not mean the package is current.",
        "data": {
          "source": "campaigns"
        },
        "mark": "list",
        "empty-message": "No CAO campaign packages were observed.",
        "encoding": {
          "columns": [
            {
              "field": "campaign-name",
              "type": "nominal",
              "title": "Package"
            },
            {
              "field": "campaign-version",
              "type": "nominal",
              "title": "Installed"
            },
            {
              "field": "campaign-current-version",
              "type": "nominal",
              "title": "Latest"
            },
            {
              "field": "campaign-update-state",
              "type": "nominal",
              "title": "Update confidence",
              "display": "status"
            },
            {
              "field": "campaign-registration",
              "type": "nominal",
              "title": "Registration",
              "display": "active-state"
            }
          ]
        },
        "layout": "full",
        "list": {
          "style": "entity-cards",
          "card": "maintenance-campaign",
          "icon": "workflow",
          "action": "update-repository"
        }
      },
      {
        "id": "maintenance-repositories",
        "title": "Repositories",
        "description": "Installed and current gh-aw compiler versions observed for each repository.",
        "data": {
          "source": "maintenance-repositories"
        },
        "mark": "list",
        "empty-message": "No Agentic Workflow compiler versions were observed.",
        "encoding": {
          "columns": [
            {
              "field": "repository",
              "type": "nominal",
              "title": "Repository"
            },
            {
              "field": "gh-aw-version",
              "type": "nominal",
              "title": "Installed"
            },
            {
              "field": "gh-aw-current-version",
              "type": "nominal",
              "title": "Latest"
            },
            {
              "field": "upgrade-state",
              "type": "nominal",
              "title": "Upgrade",
              "display": "status"
            }
          ]
        },
        "layout": "full",
        "list": {
          "style": "entity-cards",
          "card": "maintenance-repository",
          "icon": "repo",
          "action": "upgrade-repository"
        }
      }
    ]
  },
  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    }
  ]
}
