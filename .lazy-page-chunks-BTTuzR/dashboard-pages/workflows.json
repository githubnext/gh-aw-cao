{
  "page": {
    "id": "workflows",
    "kind": "built-in",
    "page": "workflows",
    "title": "Workflows",
    "icon": "workflow",
    "description": "Inspect declared central campaign and repository-owned workflow relationships. This inventory does not assert that a dispatch occurred.",
    "definition": {
      "data-state": {
        "availability": true
      },
      "views": [
        {
          "id": "workflows-by-aic-per-run",
          "title": "Average AIC per run by workflow",
          "description": "Declared workflows ranked by average AI Credit cost per observed run.",
          "data": {
            "source": "workflow-aic-per-run",
            "order-by": [
              {
                "field": "aic-per-run",
                "direction": "desc"
              }
            ],
            "limit": 10
          },
          "mark": "chart",
          "chart": "horizontal-bar",
          "layout": "full",
          "empty-message": "No workflow AI Credit cost data is available.",
          "encoding": {
            "x": {
              "field": "workflow-label",
              "type": "nominal",
              "format": "workflow-identity-label",
              "title": "Workflow"
            },
            "y": {
              "field": "aic-per-run",
              "type": "quantitative",
              "title": "Average AIC per run",
              "unit": "aic-per-run"
            },
            "href": {
              "field": "workflow-link",
              "type": "nominal"
            }
          }
        },
        {
          "id": "workflows-inventory",
          "title": "Workflows",
          "description": "Declared workflows across the configured repository scope.",
          "data": {
            "source": "workflow-inventory"
          },
          "mark": "table",
          "controls": "interactive",
          "lazy-list": true,
          "column-summaries": true,
          "layout": "full-view",
          "empty-message": "No workflows observed.",
          "encoding": {
            "columns": [
              {
                "field": "workflow-name",
                "type": "nominal",
                "title": "Workflow",
                "display": "workflow-link"
              },
              {
                "field": "workflow",
                "type": "nominal",
                "title": "Workflow file",
                "format": "workflow-relative-path"
              },
              {
                "field": "repository",
                "type": "nominal",
                "title": "Repository",
                "display": "repository-link"
              },
              {
                "field": "campaign-name",
                "type": "nominal",
                "title": "Campaign"
              },
              {
                "field": "workflow-role",
                "type": "nominal",
                "title": "Role"
              },
              {
                "field": "rollout-mode",
                "type": "nominal",
                "title": "Mode",
                "display": "mode"
              },
              {
                "field": "workflow-active",
                "type": "nominal",
                "title": "State",
                "display": "active-state"
              },
              {
                "field": "aic",
                "type": "quantitative",
                "title": "AIC",
                "unit": "aic"
              },
              {
                "field": "runs",
                "type": "quantitative",
                "title": "Runs"
              },
              {
                "field": "successful-runs",
                "type": "quantitative",
                "title": "Success"
              },
              {
                "field": "failed-runs",
                "type": "quantitative",
                "title": "Failures"
              },
              {
                "field": "aic-per-run",
                "type": "quantitative",
                "title": "Average AIC",
                "unit": "aic-per-run"
              },
              {
                "field": "ingestion",
                "type": "nominal",
                "title": "Ingestion"
              }
            ]
          }
        }
      ]
    }
  },
  "queries": [
    {
      "name": "event-base",
      "intent": "Reuse shared query stages for entity-events, event-runs",
      "from": "audits",
      "union": [
        "domains",
        "tools",
        "issues"
      ]
    },
    {
      "name": "event-runs",
      "intent": "Identify each workflow run that has one or more imported run-owned records.",
      "description": "Distinct workflow runs represented by imported domain, tool, audit, or issue records.",
      "from": "event-base",
      "aggregate": {
        "by": [
          "organization",
          "repository",
          "workflow",
          "run",
          "run-attempt"
        ],
        "values": [
          {
            "field": "event",
            "as": "events",
            "reducer": "count"
          }
        ]
      }
    },
    {
      "name": "run-import-status",
      "intent": "Identify observed runs that have one or more imported run-owned records.",
      "description": "Observed runs enriched with imported-record status.",
      "from": "runs",
      "joins": [
        {
          "source": "event-runs",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            },
            {
              "left": "run",
              "right": "run"
            },
            {
              "left": "run-attempt",
              "right": "run-attempt"
            }
          ],
          "fields": [
            {
              "field": "events",
              "as": "imported-events"
            }
          ]
        }
      ],
      "compute": [
        {
          "as": "imported-event-count",
          "function": "coalesce",
          "args": [
            {
              "field": "imported-events"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "imported",
          "function": "greater-than",
          "args": [
            {
              "field": "imported-event-count"
            },
            {
              "value": 0
            }
          ]
        }
      ]
    },
    {
      "name": "workflow-run-totals",
      "intent": "Summarize observed run counts and imported runs by declared workflow.",
      "description": "Observed run and imported-run totals for each declared workflow.",
      "from": "run-import-status",
      "compute": [
        {
          "as": "run-attempt-identity",
          "function": "concat",
          "args": [
            {
              "field": "run"
            },
            {
              "value": ":"
            },
            {
              "field": "run-attempt"
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "organization",
          "repository",
          "workflow"
        ],
        "values": [
          {
            "field": "run-attempt-identity",
            "as": "runs",
            "reducer": "distinct-count"
          },
          {
            "field": "run-conclusion",
            "as": "successful-runs",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "run-conclusion",
                  "equals": "success"
                }
              ]
            }
          },
          {
            "field": "run-conclusion",
            "as": "failed-runs",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "run-conclusion",
                  "in": [
                    "failure",
                    "startup-failure",
                    "stale",
                    "timed-out"
                  ]
                }
              ]
            }
          },
          {
            "field": "imported",
            "as": "imported-runs",
            "reducer": "sum"
          }
        ]
      }
    },
    {
      "name": "workflow-aic-totals",
      "intent": "Summarize observed AI Credit usage by declared workflow.",
      "description": "Observed AI Credit totals for each declared workflow.",
      "from": "runs",
      "aggregate": {
        "by": [
          "organization",
          "repository",
          "workflow"
        ],
        "values": [
          {
            "field": "aic-total",
            "as": "aic",
            "reducer": "sum"
          }
        ]
      }
    },
    {
      "name": "workflow-inventory",
      "intent": "List declared workflows with their campaign, repository, configuration, and observed execution totals.",
      "description": "Central campaign and repository-owned workflow inventory with observed execution totals.",
      "from": "workflows",
      "joins": [
        {
          "source": "workflow-run-totals",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            }
          ],
          "fields": [
            {
              "field": "runs",
              "as": "observed-runs"
            },
            {
              "field": "successful-runs",
              "as": "observed-successful-runs"
            },
            {
              "field": "failed-runs",
              "as": "observed-failed-runs"
            },
            {
              "field": "imported-runs",
              "as": "observed-imported-runs"
            }
          ]
        },
        {
          "source": "workflow-aic-totals",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            }
          ],
          "fields": [
            {
              "field": "aic",
              "as": "observed-aic"
            }
          ]
        }
      ],
      "compute": [
        {
          "as": "campaign-title",
          "function": "title-case",
          "args": [
            {
              "field": "campaign"
            }
          ]
        },
        {
          "as": "campaign-display-name",
          "function": "coalesce",
          "args": [
            {
              "field": "campaign-name"
            },
            {
              "field": "campaign-title"
            },
            {
              "value": "Repository-owned"
            }
          ]
        },
        {
          "as": "repository-slug",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "workflow-display-name",
          "function": "coalesce",
          "args": [
            {
              "field": "workflow-name"
            },
            {
              "field": "workflow"
            }
          ]
        },
        {
          "as": "declared-role",
          "function": "coalesce",
          "args": [
            {
              "field": "workflow-role"
            },
            {
              "value": "standalone"
            }
          ]
        },
        {
          "as": "declared-mode",
          "function": "coalesce",
          "args": [
            {
              "field": "rollout-mode"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "declared-registration",
          "function": "coalesce",
          "args": [
            {
              "field": "workflow-active"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "total-runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "total-successful-runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-successful-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "has-observed-runs",
          "function": "greater-than",
          "args": [
            {
              "field": "total-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "total-failed-runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-failed-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "total-aic",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-aic"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "aic-per-run",
          "function": "quotient",
          "args": [
            {
              "field": "total-aic"
            },
            {
              "field": "total-runs"
            }
          ]
        },
        {
          "as": "total-imported-runs",
          "function": "coalesce",
          "args": [
            {
              "field": "observed-imported-runs"
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "ingestion-rate",
          "function": "quotient",
          "args": [
            {
              "field": "total-imported-runs"
            },
            {
              "field": "total-runs"
            }
          ]
        },
        {
          "as": "ingestion",
          "function": "format-percent",
          "args": [
            {
              "field": "ingestion-rate"
            }
          ]
        },
        {
          "as": "encoded-campaign",
          "function": "url-encode",
          "args": [
            {
              "field": "campaign"
            }
          ]
        },
        {
          "as": "campaign-dashboard-href",
          "function": "concat",
          "args": [
            {
              "value": "#page-campaign-insights?campaign="
            },
            {
              "field": "encoded-campaign"
            }
          ]
        },
        {
          "as": "campaign-dashboard-label",
          "function": "concat",
          "args": [
            {
              "value": "View "
            },
            {
              "field": "campaign-display-name"
            },
            {
              "value": " campaign dashboard"
            }
          ]
        },
        {
          "as": "campaign-dashboard-link",
          "function": "dashboard-link",
          "args": [
            {
              "field": "repository-link"
            },
            {
              "field": "campaign-dashboard-href"
            },
            {
              "field": "campaign-dashboard-label"
            },
            {
              "field": "campaign"
            }
          ]
        },
        {
          "as": "encoded-repository",
          "function": "url-encode",
          "args": [
            {
              "field": "repository-slug"
            }
          ]
        },
        {
          "as": "repository-dashboard-href",
          "function": "concat",
          "args": [
            {
              "value": "#page-repository-detail?repository="
            },
            {
              "field": "encoded-repository"
            }
          ]
        },
        {
          "as": "repository-dashboard-label",
          "function": "concat",
          "args": [
            {
              "value": "View "
            },
            {
              "field": "repository-slug"
            },
            {
              "value": " repository dashboard"
            }
          ]
        },
        {
          "as": "repository-dashboard-link",
          "function": "dashboard-link",
          "args": [
            {
              "field": "repository-link"
            },
            {
              "field": "repository-dashboard-href"
            },
            {
              "field": "repository-dashboard-label"
            },
            {
              "field": "repository-slug"
            }
          ]
        },
        {
          "as": "workflow-identity",
          "function": "concat",
          "args": [
            {
              "field": "repository-slug"
            },
            {
              "value": ":"
            },
            {
              "field": "workflow"
            }
          ]
        },
        {
          "as": "encoded-workflow",
          "function": "url-encode",
          "args": [
            {
              "field": "workflow-identity"
            }
          ]
        },
        {
          "as": "workflow-dashboard-href",
          "function": "concat",
          "args": [
            {
              "value": "#page-workflow-runtime?workflow="
            },
            {
              "field": "encoded-workflow"
            }
          ]
        },
        {
          "as": "workflow-dashboard-label",
          "function": "concat",
          "args": [
            {
              "value": "View "
            },
            {
              "field": "workflow-display-name"
            },
            {
              "value": " workflow dashboard"
            }
          ]
        },
        {
          "as": "workflow-dashboard-link",
          "function": "dashboard-link",
          "args": [
            {
              "field": "workflow-link"
            },
            {
              "field": "workflow-dashboard-href"
            },
            {
              "field": "workflow-dashboard-label"
            },
            {
              "field": "workflow-identity"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "campaign"
        },
        {
          "field": "campaign-display-name",
          "as": "campaign-name"
        },
        {
          "field": "organization"
        },
        {
          "field": "repository-slug",
          "as": "repository"
        },
        {
          "field": "workflow"
        },
        {
          "field": "workflow-display-name",
          "as": "workflow-name"
        },
        {
          "field": "workflow-identity",
          "as": "workflow-label"
        },
        {
          "field": "declared-role",
          "as": "workflow-role"
        },
        {
          "field": "declared-mode",
          "as": "rollout-mode"
        },
        {
          "field": "declared-registration",
          "as": "workflow-active"
        },
        {
          "field": "total-aic",
          "as": "aic"
        },
        {
          "field": "total-runs",
          "as": "runs"
        },
        {
          "field": "total-successful-runs",
          "as": "successful-runs"
        },
        {
          "field": "total-failed-runs",
          "as": "failed-runs"
        },
        {
          "field": "aic-per-run"
        },
        {
          "field": "has-observed-runs"
        },
        {
          "field": "ingestion"
        },
        {
          "field": "campaign-dashboard-link",
          "as": "campaign-link"
        },
        {
          "field": "repository-dashboard-link",
          "as": "repository-link"
        },
        {
          "field": "workflow-dashboard-link",
          "as": "workflow-link"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        },
        {
          "field": "workflow",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "workflow-aic-per-run",
      "intent": "List declared workflows with observed runs and their average AI Credit cost per run.",
      "description": "Workflow AI Credit averages limited to workflows with at least one observed run.",
      "from": "workflow-inventory",
      "filter": {
        "predicates": [
          {
            "field": "has-observed-runs",
            "equals": true
          }
        ]
      }
    }
  ]
}
