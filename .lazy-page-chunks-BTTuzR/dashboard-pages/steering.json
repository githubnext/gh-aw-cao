{
  "page": {
    "id": "steering",
    "kind": "custom",
    "title": "Steering",
    "navigation-label": "Steering",
    "icon": "stopwatch",
    "experimental": true,
    "class-name": "steering-page",
    "description": "Gateway steering warnings injected when agentic runs approach their AI Credit budget, their time limit, or another declared limit.",
    "views": [
      {
        "id": "steering-type-breakdown",
        "title": "Steering types",
        "description": "The share of observed steering warnings by steering type, such as running out of tokens or running out of time.",
        "data": {
          "source": "steering-type-totals",
          "limit": 10
        },
        "mark": "chart",
        "chart": "pie",
        "layout": "full",
        "empty-message": "No steering warnings were observed in the selected horizon.",
        "encoding": {
          "x": {
            "field": "steering-type",
            "type": "nominal",
            "title": "Steering type"
          },
          "y": {
            "field": "events",
            "type": "quantitative",
            "title": "Steering events"
          }
        }
      },
      {
        "id": "steering-top-workflows",
        "title": "Workflows with the most steering",
        "description": "The ten workflows with the highest observed steering warning totals.",
        "data": {
          "source": "steering-top-workflows",
          "limit": 10
        },
        "mark": "chart",
        "chart": "horizontal-bar",
        "layout": "full",
        "empty-message": "No workflow steering warnings were observed in the selected horizon.",
        "encoding": {
          "x": {
            "field": "workflow-coordinate",
            "type": "nominal",
            "title": "Workflow",
            "format": "workflow-identity-label"
          },
          "y": {
            "field": "events",
            "type": "quantitative",
            "title": "Steering events"
          },
          "href": {
            "field": "workflow-dashboard-link"
          }
        }
      },
      {
        "id": "steering-workflows",
        "title": "Workflows with steering entries",
        "description": "Observed steering warnings by workflow, split into token-budget and time-limit warnings.",
        "data": {
          "source": "steering-workflows"
        },
        "mark": "table",
        "controls": "interactive",
        "lazy-list": true,
        "column-summaries": true,
        "layout": "full-view",
        "empty-message": "No workflow steering warnings were observed in the selected horizon.",
        "encoding": {
          "columns": [
            {
              "field": "workflow-dashboard-link",
              "type": "nominal",
              "title": "Workflow"
            },
            {
              "field": "repository",
              "type": "nominal",
              "title": "Repository"
            },
            {
              "field": "events",
              "type": "quantitative",
              "title": "Steering events"
            },
            {
              "field": "token-events",
              "type": "quantitative",
              "title": "Out of tokens"
            },
            {
              "field": "time-events",
              "type": "quantitative",
              "title": "Out of time"
            },
            {
              "field": "runs",
              "type": "quantitative",
              "title": "Runs"
            }
          ]
        }
      }
    ]
  },
  "queries": [
    {
      "name": "maintenance-repository-versions",
      "intent": "Group installed and current gh-aw compiler versions and upgrade evidence by repository.",
      "from": "workflows",
      "filter": {
        "predicates": [
          {
            "field": "workflow",
            "includes": ".md"
          }
        ]
      },
      "compute": [
        {
          "as": "repository-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            }
          ]
        },
        {
          "as": "update-available",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "update-available"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown",
          "function": "equals-any",
          "args": [
            {
              "field": "gh-aw-update-state"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "upgrade-state-unknown-value",
          "function": "if",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        },
        {
          "as": "upgrade-required-value",
          "function": "if",
          "args": [
            {
              "field": "update-available"
            },
            {
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      ],
      "aggregate": {
        "by": [
          "repository-coordinate"
        ],
        "values": [
          {
            "field": "gh-aw-version",
            "as": "gh-aw-version",
            "reducer": "distinct-list"
          },
          {
            "field": "gh-aw-current-version",
            "as": "gh-aw-current-version",
            "reducer": "distinct-list"
          },
          {
            "field": "upgrade-required-value",
            "as": "upgrade-required",
            "reducer": "max"
          },
          {
            "field": "upgrade-state-unknown-value",
            "as": "upgrade-state-unknown",
            "reducer": "max"
          }
        ]
      }
    },
    {
      "name": "maintenance-repositories",
      "intent": "List each repository with compiler versions and an explicit upgrade recommendation.",
      "from": "maintenance-repository-versions",
      "compute": [
        {
          "as": "should-upgrade",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-required"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "upgrade-status-unavailable",
          "function": "equals-any",
          "args": [
            {
              "field": "upgrade-state-unknown"
            },
            {
              "value": 1
            }
          ]
        },
        {
          "as": "current-or-unavailable",
          "function": "if",
          "args": [
            {
              "field": "upgrade-status-unavailable"
            },
            {
              "value": "Upgrade status unavailable"
            },
            {
              "value": "Current"
            }
          ]
        },
        {
          "as": "upgrade-state",
          "function": "if",
          "args": [
            {
              "field": "should-upgrade"
            },
            {
              "value": "Upgrade recommended"
            },
            {
              "field": "current-or-unavailable"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "repository-coordinate",
          "as": "repository"
        },
        {
          "field": "gh-aw-version"
        },
        {
          "field": "gh-aw-current-version"
        },
        {
          "field": "upgrade-required"
        },
        {
          "field": "upgrade-state"
        }
      ],
      "order-by": [
        {
          "field": "repository",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "maintenance-campaign-updates",
      "intent": "Expose at most one CAO package update row for the Updates navigation indicator.",
      "from": "campaigns",
      "filter": {
        "predicates": [
          {
            "field": "campaign-update-state",
            "equals": "update-available"
          }
        ]
      },
      "select": [
        {
          "field": "campaign-update-state"
        }
      ],
      "limit": 1
    },
    {
      "name": "maintenance-repository-upgrades",
      "intent": "Expose at most one gh-aw compiler upgrade row for the Updates navigation indicator.",
      "from": "maintenance-repositories",
      "filter": {
        "predicates": [
          {
            "field": "upgrade-required",
            "equals": 1
          }
        ]
      },
      "select": [
        {
          "field": "upgrade-required"
        }
      ],
      "limit": 1
    },
    {
      "name": "steering-events",
      "intent": "Prepare observed gateway steering warnings for aggregation by steering type and workflow.",
      "description": "Gateway steering warnings emitted when a run approaches its AI Credit budget, time limit, or another declared limit, labelled with a readable steering type.",
      "from": "audits",
      "filter": {
        "predicates": [
          {
            "field": "event-type",
            "equals": "audit.gateway_steering"
          }
        ]
      },
      "joins": [
        {
          "source": "workflows",
          "type": "left",
          "on": [
            {
              "left": "organization",
              "right": "organization"
            },
            {
              "left": "repository",
              "right": "repository"
            },
            {
              "left": "workflow",
              "right": "workflow"
            }
          ],
          "fields": [
            {
              "field": "campaign",
              "as": "campaign"
            },
            {
              "field": "workflow-name",
              "as": "workflow-name"
            }
          ]
        }
      ],
      "compute": [
        {
          "as": "steering-code",
          "function": "coalesce",
          "args": [
            {
              "field": "code"
            },
            {
              "field": "event-status"
            },
            {
              "value": "unknown"
            }
          ]
        },
        {
          "as": "_token-steering",
          "function": "equals-any",
          "args": [
            {
              "field": "steering-code"
            },
            {
              "value": "token_steering"
            }
          ]
        },
        {
          "as": "_timeout-steering",
          "function": "equals-any",
          "args": [
            {
              "field": "steering-code"
            },
            {
              "value": "timeout_steering"
            }
          ]
        },
        {
          "as": "_turn-steering",
          "function": "equals-any",
          "args": [
            {
              "field": "steering-code"
            },
            {
              "value": "turn_steering"
            },
            {
              "value": "max_turns_steering"
            }
          ]
        },
        {
          "as": "_turn-steering-type",
          "function": "if",
          "args": [
            {
              "field": "_turn-steering"
            },
            {
              "value": "Running out of turns"
            },
            {
              "field": "steering-code"
            }
          ]
        },
        {
          "as": "_timeout-steering-type",
          "function": "if",
          "args": [
            {
              "field": "_timeout-steering"
            },
            {
              "value": "Running out of time"
            },
            {
              "field": "_turn-steering-type"
            }
          ]
        },
        {
          "as": "steering-type",
          "function": "if",
          "args": [
            {
              "field": "_token-steering"
            },
            {
              "value": "Running out of tokens"
            },
            {
              "field": "_timeout-steering-type"
            }
          ]
        },
        {
          "as": "workflow-coordinate",
          "function": "concat",
          "args": [
            {
              "field": "organization"
            },
            {
              "value": "/"
            },
            {
              "field": "repository"
            },
            {
              "value": ":"
            },
            {
              "field": "workflow"
            }
          ]
        },
        {
          "as": "workflow-label",
          "function": "coalesce",
          "args": [
            {
              "field": "workflow-name"
            },
            {
              "field": "workflow-coordinate"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "id"
        },
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "workflow"
        },
        {
          "field": "workflow-name"
        },
        {
          "field": "workflow-coordinate"
        },
        {
          "field": "workflow-label"
        },
        {
          "field": "campaign"
        },
        {
          "field": "run"
        },
        {
          "field": "run-link"
        },
        {
          "field": "steering-code"
        },
        {
          "field": "steering-type"
        },
        {
          "field": "event-summary"
        },
        {
          "field": "observed-at"
        }
      ]
    },
    {
      "name": "steering-type-totals",
      "intent": "Show how often each kind of steering warning occurred.",
      "description": "Observed gateway steering warnings grouped by steering type with the number of affected runs and workflows.",
      "from": "steering-events",
      "aggregate": {
        "by": [
          "steering-type",
          "steering-code"
        ],
        "values": [
          {
            "field": "id",
            "as": "events",
            "reducer": "count"
          },
          {
            "field": "run",
            "as": "runs",
            "reducer": "distinct-count"
          },
          {
            "field": "workflow-coordinate",
            "as": "workflows",
            "reducer": "distinct-count"
          }
        ]
      },
      "select": [
        {
          "field": "steering-type"
        },
        {
          "field": "steering-code"
        },
        {
          "field": "events"
        },
        {
          "field": "runs"
        },
        {
          "field": "workflows"
        }
      ],
      "order-by": [
        {
          "field": "events",
          "direction": "desc"
        },
        {
          "field": "steering-type",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "steering-workflow-totals",
      "intent": "Count steering warnings for each workflow.",
      "description": "Gateway steering warnings grouped by workflow, split into token-budget and time-limit warnings.",
      "from": "steering-events",
      "aggregate": {
        "by": [
          "workflow-coordinate",
          "organization",
          "repository",
          "workflow",
          "workflow-label",
          "campaign"
        ],
        "values": [
          {
            "field": "id",
            "as": "events",
            "reducer": "count"
          },
          {
            "field": "run",
            "as": "runs",
            "reducer": "distinct-count"
          },
          {
            "field": "id",
            "as": "token-events",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "steering-code",
                  "equals": "token_steering"
                }
              ]
            }
          },
          {
            "field": "id",
            "as": "time-events",
            "reducer": "count",
            "filter": {
              "predicates": [
                {
                  "field": "steering-code",
                  "equals": "timeout_steering"
                }
              ]
            }
          },
          {
            "field": "steering-type",
            "as": "steering-types",
            "reducer": "distinct-count"
          }
        ]
      },
      "order-by": [
        {
          "field": "events",
          "direction": "desc"
        },
        {
          "field": "workflow-coordinate",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "steering-workflows",
      "intent": "Present workflow steering totals with a link to each workflow dashboard.",
      "description": "Workflow steering totals labelled with a link to the workflow runtime page.",
      "from": "steering-workflow-totals",
      "compute": [
        {
          "as": "encoded-workflow",
          "function": "url-encode",
          "args": [
            {
              "field": "workflow-coordinate"
            }
          ]
        },
        {
          "as": "workflow-dashboard-href",
          "function": "concat",
          "args": [
            {
              "value": "#page-workflow-runtime?workflow="
            },
            {
              "field": "encoded-workflow"
            }
          ]
        },
        {
          "as": "workflow-dashboard-label",
          "function": "concat",
          "args": [
            {
              "value": "View "
            },
            {
              "field": "workflow-coordinate"
            },
            {
              "value": " workflow dashboard"
            }
          ]
        },
        {
          "as": "workflow-dashboard-link",
          "function": "dashboard-link",
          "args": [
            {
              "value": ""
            },
            {
              "field": "workflow-dashboard-href"
            },
            {
              "field": "workflow-dashboard-label"
            },
            {
              "field": "workflow-label"
            }
          ]
        }
      ],
      "select": [
        {
          "field": "workflow-coordinate"
        },
        {
          "field": "workflow-label"
        },
        {
          "field": "workflow-dashboard-link"
        },
        {
          "field": "organization"
        },
        {
          "field": "repository"
        },
        {
          "field": "campaign"
        },
        {
          "field": "events"
        },
        {
          "field": "runs"
        },
        {
          "field": "token-events"
        },
        {
          "field": "time-events"
        },
        {
          "field": "steering-types"
        }
      ],
      "order-by": [
        {
          "field": "events",
          "direction": "desc"
        },
        {
          "field": "workflow-coordinate",
          "direction": "asc"
        }
      ]
    },
    {
      "name": "steering-top-workflows",
      "intent": "Highlight the workflows with the most steering warnings.",
      "description": "The ten workflows with the highest observed gateway steering warning totals.",
      "from": "steering-workflows",
      "order-by": [
        {
          "field": "events",
          "direction": "desc"
        },
        {
          "field": "workflow-coordinate",
          "direction": "asc"
        }
      ],
      "limit": 10
    }
  ]
}
