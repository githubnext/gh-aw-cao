{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "eu-cra-compliance-dashboard",
    "title": "EU CRA",
    "description": "Track evidence-gathering runs, non-binding CRA reports, and explicit human acceptance across each assessment domain.",
    "repository": "githubnext/gh-aw-cao",
    "queries": [
      {
        "name": "eu-cra-assessment-runs",
        "intent": "Show EU CRA orchestrator, maintainer, and assessment-worker runs so operators can verify activation across every declared domain.",
        "from": "runs",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "in": [
                ".github/workflows/eu-cra-compliance.md",
                ".github/workflows/eu-cra-compliance-package-maintainer.md",
                ".github/workflows/eu-cra-compliance-scope-classifier.md",
                ".github/workflows/eu-cra-compliance-security-requirements-auditor.md",
                ".github/workflows/eu-cra-compliance-supply-chain-sbom-auditor.md",
                ".github/workflows/eu-cra-compliance-vulnerability-handling-auditor.md",
                ".github/workflows/eu-cra-compliance-article-14-reporting-readiness.md",
                ".github/workflows/eu-cra-compliance-conformity-release-evidence.md"
              ]
            }
          ]
        },
        "order-by": [
          {
            "field": "started-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "eu-cra-evidence-reports",
        "intent": "List retained EU CRA evidence reports for human review without presenting advisory findings as legal determinations or certifications.",
        "from": "outcomes",
        "filter": {
          "predicates": [
            {
              "field": "package",
              "equals": "eu-cra-compliance"
            }
          ]
        },
        "order-by": [
          {
            "field": "published-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "eu-cra-domain-attainment",
        "intent": "Show human-reviewed attainment for each EU CRA assessment domain while preserving stable opportunities, maturity, and evidence provenance.",
        "from": "operational-values",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "in": [
                ".github/workflows/eu-cra-compliance-package-maintainer.md",
                ".github/workflows/eu-cra-compliance-scope-classifier.md",
                ".github/workflows/eu-cra-compliance-security-requirements-auditor.md",
                ".github/workflows/eu-cra-compliance-supply-chain-sbom-auditor.md",
                ".github/workflows/eu-cra-compliance-vulnerability-handling-auditor.md",
                ".github/workflows/eu-cra-compliance-article-14-reporting-readiness.md",
                ".github/workflows/eu-cra-compliance-conformity-release-evidence.md"
              ]
            }
          ]
        },
        "order-by": [
          {
            "field": "observed-at",
            "direction": "desc"
          }
        ]
      }
    ],
    "pages": [
      {
        "id": "eu-cra-compliance-dashboard",
        "kind": "custom",
        "title": "EU CRA",
        "navigation-label": "EU CRA",
        "description": "Track evidence-gathering runs, non-binding CRA reports, and explicit human acceptance across each assessment domain.",
        "icon": "shield",
        "views": [
          {
            "id": "eu-cra-compliance-runs",
            "title": "Assessment runs by conclusion",
            "disclosure": "essential",
            "data": {
              "source": "eu-cra-assessment-runs",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/eu-cra-compliance.md",
                  ".github/workflows/eu-cra-compliance-package-maintainer.md",
                  ".github/workflows/eu-cra-compliance-scope-classifier.md",
                  ".github/workflows/eu-cra-compliance-security-requirements-auditor.md",
                  ".github/workflows/eu-cra-compliance-supply-chain-sbom-auditor.md",
                  ".github/workflows/eu-cra-compliance-vulnerability-handling-auditor.md",
                  ".github/workflows/eu-cra-compliance-article-14-reporting-readiness.md",
                  ".github/workflows/eu-cra-compliance-conformity-release-evidence.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "pie",
            "layout": "half",
            "encoding": {
              "x": {
                "field": "run-conclusion",
                "type": "nominal"
              },
              "y": {
                "field": "run",
                "type": "quantitative",
                "aggregate": "count"
              }
            }
          },
          {
            "id": "eu-cra-compliance-outcomes",
            "title": "CRA evidence reports",
            "description": "Reports retain scope and evidence gaps for human review; they are not legal determinations or certifications.",
            "disclosure": "essential",
            "data": {
              "source": "eu-cra-evidence-reports",
              "filters": {
                "package": [
                  "eu-cra-compliance"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No EU CRA evidence reports were retained.",
            "encoding": {
              "href": {
                "field": "external-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "outcome-title",
                  "type": "nominal",
                  "title": "Evidence report",
                  "display": "outcome-link"
                },
                {
                  "field": "outcome-state",
                  "type": "nominal",
                  "title": "Disposition",
                  "display": "status"
                },
                {
                  "field": "published-at",
                  "type": "temporal",
                  "title": "Published"
                }
              ],
              "actions": [
                {
                  "intent": "Review this advisory CRA evidence report, verify its retained evidence and limitations, and identify the next human decision.",
                  "presentation": "copy-prompt",
                  "icon": "search",
                  "label": "Review",
                  "context": [
                    "repository",
                    "outcome-title",
                    "outcome-summary",
                    "outcome-state",
                    "evidence-strength",
                    "published-at",
                    "external-link"
                  ]
                }
              ]
            }
          },
          {
            "id": "eu-cra-compliance-attainment",
            "disclosure-label": "Human-reviewed attainment evidence",
            "description": "Each domain preserves its stable target-commit opportunity, maturity state, and repository evidence link.",
            "disclosure": "supplemental",
            "data": {
              "source": "eu-cra-domain-attainment",
              "filters": {
                "workflow": [
                  ".github/workflows/eu-cra-compliance-package-maintainer.md",
                  ".github/workflows/eu-cra-compliance-scope-classifier.md",
                  ".github/workflows/eu-cra-compliance-security-requirements-auditor.md",
                  ".github/workflows/eu-cra-compliance-supply-chain-sbom-auditor.md",
                  ".github/workflows/eu-cra-compliance-vulnerability-handling-auditor.md",
                  ".github/workflows/eu-cra-compliance-article-14-reporting-readiness.md",
                  ".github/workflows/eu-cra-compliance-conformity-release-evidence.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No EU CRA attainment evidence is available.",
            "encoding": {
              "href": {
                "field": "evidence-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "operational-value-definition",
                  "type": "nominal",
                  "title": "Assessment domain"
                },
                {
                  "field": "operational-case",
                  "type": "nominal",
                  "title": "Opportunity"
                },
                {
                  "field": "operational-value",
                  "type": "quantitative",
                  "title": "Human acceptance"
                },
                {
                  "field": "maturity-status",
                  "type": "nominal",
                  "title": "Maturity",
                  "display": "status"
                },
                {
                  "field": "evidence-cutoff",
                  "type": "temporal",
                  "title": "Evidence cutoff"
                }
              ]
            }
          },
          {
            "id": "eu-cra-compliance-value-trend",
            "title": "Assessment-domain attainment trend",
            "description": "Mean attainment remains separated by evaluator definition and does not imply legal compliance or causation.",
            "disclosure": "essential",
            "data": {
              "source": "eu-cra-domain-attainment",
              "time": {
                "range": "90d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/eu-cra-compliance-package-maintainer.md",
                  ".github/workflows/eu-cra-compliance-scope-classifier.md",
                  ".github/workflows/eu-cra-compliance-security-requirements-auditor.md",
                  ".github/workflows/eu-cra-compliance-supply-chain-sbom-auditor.md",
                  ".github/workflows/eu-cra-compliance-vulnerability-handling-auditor.md",
                  ".github/workflows/eu-cra-compliance-article-14-reporting-readiness.md",
                  ".github/workflows/eu-cra-compliance-conformity-release-evidence.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "line",
            "layout": "full",
            "encoding": {
              "x": {
                "field": "observed-at",
                "type": "temporal",
                "time-unit": "day"
              },
              "y": {
                "field": "operational-value",
                "type": "quantitative",
                "aggregate": "mean"
              },
              "color": {
                "field": "operational-value-definition",
                "type": "nominal"
              }
            }
          }
        ]
      }
    ],
    "navigation": [
      {
        "label": "Package operations",
        "experimental": true,
        "pages": [
          "eu-cra-compliance-dashboard"
        ]
      }
    ]
  }
}
