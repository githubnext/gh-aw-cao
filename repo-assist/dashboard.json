{
  "language-version": "0.1.0",
  "dashboard": {
    "id": "repo-assist-dashboard",
    "title": "Repo Assist",
    "description": "Track Repo Assist activation, review work, and one-shot operational-value observations across issue triage, fixes, maintenance, and pull request upkeep.",
    "repository": "githubnext/gh-aw-cao",
    "queries": [
      {
        "name": "repo-assist-run-observations",
        "intent": "Show Repo Assist orchestrator and worker runs so operators can verify activation and investigate execution failures.",
        "from": "runs",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "in": [
                ".github/workflows/repo-assist.md",
                ".github/workflows/repo-assist-issue-triage.md",
                ".github/workflows/repo-assist-issue-fix.md",
                ".github/workflows/repo-assist-maintenance.md",
                ".github/workflows/repo-assist-pr-upkeep.md"
              ]
            }
          ]
        },
        "order-by": [
          {
            "field": "started-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "repo-assist-retained-outcomes",
        "intent": "List retained Repo Assist review items so maintainers can inspect the proposed action, evidence, and disposition.",
        "from": "outcomes",
        "filter": {
          "predicates": [
            {
              "field": "package",
              "equals": "repo-assist"
            }
          ]
        },
        "order-by": [
          {
            "field": "published-at",
            "direction": "desc"
          }
        ]
      },
      {
        "name": "repo-assist-value-observations",
        "intent": "Show one-shot decision-readiness observations for each measurable Repo Assist worker without treating requested actions as applied or accepted.",
        "from": "operational-values",
        "filter": {
          "predicates": [
            {
              "field": "workflow",
              "in": [
                ".github/workflows/repo-assist-issue-triage.md",
                ".github/workflows/repo-assist-issue-fix.md",
                ".github/workflows/repo-assist-maintenance.md",
                ".github/workflows/repo-assist-pr-upkeep.md"
              ]
            }
          ]
        },
        "order-by": [
          {
            "field": "observed-at",
            "direction": "desc"
          }
        ]
      }
    ],
    "pages": [
      {
        "id": "repo-assist-dashboard",
        "kind": "custom",
        "title": "Repo Assist",
        "description": "Track Repo Assist activation, review work, and one-shot operational-value observations across issue triage, fixes, maintenance, and pull request upkeep.",
        "icon": "gear",
        "views": [
          {
            "id": "repo-assist-runs",
            "title": "Repo Assist runs by conclusion",
            "disclosure": "essential",
            "data": {
              "source": "repo-assist-run-observations",
              "time": {
                "range": "30d"
              },
              "filters": {
                "workflow": [
                  ".github/workflows/repo-assist.md",
                  ".github/workflows/repo-assist-issue-triage.md",
                  ".github/workflows/repo-assist-issue-fix.md",
                  ".github/workflows/repo-assist-maintenance.md",
                  ".github/workflows/repo-assist-pr-upkeep.md"
                ]
              }
            },
            "mark": "chart",
            "chart": "pie",
            "layout": "half",
            "encoding": {
              "x": {
                "field": "run-conclusion",
                "type": "nominal"
              },
              "y": {
                "field": "run",
                "type": "quantitative",
                "aggregate": "count"
              }
            }
          },
          {
            "id": "repo-assist-outcomes",
            "title": "Repo Assist review work",
            "description": "Review items and draft changes remain human-reviewed and are not presented as applied repository outcomes.",
            "disclosure": "essential",
            "data": {
              "source": "repo-assist-retained-outcomes",
              "filters": {
                "package": [
                  "repo-assist"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No Repo Assist review work was retained.",
            "encoding": {
              "href": {
                "field": "external-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "outcome-title",
                  "type": "nominal",
                  "title": "Review item",
                  "display": "outcome-link"
                },
                {
                  "field": "outcome-state",
                  "type": "nominal",
                  "title": "Disposition",
                  "display": "status"
                },
                {
                  "field": "published-at",
                  "type": "temporal",
                  "format": "human-friendly-timestamp",
                  "title": "Published"
                }
              ],
              "actions": [
                {
                  "intent": "Review this Repo Assist item, verify its evidence and validation, and decide whether to accept, revise, or close it.",
                  "presentation": "copy-prompt",
                  "icon": "search",
                  "label": "Review",
                  "context": [
                    "repository",
                    "outcome-title",
                    "outcome-summary",
                    "outcome-state",
                    "published-at",
                    "external-link"
                  ]
                }
              ]
            }
          },
          {
            "id": "repo-assist-value",
            "title": "Worker decision readiness",
            "description": "Each observation grades the current run's validated request. A value of one means the worker met its structural and target-binding contract; null means no eligible opportunity or unavailable evidence.",
            "disclosure": "essential",
            "data": {
              "source": "repo-assist-value-observations",
              "filters": {
                "workflow": [
                  ".github/workflows/repo-assist-issue-triage.md",
                  ".github/workflows/repo-assist-issue-fix.md",
                  ".github/workflows/repo-assist-maintenance.md",
                  ".github/workflows/repo-assist-pr-upkeep.md"
                ]
              },
              "limit": 50
            },
            "mark": "table",
            "controls": "interactive",
            "lazy-list": true,
            "layout": "full-view",
            "empty-message": "No Repo Assist operational-value observations are available.",
            "encoding": {
              "href": {
                "field": "evidence-link",
                "type": "nominal"
              },
              "columns": [
                {
                  "field": "repository",
                  "type": "nominal"
                },
                {
                  "field": "operational-value-definition",
                  "type": "nominal",
                  "title": "Worker metric"
                },
                {
                  "field": "operational-value",
                  "type": "quantitative",
                  "title": "Decision readiness"
                },
                {
                  "field": "maturity-status",
                  "type": "nominal",
                  "title": "Evidence",
                  "display": "status"
                },
                {
                  "field": "observed-at",
                  "type": "temporal",
                  "format": "human-friendly-timestamp",
                  "title": "Observed"
                }
              ]
            }
          }
        ]
      }
    ],
    "navigation": [
      {
        "label": "Package operations",
        "experimental": true,
        "pages": [
          "repo-assist-dashboard"
        ]
      }
    ]
  }
}