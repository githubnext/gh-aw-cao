---
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import { getCollection } from "astro:content";
import { starlightAgentConfig } from "virtual:starlight-agent/config";

const { entry } = Astro.locals.starlightRoute;
const resourceIds = new Set((await getCollection(
  "docs",
  (candidate) => !candidate.data.draft && !starlightAgentConfig.excludedIds.includes(candidate.id),
)).map((candidate) => candidate.id));
const resourceId = entry.id || "index";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const resourcePath = resourceId === "index" ? "index.json" : `${resourceId}/index.json`;
const hasStructuredResource = resourceIds.has(resourceId);
---

<DefaultHead />
<link rel="describedby" href={`${base}${starlightAgentConfig.scopePath}/llms.txt`} />
<link rel="index" type="application/json" href={`${base}${starlightAgentConfig.scopePath}/resources.json`} />
{hasStructuredResource && <link rel="alternate" type="application/json" href={`${base}${resourcePath}`} />}
