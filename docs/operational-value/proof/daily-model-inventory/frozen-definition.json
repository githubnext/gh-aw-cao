    "workflowName": "Daily Model Inventory Checker",
    "sourcePath": ".github/workflows/daily-model-inventory.md",
    "intent": {
      "goal": "Keep the built-in model alias mapping usable against live applicable provider inventories.",
      "acceptance": "An alias has at least one source-defined recursive pattern or exact fallback matching an independently complete applicable live provider inventory.",
      "temporalAnchor": "contract-activation"
    },
    "adoption": {
      "commit": "c86377ec47b38f0b5af463277ee55d1d03d08da8",
      "adoptedAt": "2026-10-18T06:32:44Z",
      "baselineCommit": null,
      "baselineAt": null
    },
    "evaluation": {
      "mode": "attainment-only"
    },
    "evidence": {
      "key": "current-source-live-alias-support",
      "repositories": [
        "github/gh-aw"
      ],
      "opportunity": "Each built-in alias key at the pinned current-source cutoff, including meta-aliases and per-engine aliases; each key counted once.",
      "filters": [
        "Built-in alias map only; no workflow overrides or task-family usefulness inference.",
        "Case-insensitive literal provider matching; star cannot cross slash; strip parameters before presence checks.",
        "Use complete independent account-scoped inventory; errors, skipped/empty/paginated-incomplete providers are unknown.",
        "Current source predicates never applied to an unknown historical source era.",
        "models.json pricing/history is not live inventory; retain historical entries without automatic removal."
      ],
      "collection": "Batch offline replay of retained whole immutable sources and protected provider capture pages. Canonical activity discovery lacks live provider facts. No network or fetched-code execution.",
      "measurementKind": "snapshot",
      "window": {
        "durationDays": 1,
        "cadenceDays": 1,
        "maturationDays": 0
      }
    },
    "model": {
      "architecture": "Deterministic source-matched presence oracle; repository outcome is independent of workflow output and actor.",
      "recommendation": "Report native aliases and unknown coverage; no thresholds or keep decision are inferred.",
      "presentation": {
        "label": "Stale alias definitions",
        "betterLabel": "Fewer stale aliases"
      }
    },
    "summary": {
      "nativeLabel": "Aliases without live support"
    },
    "metrics": [
      {
        "id": "stale-aliases",
        "name": "Stale alias definitions",
        "role": "primary",
        "formula": "Count aliases with no live resolution; null unless the entire alias population is independently assessed.",
        "direction": "decrease",
        "unit": "aliases",
        "presentation": {
          "name": "Stale alias definitions",
          "legendLabel": "Stale aliases",
          "transform": "identity"
        }
      },
      {
        "id": "known-stale-aliases",
        "name": "Established stale subtotal",
        "role": "diagnostic",
        "formula": "Count positively established stale aliases among assessed opportunities; a lower bound during partial coverage, not an all-clear.",
        "direction": "decrease",
        "unit": "aliases",
        "presentation": {
          "name": "Established stale subtotal",
          "legendLabel": "Known stale subtotal",
          "transform": "identity"
        }
      },
      {
        "id": "supported-aliases",
        "name": "Independently supported aliases",
        "role": "diagnostic",
        "formula": "Count alias keys with a live matching candidate from at least one complete applicable inventory; preserve partial support independently of full acceptance.",
        "direction": "increase",
        "unit": "aliases",
        "presentation": {
          "name": "Independently supported aliases",
          "legendLabel": "Supported aliases",
          "transform": "identity"
        }
      }
    ],
