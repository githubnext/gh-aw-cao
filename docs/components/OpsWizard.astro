---
import controlPolicy from "../../.github/workflows/cao.json";
import { buildWizardPolicy } from "../lib/configured-operations.mjs";
import { configuredOperationEntries as operations } from "../lib/catalog";

const defaultOperation = operations[0]?.slug;

const agents = [
  {
    id: "copilot",
    name: "GitHub Copilot CLI",
    command: "copilot",
    install: "npm install -g @github/copilot",
  },
  {
    id: "claude",
    name: "Claude Code",
    command: "claude",
    install: "npm install -g @anthropic-ai/claude-code",
  },
  {
    id: "codex",
    name: "OpenAI Codex CLI",
    command: "codex",
    install: "npm install -g @openai/codex",
  },
];
---

<section class="ops-wizard-shell" aria-labelledby="ops-wizard-title">
  <details class="ops-wizard">
    <summary class="wizard-toggle">
      <span class="wizard-eyebrow">Setup wizard</span>
      <span class="wizard-toggle-copy">
        <span class="wizard-toggle-title" id="ops-wizard-title">Start an operation in three steps</span>
        <span class="wizard-toggle-lede">
          Generate a copy-ready prompt for creating a private control plane and running the first review-mode operation.
        </span>
      </span>
      <span class="wizard-toggle-action" aria-hidden="true">
        <span class="wizard-toggle-open">Open wizard</span>
        <span class="wizard-toggle-close">Close wizard</span>
      </span>
    </summary>

    <div class="wizard-body">
      <div class="wizard-intro">
        <p class="wizard-lede">
          Pick the operation you want to run and the coding agent you use, then copy the generated prompt. The agent
          creates your private control plane repository, installs the operation, and runs it once in <code>review</code>
          mode.
        </p>
        <ul class="wizard-badges" aria-label="Wizard benefits">
          <li>Private control plane</li>
          <li>Review-mode first run</li>
          <li>Agent-ready prompt</li>
        </ul>
      </div>

      <form class="wizard-form" data-ops-wizard>
    <fieldset class="wizard-step">
      <legend><span class="step-number">1</span> Choose the operation to run</legend>
      <div class="card-grid">
        {
          operations.map((operation) => (
            <label class="option-card">
              <input
                type="radio"
                name="operation"
                value={operation.slug}
                data-operation-name={operation.name}
                checked={operation.slug === defaultOperation}
              />
              <span class="option-body">
                <span class="option-name">{operation.name}</span>
                <span class="option-description">{operation.description}</span>
              </span>
              <span class="option-check" aria-hidden="true" />
            </label>
          ))
        }
        <label class="option-card">
          <input type="radio" name="operation" value="custom" data-operation-name="Custom operation" />
          <span class="option-body">
            <span class="option-name">Custom operation</span>
            <span class="option-description">
              Describe your own operation. The prompt uses the bundled <code>create-cao-campaign</code> skill to design the
              orchestrator and workers for you.
            </span>
          </span>
          <span class="option-check" aria-hidden="true"></span>
        </label>
      </div>
      <div class="custom-idea" data-custom-idea>
        <label for="ops-wizard-idea">Describe the operation you want</label>
        <textarea
          id="ops-wizard-idea"
          name="idea"
          rows="3"
          placeholder="Example: review stale GitHub Actions permissions across our service repositories and open one issue per repository with a least-privilege proposal."
        ></textarea>
      </div>
    </fieldset>

    <fieldset class="wizard-step">
      <legend><span class="step-number">2</span> Choose your coding agent</legend>
      <div class="card-grid agents">
        {
          agents.map((agent, index) => (
            <label class="option-card">
              <input
                type="radio"
                name="agent"
                value={agent.id}
                data-agent-name={agent.name}
                data-agent-command={agent.command}
                data-agent-install={agent.install}
                checked={index === 0}
              />
              <span class="option-body">
                <span class="option-name">{agent.name}</span>
                <span class="option-description">
                  Run <code>{agent.command}</code> in an empty working directory, then paste the prompt.
                </span>
              </span>
              <span class="option-check" aria-hidden="true" />
            </label>
          ))
        }
      </div>
      <div class="scope-fields">
        <div>
          <label for="ops-wizard-owner">GitHub organization or user</label>
          <input id="ops-wizard-owner" name="owner" type="text" placeholder="acme" autocomplete="off" />
        </div>
        <div>
          <label for="ops-wizard-repo">Control repository name</label>
          <input id="ops-wizard-repo" name="repo" type="text" placeholder="central-agentic-ops" autocomplete="off" />
        </div>
      </div>
    </fieldset>

    <fieldset class="wizard-step">
      <legend><span class="step-number">3</span> Copy the prompt and run it</legend>
      <p class="run-hint">
        Install the agent with <code data-agent-install-hint>npm install -g @github/copilot</code>, start it with
        <code data-agent-command-hint>copilot</code>, and paste the prompt below.
      </p>
      <noscript>
        <p class="run-hint">
          This wizard needs JavaScript. Follow the <a href="/gh-aw-cao/getting-started/">Quickstart</a> to install
          an operation manually.
        </p>
      </noscript>
      <div class="prompt-panel" aria-label="Generated prompt preview">
        <div class="prompt-toolbar">
        <span class="prompt-summary">
          <span data-prompt-summary></span>
          <span class="prompt-preview-label">Prompt preview</span>
        </span>
        </div>
        <pre data-prompt-output></pre>
      </div>
      <button type="button" class="wizard-copy-button" data-copy-prompt>
        <span class="copy-icon" aria-hidden="true">
          <svg viewBox="0 0 20 20" focusable="false">
            <path
              d="M6.5 5.5V3.75A1.75 1.75 0 0 1 8.25 2h6A1.75 1.75 0 0 1 16 3.75v8.5A1.75 1.75 0 0 1 14.25 14H12.5v1.75A1.75 1.75 0 0 1 10.75 17h-5A1.75 1.75 0 0 1 4 15.25v-8A1.75 1.75 0 0 1 5.75 5.5h.75Zm1.5 0h2.75a1.75 1.75 0 0 1 1.75 1.75v5.25h1.75a.25.25 0 0 0 .25-.25v-8.5a.25.25 0 0 0-.25-.25h-6a.25.25 0 0 0-.25.25V5.5Zm-2.25 1.5a.25.25 0 0 0-.25.25v8a.25.25 0 0 0 .25.25h5a.25.25 0 0 0 .25-.25v-8a.25.25 0 0 0-.25-.25h-5Z"
            ></path>
          </svg>
        </span>
        <span class="copy-label">Copy prompt</span>
      </button>
      <p class="copy-status" role="status" aria-live="polite" data-copy-status></p>
      <dialog class="copy-dialog" data-copy-dialog aria-labelledby="ops-wizard-copy-dialog-title">
        <div class="copy-dialog-card">
          <span class="copy-dialog-kicker">Prompt copied</span>
          <h2 class="copy-dialog-title" id="ops-wizard-copy-dialog-title">
            Run this prompt in your central agentic ops repo
          </h2>
          <p class="copy-dialog-reinforce">
            Your prompt is on the clipboard. Head over to your Central Agentic Ops control repository and run it there.
          </p>
          <ol class="copy-dialog-steps">
            <li>Create or open a private repository for your Central Agentic Ops control plane.</li>
            <li>Open the repository in your preferred coding agent.</li>
            <li>Paste the copied prompt into the starter text box and let the agent prepare the repo.</li>
          </ol>
          <button type="button" class="copy-dialog-close" data-copy-dialog-close>Got it, take me back</button>
        </div>
      </dialog>
    </fieldset>
      </form>
    </div>
  </details>
</section>

<script>
  import controlPolicy from "../../.github/workflows/cao.json";
  import { buildWizardPolicy } from "../lib/configured-operations.mjs";

  const CATALOG = "githubnext/gh-aw-cao";
  const CATALOG_REF = "main";
  const SETUP_SKILL_URL =
    "https://raw.githubusercontent.com/githubnext/gh-aw-cao/main/.github/skills/setup-cao/SKILL.md";
  function selected(form: HTMLFormElement, name: string): HTMLInputElement | null {
    return form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
  }

  function buildPrompt(form: HTMLFormElement): string {
    const operation = selected(form, "operation");
    const agent = selected(form, "agent");
    if (!operation || !agent) return "";

    const owner = (form.querySelector<HTMLInputElement>('input[name="owner"]')?.value || "").trim() || "<owner>";
    const repo =
      (form.querySelector<HTMLInputElement>('input[name="repo"]')?.value || "").trim() || "central-agentic-ops";
    const controlRepo = `${owner}/${repo}`;
    const isCustom = operation.value === "custom";
    const idea =
      (form.querySelector<HTMLTextAreaElement>('textarea[name="idea"]')?.value || "").trim() ||
      "<describe the operation you want to run>";
    const operationName = operation.dataset.operationName || operation.value;
    const engine = agent.value;
    const policy = !isCustom
      ? JSON.stringify(buildWizardPolicy(controlPolicy, owner, operation.value), null, 2)
      : "";

    const setup = [
      "## Setup",
      "",
      "1. Confirm the GitHub CLI is authenticated with `repo` and `workflow` scopes: `gh auth status`.",
      "2. Install the Agentic Workflows extension: `gh extension install github/gh-aw` (skip if `gh aw --help` already works).",
      `3. Create the private control repository and work inside it: \`gh repo create ${controlRepo} --private --clone\`.`,
    ];

    const body = isCustom
      ? [
          `4. Install the catalog campaigns and bundled skills: \`gh aw add ${CATALOG}@${CATALOG_REF}\`.`,
          "5. Read `.github/skills/create-cao-campaign/SKILL.md` and follow it to design a new operation campaign for:",
          "",
          `   > ${idea}`,
          "",
          "6. Create the orchestrator and every worker under `.github/workflows/`, then compile them with `gh aw compile`.",
          `7. Set \`engine: ${engine}\` in each new workflow's frontmatter.`,
          "8. Add the campaign and every worker to `.github/workflows/cao.json` in `review` mode with `max-repositories` set to `1`.",
          "9. Commit and push the policy, sources, and generated `.lock.yml` files together.",
        ]
      : [
          `4. Install the operation campaign: \`gh aw add ${CATALOG}/${operation.value}@${CATALOG_REF}\`.`,
          `5. Set \`engine: ${engine}\` in the installed workflow frontmatter, then recompile with \`gh aw compile\`.`,
          "6. Create `.github/workflows/cao.json` with this policy:",
          "",
          "```json",
          policy,
          "```",
          "",
          "7. Commit and push the policy, installed sources, and generated `.lock.yml` files together.",
        ];

    const rollout = isCustom
      ? [
          "## First run",
          "",
          "- Confirm `.github/workflows/cao.json` allows only the intended owners and keeps the campaign in `review` with a one-repository cap.",
          "- Trigger one manual run of the orchestrator against a single low-risk target repository with `safe_output_mode=review`.",
          "- Watch the run with `gh run watch` and summarize the orchestrator report.",
        ]
      : [
          "## First run",
          "",
          `- Trigger one manual run: \`gh aw run ${operation.value} --ref main --raw-field target_repo="${owner}/<target-repo>" --raw-field max_repos="1" --raw-field safe_output_mode="review"\`.`,
          "- Watch the run with `gh run watch` and summarize the orchestrator report.",
        ];

    return [
      `# Set up Central Agentic Ops: ${operationName}`,
      "",
      `Follow the Central Agentic Ops setup skill at ${SETUP_SKILL_URL}. Read it before taking any setup action, then use it to complete this request.`,
      "",
      `Act as my operations engineer. Set up a private GitHub control plane repository at \`${controlRepo}\` that runs the ${isCustom ? "custom operation described below" : `"${operationName}" operation`} from the Central Agentic Ops catalog (https://github.com/${CATALOG}). The control plane holds the workflows and credentials; target repositories never receive copies of them.`,
      "",
      ...setup,
      ...body,
      "",
      ...rollout,
      "",
      "## Rules",
      "",
      "- Keep the control repository private.",
      "- Keep the operation in `review` mode for the first run; never switch it to `live` without asking me.",
      "- Never edit generated `.lock.yml` files by hand; change the Markdown source and recompile.",
      "- Stop and ask me before adding secrets, widening permissions, or targeting additional repositories.",
      "",
      "Report the control repository URL, the installed workflows, the committed policy, and the run URL when you are done.",
    ].join("\n");
  }

  function initOpsWizard() {
    document.querySelectorAll<HTMLFormElement>("[data-ops-wizard]").forEach((form) => {
      if (form.dataset.wizardReady === "true") return;
      form.dataset.wizardReady = "true";

      const output = form.querySelector<HTMLPreElement>("[data-prompt-output]");
      const status = form.querySelector<HTMLParagraphElement>("[data-copy-status]");
      const summary = form.querySelector<HTMLElement>("[data-prompt-summary]");
      const customIdea = form.querySelector<HTMLElement>("[data-custom-idea]");
      const ideaField = form.querySelector<HTMLTextAreaElement>('textarea[name="idea"]');
      const customOperation = form.querySelector<HTMLInputElement>('input[name="operation"][value="custom"]');
      const commandHint = form.querySelector<HTMLElement>("[data-agent-command-hint]");
      const installHint = form.querySelector<HTMLElement>("[data-agent-install-hint]");
      const copyButton = form.querySelector<HTMLButtonElement>("[data-copy-prompt]");
      const copyLabel = copyButton?.querySelector<HTMLElement>(".copy-label");
      const copyDialog = form.querySelector<HTMLDialogElement>("[data-copy-dialog]");
      const copyDialogClose = form.querySelector<HTMLButtonElement>("[data-copy-dialog-close]");
      let resetCopyLabel: ReturnType<typeof setTimeout> | undefined;

      function openCopyDialog() {
        if (!copyDialog) return;
        if (typeof copyDialog.showModal === "function") {
          if (!copyDialog.open) copyDialog.showModal();
        }
      }

      function resetCopyState() {
        if (copyLabel) copyLabel.textContent = "Copy prompt";
        copyButton?.classList.remove("is-copied");
      }

      function render() {
        const operation = selected(form, "operation");
        const agent = selected(form, "agent");
        if (customIdea) customIdea.classList.toggle("is-active", operation?.value === "custom");
        if (commandHint && agent) commandHint.textContent = agent.dataset.agentCommand || "";
        if (installHint && agent) installHint.textContent = agent.dataset.agentInstall || "";
        if (summary) {
          summary.textContent =
            operation && agent ? `${operation.dataset.operationName} with ${agent.dataset.agentName}` : "";
        }
        if (output) output.textContent = buildPrompt(form);
        if (status) status.textContent = "";
      }

      ideaField?.addEventListener("input", () => {
        if (customOperation && !customOperation.checked && ideaField.value.trim().length > 0) {
          customOperation.checked = true;
          render();
        }
      });

      form.addEventListener("input", render);
      form.addEventListener("submit", (event) => event.preventDefault());

      copyButton?.addEventListener("click", async () => {
        const prompt = output?.textContent || "";
        if (!prompt) return;
        clearTimeout(resetCopyLabel);
        try {
          await navigator.clipboard.writeText(prompt);
          if (status) status.textContent = "Prompt copied. Create a repository, then paste it into the starter text box.";
          if (copyLabel) copyLabel.textContent = "Copied";
          copyButton.classList.add("is-copied");
          openCopyDialog();
          resetCopyLabel = setTimeout(resetCopyState, 2400);
        } catch {
          if (status) status.textContent = "Copy failed. Select the prompt text and copy it manually.";
        }
      });

      copyDialogClose?.addEventListener("click", () => copyDialog?.close());
      copyDialog?.addEventListener("close", () => {
        clearTimeout(resetCopyLabel);
        resetCopyState();
      });
      copyDialog?.addEventListener("click", (event) => {
        if (event.target === copyDialog) copyDialog.close();
      });

      render();
    });
  }

  initOpsWizard();
  document.addEventListener("astro:page-load", initOpsWizard);
</script>

<style>
  @layer starlight.core {
    .ops-wizard-shell {
      width: min(52rem, 100%);
      margin-inline: auto;
    }

    .ops-wizard {
      --wizard-blue: #00d4ff;
      --wizard-indigo: #5b5cff;
      --wizard-pink: #ff4ecd;
      --wizard-violet: #9b5cff;
      --wizard-glow-opacity: 0.16;

      position: relative;
      overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--sl-color-text-accent) 28%, transparent);
      border-radius: 1rem;
      background:
        linear-gradient(135deg, color-mix(in srgb, var(--wizard-indigo) 8%, transparent), transparent 45%),
        color-mix(in srgb, var(--sl-color-black) 20%, transparent);
      box-shadow:
        0 0.75rem 1.75rem color-mix(in srgb, var(--sl-color-black) 22%, transparent),
        inset 0 1px 0 color-mix(in srgb, var(--sl-color-white) 10%, transparent);
      isolation: isolate;
    }

    .wizard-toggle {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0.75rem;
      align-items: center;
      padding: 0.85rem 1rem;
      cursor: pointer;
      list-style: none;
    }

    .wizard-toggle::-webkit-details-marker {
      display: none;
    }

    .wizard-toggle:focus-visible {
      outline: 2px solid var(--sl-color-text-accent);
      outline-offset: -4px;
    }

    .wizard-toggle-copy {
      display: flex;
      min-width: 0;
      flex-direction: column;
      gap: 0.15rem;
    }

    .wizard-toggle-title {
      color: var(--sl-color-white);
      font-size: var(--sl-text-lg);
      font-weight: 700;
      line-height: 1.2;
    }

    .wizard-toggle-lede {
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-xs);
      line-height: 1.45;
    }

    .wizard-toggle-action {
      border: 1px solid color-mix(in srgb, var(--sl-color-text-accent) 42%, transparent);
      border-radius: 999px;
      background: color-mix(in srgb, var(--sl-color-text-accent) 10%, transparent);
      padding: 0.32rem 0.7rem;
      color: color-mix(in srgb, var(--sl-color-text-accent) 84%, var(--sl-color-white));
      font-size: var(--sl-text-xs);
      font-weight: 800;
      white-space: nowrap;
    }

    .ops-wizard[open] .wizard-toggle-action {
      background: color-mix(in srgb, var(--sl-color-white) 8%, transparent);
    }

    .wizard-toggle-close,
    .ops-wizard[open] .wizard-toggle-open {
      display: none;
    }

    .ops-wizard[open] .wizard-toggle-close {
      display: inline;
    }

    .wizard-body {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      border-top: 1px solid color-mix(in srgb, var(--sl-color-white) 10%, transparent);
      padding: clamp(1rem, 2vw, 1.5rem);
    }

    .ops-wizard::before,
    .ops-wizard::after {
      position: absolute;
      z-index: 0;
      width: 16rem;
      height: 16rem;
      border-radius: 999px;
      content: "";
      filter: blur(2rem);
      opacity: 0;
      pointer-events: none;
    }

    .ops-wizard::before {
      top: -6rem;
      right: -4rem;
      background: var(--wizard-pink);
    }

    .ops-wizard::after {
      bottom: -7rem;
      left: -5rem;
      background: var(--wizard-blue);
    }

    .ops-wizard[open]::before,
    .ops-wizard[open]::after {
      opacity: var(--wizard-glow-opacity);
    }

    .wizard-eyebrow {
      margin: 0;
      border: 1px solid color-mix(in srgb, var(--sl-color-text-accent) 55%, transparent);
      border-radius: 999px;
      background: color-mix(in srgb, var(--sl-color-text-accent) 10%, transparent);
      padding: 0.22rem 0.6rem;
      color: color-mix(in srgb, var(--sl-color-text-accent) 85%, var(--sl-color-white));
      font-size: var(--sl-text-xs);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .wizard-intro {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }

    .wizard-lede {
      margin: 0 auto;
      max-width: 60ch;
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-sm);
      line-height: 1.6;
    }

    .wizard-badges {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 0.25rem;
      margin-bottom: 0;
      padding: 0;
      list-style: none;
    }

    .wizard-badges li {
      border: 1px solid color-mix(in srgb, var(--sl-color-white) 18%, transparent);
      border-radius: 999px;
      background: color-mix(in srgb, var(--sl-color-white) 8%, transparent);
      padding: 0.35rem 0.7rem;
      color: var(--sl-color-gray-1);
      font-size: var(--sl-text-xs);
      font-weight: 600;
    }

    .wizard-form {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .wizard-step {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      border: 1px solid color-mix(in srgb, var(--sl-color-white) 12%, transparent);
      border-radius: 0.9rem;
      margin: 0;
      background: color-mix(in srgb, var(--sl-color-black) 18%, transparent);
      padding: 1rem;
    }

    .wizard-step legend {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0;
      color: var(--sl-color-white);
      font-size: var(--sl-text-base);
      font-weight: 600;
    }

    .step-number {
      display: inline-flex;
      width: 1.5rem;
      height: 1.5rem;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--wizard-blue), var(--wizard-violet) 50%, var(--wizard-pink));
      color: var(--sl-color-black);
      font-size: var(--sl-text-xs);
      font-weight: 800;
      box-shadow: 0 0.5rem 1.25rem color-mix(in srgb, var(--sl-color-text-accent) 30%, transparent);
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: 0.75rem;
    }

    .option-card {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 0.625rem;
      border: 1px solid color-mix(in srgb, var(--sl-color-gray-5) 65%, transparent);
      border-radius: 0.8rem;
      background:
        linear-gradient(145deg, color-mix(in srgb, var(--sl-color-white) 8%, transparent), transparent),
        color-mix(in srgb, var(--sl-color-black) 24%, transparent);
      padding: 0.875rem 2.25rem 0.875rem 0.875rem;
      cursor: pointer;
      transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
    }

    .option-card:hover {
      transform: translateY(-2px);
      border-color: color-mix(in srgb, var(--wizard-blue) 70%, transparent);
      background:
        linear-gradient(
          145deg,
          color-mix(in srgb, var(--wizard-blue) 12%, transparent),
          color-mix(in srgb, var(--wizard-pink) 8%, transparent)
        ),
        color-mix(in srgb, var(--sl-color-black) 16%, transparent);
      box-shadow: 0 0.5rem 1.25rem color-mix(in srgb, var(--sl-color-black) 30%, transparent);
    }

    .option-card:focus-within {
      border-color: var(--sl-color-text-accent);
      outline: 2px solid var(--sl-color-text-accent);
      outline-offset: 2px;
    }

