---
import { configuredOperationEntries as operations } from "../lib/catalog";

const defaultOperation = operations[0]?.slug;

const agents = [
  {
    id: "copilot",
    name: "GitHub Copilot CLI",
    command: "copilot",
    install: "npm install -g @github/copilot",
  },
  {
    id: "claude",
    name: "Claude Code",
    command: "claude",
    install: "npm install -g @anthropic-ai/claude-code",
  },
  {
    id: "codex",
    name: "OpenAI Codex CLI",
    command: "codex",
    install: "npm install -g @openai/codex",
  },
];

const redisProviders = [
  ["generic", "Generic Redis (REDIS_URL)"],
  ["local", "Local or private-network Redis"],
  ["upstash", "Upstash"],
  ["aws-elasticache", "AWS ElastiCache"],
  ["redis-cloud", "Redis Cloud"],
  ["gcp-memorystore", "GCP Memorystore"],
  ["railway", "Railway"],
  ["render", "Render"],
  ["digitalocean", "DigitalOcean"],
];

const hostTargets = [
  ["none", "Static dashboard", "No server infrastructure. Add hosted deployment later."],
  ["container", "Container", "Deploy with Coolify or another compatible container platform."],
  ["azure-functions", "Azure Functions", "Run the app server as an Azure Functions deployment."],
];
---

<section class="ops-wizard-shell" aria-labelledby="ops-wizard-title">
  <div class="ops-wizard">
    <header class="wizard-header">
      <span class="wizard-eyebrow">Launch CAO</span>
      <span class="wizard-toggle-copy">
        <h1 class="wizard-toggle-title" id="ops-wizard-title">Plan a control plane and first campaign in four steps</h1>
        <span class="wizard-toggle-lede">
          Generate a copy-ready prompt that sets up the bare control plane before adding and proving a campaign.
        </span>
      </span>
    </header>

    <div class="wizard-body">
      <div class="wizard-intro">
        <p class="wizard-lede">
          Choose the first operation and your coding agent. The generated prompt creates or configures a central
          control repository, installs the reusable campaign, and proves its boundary against one target in
          <code>review</code> mode.
        </p>
        <ul class="wizard-badges" aria-label="Wizard benefits">
          <li>Fleet-ready policy</li>
          <li>One-target proof</li>
          <li>Agent-ready prompt</li>
        </ul>
      </div>

      <form class="wizard-form" data-ops-wizard>
    <fieldset class="wizard-step">
      <legend><span class="step-number">1</span> Choose the first operation</legend>
      <div class="card-grid">
        {
          operations.map((operation) => (
            <label class="option-card">
              <input
                type="radio"
                name="operation"
                value={operation.slug}
                data-operation-name={operation.name}
                checked={operation.slug === defaultOperation}
              />
              <span class="option-body">
                <span class="option-name">{operation.name}</span>
                <span class="option-description">{operation.description}</span>
              </span>
              <span class="option-check" aria-hidden="true" />
            </label>
          ))
        }
      </div>
      <p class="step-help">
        Need a custom outcome? Prove the control plane with one catalog campaign first. The setup skill will then ask
        whether you also want to create a custom campaign.
      </p>
    </fieldset>

    <fieldset class="wizard-step">
      <legend><span class="step-number">2</span> Choose your coding agent</legend>
      <div class="card-grid agents">
        {
          agents.map((agent, index) => (
            <label class="option-card">
              <input
                type="radio"
                name="agent"
                value={agent.id}
                data-agent-name={agent.name}
                data-agent-command={agent.command}
                data-agent-install={agent.install}
                checked={index === 0}
              />
              <span class="option-body">
                <span class="option-name">{agent.name}</span>
                <span class="option-description">
                  Run <code>{agent.command}</code> in an empty working directory, then paste the prompt.
                </span>
              </span>
              <span class="option-check" aria-hidden="true" />
            </label>
          ))
        }
      </div>
      <div class="scope-fields">
        <div>
          <label for="ops-wizard-owner">GitHub organization or user</label>
          <input id="ops-wizard-owner" name="owner" type="text" placeholder="acme" autocomplete="off" />
        </div>
        <div>
          <label for="ops-wizard-repo">Control repository name</label>
          <input id="ops-wizard-repo" name="repo" type="text" placeholder="central-agentic-ops" autocomplete="off" />
        </div>
      </div>
    </fieldset>

    <fieldset class="wizard-step">
      <legend><span class="step-number">3</span> Choose optional dashboard hosting</legend>
      <p class="run-hint">
        Keep the static dashboard, or compose an app target with a Redis provider. Credentials stay in your hosting
        platform's environment, never in <code>cao.json</code>.
      </p>
      <div class="hosting-options">
        <div class="hosting-choice">
          <span class="choice-label" id="ops-wizard-target-label">App server target</span>
          <div class="card-grid hosting-cards" role="radiogroup" aria-labelledby="ops-wizard-target-label">
            {
              hostTargets.map(([value, label, description], index) => (
                <label class="option-card">
                  <input type="radio" name="host-target" value={value} checked={index === 0} />
                  <span class="option-body">
                    <span class="option-name">{label}</span>
                    <span class="option-description">{description}</span>
                  </span>
                  <span class="option-check" aria-hidden="true" />
                </label>
              ))
            }
          </div>
        </div>
        <div class="hosting-choice" data-redis-choice>
          <span class="choice-label" id="ops-wizard-redis-label">Redis provider</span>
          <div class="card-grid provider-cards" role="radiogroup" aria-labelledby="ops-wizard-redis-label">
            {
              redisProviders.map(([value, label], index) => (
                <label class="option-card">
                  <input type="radio" name="redis-provider" value={value} checked={index === 0} disabled />
                  <span class="option-body">
                    <span class="option-name">{label}</span>
                  </span>
                  <span class="option-check" aria-hidden="true" />
                </label>
              ))
            }
          </div>
        </div>
      </div>
      <p class="run-hint" data-host-guidance aria-live="polite">
        No server infrastructure is added. You can deploy a hosted dashboard later.
      </p>
    </fieldset>

    <fieldset class="wizard-step">
      <legend><span class="step-number">4</span> Copy the prompt and run it</legend>
      <p class="run-hint">
        Install the agent with <code data-agent-install-hint>npm install -g @github/copilot</code>, start it with
        <code data-agent-command-hint>copilot</code>, and paste the prompt below.
      </p>
      <noscript>
        <p class="run-hint">
          This wizard needs JavaScript. Follow the <a href="/gh-aw-cao/getting-started/">quickstart</a> to install
          a campaign manually.
        </p>
      </noscript>
      <div class="prompt-panel" aria-label="Generated prompt preview">
        <div class="prompt-toolbar">
        <span class="prompt-summary">
          <span data-prompt-summary></span>
          <span class="prompt-preview-label">Prompt preview</span>
        </span>
        </div>
        <pre data-prompt-output></pre>
      </div>
      <button type="button" class="wizard-copy-button" data-copy-prompt>
        <span class="copy-icon" aria-hidden="true">
          <svg viewBox="0 0 20 20" focusable="false">
            <path
              d="M6.5 5.5V3.75A1.75 1.75 0 0 1 8.25 2h6A1.75 1.75 0 0 1 16 3.75v8.5A1.75 1.75 0 0 1 14.25 14H12.5v1.75A1.75 1.75 0 0 1 10.75 17h-5A1.75 1.75 0 0 1 4 15.25v-8A1.75 1.75 0 0 1 5.75 5.5h.75Zm1.5 0h2.75a1.75 1.75 0 0 1 1.75 1.75v5.25h1.75a.25.25 0 0 0 .25-.25v-8.5a.25.25 0 0 0-.25-.25h-6a.25.25 0 0 0-.25.25V5.5Zm-2.25 1.5a.25.25 0 0 0-.25.25v8a.25.25 0 0 0 .25.25h5a.25.25 0 0 0 .25-.25v-8a.25.25 0 0 0-.25-.25h-5Z"
            ></path>
          </svg>
        </span>
        <span class="copy-label">Copy prompt</span>
      </button>
      <p class="copy-status" role="status" aria-live="polite" data-copy-status></p>
      <dialog class="copy-dialog" data-copy-dialog aria-labelledby="ops-wizard-copy-dialog-title">
        <div class="copy-dialog-card">
          <span class="copy-dialog-kicker">Prompt copied</span>
          <h2 class="copy-dialog-title" id="ops-wizard-copy-dialog-title">
            Run this prompt in your CAO control repository
          </h2>
          <p class="copy-dialog-reinforce">
            Your prompt is on the clipboard. Open the repository that will coordinate policy across your campaign portfolio.
          </p>
          <ol class="copy-dialog-steps">
            <li>Create or open a private repository for your Central Agentic Ops control plane.</li>
            <li>Open the repository in your preferred coding agent.</li>
            <li>Paste the copied prompt into the starter text box and let the agent prepare the repo.</li>
          </ol>
          <button type="button" class="copy-dialog-close" data-copy-dialog-close>Got it, take me back</button>
        </div>
      </dialog>
    </fieldset>
      </form>
    </div>
  </div>
</section>

<script>
  const CATALOG = "githubnext/gh-aw-cao";
  const SETUP_SKILL_URL =
    "https://raw.githubusercontent.com/githubnext/gh-aw-cao/main/skills/setup-cao/SKILL.md";
  const ADD_CAMPAIGN_SKILL_URL =
    "https://raw.githubusercontent.com/githubnext/gh-aw-cao/main/skills/add-cao-campaign/SKILL.md";
  function selected(form: HTMLFormElement, name: string): HTMLInputElement | null {
    return form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
  }

  function buildPrompt(form: HTMLFormElement): string {
    const operation = selected(form, "operation");
    const agent = selected(form, "agent");
    if (!operation || !agent) return "";

    const owner = (form.querySelector<HTMLInputElement>('input[name="owner"]')?.value || "").trim() || "<owner>";
    const repo =
      (form.querySelector<HTMLInputElement>('input[name="repo"]')?.value || "").trim() || "central-agentic-ops";
    const controlRepo = `${owner}/${repo}`;
    const operationName = operation.dataset.operationName || operation.value;

    return [
      `# Set up Central Agentic Ops: ${operationName}`,
      "",
      `First follow the Central Agentic Ops setup skill at ${SETUP_SKILL_URL} to create and validate the bare control plane.`,
      `After that setup is complete, follow the campaign skill at ${ADD_CAMPAIGN_SKILL_URL} to install and prove the selected campaign as a separate change.`,
      "",
      "## Choices already made",
      "",
      `- Control repository: \`${controlRepo}\`. Create it as private if it does not exist; preserve its current visibility if it already exists.`,
      `- First catalog campaign: "${operationName}" (\`${CATALOG}/${operation.value}\`).`,
      `- Coding agent used for setup: ${agent.dataset.agentName}. This does not select or rewrite the workflow inference engine.`,
      "",
      "## Complete the remaining setup choices",
      "",
      "- Ask me to choose the exact repository for the first review run. Offer the control repository as the safe default.",
      "- After the target is known, select the least-privilege authentication profile required for its visibility, owner, evidence, and output destination.",
      "- Ask separately whether I also want to create a custom campaign. If yes, defer authoring until the base control-plane boundary is proven.",
      "",
      "## Required proof",
      "",
      "- Use the CAO installer and repository-local `./cao.sh` commands required by the setup skill. Do not install from a branch or copy runtime files manually.",
      "- Treat installed campaign package sources as immutable. Put any additional campaign prompting in the consumer-owned `.github/cao/<campaign-slug>.md` file loaded by the workflows' optional `runtime-import`, rather than editing installed workflow sources.",
      "- Enroll only the exact first target in `.github/workflows/cao.json`.",
      "- Run only the selected campaign with `max_repos=1`, `rollout_percent=100`, and `safe_output_mode=review`.",
      "- Verify the effective mode, worker count, review-output destination, and absence of an unauthorized live target effect.",
      "- Report the control repository and visibility, campaign, target and visibility, authentication profile, committed policy, run URLs, and verification result.",
    ].join("\n");
  }

  function initOpsWizard() {
    document.querySelectorAll<HTMLFormElement>("[data-ops-wizard]").forEach((form) => {
      if (form.dataset.wizardReady === "true") return;
      form.dataset.wizardReady = "true";

      const output = form.querySelector<HTMLPreElement>("[data-prompt-output]");
      const status = form.querySelector<HTMLParagraphElement>("[data-copy-status]");
      const summary = form.querySelector<HTMLElement>("[data-prompt-summary]");
      const commandHint = form.querySelector<HTMLElement>("[data-agent-command-hint]");
      const installHint = form.querySelector<HTMLElement>("[data-agent-install-hint]");
      const copyButton = form.querySelector<HTMLButtonElement>("[data-copy-prompt]");
      const copyLabel = copyButton?.querySelector<HTMLElement>(".copy-label");
      const copyDialog = form.querySelector<HTMLDialogElement>("[data-copy-dialog]");
      const copyDialogClose = form.querySelector<HTMLButtonElement>("[data-copy-dialog-close]");
      const redisChoice = form.querySelector<HTMLElement>("[data-redis-choice]");
      const hostGuidance = form.querySelector<HTMLElement>("[data-host-guidance]");
      let resetCopyLabel: ReturnType<typeof setTimeout> | undefined;

      function openCopyDialog() {
        if (!copyDialog) return;
        if (typeof copyDialog.showModal === "function") {
          if (!copyDialog.open) copyDialog.showModal();
        }
      }

      function resetCopyState() {
        if (copyLabel) copyLabel.textContent = "Copy prompt";
        copyButton?.classList.remove("is-copied");
      }

      function render() {
        const operation = selected(form, "operation");
        const agent = selected(form, "agent");
        if (commandHint && agent) commandHint.textContent = agent.dataset.agentCommand || "";
        if (installHint && agent) installHint.textContent = agent.dataset.agentInstall || "";
        const target = selected(form, "host-target");
        const redis = selected(form, "redis-provider");
        if (target) {
          const hosted = target.value !== "none";
          const redisOptions = form.querySelectorAll<HTMLInputElement>('input[name="redis-provider"]');
          redisOptions.forEach((option) => {
            option.disabled = !hosted || (target.value === "azure-functions" && option.value === "upstash");
          });
          if (hosted && target.value === "azure-functions" && redis?.value === "upstash") {
            const generic = form.querySelector<HTMLInputElement>('input[name="redis-provider"][value="generic"]');
            if (generic) generic.checked = true;
          }
          if (redisChoice) redisChoice.dataset.disabled = String(!hosted);
          if (hostGuidance) {
            hostGuidance.textContent = hosted
              ? target.value === "azure-functions"
                ? "Azure Functions supports pooled Redis providers; Upstash is unavailable because this target cannot guarantee a single replica."
                : "The generated policy composes this target and provider. Add connection values only in the deployment environment."
              : "No server infrastructure is added. You can deploy a hosted dashboard later.";
          }
        }
        if (summary) {
          summary.textContent =
            operation && agent ? `${operation.dataset.operationName} with ${agent.dataset.agentName}` : "";
        }
        if (output) output.textContent = buildPrompt(form);
        if (status) status.textContent = "";
      }

      form.addEventListener("input", render);
      form.addEventListener("submit", (event) => event.preventDefault());

      copyButton?.addEventListener("click", async () => {
        const prompt = output?.textContent || "";
        if (!prompt) return;
        clearTimeout(resetCopyLabel);
        try {
          await navigator.clipboard.writeText(prompt);
          if (status) status.textContent = "Prompt copied. Create a repository, then paste it into the starter text box.";
          if (copyLabel) copyLabel.textContent = "Copied";
          copyButton.classList.add("is-copied");
          openCopyDialog();
          resetCopyLabel = setTimeout(resetCopyState, 2400);
        } catch {
          if (status) status.textContent = "Copy failed. Select the prompt text and copy it manually.";
        }
      });

      copyDialogClose?.addEventListener("click", () => copyDialog?.close());
      copyDialog?.addEventListener("close", () => {
        clearTimeout(resetCopyLabel);
        resetCopyState();
      });
      copyDialog?.addEventListener("click", (event) => {
        if (event.target === copyDialog) copyDialog.close();
      });

      render();
    });
  }

  initOpsWizard();
  document.addEventListener("astro:page-load", initOpsWizard);
</script>

<style>
  @layer starlight.core {
    .ops-wizard-shell {
      width: 100%;
      min-height: calc(100svh - var(--sl-nav-height));
      margin-inline: auto;
    }

    .ops-wizard {
      --wizard-blue: #00d4ff;
      --wizard-indigo: #5b5cff;
      --wizard-pink: #ff4ecd;
      --wizard-violet: #9b5cff;
      --wizard-glow-opacity: 0.16;

      position: relative;
      display: flex;
      min-height: calc(100svh - var(--sl-nav-height));
      flex-direction: column;
      overflow: hidden;
      background:
        radial-gradient(circle at 85% 5%, color-mix(in srgb, var(--wizard-pink) 13%, transparent), transparent 30rem),
        radial-gradient(circle at 10% 65%, color-mix(in srgb, var(--wizard-blue) 12%, transparent), transparent 34rem),
        linear-gradient(135deg, color-mix(in srgb, var(--wizard-indigo) 7%, transparent), transparent 45%);
      isolation: isolate;
    }

    .wizard-header {
      position: relative;
      z-index: 1;
      display: flex;
      width: 100%;
      max-width: 76rem;
      flex-direction: column;
      gap: 1rem;
      align-items: center;
      margin-inline: auto;
      padding: clamp(3rem, 8vh, 6rem) var(--wizard-gutter) clamp(2rem, 5vh, 4rem);
      text-align: center;
    }

    .wizard-toggle-copy {
      display: flex;
      min-width: 0;
      flex-direction: column;
      gap: 0.75rem;
      align-items: center;
    }

    .wizard-toggle-title {
      margin: 0;
      color: var(--sl-color-white);
      font-size: clamp(2.5rem, 7vw, 5.75rem);
      font-weight: 800;
      letter-spacing: -0.055em;
      line-height: 0.95;
    }

    .wizard-toggle-lede {
      max-width: 48rem;
      color: var(--sl-color-gray-2);
      font-size: clamp(1rem, 2vw, 1.25rem);
      line-height: 1.55;
    }

    .wizard-body {
      position: relative;
      z-index: 1;
      display: flex;
      width: 100%;
      max-width: 76rem;
      flex-direction: column;
      gap: clamp(1.5rem, 3vw, 2.5rem);
      margin-inline: auto;
      padding: 0 var(--wizard-gutter) clamp(3rem, 8vh, 6rem);
    }

    .ops-wizard::before,
    .ops-wizard::after {
      position: absolute;
      z-index: 0;
      width: 16rem;
      height: 16rem;
      border-radius: 999px;
      content: "";
      filter: blur(2rem);
      opacity: 0;
      pointer-events: none;
    }

    .ops-wizard::before {
      top: -6rem;
      right: -4rem;
      background: var(--wizard-pink);
    }

    .ops-wizard::after {
      bottom: -7rem;
      left: -5rem;
      background: var(--wizard-blue);
    }

    .ops-wizard::before,
    .ops-wizard::after {
      opacity: var(--wizard-glow-opacity);
    }

    .wizard-eyebrow {
      margin: 0;
      border: 1px solid color-mix(in srgb, var(--sl-color-text-accent) 55%, transparent);
      border-radius: 999px;
      background: color-mix(in srgb, var(--sl-color-text-accent) 10%, transparent);
      padding: 0.22rem 0.6rem;
      color: color-mix(in srgb, var(--sl-color-text-accent) 85%, var(--sl-color-white));
      font-size: var(--sl-text-xs);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .wizard-intro {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }

    .wizard-lede {
      margin: 0 auto;
      max-width: 60ch;
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-sm);
      line-height: 1.6;
    }

    .wizard-badges {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 0.25rem;
      margin-bottom: 0;
      padding: 0;
      list-style: none;
    }

    .wizard-badges li {
      border: 1px solid color-mix(in srgb, var(--sl-color-white) 18%, transparent);
      border-radius: 999px;
      background: color-mix(in srgb, var(--sl-color-white) 8%, transparent);
      padding: 0.35rem 0.7rem;
      color: var(--sl-color-gray-1);
      font-size: var(--sl-text-xs);
      font-weight: 600;
    }

    .wizard-form {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: clamp(1rem, 3vw, 2rem);
    }

    .wizard-step {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      border: 1px solid color-mix(in srgb, var(--sl-color-white) 12%, transparent);
      border-radius: 1rem;
      margin: 0;
      background: color-mix(in srgb, var(--sl-color-black) 18%, transparent);
      padding: clamp(1rem, 3vw, 2rem);
      box-shadow: 0 1rem 2.5rem color-mix(in srgb, var(--sl-color-black) 12%, transparent);
    }

    .wizard-step legend {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0;
      color: var(--sl-color-white);
      font-size: var(--sl-text-base);
      font-weight: 600;
    }

    .step-number {
      display: inline-flex;
      width: 1.5rem;
      height: 1.5rem;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--wizard-blue), var(--wizard-violet) 50%, var(--wizard-pink));
      color: var(--sl-color-black);
      font-size: var(--sl-text-xs);
      font-weight: 800;
      box-shadow: 0 0.5rem 1.25rem color-mix(in srgb, var(--sl-color-text-accent) 30%, transparent);
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: 0.75rem;
    }

    .option-card {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 0.625rem;
      border: 1px solid color-mix(in srgb, var(--sl-color-gray-5) 65%, transparent);
      border-radius: 0.8rem;
      background:
        linear-gradient(145deg, color-mix(in srgb, var(--sl-color-white) 8%, transparent), transparent),
        color-mix(in srgb, var(--sl-color-black) 24%, transparent);
      padding: 0.875rem 2.25rem 0.875rem 0.875rem;
      cursor: pointer;
      transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
    }

    .option-card:hover {
      transform: translateY(-2px);
      border-color: color-mix(in srgb, var(--wizard-blue) 70%, transparent);
      background:
        linear-gradient(
          145deg,
          color-mix(in srgb, var(--wizard-blue) 12%, transparent),
          color-mix(in srgb, var(--wizard-pink) 8%, transparent)
        ),
        color-mix(in srgb, var(--sl-color-black) 16%, transparent);
      box-shadow: 0 0.5rem 1.25rem color-mix(in srgb, var(--sl-color-black) 30%, transparent);
    }

    .option-card:focus-within {
      border-color: var(--sl-color-text-accent);
      outline: 2px solid var(--sl-color-text-accent);
      outline-offset: 2px;
    }

    .option-card:has(input:checked) {
      border-color: color-mix(in srgb, var(--wizard-blue) 80%, var(--sl-color-text-accent));
      background:
        linear-gradient(
          145deg,
          color-mix(in srgb, var(--wizard-blue) 16%, transparent),
          color-mix(in srgb, var(--wizard-pink) 13%, transparent)
        ),
