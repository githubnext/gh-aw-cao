---
// Adapted from github/gh-aw (MIT), revision 9bf555c835e3a2086c4448de45e75ecc803e6950.
import { Icon } from "@astrojs/starlight/components";
---

<dialog class="snippet-dialog" data-slideshow-snippet-dialog aria-labelledby="slideshow-snippet-title">
  <div class="snippet-header">
    <div>
      <h2 id="slideshow-snippet-title">Expanded snippet</h2>
      <p id="slideshow-snippet-edit-hint" data-snippet-edit-hint hidden>Edit code in this view. Changes are discarded when it closes.</p>
    </div>
    <button type="button" data-snippet-close aria-label="Close expanded snippet" autofocus><Icon name="close" size="1.5rem" /></button>
  </div>
  <div class="snippet-content" data-snippet-content></div>
</dialog>

<style>
  .snippet-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(1.5rem, 4vw, 4rem);
    border: 0;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    overflow: auto;
    opacity: 0;
    transform: scale(0.96);
    transition: opacity 220ms ease, transform 220ms ease, display 220ms allow-discrete, overlay 220ms allow-discrete;
  }
  .snippet-dialog[open] { display: flex; flex-direction: column; opacity: 1; transform: scale(1); }
  @starting-style { .snippet-dialog[open] { opacity: 0; transform: scale(0.96); } }
  .snippet-dialog::backdrop {
    background: var(--sl-color-bg);
    opacity: 0;
    transition: opacity 220ms ease, display 220ms allow-discrete, overlay 220ms allow-discrete;
  }
  .snippet-dialog[open]::backdrop { opacity: 1; }
  @starting-style { .snippet-dialog[open]::backdrop { opacity: 0; } }
  .snippet-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .snippet-header h2 { margin: 0; font-size: 1.5rem; font-weight: 500; }
  .snippet-header p { margin: 0.25rem 0 0; color: var(--sl-color-gray-2); font-size: 0.875rem; }
  .snippet-header button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
    cursor: pointer;
  }
  .snippet-content { width: 100%; margin: auto; padding-block: 2rem; font-size: clamp(1.5rem, 2.8vw, 2.25rem); line-height: 1.6; }
  .snippet-content > :global(*) {
    position: relative;
    inset: auto;
    width: 100%;
    max-width: none;
    height: auto;
    min-height: 0;
    margin: 0;
    overflow: visible;
    animation: none;
    transform: none;
  }
  .snippet-content :global(pre) { font: inherit; font-family: "Mona Sans Mono", monospace; white-space: pre-wrap; overflow-wrap: anywhere; }
  .snippet-content :global(picture[data-theme-picture]) { width: min(100%, 40rem); }
  .snippet-content :global([data-snippet-editor]) { cursor: text; outline: 1px dashed var(--sl-color-gray-4); outline-offset: 0.375rem; }
  .snippet-content :global([data-snippet-editor]:focus-visible),
  .snippet-header button:focus-visible { outline: 3px solid var(--sl-color-accent-high); outline-offset: 4px; }
  :global(#landing-slideshow [data-snippet-trigger]) { cursor: zoom-in; }
  :global(#landing-slideshow [data-snippet-trigger]:focus-visible) { outline: 3px solid var(--sl-color-accent-high); outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .snippet-dialog, .snippet-dialog::backdrop { transition: none; transform: none; } }
</style>
