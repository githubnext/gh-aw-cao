---
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";
import copilotRight from "../assets/copilot-right.png";
import earth from "../assets/earth.png";
import glow from "../assets/glow.png";

const PAGE_TITLE_ID = "_top";

type HeroAction = {
  attrs?: Omit<HTMLAttributes<"a">, "href">;
  icon?: { name?: string; html?: string };
  link: string;
  text: string;
  variant?: "primary" | "secondary" | "minimal";
};
type HeroData = {
  title: string;
  draft?: boolean;
  hero?: {
    title?: string;
    tagline?: string;
    actions?: HeroAction[];
  };
};

const { data } = (Astro.locals as unknown as { starlightRoute: { entry: { data: HeroData } } }).starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="hero">
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
      {data.draft && <aside class="draft-notice">This page is a draft and may contain incomplete content.</aside>}
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>
    {
      actions.length > 0 && (
        <div class="sl-flex actions">
          {actions.map(
            ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
              <a href={href} class:list={["hero-action", variant || "primary", className]} {...attrs}>
                {text}
                {icon?.html ? <Fragment set:html={icon.html} /> : icon?.name === "right-arrow" && <span aria-hidden="true">→</span>}
              </a>
            ),
          )}
        </div>
      )
    }
  </div>

  <figure class="central-ops-visual" aria-labelledby="central-ops-title" aria-describedby="central-ops-description">
    <figcaption class="visually-hidden">
      <span id="central-ops-title">The central operations lifecycle</span>
      <span id="central-ops-description">Agents move through a governed lifecycle entirely within one private central control plane: govern, run centrally, verify, and improve. The control plane can dispatch work across more than 10,000 remote target repositories. Its extensible operation catalogue includes Dependabot and Optimization.</span>
    </figcaption>

    <Image src={earth} alt="" class="earth-horizon" loading="eager" />

    <div class="visual-layout" aria-hidden="true">
      <div class="loop-wrap">
        <Image src={glow} alt="" class="loop-glow" loading="eager" />
        <div class="loop-ring"></div>

        <div class="operation-feed">
          <div class="operation-source">
            <span class="operation-source-title">Central operations</span>
            <div class="operation-source-list">
              <span class="operation-source-item">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M5.75 7.5a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5a.75.75 0 0 1 .75-.75Zm5.25.75a.75.75 0 0 0-1.5 0v1.5a.75.75 0 0 0 1.5 0v-1.5Z"></path>
                  <path d="M6.25 0h2A.75.75 0 0 1 9 .75V3.5h3.25a2.25 2.25 0 0 1 2.25 2.25V8h.75a.75.75 0 0 1 0 1.5h-.75v2.75a2.25 2.25 0 0 1-2.25 2.25h-8.5a2.25 2.25 0 0 1-2.25-2.25V9.5H.75a.75.75 0 0 1 0-1.5h.75V5.75A2.25 2.25 0 0 1 3.75 3.5H7.5v-2H6.25a.75.75 0 0 1 0-1.5ZM3 5.75v6.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-6.5a.75.75 0 0 0-.75-.75h-8.5a.75.75 0 0 0-.75.75Z"></path>
                </svg>
                Dependabot
              </span>
              <span class="operation-source-item">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M8 1.5a6.5 6.5 0 1 0 6.016 4.035.75.75 0 0 1 1.388-.57 8 8 0 1 1-4.37-4.37.75.75 0 1 1-.569 1.389A6.473 6.473 0 0 0 8 1.5Zm6.28.22a.75.75 0 0 1 0 1.06l-4.063 4.064a2.5 2.5 0 1 1-1.06-1.06L13.22 1.72a.75.75 0 0 1 1.06 0ZM7 8a1 1 0 1 0 2 0 1 1 0 0 0-2 0Z"></path>
                </svg>
                Optimization
              </span>
              <span class="operation-source-more"><i></i><i></i><i></i></span>
            </div>
          </div>
          <span class="operation-feed-line"></span>
        </div>

        <div class="loop-node govern"><span>✓</span> Govern</div>
        <div class="loop-node run"><span>▶</span> Run</div>
        <div class="loop-node verify"><span>✓</span> Verify</div>
        <div class="loop-node improve"><span>↻</span> Improve</div>

        <div class="agent-orbit agent-one"><span class="agent-marker"><Image src={copilotRight} alt="" class="agent-image" loading="eager" /></span></div>
        <div class="agent-orbit agent-two"><span class="agent-marker"><Image src={copilotRight} alt="" class="agent-image" loading="eager" /></span></div>

        <div class="loop-core">
          <p>One private runtime</p>
          <h2>Dispatches to</h2>
          <div class="dispatch-count"><strong data-dispatch-count>0</strong><span data-dispatch-plus>+</span></div>
          <div class="dispatch-meter"><i data-dispatch-meter></i></div>
          <div class="dispatch-target">repositories</div>
        </div>

      </div>
    </div>

  </figure>
</div>

<script>
  const count = document.querySelector<HTMLElement>("[data-dispatch-count]");
  const meter = document.querySelector<HTMLElement>("[data-dispatch-meter]");
  const plus = document.querySelector<HTMLElement>("[data-dispatch-plus]");

  if (count && meter && plus) {
    const finish = () => {
      count.textContent = "10,000";
      meter.style.setProperty("--dispatch-progress", "1");
      plus.dataset.visible = "true";
    };

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      finish();
    } else {
      const observer = new IntersectionObserver(([entry]) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        const startedAt = performance.now();
        const duration = 2400;

        const tick = (now: number) => {
          const elapsed = Math.min((now - startedAt) / duration, 1);
          const progress = 1 - Math.pow(1 - elapsed, 3);
          count.textContent = Math.round(progress * 10000).toLocaleString("en-US");
          meter.style.setProperty("--dispatch-progress", String(progress));
          if (elapsed < 1) requestAnimationFrame(tick);
          else finish();
        };

        requestAnimationFrame(tick);
      }, { threshold: 0.35 });

      observer.observe(count);
    }
  }
</script>

<style>
  @layer starlight.core {
    .hero {
      --hero-bottom-padding: 3rem;
      position: relative;
      isolation: isolate;
      display: grid;
      overflow: clip;
      grid-template-columns: minmax(0, 1fr);
      align-items: center;
      gap: 1.25rem;
      padding-block: 2rem 3rem;
    }

    .earth-horizon {
      position: absolute;
      bottom: calc(-1 * var(--hero-bottom-padding));
      left: 50%;
      z-index: 0;
      width: min(40rem, 140%) !important;
      max-width: none;
      height: auto !important;
      opacity: 0.72;
      pointer-events: none;
      transform: translateX(-50%);
      user-select: none;
    }

    .stack,
    .central-ops-visual {
      position: relative;
      z-index: 1;
      animation: hero-enter 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .stack {
      flex-direction: column;
      gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
      text-align: center;
    }

    .copy {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .copy > * {
      max-width: 54ch;
    }

    .hero h1 {
      max-width: 14ch;
      background: var(--sl-color-text-accent);
      background-clip: text;
      color: transparent;
      font-size: clamp(2.25rem, 5vw, 3.25rem) !important;
      font-weight: 700 !important;
      line-height: 1.1 !important;
      letter-spacing: 0;
      animation: none !important;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      hyphens: none !important;
      overflow-wrap: normal !important;
      word-break: normal !important;
    }

    .hero .tagline {
      color: var(--sl-color-gray-2);
      font-size: clamp(1rem, 1.4vw, 1.125rem) !important;
      line-height: 1.55 !important;
    }

    .draft-notice {
      border-inline-start: 0.25rem solid var(--sl-color-orange);
      padding-inline-start: 1rem;
      color: var(--sl-color-gray-2);
    }

    .actions {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem 2rem;
    }

    .hero-action {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      border: 1px solid transparent;
      border-radius: 6px;
      padding: 0.5rem 1rem;
      font-size: var(--sl-text-sm);
      font-weight: 600;
      line-height: 1.1875;
      text-decoration: none;
      outline-offset: 0.25rem;
    }

    .hero-action :global(svg),
    .hero-action > span {
      width: 1rem;
      height: 1rem;
      flex: 0 0 auto;
      font-size: 1rem;
      line-height: 1;
    }

    .hero-action.primary {
      border-color: var(--sl-color-text-accent);
      background: var(--sl-color-text-accent);
      color: var(--sl-color-black);
    }

    .hero-action.secondary {
      border-color: currentColor;
      color: var(--sl-color-white);
    }

    .hero-action.minimal {
      color: var(--sl-color-white);
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .central-ops-visual {
      --visual-width: min(70rem, calc(100vw - 3rem));
      isolation: isolate;
      width: var(--visual-width);
      margin: 0 0 0 calc((100% - var(--visual-width)) / 2);
      padding-block: 0.5rem;
      color: var(--sl-color-white);
      font-family: inherit;
    }

    .visual-layout {
      position: relative;
      z-index: 1;
      display: grid;
      place-items: center;
      gap: 1rem;
      min-height: 31rem;
      padding-top: 6rem;
      transform: translateY(-1rem);
    }

    .loop-wrap {
      position: relative;
      isolation: isolate;
      width: min(100%, 31rem);
      aspect-ratio: 1;
      justify-self: center;
    }

    .loop-glow {
      position: absolute;
      max-width: none;
      pointer-events: none;
      user-select: none;
    }

    .loop-glow {
      z-index: -1;
      top: -1.4rem;
      left: 50%;
      width: 118% !important;
      height: auto !important;
      opacity: 0.98;
      filter: brightness(1.18) saturate(1.12);
      transform: translateX(-59.3%);
    }

    .loop-ring,
    .agent-orbit {
      position: absolute;
      inset: 8%;
      border-radius: 50%;
    }

    .loop-ring {
      z-index: 1;
      border: 3px solid color-mix(in srgb, var(--sl-color-gray-3) 30%, transparent);
      box-shadow:
        inset 0 0 32px color-mix(in srgb, var(--sl-color-text-accent) 7%, transparent),
        0 0 14px color-mix(in srgb, var(--sl-color-gray-2) 7%, transparent);
    }

    .loop-core {
      position: absolute;
      z-index: 2;
      inset: 26%;
      display: grid;
      place-content: center;
      border-radius: 50%;
      padding: 1rem;
      text-align: center;
      transform: translateY(-0.4rem);
    }

    .loop-core p,
    .target-kicker {
      margin: 0 0 0.35rem;
      color: var(--sl-color-gray-2);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .loop-core p {
      margin-bottom: 1.125rem;
    }

    .loop-core h2 {
      margin: 0;
      color: #a78bfa;
      font-size: 1rem;
      line-height: 1.1;
      letter-spacing: 0;
      white-space: nowrap;
    }

    .dispatch-count {
      display: flex;
      min-width: 0;
      align-items: center;
      justify-content: center;
      gap: 0.3rem;
      margin-top: 0.65rem;
      font-variant-numeric: tabular-nums;
      line-height: 1;
      white-space: nowrap;
    }

    .dispatch-count strong {
      min-width: 4.4ch;
      color: #a78bfa;
      font-size: clamp(1.55rem, 3.5vw, 2.15rem);
      font-weight: 680;
      letter-spacing: 0;
      text-align: end;
      text-shadow: 0 0 14px color-mix(in srgb, #a78bfa 42%, transparent);
    }

    .dispatch-count span {
      visibility: hidden;
      color: #a78bfa;
      font-size: clamp(1.2rem, 2.8vw, 1.65rem);
      font-weight: 750;
      text-shadow: 0 0 14px color-mix(in srgb, #a78bfa 42%, transparent);
    }

    .dispatch-count span[data-visible="true"] {
      visibility: visible;
    }

    .dispatch-target {
      margin-top: 0.65rem;
      color: #a78bfa;
      font-size: 0.875rem;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0;
    }

    .dispatch-meter {
      width: min(9.75rem, 88%);
      height: 0.4rem;
      overflow: hidden;
      margin: 0.55rem auto 0;
      border-radius: 999rem;
      border: 1px solid color-mix(in srgb, var(--sl-color-gray-3) 25%, transparent);
      background: color-mix(in srgb, var(--sl-color-gray-3) 15%, transparent);
    }

    .dispatch-meter i {
      --dispatch-progress: 0;
      display: block;
      width: 100%;
      height: 100%;
      border-radius: inherit;
      background: #a78bfa;
      box-shadow:
        0 0 8px color-mix(in srgb, #a78bfa 58%, transparent),
        0 0 16px color-mix(in srgb, #a78bfa 42%, transparent);
      transform: scaleX(var(--dispatch-progress));
      transform-origin: left;
    }

    .operation-feed {
      position: absolute;
      top: -5.75rem;
      left: 50%;
      z-index: 8;
      display: grid;
      justify-items: center;
      transform: translateX(-50%);
    }

    .operation-source {
      display: grid;
      justify-items: center;
      gap: 0.55rem;
      border: 1px solid color-mix(in srgb, var(--sl-color-white) 28%, transparent);
      border-radius: 6px;
      background: color-mix(in srgb, var(--sl-color-bg) 97%, transparent);
      padding: 0.65rem 0.75rem 0.75rem;
      box-shadow:
        inset 0 1px 0 color-mix(in srgb, #ffffff 8%, transparent),
        0 8px 24px color-mix(in srgb, #000000 28%, transparent);
    }

    .operation-source-title {
      color: var(--sl-color-white);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0;
      line-height: 1.2;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .operation-source-list,
    .operation-source-item,
    .operation-source-more {
      display: flex;
      align-items: center;
    }

    .operation-source-list {
      gap: 0.75rem;
    }

    .operation-source-item {
      gap: 0.4rem;
      min-height: 2rem;
      border-radius: 5px;
      background: color-mix(in srgb, #8b5cf6 14%, var(--sl-color-bg));
      padding: 0.35rem 0.55rem;
      color: #a78bfa;
      font-size: 0.75rem;
      font-weight: 650;
      line-height: 1.2;
      white-space: nowrap;
    }

    .operation-source-item svg {
      width: 1rem;
      height: 1rem;
      flex: 0 0 auto;
      fill: #a78bfa;
    }

    .operation-source-more {
      gap: 0.22rem;
      padding-inline: 0.1rem;
    }

    .operation-source-more i {
      width: 0.2rem;
      height: 0.2rem;
      border-radius: 50%;
      background: #a78bfa;
      box-shadow: 0 0 6px color-mix(in srgb, #a78bfa 58%, transparent);
    }

    .operation-feed-line {
      position: relative;
      width: 2px;
      height: 1.5rem;
      margin-top: 0.35rem;
      background: repeating-linear-gradient(
        to bottom,
        color-mix(in srgb, #a78bfa 78%, white) 0 4px,
        transparent 4px 8px
      );
      filter: drop-shadow(0 0 3px color-mix(in srgb, #a78bfa 42%, transparent));
    }

    .operation-feed-line::after {
      position: absolute;
      bottom: -0.1rem;
      left: 50%;
      border-top: 0.42rem solid color-mix(in srgb, #a78bfa 78%, white);
      border-right: 0.3rem solid transparent;
      border-left: 0.3rem solid transparent;
      content: "";
      transform: translateX(-50%);
    }

    .loop-node {
      position: absolute;
      z-index: 7;
      display: inline-flex;
      min-width: 0;
      align-items: center;
      gap: 0.4rem;
      border: 1px solid color-mix(in srgb, var(--sl-color-gray-4) 72%, transparent);
      border-radius: 6px;
      background: color-mix(in srgb, var(--sl-color-bg) 82%, transparent);
      padding: 0.45rem 0.55rem;
      color: var(--sl-color-white);
      font-size: 0.75rem;
      font-weight: 650;
      line-height: 1.2;
      white-space: nowrap;
    }

    .loop-node.govern {
      top: 4%;
      left: 50%;
      transform: translateX(-50%);
    }

    .loop-node.run {
      top: 50%;
      right: 4%;
      transform: translateY(-50%);
    }

    .loop-node.verify {
      bottom: 4%;
      left: 50%;
      transform: translateX(-50%);
    }

    .loop-node.improve {
      top: 50%;
      left: 1%;
      transform: translateY(-50%);
    }

    .loop-node span {
      display: inline-grid;
      width: 1rem;
      height: 1rem;
      flex: 0 0 auto;
      place-items: center;
      border: 1px solid currentColor;
      border-radius: 50%;
      font-size: 0.6rem;
      line-height: 1;
    }

    .agent-orbit {
      z-index: 6;
      animation: orbit 12s linear infinite;
    }

    .agent-orbit::before {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: conic-gradient(
        from 0deg,
        transparent 0deg 48deg,
        color-mix(in srgb, #ffffff 10%, transparent) 54deg,
        color-mix(in srgb, #f2f7ff 92%, transparent) 86deg,
        transparent 96deg 360deg
      );
      content: "";
      filter: drop-shadow(0 0 7px color-mix(in srgb, #ffffff 68%, transparent));
      mask: radial-gradient(farthest-side, transparent calc(100% - 5px), #000 calc(100% - 4px));
      -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 5px), #000 calc(100% - 4px));
    }

    .agent-orbit.agent-two {
      animation-delay: -6s;
    }

    .agent-marker {
      position: absolute;
      top: 50%;
      right: -2rem;
      display: block;
      width: 4rem;
      height: 4rem;
      filter: drop-shadow(0 0 16px color-mix(in srgb, #7c3cff 72%, transparent));
      transform: translateY(-50%) rotate(90deg);
    }

    .agent-image {
      display: block;
      width: 100% !important;
      height: 100% !important;
      object-fit: contain;
    }

    .agent-two .agent-marker {
      filter: drop-shadow(0 0 16px color-mix(in srgb, #a78bfa 58%, transparent));
    }

    :global(:root[data-theme="light"]) .operation-source-item,
    :global(:root[data-theme="light"]) .loop-core h2,
    :global(:root[data-theme="light"]) .dispatch-count strong,
    :global(:root[data-theme="light"]) .dispatch-count span,
    :global(:root[data-theme="light"]) .dispatch-target {
      color: #6d28d9;
    }

    :global(:root[data-theme="light"]) .operation-source-item svg {
      fill: #6d28d9;
    }

    :global(:root[data-theme="light"]) .operation-source-more i,
    :global(:root[data-theme="light"]) .dispatch-meter i {
      background: #6d28d9;
    }

    :global(:root[data-theme="light"]) .operation-source {
      border-color: #858a93;
      box-shadow:
        inset 0 1px 0 #ffffff,
        0 8px 24px color-mix(in srgb, #17181c 14%, transparent);
    }

    :global(:root[data-theme="light"]) .loop-ring {
      border-color: color-mix(in srgb, #4c1d95 55%, transparent);
    }

    :global(:root[data-theme="light"]) .dispatch-count strong,
    :global(:root[data-theme="light"]) .dispatch-count span {
      text-shadow: 0 0 14px color-mix(in srgb, #6d28d9 28%, transparent);
    }

    :global(:root[data-theme="light"]) .dispatch-meter {
      border-color: #858a93;
      background: #e2e4e8;
    }

    :global(:root[data-theme="light"]) .dispatch-meter i {
      box-shadow:
        0 0 8px color-mix(in srgb, #6d28d9 42%, transparent),
        0 0 16px color-mix(in srgb, #6d28d9 24%, transparent);
    }

    :global(:root[data-theme="light"]) .operation-feed-line {
      background: repeating-linear-gradient(
        to bottom,
        #6d28d9 0 4px,
        transparent 4px 8px
      );
      filter: drop-shadow(0 0 3px color-mix(in srgb, #6d28d9 30%, transparent));
    }

    :global(:root[data-theme="light"]) .operation-feed-line::after {
      border-top-color: #6d28d9;
    }

    :global(:root[data-theme="light"]) .agent-orbit::before {
      background: conic-gradient(
        from 0deg,
        transparent 0deg 48deg,
        color-mix(in srgb, #4c1d95 12%, transparent) 54deg,
        color-mix(in srgb, #4c1d95 72%, transparent) 86deg,
        transparent 96deg 360deg
      );
      filter: drop-shadow(0 0 7px color-mix(in srgb, #4c1d95 28%, transparent));
    }

    :global(:root[data-theme="light"]) .loop-glow {
      opacity: 0.62;
      filter: none;
    }

    @keyframes orbit {
      to { transform: rotate(1turn); }
    }

    @keyframes hero-enter {
      from {
        opacity: 0;
        transform: translateY(0.75rem);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 54rem) {
      .hero {
        gap: 2rem;
      }

      .central-ops-visual {
        --visual-width: min(38rem, calc(100vw - 2rem));
      }

      .visual-layout {
        min-height: 0;
      }

      .loop-wrap {
        width: min(100%, 28rem);
      }

    }

    @media (max-width: 30rem) {
      .hero {
        width: calc(100% + 2rem);
        margin-inline: -1rem;
        padding-inline: 0 !important;
      }

      .hero h1 {
        font-size: 2.125rem !important;
      }
    }

    @media (max-width: 27rem) {
      .loop-glow {
        top: -1.8rem;
      }

      .operation-source {
        gap: 0.45rem;
        padding: 0.55rem 0.6rem 0.65rem;
        transform: scale(0.9);
        transform-origin: bottom center;
      }

      .operation-source-list {
        gap: 0.5rem;
