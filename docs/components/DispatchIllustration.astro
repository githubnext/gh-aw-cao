];

const jobs = [
  {
    row: 2,
    timing: "job-1",
    operation: "Dependabot update planner",
    workflow: "Dependabot / Update Planner",
    repository: "github/gh-aw",
    mode: "live",
    duration: "2m 18s",
    targetRow: 6,
    organizationPath: "M0 100 H41 V344 H82",
    repositoryPath: "M0 344 H41 V308 H82",
    organizationTimes: "0;0.51;0.52;0.55;0.56;1",
    repositoryTimes: "0;0.55;0.56;0.59;0.60;1",
  },
  {
    row: 3,
    timing: "job-2",
    operation: "Dependabot update planner",
    workflow: "Dependabot / Update Planner",
    repository: "githubnext/gh-aw-cao",
    mode: "review",
    duration: "3m 41s",
    targetRow: 2,
    organizationPath: "M0 172 H82",
    repositoryPath: "M0 172 H41 V100 H82",
    organizationTimes: "0;0.60;0.61;0.64;0.65;1",
    repositoryTimes: "0;0.64;0.65;0.68;0.69;1",
  },
  {
    row: 6,
    timing: "job-3",
    operation: "Repo Assist issue triage",
    workflow: "Repo Assist / Issue Triage",
    repository: "github/gh-aw-firewall",
    mode: "live",
    duration: "2m 56s",
    targetRow: 7,
    organizationPath: "M0 308 H41 V344 H82",
    repositoryPath: "M0 344 H41 V380 H82",
    organizationTimes: "0;0.66;0.67;0.70;0.71;1",
    repositoryTimes: "0;0.70;0.71;0.74;0.75;1",
  },
  {
    row: 7,
    timing: "job-4",
    operation: "Repo Assist issue fix",
    workflow: "Repo Assist / Issue Fix",
    repository: "githubnext/agentics",
    mode: "review",
    duration: "4m 12s",
    failed: true,
    organizationPath: "M0 380 H41 V172 H82",
    organizationTimes: "0;0.75;0.76;0.79;0.80;1",
    repositoryTimes: "0;0.79;0.80;0.83;0.84;1",
  },
  {
    row: 8,
    timing: "job-5",
    operation: "Repo Assist maintenance",
    workflow: "Repo Assist / Maintenance",
    repository: "githubnext/gh-aw",
    mode: "live",
    duration: "5m 07s",
    targetRow: 3,
    organizationPath: "M0 456 H41 V172 H82",
    repositoryPath: "M0 172 H82",
    organizationTimes: "0;0.84;0.85;0.88;0.89;1",
    repositoryTimes: "0;0.88;0.89;0.92;0.93;1",
  },
];

const campaigns = [
  {
    name: "Dependabot",
    dispatcherClass: "dispatcher-dependabot",
    organizations: ["githubnext", "github"],
    jobs: [jobs[1], jobs[0]],
  },
  {
    name: "Repo Assist",
    dispatcherClass: "dispatcher-repo-assist",
    organizations: ["githubnext", "github"],
    jobs: [jobs[3], jobs[4], jobs[2]],
  },
];

const successfulJobs = jobs.filter((job) => !job.failed);
const controlRepository = successfulJobs.find((job) => job.repository === "githubnext/gh-aw-cao");
const targetJobs = [...successfulJobs].sort((left, right) => left.targetRow - right.targetRow);

const organizationNodes = [
  { organization: "githubnext", top: 146 },
  { organization: "github", top: 318 },
];
---

<div class="dispatch-illustration" aria-hidden="true">
  <section class="control-plane">
    <header class="control-plane-heading">
      <span>Central Agentic Ops (CAO)</span>
      <small>Control plane</small>
    </header>

    <div class="flow-layout">
      <section class="actions-column cao-surface">
        <div class="campaign-cue">
          <svg viewBox="0 0 16 16">{goalPaths.map((path) => <path d={path}></path>)}</svg>
          <span>Configured campaigns</span>
          <strong>Dependabot</strong>
          <strong>Repo Assist</strong>
        </div>
        <h3>GitHub Actions</h3>
        <div class="execution-grid">
          <article class="run-card dispatcher dispatcher-dependabot" style="grid-row: 1">
            <span class="status-stack">
              <svg class="status queued" viewBox="0 0 16 16"><path d={clockPath}></path></svg>
              <svg class="status running action-progress" viewBox="0 0 16 16">
                <circle class="progress-track" cx="8" cy="8" r="6.25"></circle>
                <circle class="progress-ring" cx="8" cy="8" r="6.25"></circle>
                <circle class="progress-dot" cx="8" cy="8" r="3.15"></circle>
              </svg>
              <svg class="status complete" viewBox="0 0 16 16"><path d={checkPath}></path></svg>
            </span>
            <span class="run-copy"><strong>Dependabot</strong><small>Campaign dispatcher</small></span>
            <span class="branch">main</span>
            <span class="run-meta">
              <span class="run-age"><svg viewBox="0 0 16 16"><path d={calendarPath}></path></svg>now</span>
              <span class="run-state">
                <svg viewBox="0 0 16 16"><path d={stopwatchPath}></path></svg>
                <i class="status-label queued">Queued</i>
                <i class="status-label running">In progress</i>
                <i class="status-label complete">Done</i>
              </span>
            </span>
          </article>

          <article class="run-card dispatcher dispatcher-repo-assist" style="grid-row: 5">
            <span class="status-stack">
              <svg class="status queued" viewBox="0 0 16 16"><path d={clockPath}></path></svg>
              <svg class="status running action-progress" viewBox="0 0 16 16">
                <circle class="progress-track" cx="8" cy="8" r="6.25"></circle>
                <circle class="progress-ring" cx="8" cy="8" r="6.25"></circle>
                <circle class="progress-dot" cx="8" cy="8" r="3.15"></circle>
              </svg>
              <svg class="status complete" viewBox="0 0 16 16"><path d={checkPath}></path></svg>
            </span>
            <span class="run-copy"><strong>Repo Assist</strong><small>Campaign dispatcher</small></span>
            <span class="branch">main</span>
            <span class="run-meta">
              <span class="run-age"><svg viewBox="0 0 16 16"><path d={calendarPath}></path></svg>now</span>
              <span class="run-state">
                <svg viewBox="0 0 16 16"><path d={stopwatchPath}></path></svg>
                <i class="status-label queued">Queued</i>
                <i class="status-label running">In progress</i>
                <i class="status-label complete">Done</i>
              </span>
            </span>
          </article>

          {jobs.map((job) => (
            <article class={`run-card worker ${job.timing}`} style={`grid-row: ${job.row}`}>
              <span class="status-stack">
                <svg class="status queued" viewBox="0 0 16 16"><path d={clockPath}></path></svg>
                <svg class="status running action-progress" viewBox="0 0 16 16">
                  <circle class="progress-track" cx="8" cy="8" r="6.25"></circle>
                  <circle class="progress-ring" cx="8" cy="8" r="6.25"></circle>
                  <circle class="progress-dot" cx="8" cy="8" r="3.15"></circle>
                </svg>
                <svg class={`status ${job.failed ? "failed" : "complete"}`} viewBox="0 0 16 16">
                  <path d={job.failed ? failurePath : checkPath}></path>
                </svg>
              </span>
              <span class="run-copy">
                <strong>{job.operation} · {job.repository} · {job.mode}</strong>
                <small>{job.workflow}</small>
              </span>
              <span class="branch">main</span>
              <span class="run-meta">
                <span class="run-age"><svg viewBox="0 0 16 16"><path d={calendarPath}></path></svg>now</span>
                <span class="run-state">
                  <svg viewBox="0 0 16 16"><path d={stopwatchPath}></path></svg>
                  <i class="status-label queued">Queued</i>
                  <i class="status-label running">In progress</i>
                  <i class={`status-label ${job.failed ? "failed" : "complete"}`}>
                    {job.failed ? "Failed" : "Done"} · {job.duration}
                  </i>
                </span>
              </span>
            </article>
          ))}
        </div>
      </section>

      <section class="organization-routes">
        <div class="stage-cue-spacer" aria-hidden="true"></div>
        <h3>Organization routes</h3>
        <div class="graph-route-stage">
          <svg class="graph-routes" viewBox="0 0 82 488" preserveAspectRatio="none">
            {jobs.map((job) => (
              <>
                <path d={job.organizationPath}></path>
                {!job.failed && (
                  <circle class={job.mode === "review" ? "graph-route-dot review" : "graph-route-dot"} r="2.5">
                    <animateMotion
                      dur="14s"
                      repeatCount="indefinite"
                      path={job.organizationPath}
                      keyTimes={job.organizationTimes}
                      keyPoints="0;0;0;1;1;1"
                      calcMode="linear"
                    />
                    <animate
                      attributeName="opacity"
                      dur="14s"
                      repeatCount="indefinite"
                      values="0;0;1;1;0;0"
                      keyTimes={job.organizationTimes}
                    />
                  </circle>
                )}
              </>
            ))}
            <circle class="graph-junction" cx="41" cy="172" r="2.5"></circle>
            <circle class="graph-junction" cx="41" cy="344" r="2.5"></circle>
          </svg>
        </div>
      </section>

      <section class="organizations-column">
        <div class="stage-cue-spacer" aria-hidden="true"></div>
        <h3>Organizations</h3>
        <div class="organization-stage">
          {organizationNodes.map((node) => (
            <article class="organization-node" style={`top: ${node.top}px`}>
              <svg class="organization-icon" viewBox="0 0 16 16"><path d={organizationPath}></path></svg>
              <span>
                <strong>{node.organization}</strong>
              </span>
            </article>
          ))}
        </div>
        <div class="node-continuation node-continuation-no-icon">
          <b>•••</b>
          <small>more organizations</small>
        </div>
      </section>

      <section class="repository-routes">
        <div class="stage-cue-spacer" aria-hidden="true"></div>
        <h3>Repository routes</h3>
        <div class="graph-route-stage">
          <svg class="graph-routes" viewBox="0 0 82 488" preserveAspectRatio="none">
            {targetJobs.map((job) => (
              <>
                <path d={job.repositoryPath}></path>
                <circle class={job.mode === "review" ? "graph-route-dot review" : "graph-route-dot"} r="2.5">
                  <animateMotion
                    dur="14s"
                    repeatCount="indefinite"
                    path={job.repositoryPath}
                    keyTimes={job.repositoryTimes}
                    keyPoints="0;0;0;1;1;1"
                    calcMode="linear"
                  />
                  <animate
                    attributeName="opacity"
                    dur="14s"
                    repeatCount="indefinite"
                    values="0;0;1;1;0;0"
                    keyTimes={job.repositoryTimes}
                  />
                </circle>
              </>
            ))}
            <circle class="graph-junction" cx="41" cy="172" r="2.5"></circle>
            <circle class="graph-junction" cx="41" cy="344" r="2.5"></circle>
          </svg>
        </div>
      </section>

      <section class="repositories-column">
        <div class="stage-cue-spacer" aria-hidden="true"></div>
        <h3>Target Repositories</h3>
        <div class="target-grid">
          {targetJobs.map((job) => (
            <article class={`repository-card ${job.timing} ${job.mode}`} style={`grid-row: ${job.targetRow}`}>
              <svg class="repo-icon repository-icon" viewBox="0 0 16 16"><path d={repoPath}></path></svg>
              <span class="repository-copy">
                <strong>{job.repository}</strong>
                {job.repository === controlRepository?.repository && <small>CAO control plane</small>}
              </span>
            </article>
          ))}
        </div>
        <div class="node-continuation">
          <svg class="repo-icon repository-icon" viewBox="0 0 16 16"><path d={repoPath}></path></svg>
          <b>•••</b>
          <small>more repositories</small>
        </div>
      </section>
    </div>

    <div class="mobile-flow">
      <div class="campaign-cue">
        <svg viewBox="0 0 16 16">{goalPaths.map((path) => <path d={path}></path>)}</svg>
        <span>Configured campaigns</span>
        <strong>Dependabot</strong>
        <strong>Repo Assist</strong>
      </div>

      {campaigns.map((campaign) => (
        <section class="mobile-campaign">
          <header class="mobile-campaign-heading">
            <span>{campaign.name}</span>
            <span class="mobile-campaign-organizations">
              {campaign.organizations.map((organization) => (
                <small>
                  <svg class="organization-icon" viewBox="0 0 16 16"><path d={organizationPath}></path></svg>
                  {organization}
                </small>
              ))}
              <em>+ others</em>
            </span>
          </header>

          <article class={`mobile-action-card mobile-dispatcher ${campaign.dispatcherClass}`}>
            <span class="status-stack">
              <svg class="status queued" viewBox="0 0 16 16"><path d={clockPath}></path></svg>
              <svg class="status running action-progress" viewBox="0 0 16 16">
                <circle class="progress-track" cx="8" cy="8" r="6.25"></circle>
                <circle class="progress-ring" cx="8" cy="8" r="6.25"></circle>
                <circle class="progress-dot" cx="8" cy="8" r="3.15"></circle>
              </svg>
              <svg class="status complete" viewBox="0 0 16 16"><path d={checkPath}></path></svg>
            </span>
            <span>
              <strong>{campaign.name}</strong>
              <small>Campaign dispatcher</small>
            </span>
          </article>

          <div class="mobile-workers">
            <p>Parallel workers</p>
            {campaign.jobs.map((job) => (
              <div class="mobile-dispatch-pair">
                <article class={`mobile-action-card mobile-worker ${job.timing}`}>
                  <span class="status-stack">
                    <svg class="status queued" viewBox="0 0 16 16"><path d={clockPath}></path></svg>
                    <svg class="status running action-progress" viewBox="0 0 16 16">
                      <circle class="progress-track" cx="8" cy="8" r="6.25"></circle>
                      <circle class="progress-ring" cx="8" cy="8" r="6.25"></circle>
                      <circle class="progress-dot" cx="8" cy="8" r="3.15"></circle>
                    </svg>
                    <svg class={`status ${job.failed ? "failed" : "complete"}`} viewBox="0 0 16 16">
                      <path d={job.failed ? failurePath : checkPath}></path>
                    </svg>
                  </span>
                  <span>
                    <strong>{job.workflow}</strong>
                    <small>{job.operation}</small>
                  </span>
                </article>
                {!job.failed && (
                  <>
                    <span class={`mobile-pair-route ${job.timing} ${job.mode}`}>
                      <i></i>
                    </span>
                    <article class={`mobile-repository-card ${job.mode}`}>
                      <svg class="repo-icon repository-icon" viewBox="0 0 16 16"><path d={repoPath}></path></svg>
                      <span>
                        <strong>{job.repository}</strong>
                        {job.repository === controlRepository?.repository && <small>CAO control plane</small>}
                      </span>
                    </article>
                  </>
                )}
              </div>
            ))}
          </div>
        </section>
      ))}

      <div class="mobile-scale-cue">
        <span class="mobile-scale-icons">
          <svg class="organization-icon" viewBox="0 0 16 16"><path d={organizationPath}></path></svg>
          <svg class="repository-icon" viewBox="0 0 16 16"><path d={repoPath}></path></svg>
        </span>
        <span><strong>More organizations and repositories</strong><small>The bounded dispatch pattern continues.</small></span>
        <b>•••</b>
      </div>
    </div>
  </section>
</div>

<style>
  .dispatch-illustration {
    --line: color-mix(in srgb, var(--sl-color-gray-4) 72%, transparent);
    --muted: var(--sl-color-gray-3);
    --panel: color-mix(in srgb, var(--sl-color-bg) 91%, var(--sl-color-gray-6));
    --card: color-mix(in srgb, var(--sl-color-bg) 96%, var(--sl-color-gray-5));
    --success: #2da44e;
    --review: #0969da;
    --attention: #bf8700;
    --danger: #cf222e;
    width: min(100%, 1270px);
    margin: 0 auto;
    padding: 0 8px;
    box-sizing: border-box;
    color: var(--sl-color-white);
    text-align: left;
  }

  :global([data-theme="dark"]) .dispatch-illustration {
    --success: #3fb950;
    --review: #58a6ff;
    --attention: #d29922;
    --danger: #f85149;
    --muted: #d0d7de;
  }

  h3 {
    height: 34px;
    margin: 0;
    color: var(--sl-color-white);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.02em;
    line-height: 34px;
  }

  .control-plane {
    overflow: visible;
  }

  .control-plane-heading {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    height: 42px;
    padding: 0 4px;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .control-plane-heading small {
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 500;
  }

  .flow-layout {
    display: grid;
    grid-template-columns: minmax(520px, 740px) 72px 150px 72px 220px;
    gap: 0;
  }

  .mobile-flow {
    display: none;
  }

  .cao-surface {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: color-mix(in srgb, var(--sl-color-bg) 97%, var(--sl-color-gray-6));
  }

  .campaign-cue,
  .stage-cue-spacer {
    height: 34px;
  }

  .campaign-cue {
    display: flex;
    align-items: center;
