---
// Adapted from github/gh-aw (MIT), revision 9bf555c835e3a2086c4448de45e75ecc803e6950.
import { Icon } from "@astrojs/starlight/components";

const emojis = [
  { symbol: "😄", label: "Smile" }, { symbol: "🤔", label: "Thinking" },
  { symbol: "😭", label: "Crying" }, { symbol: "👀", label: "Eyes" },
];
const colors = [
  { value: "#ffe135", label: "Yellow" }, { value: "#00d9ff", label: "Cyan" },
  { value: "#cf1fdb", label: "Magenta" }, { value: "#ee0000", label: "Red" },
];
---

<div class="drawing-tools" data-slideshow-drawing>
  <button type="button" data-drawing-toggle aria-label="Drawing tools" aria-expanded="false" aria-controls="slideshow-drawing-panel" title="Drawing tools">
    <Icon name="pencil" size="1.25rem" />
  </button>
  <div id="slideshow-drawing-panel" class="drawing-panel" role="group" aria-label="Draw on slides" hidden>
    <div class="drawing-row">
      <button type="button" data-drawing-tool="pointer" aria-label="Interact with slide" aria-pressed="true" title="Interact with slide">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m5 3 15 10-7 1-3 7Z" /></svg>
      </button>
      <button type="button" data-drawing-tool="rect" aria-label="Draw rectangle (Shift for square)" aria-pressed="false" title="Draw rectangle (Shift for square)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="1" /></svg>
      </button>
      <button type="button" data-drawing-tool="arrow" aria-label="Draw arrow" aria-pressed="false" title="Drag from the arrow's tail to its tip">
        <Icon name="right-arrow" size="1.25rem" />
      </button>
      {emojis.map(emoji => (
        <button type="button" data-drawing-tool="emoji" data-emoji={emoji.symbol} aria-label={`${emoji.label} emoji`} aria-pressed="false" title={`${emoji.label} emoji`}>
          <span aria-hidden="true">{emoji.symbol}</span>
        </button>
      ))}
    </div>
    <div class="drawing-row">
      <div class="drawing-colors" role="group" aria-label="Ink color">
        {colors.map((color, index) => (
          <button type="button" data-drawing-color={color.value} aria-label={`${color.label} ink`} aria-pressed={index === 0 ? "true" : "false"} title={`${color.label} ink`}>
            <span class="drawing-swatch" style={`background:${color.value}`} aria-hidden="true"></span>
          </button>
        ))}
      </div>
      <span class="drawing-help">
        <button type="button" aria-label="Drawing help" aria-describedby="slideshow-drawing-help"><Icon name="question" size="1.25rem" /></button>
        <span id="slideshow-drawing-help" class="drawing-help-tooltip" role="tooltip">
          Drag to draw. Hold Shift for squares. Choose an emoji, then click the slide to stamp; drag to resize and rotate.
        </span>
      </span>
      <button type="button" data-drawing-undo aria-label="Undo drawing" title="Undo drawing (Ctrl/Cmd+Z)" disabled>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m8 4-5 5 5 5M3 9h11a6 6 0 0 1 0 12" /></svg>
      </button>
      <button type="button" data-drawing-clear aria-label="Clear slide drawings" title="Clear slide drawings" disabled>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" /></svg>
      </button>
    </div>
    <span class="sr-only" data-drawing-status role="status" aria-live="polite"></span>
  </div>
</div>

<style>
  .drawing-tools { position: relative; }
  .drawing-panel {
    position: absolute;
    inset-inline-start: 0;
    bottom: calc(100% + 1rem);
    width: max-content;
    max-width: calc(100vw - 4rem);
    padding: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-bg-nav);
    box-shadow: var(--sl-shadow-lg);
  }
  .drawing-panel[hidden] { display: none; }
  .drawing-row, .drawing-colors { display: flex; gap: 0.375rem; align-items: center; }
  .drawing-row + .drawing-row { margin-top: 0.5rem; }
  .drawing-colors { margin-inline-end: auto; }
  .drawing-tools button[aria-pressed="true"] { border-color: var(--sl-color-text-accent); box-shadow: inset 0 0 0 1px var(--sl-color-text-accent); }
  .drawing-tools [data-emoji] { font-size: 1.5rem; }
  .drawing-swatch { width: 1.125rem; height: 1.125rem; border-radius: 50%; }
  .drawing-help { position: relative; display: inline-flex; }
  .drawing-help-tooltip {
    display: none;
    position: absolute;
    inset-inline-end: 0;
    bottom: calc(100% + 0.5rem);
    z-index: 1;
    width: 20rem;
    max-width: calc(100vw - 4rem);
    padding: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    box-shadow: var(--sl-shadow-lg);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .drawing-help:hover .drawing-help-tooltip,
  .drawing-help:focus-within .drawing-help-tooltip { display: block; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
