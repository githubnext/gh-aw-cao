---
import type { HTMLAttributes } from "astro/types";

const PAGE_TITLE_ID = "_top";

type HeroAction = {
  attrs?: Omit<HTMLAttributes<"a">, "href">;
  icon?: { name?: string; html?: string };
  link: string;
  text: string;
  variant?: "primary" | "secondary" | "minimal";
};
type HeroData = {
  title: string;
  draft?: boolean;
  hero?: {
    title?: string;
    tagline?: string;
    image?: { alt?: string };
    actions?: HeroAction[];
  };
};

const { data } = (Astro.locals as unknown as { starlightRoute: { entry: { data: HeroData } } }).starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="hero">
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
      {data.draft && <aside class="draft-notice">This page is a draft and may contain incomplete content.</aside>}
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>
    {
      actions.length > 0 && (
        <div class="sl-flex actions">
          {actions.map(
            ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
              <a href={href} class:list={["hero-action", variant || "primary", className]} {...attrs}>
                {text}
                {icon?.html ? <Fragment set:html={icon.html} /> : icon?.name === "right-arrow" && <span aria-hidden="true">→</span>}
              </a>
            ),
          )}
        </div>
      )
    }
  </div>

  <figure class="operations-map" aria-labelledby="operations-map-title" aria-describedby="operations-map-description">
    <figcaption class="visually-hidden">
      <span id="operations-map-title">Central execution with bounded repository outputs</span>
      <span id="operations-map-description">Orchestrators and workers run in the private central control repository. A central worker inspects one target repository at a time and emits declared safe outputs. Control-plane workflows are not installed in or run from target repositories.</span>
    </figcaption>

    <div class="map-flow">
      <section class="map-stage" aria-labelledby="govern-title">
        <p class="stage-label"><span>01</span> Govern</p>
        <div class="stage-panel control-panel">
          <div>
            <p class="panel-kicker">Central execution runtime</p>
            <h2 id="govern-title">Control plane</h2>
            <p class="panel-copy"><strong>Orchestrators and workers run here.</strong> Policy, limits, and credentials stay centralized.</p>
          </div>
          <div class="rollout">
            <p>Rollout mode</p>
            <div class="mode-track" role="group" aria-label="Review, then live rollout">
              <span>Review</span><span>Live</span>
            </div>
            <div class="human-gate"><span aria-hidden="true">✓</span> Human approval before live</div>
          </div>
        </div>
      </section>

      <div class="flow-connector" aria-hidden="true"><span>approved</span><i></i></div>

      <section class="map-stage" aria-labelledby="campaigns-title">
        <p class="stage-label"><span>02</span> Run centrally</p>
        <div class="stage-panel campaign-panel">
          <div>
            <p class="panel-kicker">Installed in control plane</p>
            <h2 id="campaigns-title">Operation campaigns</h2>
          </div>
          <div class="campaign-stack">
            <div class="campaign-node"><strong>Dependabot</strong><small>Central orchestrator + worker</small></div>
            <div class="campaign-more"><span class="visually-hidden">More operation campaigns</span><i></i><i></i><i></i></div>
            <div class="campaign-node"><strong>AW Optimization</strong><small>Central orchestrator + workers</small></div>
          </div>
        </div>
      </section>

      <div class="flow-connector boundary-connector" aria-hidden="true"><span>safe outputs only</span><i></i></div>

      <section class="map-stage" aria-labelledby="execute-title">
        <p class="stage-label"><span>03</span> Target</p>
        <div class="stage-panel repository-panel">
          <div class="scale-lockup">
            <p class="panel-kicker">Remote repository fleet</p>
            <h2 id="execute-title"><strong>10,000</strong> targets</h2>
            <p class="panel-copy">Central workers inspect one target at a time.</p>
          </div>
          <p class="execution-boundary"><span aria-hidden="true">×</span> No control-plane workflows run here</p>
          <div class="repository-list">
            <div class="repository-node"><span>Repository 1</span><span class="visually-hidden">Passed</span><i class="status success" aria-hidden="true"></i></div>
            <div class="repository-node"><span>Repository 2</span><span class="visually-hidden">Failed</span><i class="status failure" aria-hidden="true"></i></div>
            <div class="repository-more"><span class="visually-hidden">Repositories 3 through 9,999</span><i></i><i></i><i></i></div>
            <div class="repository-node"><span>Repository 10,000</span><span class="visually-hidden">Passed</span><i class="status success delayed" aria-hidden="true"></i></div>
          </div>
        </div>
      </section>

      <div class="flow-connector" aria-hidden="true"><span>correlated</span><i></i></div>

      <section class="map-stage" aria-labelledby="verify-title">
        <p class="stage-label"><span>04</span> Verify</p>
        <div class="stage-panel outcome-panel">
          <div>
            <p class="panel-kicker">Example batch</p>
            <h2 id="verify-title">Traceable outcomes</h2>
            <p class="panel-copy">Every result links to its originating run.</p>
          </div>
          <div class="outcome-summary">
            <div class="outcome-chart">
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <circle class="outcome-track" cx="50" cy="50" r="42" pathLength="100"></circle>
                <circle class="outcome-ring success" cx="50" cy="50" r="42" pathLength="100"></circle>
                <circle class="outcome-ring failure" cx="50" cy="50" r="42" pathLength="100"></circle>
              </svg>
              <strong>12</strong><span>results</span>
            </div>
            <div class="outcome-legend">
              <p><i class="success"></i><strong>10</strong> passed</p>
              <p><i class="failure"></i><strong>2</strong> failed</p>
            </div>
          </div>
          <p class="correlation-id">Run #1842 · correlated</p>
        </div>
      </section>
    </div>
  </figure>
</div>

<style>
  @layer starlight.core {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: center;
      gap: 2rem;
      padding-block: 2rem 3rem;
    }

    .stack {
      flex-direction: column;
      gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
      text-align: center;
    }

    .copy {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .copy > * {
      max-width: 52ch;
    }

    h1 {
      max-width: 14ch;
      color: var(--sl-color-white);
      font-size: clamp(var(--sl-text-3xl), 6vw, var(--sl-text-6xl));
      font-weight: 650;
      line-height: var(--sl-line-height-headings);
      letter-spacing: 0;
      hyphens: none !important;
      overflow-wrap: normal !important;
      word-break: normal !important;
    }

    .tagline {
      color: var(--sl-color-gray-2);
      font-size: clamp(var(--sl-text-base), 2vw, var(--sl-text-xl));
    }

    .draft-notice {
      border-inline-start: 0.25rem solid var(--sl-color-orange);
      padding-inline-start: 1rem;
      color: var(--sl-color-gray-2);
    }

    .actions {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem 2rem;
    }

    .hero-action {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      border: 1px solid transparent;
      border-radius: 999rem;
      padding: 0.4375rem 1.125rem;
      font-size: var(--sl-text-sm);
      font-weight: 600;
      line-height: 1.1875;
      text-decoration: none;
      outline-offset: 0.25rem;
    }

    .hero-action.primary {
      border-color: var(--sl-color-text-accent);
      background: var(--sl-color-text-accent);
      color: var(--sl-color-black);
    }

    .hero-action.secondary {
      border-color: currentColor;
      color: var(--sl-color-white);
    }

    .hero-action.minimal {
      color: var(--sl-color-white);
    }

    .operations-map {
      --map-width: min(86rem, calc(100vw - 3rem));
      width: var(--map-width);
      margin: 0 0 0 calc((100% - var(--map-width)) / 2);
      padding: 1.5rem 0;
      color: #1f2328;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .map-flow {
      display: grid;
      grid-template-columns: minmax(13.5rem, 1.05fr) 4rem minmax(13rem, 1fr) 5rem minmax(14rem, 1.08fr) 4rem minmax(13rem, 1fr);
      align-items: stretch;
      gap: 0;
    }

    .map-stage {
      display: flex;
      min-width: 0;
      flex-direction: column;
    }

    .stage-label {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      margin: 0 0 0.65rem;
      color: var(--sl-color-gray-2);
      font-size: 0.8125rem;
      font-weight: 700;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .stage-label span {
      display: inline-grid;
      width: 1.75rem;
      height: 1.75rem;
      place-items: center;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 50%;
      color: var(--sl-color-text-accent);
      font-size: 0.6875rem;
    }

    .stage-panel {
      display: flex;
      min-height: 19rem;
      flex: 1;
      flex-direction: column;
      justify-content: space-between;
      gap: 1.25rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 6px;
      background: var(--sl-color-bg);
      padding: 1.25rem;
      box-shadow: 0 12px 30px color-mix(in srgb, #1f2328 9%, transparent);
    }

    .control-panel {
      border-top: 4px solid var(--sl-color-text-accent);
    }

    .campaign-panel {
      border-top: 4px solid var(--sl-color-text-accent);
    }

    .panel-kicker,
    .rollout > p {
      margin: 0 0 0.35rem;
      color: var(--sl-color-gray-2);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .stage-panel h2 {
      margin: 0;
      color: var(--sl-color-white);
      font-size: clamp(1.125rem, 1.5vw, 1.375rem);
      line-height: 1.2;
      letter-spacing: 0;
    }

    .panel-copy {
      margin: 0.65rem 0 0;
      color: var(--sl-color-gray-2);
      font-size: 1rem;
      line-height: 1.5;
    }

    .panel-copy strong {
      color: var(--sl-color-white);
      font-weight: 700;
    }

    .mode-track {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      overflow: hidden;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 5px;
    }

    .mode-track span {
      padding: 0.5rem 0.25rem;
      color: var(--sl-color-gray-2);
      font-size: 0.75rem;
      font-weight: 650;
      text-align: center;
    }

    .mode-track span + span {
      border-inline-start: 1px solid var(--sl-color-gray-5);
    }

    .mode-track span:first-child {
      color: var(--sl-color-white);
    }

    .human-gate {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      margin-top: 0.65rem;
      color: var(--sl-color-gray-2);
      font-size: 0.75rem;
      font-weight: 600;
    }

    .human-gate span {
      display: inline-grid;
      width: 1.15rem;
      height: 1.15rem;
      place-items: center;
      border-radius: 50%;
      background: var(--sl-color-text-accent);
      color: var(--sl-color-black);
      font-size: 0.7rem;
    }

    .flow-connector {
      position: relative;
      align-self: center;
      height: 2px;
      background: var(--sl-color-gray-5);
    }

    .flow-connector::after {
      position: absolute;
      top: 50%;
      right: -1px;
      width: 0.5rem;
      height: 0.5rem;
      border-top: 2px solid var(--sl-color-gray-3);
      border-right: 2px solid var(--sl-color-gray-3);
      content: "";
      transform: translateY(-50%) rotate(45deg);
    }

    .flow-connector span {
      position: absolute;
      bottom: 0.65rem;
      left: 50%;
      width: max-content;
      color: var(--sl-color-gray-3);
      font-size: 0.75rem;
      font-weight: 650;
      transform: translateX(-50%);
    }

    .flow-connector i {
      position: absolute;
      top: -3px;
      left: 0;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--sl-color-text-accent);
      box-shadow: 0 0 8px var(--sl-color-text-accent);
      animation: flow-pulse 8s ease-in-out infinite;
    }

    .flow-connector:nth-child(4) i {
      animation-delay: 0.8s;
    }

    .flow-connector:nth-child(6) i {
      animation-delay: 1.6s;
    }

    .campaign-panel {
      gap: 0.85rem;
    }

    .campaign-stack {
      display: grid;
      gap: 0.45rem;
    }

    .campaign-node {
      display: grid;
      gap: 0.15rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 5px;
      padding: 0.7rem 0.8rem;
      background: color-mix(in srgb, var(--sl-color-gray-6) 55%, transparent);
    }

    .campaign-node strong {
      color: var(--sl-color-white);
      font-size: 1rem;
    }

    .campaign-node small {
      color: var(--sl-color-gray-2);
      font-size: 0.75rem;
    }

    .campaign-more,
    .repository-more {
      display: flex;
      justify-content: center;
      gap: 0.28rem;
      padding-block: 0.1rem;
    }

    .campaign-more i,
    .repository-more i {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--sl-color-gray-3);
    }

    .scale-lockup h2 {
      display: flex;
      align-items: baseline;
      gap: 0.4rem;
      font-size: 1rem;
    }

    .scale-lockup h2 strong {
      color: var(--sl-color-white);
      font-size: clamp(2rem, 3vw, 2.75rem);
      font-variant-numeric: tabular-nums;
      line-height: 1;
    }

    .repository-list {
      display: grid;
      gap: 0.45rem;
    }

    .execution-boundary {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin: 0;
      border: 1px solid color-mix(in srgb, var(--sl-color-text-accent) 45%, var(--sl-color-gray-5));
      border-radius: 5px;
      padding: 0.55rem 0.65rem;
      background: color-mix(in srgb, var(--sl-color-text-accent) 8%, transparent);
      color: var(--sl-color-white);
      font-size: 0.8125rem;
      font-weight: 650;
    }

    .execution-boundary span {
      display: inline-grid;
      width: 1.1rem;
      height: 1.1rem;
      flex: 0 0 auto;
      place-items: center;
      border: 1px solid currentColor;
      border-radius: 50%;
      line-height: 1;
    }

    .repository-node {
      display: flex;
      min-height: 2.25rem;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      border-bottom: 1px solid var(--sl-color-gray-5);
      color: var(--sl-color-white);
      font-size: 0.9375rem;
      font-weight: 600;
    }

    .status,
    .outcome-legend i {
      width: 0.65rem;
      height: 0.65rem;
      flex: 0 0 auto;
      border-radius: 50%;
      background: var(--sl-color-orange);
    }

    .status.success {
      animation: status-success 8s steps(1, end) infinite;
    }

    .status.failure {
      animation: status-failure 8s steps(1, end) infinite;
    }

    .status.delayed {
      animation-delay: 0.45s;
    }

    .outcome-summary {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .outcome-chart {
      position: relative;
      display: grid;
      width: 5.75rem;
      height: 5.75rem;
      flex: 0 0 auto;
      place-content: center;
      text-align: center;
    }

    .outcome-chart svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
      transform: rotate(-90deg);
    }

    .outcome-track,
    .outcome-ring {
      fill: none;
      stroke-width: 11;
    }

    .outcome-track {
      stroke: var(--sl-color-gray-5);
    }

    .outcome-ring {
      stroke-dasharray: 0 100;
    }

    .outcome-ring.success {
      stroke: #1f883d;
      animation: chart-success 8s ease-out infinite;
    }

    .outcome-ring.failure {
      stroke: #cf222e;
      stroke-dashoffset: -83.33;
      animation: chart-failure 8s ease-out infinite;
    }

    .outcome-chart strong,
    .outcome-chart span {
      display: block;
    }

    .outcome-chart strong {
      color: var(--sl-color-white);
      font-size: 1.5rem;
      line-height: 1;
    }

    .outcome-chart span {
      margin-top: 0.2rem;
      color: var(--sl-color-gray-2);
      font-size: 0.6875rem;
    }

    .outcome-legend {
      display: grid;
      gap: 0.55rem;
    }

    .outcome-legend p {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      margin: 0;
      color: var(--sl-color-gray-2);
      font-size: 0.8125rem;
    }

    .outcome-legend i.success {
      background: #1f883d;
    }

    .outcome-legend i.failure {
      background: #cf222e;
    }

    .outcome-legend strong {
      color: var(--sl-color-white);
      font-size: 1rem;
    }

    .correlation-id {
      margin: 0;
      border-top: 1px solid var(--sl-color-gray-5);
      padding-top: 0.65rem;
      color: var(--sl-color-gray-2);
      font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
      font-size: 0.6875rem;
    }

    @keyframes flow-pulse {
      0%, 8% { left: 0; opacity: 0; }
      12% { opacity: 1; }
      24%, 100% { left: calc(100% - 8px); opacity: 0; }
    }

    @keyframes status-success {
      0%, 47% { background: var(--sl-color-orange); }
      48%, 100% { background: #1f883d; }
    }

    @keyframes status-failure {
      0%, 52% { background: var(--sl-color-orange); }
      53%, 100% { background: #cf222e; }
    }

    @keyframes chart-success {
      0%, 52% { stroke-dasharray: 0 100; }
      66%, 100% { stroke-dasharray: 83.33 16.67; }
    }

    @keyframes chart-failure {
      0%, 66% { stroke-dasharray: 0 100; }
      74%, 100% { stroke-dasharray: 16.67 83.33; }
    }

    @media (max-width: 70rem) {
      .operations-map {
        --map-width: min(38rem, calc(100vw - 2rem));
      }

      .map-flow {
        grid-template-columns: minmax(0, 1fr);
      }

      .stage-panel {
        min-height: auto;
      }

      .flow-connector {
        width: 2px;
        height: 3.75rem;
        justify-self: center;
      }

      .flow-connector::after {
        top: auto;
        right: 50%;
        bottom: 0;
        transform: translateX(50%) rotate(135deg);
      }

      .flow-connector span {
        top: 50%;
        bottom: auto;
        left: 1rem;
        transform: translateY(-50%);
      }

      .flow-connector i {
        top: 0;
        left: -3px;
        animation-name: flow-pulse-vertical;
      }
    }

    @keyframes flow-pulse-vertical {
      0%, 8% { top: 0; opacity: 0; }
      12% { opacity: 1; }
      24%, 100% { top: calc(100% - 8px); opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .flow-connector i,
      .status.success,
      .status.failure,
      .outcome-ring.success,
      .outcome-ring.failure {
        animation: none;
      }

      .status.success {
        background: #1f883d;
      }

      .status.failure {
        background: #cf222e;
      }

      .outcome-ring.success {
        stroke-dasharray: 83.33 16.67;
      }

      .outcome-ring.failure {
        stroke-dasharray: 16.67 83.33;
      }
    }

    @media (min-width: 64rem) {
      .hero {
        grid-template-columns: minmax(0, 1fr) !important;
        gap: 2rem;
        min-height: auto;
        padding-block: 3rem 4rem;
      }

      .stack {
        max-width: 52rem;
        margin-inline: auto;
        text-align: center;
      }

      .copy {
        align-items: center;
      }

      .actions {
        justify-content: center;
      }
    }
  }
</style>
