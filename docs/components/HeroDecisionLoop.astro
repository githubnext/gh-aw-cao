    <li><span>01</span><strong>Run</strong><small>Bounded scope</small></li>
    <li><span>02</span><strong>Observe</strong><small>Runs + cost</small></li>
    <li><span>03</span><strong>Review</strong><small>Outcome evidence</small></li>
  </ol>
  <div class="loop-connector" aria-hidden="true">↓</div>
  <div class="decision-gate">
