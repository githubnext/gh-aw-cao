---
import HeroIntro from "./HeroIntro.astro";
import TerminalDemo from "./TerminalDemo.astro";
import ThemeImage from "./ThemeImage.astro";
import dashboardCampaignValue from "../assets/product/cao-dashboard-campaign-value-mobile.png";
import dashboardCampaignValueLight from "../assets/product/cao-dashboard-campaign-value-mobile-light.png";
import dashboardMobileOverview from "../assets/product/cao-dashboard-mobile-overview.png";
import dashboardMobileOverviewLight from "../assets/product/cao-dashboard-mobile-overview-light.png";
import dashboardRunHistory from "../assets/product/cao-dashboard-run-history-mobile.png";
import dashboardRunHistoryLight from "../assets/product/cao-dashboard-run-history-mobile-light.png";
---

<div class="hierarchy-hero">
  <HeroIntro />

  <div class="hero-visual">
    <span class="hero-callout callout-health" aria-hidden="true">
      <span class="callout-card">Campaign health<br />at a glance</span>
      <span class="callout-line"></span>
    </span>
    <span class="hero-callout callout-attention" aria-hidden="true">
      <span class="callout-card">Drill into what<br />needs attention</span>
      <span class="callout-line"></span>
    </span>
    <figure class="phone-preview" aria-labelledby="mobile-dashboard-preview-title">
      <figcaption class="visually-hidden">
        <span id="mobile-dashboard-preview-title">Central Agentic Ops mobile dashboard overview</span>
      </figcaption>
      <div class="phone-shell">
        <span class="phone-speaker" aria-hidden="true"></span>
        <ThemeImage
          dark={dashboardMobileOverview}
          light={dashboardMobileOverviewLight}
          alt="Central Agentic Ops mobile dashboard showing campaigns needing attention, campaign rhythm, health, and repository coverage."
          widths={[390, 780]}
          sizes="(max-width: 42rem) 76vw, 18vw"
          loading="eager"
          class="phone-image"
        />
      </div>
    </figure>
  </div>
</div>

<section class="product-story terminal-story" aria-labelledby="terminal-title" data-reveal>
  <div class="product-story-copy">
    <p class="section-eyebrow">From one control repo to many campaigns</p>
    <h2 id="terminal-title">Coordinate campaign fleets from one control plane.</h2>
    <p>
      Install multiple operational campaigns, give each an explicit repository fleet, and expand them through
      controlled cohorts. CAO resolves shared policy before orchestrators select work and dispatch bounded workers.
    </p>
    <ul class="story-points">
      <li>Run each operation across its intended fleet of repositories.</li>
      <li>Control scope, mode, credentials, and rollout limits in reviewed policy.</li>
      <li>Keep every worker fixed to one explicitly authorized target.</li>
    </ul>
  </div>
  <TerminalDemo />
</section>

<section class="product-story runs-story" aria-labelledby="runs-title" data-reveal>
  <div class="product-story-copy">
    <p class="section-eyebrow">Many runs, one operating picture</p>
    <h2 id="runs-title">See every campaign. Focus where it diverges.</h2>
    <p>
      CAO connects each run to its campaign, workflow revision, target, and outcome. Instead of visiting repositories
      one by one, operators can identify shared patterns and spend attention on the exceptions that need judgment.
    </p>
    <ul class="story-points">
      <li>Compare campaigns and their fleets across the same time horizon.</li>
      <li>Separate cross-campaign patterns from isolated target issues.</li>
      <li>Drill from aggregate health into the exact run and evidence.</li>
    </ul>
  </div>
  <figure class="product-frame product-shot product-shot-mobile product-shot-runs">
    <ThemeImage
      dark={dashboardRunHistory}
      light={dashboardRunHistoryLight}
      alt="Mobile CAO Runs view showing its compact app header and one-week successful, failed, and cancelled workflow chart."
      widths={[390, 780]}
      sizes="(max-width: 42rem) calc(100vw - 3rem), 22rem"
      loading="lazy"
      class="product-image"
    />
  </figure>
</section>

<section class="product-story value-story reverse" aria-labelledby="value-title" data-reveal>
  <div class="product-story-copy">
    <p class="section-eyebrow">Scale what works</p>
    <h2 id="value-title">Prove value before multiplying work.</h2>
    <p>
      Campaign-specific measures combine cost, reliability, and repository outcomes into comparable evidence. Use
      that evidence to expand a cohort, pause an operation, or improve it before it reaches more repositories.
    </p>
    <ul class="story-points">
      <li>Define success in the operation instead of inferring it from completed runs.</li>
      <li>Compare cohorts without hiding missing or incomplete evidence.</li>
      <li>Promote, revise, or stop work based on observed operational value.</li>
    </ul>
  </div>
  <figure class="product-frame product-shot product-shot-mobile product-shot-value">
    <ThemeImage
      dark={dashboardCampaignValue}
      light={dashboardCampaignValueLight}
      alt="Mobile AW Optimization view showing compact campaign navigation and AI credit per successful run against its baseline."
      widths={[390, 780]}
      sizes="(max-width: 42rem) calc(100vw - 3rem), 22rem"
      loading="lazy"
      class="product-image"
    />
  </figure>
</section>

<script>
  const revealTargets = document.querySelectorAll<HTMLElement>("[data-reveal]");

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && revealTargets.length > 0) {
    revealTargets.forEach((target) => target.classList.add("reveal-pending"));

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          entry.target.classList.remove("reveal-pending");
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
    );

    revealTargets.forEach((target) => observer.observe(target));
  }
</script>

<style>
  @layer starlight.core {
    :global(.content-panel:has(.hierarchy-hero)) {
      --cao-page-bg: #f7faf8;
      --cao-page-grid-minor: rgba(26, 127, 55, 0.055);
      --cao-page-grid-major: rgba(26, 127, 55, 0.13);
      --cao-page-glow: rgba(26, 127, 55, 0.12);
      --cao-page-secondary-glow: rgba(26, 127, 55, 0.055);
      --cao-signal-bg: rgba(255, 255, 255, 0.92);
      --cao-signal-border: rgba(31, 35, 40, 0.18);
      --cao-phone-bg: #d8dee4;
      --cao-phone-border: #8c959f;
      --cao-phone-inset: rgba(255, 255, 255, 0.72);
      --cao-phone-shadow: rgba(31, 35, 40, 0.2);
      --cao-phone-speaker: #6e7781;
      --cao-section-bg: rgba(255, 255, 255, 0.84);
      --cao-section-border: rgba(31, 35, 40, 0.17);
      --cao-section-shadow: 0 1.5rem 4rem rgba(31, 35, 40, 0.1);
      --cao-section-accent-start: 12%;
      --cao-section-accent-end: 5%;
      --cao-section-glow-strength: 24%;
      --cao-story-heading: #1f2328;
      --cao-story-text: #4d5560;
      --cao-story-eyebrow: #3d444d;
      --cao-product-label: #59636e;
      --cao-loop-text: #1f2328;
      --cao-loop-muted: #59636e;
      --cao-loop-border: #afb8c1;
      padding-inline: 0;
      background-color: var(--cao-page-bg);
      background-image:
        radial-gradient(circle at 76% 7%, var(--cao-page-glow), transparent 31rem),
        radial-gradient(circle at 12% 42%, var(--cao-page-secondary-glow), transparent 27rem),
        linear-gradient(var(--cao-page-grid-major) 1px, transparent 1px),
        linear-gradient(90deg, var(--cao-page-grid-major) 1px, transparent 1px),
        linear-gradient(var(--cao-page-grid-minor) 1px, transparent 1px),
        linear-gradient(90deg, var(--cao-page-grid-minor) 1px, transparent 1px);
      background-position: center top;
      background-size: auto, auto, 160px 160px, 160px 160px, 32px 32px, 32px 32px;
    }

    :global(:root[data-theme="dark"] .content-panel:has(.hierarchy-hero)) {
      --cao-page-bg: #030705;
      --cao-page-grid-minor: rgba(63, 185, 80, 0.09);
      --cao-page-grid-major: rgba(63, 185, 80, 0.22);
      --cao-page-glow: rgba(63, 185, 80, 0.22);
      --cao-page-secondary-glow: rgba(63, 185, 80, 0.14);
      --cao-signal-bg: rgba(13, 17, 23, 0.92);
      --cao-signal-border: rgba(240, 246, 252, 0.18);
      --cao-phone-bg: #21262d;
      --cao-phone-border: #57606a;
      --cao-phone-inset: rgba(255, 255, 255, 0.07);
      --cao-phone-shadow: rgba(0, 0, 0, 0.3);
      --cao-phone-speaker: #8c959f;
      --cao-section-bg: rgba(13, 17, 23, 0.84);
      --cao-section-border: rgba(240, 246, 252, 0.15);
      --cao-section-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.28);
      --cao-section-accent-start: 16%;
      --cao-section-accent-end: 7%;
      --cao-section-glow-strength: 30%;
      --cao-story-heading: #f0f6fc;
      --cao-story-text: #b1bac4;
      --cao-story-eyebrow: #b1bac4;
      --cao-product-label: #a4aea6;
      --cao-loop-text: #f0f6fc;
      --cao-loop-muted: #b1bac4;
      --cao-loop-border: #30363d;
      background-image:
        radial-gradient(ellipse 58rem 42rem at 76% 8%, var(--cao-page-glow), transparent 72%),
        radial-gradient(ellipse 54rem 46rem at 16% 48%, var(--cao-page-secondary-glow), transparent 74%),
        linear-gradient(var(--cao-page-grid-major) 1px, transparent 1px),
        linear-gradient(90deg, var(--cao-page-grid-major) 1px, transparent 1px),
        linear-gradient(var(--cao-page-grid-minor) 1px, transparent 1px),
        linear-gradient(90deg, var(--cao-page-grid-minor) 1px, transparent 1px);
    }

    :global(.sl-container:has(> .hierarchy-hero)) {
      width: 100%;
      max-width: none;
      padding-inline: 0;
    }

    .hierarchy-hero {
      --cao-hero-bg: #ffffff;
      --cao-hero-fg: #1f2328;
      --cao-hero-muted: #4d5560;
      --cao-hero-accent: #0969da;
      --cao-hero-border: #d0d7de;
      --cao-secondary-bg: #f6f8fa;
      --cao-secondary-bg-hover: #eaeef2;
      --cao-secondary-border: #d0d7de;
      --cao-secondary-border-hover: #8c959f;
      --cao-hero-glow: rgba(26, 127, 55, 0.1);
      position: relative;
      isolation: isolate;
      display: grid;
      overflow: clip;
      width: 100%;
      margin-inline: 0;
      grid-template-columns: minmax(0, 1fr);
      align-items: center;
      gap: 3.5rem;
      border-block-end: 1px solid var(--cao-hero-border);
      padding: 4.5rem clamp(1rem, 4vw, 3rem) 0;
      background-color: transparent;
      background-image:
        radial-gradient(circle at 50% 100%, var(--cao-hero-glow), transparent 34rem);
      background-position: center top;
      background-size: auto;
      color: var(--cao-hero-fg);
    }

    :global(:root[data-theme="dark"]) .hierarchy-hero {
      --cao-hero-bg: #000000;
      --cao-hero-fg: #f0f6fc;
      --cao-hero-muted: #b1bac4;
      --cao-hero-accent: #58a6ff;
      --cao-hero-border: #21262d;
      --cao-secondary-bg: #21262d;
      --cao-secondary-bg-hover: #30363d;
      --cao-secondary-border: #30363d;
      --cao-secondary-border-hover: #8c959f;
      --cao-hero-glow: rgba(63, 185, 80, 0.13);
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .product-frame {
      position: relative;
      overflow: hidden;
      margin: 0;
      border: 1px solid var(--cao-loop-border);
      border-radius: 0.875rem;
      background: #0d1117;
      box-shadow:
        0 1.5rem 4rem rgba(31, 35, 40, 0.16),
        0 0 0 1px color-mix(in srgb, var(--sl-color-text-accent) 8%, transparent);
    }

    .product-frame-bar {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      border-block-end: 1px solid #30363d;
      padding: 0.65rem 0.85rem;
      background: #161b22;
      color: #8c959f;
      font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.625rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .product-frame-status {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      color: #7ee787;
    }

    .product-frame-status::before {
      width: 0.45rem;
      height: 0.45rem;
      border-radius: 50%;
      background: #3fb950;
      box-shadow: 0 0 0.75rem rgba(63, 185, 80, 0.7);
      content: "";
    }

    .product-image {
      display: block;
      width: 100%;
      height: auto;
    }

    .hero-visual {
      position: relative;
      isolation: isolate;
      display: grid;
      min-height: 0;
      min-width: 0;
      place-items: center;
    }

    .phone-preview {
      position: relative;
      z-index: 1;
      width: clamp(15rem, 21vw, 18rem);
      margin: 0;
      filter: drop-shadow(0 1.25rem 2.25rem var(--cao-phone-shadow));
      animation: phone-float 7s ease-in-out infinite;
      transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .phone-preview:hover {
      transform: translateY(-0.4rem) rotate(0.35deg);
    }

    .phone-shell {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--cao-phone-border);
      border-radius: 1.8rem;
      padding: 0.38rem;
      background: var(--cao-phone-bg);
      box-shadow:
        inset 0 0 0 1px var(--cao-phone-inset),
        0 0 0 1px color-mix(in srgb, var(--cao-phone-border) 45%, transparent);
    }

    .phone-speaker {
      position: absolute;
      z-index: 1;
      top: 0.72rem;
      left: 50%;
      width: 30%;
      height: 0.28rem;
      border-radius: 999px;
      background: var(--cao-phone-speaker);
      transform: translateX(-50%);
    }

    .phone-image {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 1.45rem;
    }

    .hero-callout {
      --callout-color: #3fb950;
      position: absolute;
      z-index: 2;
      display: flex;
      align-items: center;
      color: var(--callout-color);
    }

    .callout-card {
      width: max-content;
      border: 1px solid color-mix(in srgb, var(--callout-color) 45%, var(--cao-signal-border));
      border-radius: 0.55rem;
      padding: 0.4rem 0.6rem;
      background: var(--cao-signal-bg);
      box-shadow: 0 0.5rem 1.25rem rgba(0, 0, 0, 0.13);
      color: var(--cao-loop-text);
      font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0;
      line-height: 1.25;
      white-space: nowrap;
      backdrop-filter: blur(12px);
      animation: callout-card-enter 600ms cubic-bezier(0.22, 1, 0.36, 1) 250ms both;
    }

    .callout-line {
      position: relative;
      width: clamp(2.5rem, 5vw, 4.5rem);
      height: 1px;
      background: var(--callout-color);
      transform-origin: left;
      animation: callout-line-enter 700ms cubic-bezier(0.22, 1, 0.36, 1) 500ms both;
    }

    .callout-line::after {
      position: absolute;
      top: 50%;
      right: -0.3rem;
      width: 0.55rem;
      height: 0.55rem;
      border: 1.5px solid var(--callout-color);
      border-radius: 50%;
      background: var(--cao-page-bg);
      content: "";
      transform: translateY(-50%);
      animation: callout-point-pulse 2.8s ease-in-out 1.2s infinite;
    }

    .callout-health {
      top: 42%;
      left: calc(-10% + 2.5rem);
    }

    .callout-health .callout-line {
      width: 3rem;
    }

    .callout-attention {
      --callout-color: #f85149;
      top: 84%;
      left: calc(50% + 8rem);
      flex-direction: row-reverse;
    }

    .callout-attention .callout-line {
      width: 2.5rem;
      transform-origin: right;
    }

    .callout-attention .callout-line::after {
      right: auto;
      left: -0.3rem;
    }

    @keyframes phone-float {
      0%,
      100% {
        translate: 0 0;
      }
      50% {
        translate: 0 -0.35rem;
      }
    }

    @keyframes callout-line-enter {
      from {
        opacity: 0;
        transform: scaleX(0);
      }
      to {
        opacity: 1;
        transform: scaleX(1);
      }
    }

    @keyframes callout-point-pulse {
      0%,
      100% {
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--callout-color) 0%, transparent);
      }
      50% {
        box-shadow: 0 0 0 0.3rem color-mix(in srgb, var(--callout-color) 18%, transparent);
      }
    }

    @keyframes callout-card-enter {
      from {
        opacity: 0;
        transform: translateY(0.4rem) scale(0.97);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .product-story {
      width: min(calc(100% - 2rem), 76rem);
      margin: 1.25rem auto;
      padding: clamp(2.5rem, 4.5vw, 4rem) clamp(1rem, 4vw, 3rem);
    }

    [data-reveal] {
      transition:
        opacity 650ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-reveal].reveal-pending {
      opacity: 0;
      transform: translateY(1.25rem);
    }

    [data-reveal].is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .product-story {
      --section-accent: #3fb950;
      position: relative;
      isolation: isolate;
      display: grid;
      grid-template-columns: minmax(19rem, 1.35fr) minmax(14rem, 0.7fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: center;
      overflow: hidden;
      border: 1px solid var(--cao-section-border);
      border-radius: 1.5rem;
      background:
        linear-gradient(
          135deg,
          color-mix(in srgb, var(--section-accent) var(--cao-section-accent-start), var(--cao-section-bg)),
          var(--cao-section-bg) 48%,
          color-mix(in srgb, var(--section-accent) var(--cao-section-accent-end), var(--cao-section-bg))
        );
      box-shadow: var(--cao-section-shadow);
      backdrop-filter: blur(12px);
    }

    .product-story::before {
      position: absolute;
      z-index: -1;
      top: -10rem;
      right: -8rem;
      width: 24rem;
      aspect-ratio: 1;
      border-radius: 50%;
      background:
        radial-gradient(
          circle,
          color-mix(in srgb, var(--section-accent) var(--cao-section-glow-strength), transparent),
          transparent 68%
        );
      content: "";
      pointer-events: none;
      animation: section-glow-drift 10s ease-in-out infinite alternate;
    }

    :global(:root[data-theme="dark"]) .product-story {
      background:
        radial-gradient(ellipse 80% 120% at 0% 0%, rgba(63, 185, 80, 0.16), transparent 70%),
        radial-gradient(ellipse 80% 120% at 100% 100%, rgba(63, 185, 80, 0.1), transparent 72%),
        rgba(13, 17, 23, 0.88);
    }

    :global(:root[data-theme="dark"]) .product-story::before {
      display: none;
    }

    .product-story.reverse {
      grid-template-columns: minmax(14rem, 0.7fr) minmax(19rem, 1.35fr);
    }

    .product-story.reverse .product-story-copy {
      order: 2;
    }

    .product-story.reverse .product-shot {
      order: 1;
    }

    .product-story.reverse::before {
      right: auto;
      left: -8rem;
    }

    @keyframes section-glow-drift {
      from {
        opacity: 0.7;
        transform: translate3d(0, 0, 0) scale(0.96);
      }
      to {
        opacity: 1;
        transform: translate3d(-1rem, 1rem, 0) scale(1.04);
      }
    }

    .product-shot {
      background: #0d1117;
      box-shadow:
        0 1.5rem 4rem rgba(31, 35, 40, 0.18),
        0 0 0 1px color-mix(in srgb, var(--sl-color-text-accent) 8%, transparent);
      transition:
        transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 350ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .product-shot:hover {
      transform: translateY(-0.3rem) scale(1.008);
      box-shadow:
        0 2rem 5rem rgba(31, 35, 40, 0.24),
        0 0 0 1px color-mix(in srgb, var(--section-accent) 28%, transparent);
    }

    .product-shot-mobile {
      display: grid;
      min-height: 0;
      place-items: start center;
      background:
        radial-gradient(circle at 50% 15%, rgba(63, 185, 80, 0.13), transparent 55%),
        #0d1117;
    }

    :global(:root[data-theme="light"]) .product-shot-mobile {
      background:
        radial-gradient(circle at 50% 15%, rgba(26, 127, 55, 0.1), transparent 55%),
        #f6f8fa;
    }

    .product-shot-mobile :global(picture[data-theme-picture]) {
      display: block;
      width: 100%;
      margin-inline: auto;
    }

    .product-shot-runs {
      height: clamp(25rem, 38vw, 29rem);
      padding: clamp(1rem, 2.25vw, 1.5rem);
    }

    .product-shot-runs :global(picture[data-theme-picture]) {
      width: min(100%, 22rem);
    }

    .product-shot-value {
      height: clamp(28rem, 38vw, 31rem);
      padding: clamp(1rem, 2.25vw, 1.5rem) clamp(1rem, 3vw, 2.25rem) 0;
    }

    .product-shot-value :global(picture[data-theme-picture]) {
      width: min(100%, 22rem);
    }

    .terminal-story :global(.terminal) {
      transition:
        transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 350ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .terminal-story :global(.terminal:hover) {
      transform: translateY(-0.3rem);
      box-shadow:
        0 2rem 5rem rgba(31, 35, 40, 0.25),
        0 0 0 1px color-mix(in srgb, var(--section-accent) 30%, transparent);
    }

    .story-points {
      display: grid;
      gap: 0.8rem;
      margin: 1.5rem 0 0;
      padding: 0;
      color: var(--cao-story-text);
      list-style: none;
    }

    .story-points li {
      position: relative;
      padding-inline-start: 1.25rem;
      line-height: 1.5;
    }

    .story-points li::before {
      position: absolute;
      top: 0.62em;
      left: 0;
      width: 0.45rem;
      height: 0.45rem;
