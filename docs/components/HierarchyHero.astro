---
import type { HTMLAttributes } from "astro/types";
import dispatchFallback from "../assets/control-plane-dispatch-fallback.svg";
import dispatchFallbackDark from "../assets/control-plane-dispatch-fallback-dark-mode.svg";
import dispatchMotion from "../assets/control-plane-dispatch-motion.svg";
import mobileDispatchFallback from "../assets/control-plane-dispatch-mobile.svg";
import mobileDispatchFallbackDark from "../assets/control-plane-dispatch-mobile-dark-mode.svg";
import mobileDispatchMotion from "../assets/control-plane-dispatch-mobile-motion.svg";
import OpsWizard from "./OpsWizard.astro";

const PAGE_TITLE_ID = "_top";

type HeroAction = {
  attrs?: Omit<HTMLAttributes<"a">, "href">;
  icon?: { name?: string; html?: string };
  link: string;
  text: string;
  variant?: "primary" | "secondary" | "minimal";
};
type HeroData = {
  title: string;
  draft?: boolean;
  hero?: {
    title?: string;
    tagline?: string;
    actions?: HeroAction[];
  };
};

const { data } = (Astro.locals as unknown as { starlightRoute: { entry: { data: HeroData } } }).starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="hierarchy-hero">
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
      {data.draft && <aside class="draft-notice">This page is a draft and may contain incomplete content.</aside>}
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>
    {
      actions.length > 0 && (
        <div class="sl-flex actions">
          {actions.map(
            ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
              <a href={href} class:list={["hero-action", variant || "primary", className]} {...attrs}>
                {text}
                {icon?.html ? <Fragment set:html={icon.html} /> : icon?.name === "right-arrow" && <span aria-hidden="true">→</span>}
              </a>
            ),
          )}
        </div>
      )
    }
  </div>

  <figure class="hierarchy" aria-labelledby="hierarchy-title" aria-describedby="hierarchy-description">
    <figcaption class="visually-hidden">
      <span id="hierarchy-title">Central Agentic Ops execution hierarchy</span>
      <span id="hierarchy-description">A private control plane runs Supply chain, Compliance, Security, and Governance operation packages, routes every package through every authorized organization to every repo, and correlates every outcome into an operational report excerpt.</span>
    </figcaption>

    <div class="desktop-scene">
      <img
        src={dispatchFallback.src}
        width={dispatchFallback.width}
        height={dispatchFallback.height}
        alt=""
        loading="eager"
        decoding="async"
        class="pipeline-image theme-light"
      />
      <img
        src={dispatchFallbackDark.src}
        width={dispatchFallbackDark.width}
        height={dispatchFallbackDark.height}
        alt=""
        loading="eager"
        decoding="async"
        class="pipeline-image theme-dark"
      />
      <img
        src={dispatchMotion.src}
        width={dispatchMotion.width}
        height={dispatchMotion.height}
        alt=""
        loading="eager"
        decoding="async"
        class="dispatch-motion"
      />
    </div>

    <div class="mobile-scene" aria-hidden="true">
      <img
        src={mobileDispatchFallback.src}
        width={mobileDispatchFallback.width}
        height={mobileDispatchFallback.height}
        alt=""
        loading="eager"
        decoding="async"
        class="mobile-pipeline-image theme-light"
      />
      <img
        src={mobileDispatchFallbackDark.src}
        width={mobileDispatchFallbackDark.width}
        height={mobileDispatchFallbackDark.height}
        alt=""
        loading="eager"
        decoding="async"
        class="mobile-pipeline-image theme-dark"
      />
      <img
        src={mobileDispatchMotion.src}
        width={mobileDispatchMotion.width}
        height={mobileDispatchMotion.height}
        alt=""
        loading="eager"
        decoding="async"
        class="dispatch-motion mobile-dispatch-motion"
      />
    </div>
  </figure>

</div>

<section class="operations-overview" aria-labelledby="operations-overview-title">
  <div class="overview-copy">
    <p class="overview-eyebrow">Agentic operations as code</p>
    <h2 id="operations-overview-title">Package once. Operate everywhere.</h2>
    <p>
      Choose a ready operation or build your own. Customize it once, run it safely across any set of repositories, and
      prove the value it delivers.
    </p>
  </div>

  <ol class="operations-path" aria-label="How Central Agentic Ops works">
    <li><span>1</span>Choose or build</li>
    <li><span>2</span>Package your expertise</li>
    <li><span>3</span>Run on one repository or thousands</li>
    <li><span>4</span>Review and measure the outcome</li>
  </ol>

  <p class="overview-boundary">
    Each organization, team, region, or trust boundary can run its own operations hub. Central means managed in one
    place within that boundary, not one global installation. The CAO Evolution operation can spot missing capabilities
    and suggest what to adopt or author next; maintainers still approve every installation and rollout.
  </p>
  <a class="overview-link" href="/gh-aw-cao/architecture-at-a-glance/">See how Central Agentic Ops works <span aria-hidden="true">→</span></a>
</section>

<OpsWizard />

<style>
  @layer starlight.core {
    .hierarchy-hero {
      position: relative;
      isolation: isolate;
      display: grid;
      overflow: clip;
      grid-template-columns: minmax(0, 1fr);
      align-items: center;
      gap: 2rem;
      padding-block: 2rem 3rem;
    }

    .stack,
    .hierarchy {
      animation: hero-enter 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .stack {
      flex-direction: column;
      gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
      text-align: center;
    }

    .copy {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .copy > * {
      max-width: 54ch;
    }

    .hierarchy-hero h1 {
      max-width: 14ch;
      background: var(--sl-color-text-accent);
      background-clip: text;
      color: transparent;
      font-size: clamp(2.25rem, 5vw, 3.25rem) !important;
      font-weight: 700 !important;
      line-height: 1.1 !important;
      letter-spacing: 0;
      animation: none !important;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      hyphens: none !important;
      overflow-wrap: normal !important;
      word-break: normal !important;
    }

    .hierarchy-hero .tagline {
      color: var(--sl-color-gray-2);
      font-size: clamp(1rem, 1.4vw, 1.125rem) !important;
      line-height: 1.55 !important;
    }

    .draft-notice {
      border-inline-start: 0.25rem solid var(--sl-color-orange);
      padding-inline-start: 1rem;
      color: var(--sl-color-gray-2);
    }

    .actions {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem 2rem;
    }

    .hero-action {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      border: 1px solid transparent;
      border-radius: 6px;
      padding: 0.5rem 1rem;
      font-size: var(--sl-text-sm);
      font-weight: 600;
      line-height: 1.1875;
      text-decoration: none;
      outline-offset: 0.25rem;
    }

    .hero-action :global(svg),
    .hero-action > span {
      width: 1rem;
      height: 1rem;
      flex: 0 0 auto;
      font-size: 1rem;
      line-height: 1;
    }

    .hero-action.primary {
      border-color: var(--sl-color-text-accent);
      background: var(--sl-color-text-accent);
      color: var(--sl-color-black);
    }

    .hero-action.secondary {
      border-color: currentColor;
      color: var(--sl-color-white);
    }

    .hero-action.minimal {
      color: var(--sl-color-white);
    }

    .hero-action.dashboard-action {
      position: relative;
      border-color: color-mix(in srgb, var(--sl-color-text-accent) 65%, var(--sl-color-gray-2));
      background: color-mix(in srgb, var(--sl-color-text-accent) 10%, transparent);
      transition: background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
    }

    .hero-action.dashboard-action:hover,
    .hero-action.dashboard-action:focus-visible {
      border-color: var(--sl-color-text-accent);
      background: color-mix(in srgb, var(--sl-color-text-accent) 16%, transparent);
      box-shadow: 0 4px 14px color-mix(in srgb, var(--sl-color-black) 20%, transparent);
    }

    .hero-action.dashboard-action > span {
      transform: rotate(-45deg);
      transition: transform 160ms ease;
    }

    .hero-action.dashboard-action:hover > span,
    .hero-action.dashboard-action:focus-visible > span {
      transform: translate(0.1rem, -0.1rem) rotate(-45deg);
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .hierarchy {
      --scene-width: min(58rem, calc(100vw - 3rem));
      width: var(--scene-width);
      margin-inline: auto;
    }

    .desktop-scene {
      position: relative;
      overflow: hidden;
      width: 100%;
      aspect-ratio: 31 / 14;
      isolation: isolate;
    }

    .pipeline-image,
    .dispatch-motion {
      position: absolute;
      top: -26.053%;
      left: -44.706%;
      width: 145.882% !important;
      height: 145.882% !important;
    }

    .pipeline-image {
      object-fit: contain;
    }

    .theme-dark {
      display: block;
    }

    .theme-light {
      display: none;
    }

    :global(:root[data-theme="light"]) .theme-dark {
      display: none;
    }

    :global(:root[data-theme="light"]) .theme-light {
      display: block;
    }

    .dispatch-motion {
      z-index: 2;
      pointer-events: none;
    }

    .mobile-scene {
      display: none;
    }

    .operations-overview {
      width: min(100%, 64rem);
      margin: 0 auto 3rem;
      padding: 2.5rem clamp(1rem, 4vw, 3rem);
      border-block: 1px solid var(--sl-color-gray-5);
    }

    .overview-copy {
      max-width: 48rem;
    }

    .overview-eyebrow {
      margin: 0 0 0.5rem;
      color: var(--sl-color-text-accent);
      font-size: var(--sl-text-xs);
      font-weight: 700;
      text-transform: uppercase;
    }

    .operations-overview h2 {
      margin: 0;
      color: var(--sl-color-white);
      font-size: clamp(1.75rem, 3vw, 2.5rem);
      line-height: 1.15;
      letter-spacing: 0;
    }

    .overview-copy > p:last-child,
    .overview-boundary {
      color: var(--sl-color-gray-2);
      line-height: 1.6;
    }

    .operations-path {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
      margin: 2rem 0;
      padding: 0;
      list-style: none;
    }

    .operations-path li {
      border-block-start: 2px solid var(--sl-color-text-accent);
      padding-block-start: 0.75rem;
      color: var(--sl-color-white);
      font-weight: 600;
      line-height: 1.4;
    }

    .operations-path span {
      display: block;
      margin-block-end: 0.25rem;
      color: var(--sl-color-text-accent);
      font-size: var(--sl-text-xs);
    }

    .overview-boundary {
      max-width: 56rem;
      margin-block: 0 1rem;
    }

    .overview-link {
      color: var(--sl-color-text-accent);
      font-weight: 600;
      text-decoration: none;
    }

    .overview-link:hover,
    .overview-link:focus-visible {
      text-decoration: underline;
    }

    @keyframes hero-enter {
      from { opacity: 0; transform: translateY(0.75rem); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
      .dispatch-motion {
        display: none;
      }
    }

    @media (max-width: 42rem) {
      .hierarchy-hero {
        width: calc(100% + 2rem);
        margin-inline: -1rem;
        gap: 2rem;
        padding-inline: 1rem !important;
      }

      .hierarchy-hero h1 {
        font-size: 2.125rem !important;
      }

      .hierarchy {
        width: 100vw;
        margin-inline: calc(50% - 50vw);
      }

      .desktop-scene {
        display: none;
      }

      .mobile-scene {
        position: relative;
        display: block;
        width: min(100%, 24.375rem);
        aspect-ratio: 390 / 886;
        margin-inline: auto;
        isolation: isolate;
      }

      .mobile-pipeline-image,
      .mobile-dispatch-motion {
        position: absolute;
        inset: 0;
        width: 100% !important;
        height: 100% !important;
      }

      .mobile-pipeline-image {
        object-fit: contain;
      }

      .operations-overview {
        margin-block-end: 2rem;
        padding-block: 2rem;
      }

      .operations-path {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .stack,
      .hierarchy {
        animation: none;
      }

      .dispatch-motion {
        display: none;
      }

      .hero-action.dashboard-action,
      .hero-action.dashboard-action > span {
        transition: none;
      }
    }

    @media (min-width: 64rem) {
      .hierarchy-hero {
        min-height: auto;
        padding-block: 3rem 4rem;
      }

      .stack {
        max-width: 54rem;
        margin-inline: auto;
      }
    }
  }
</style>