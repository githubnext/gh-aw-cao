---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import CampaignReadmeContent from "../../components/CampaignReadmeContent.astro";
import { catalogEntries } from "../../lib/catalog";

export function getStaticPaths() {
  return catalogEntries.map((entry) => ({ params: { slug: entry.slug } }));
}

const entry = catalogEntries.find(({ slug }) => slug === Astro.params.slug);
if (!entry) throw new Error(`Unknown campaign: ${Astro.params.slug}`);

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const repositoryBase = "https://github.com/githubnext/gh-aw-cao";
const campaignUrl = `${repositoryBase}/tree/main/${entry.slug}`;
const manifestUrl = `${repositoryBase}/blob/main/${entry.slug}/${entry.manifestFile}`;
const editUrl = entry.readmePath
  ? `${repositoryBase}/edit/main/${entry.readmePath}`
  : `${repositoryBase}/edit/main/${entry.slug}/${entry.manifestFile}`;
const installCommand = `gh aw add githubnext/gh-aw-cao/${entry.slug}@<catalog-release>`;
const ReadmeContent = entry.ReadmeContent;
---

<StarlightPage
  frontmatter={{
    title: entry.name,
    description: entry.description,
    editUrl,
  }}
>
  <section class="campaign-overview" aria-label="What it does">
    <p>{entry.description}</p>
    <p class="campaign-meta">
      {entry.experimental ? "Experimental campaign" : "Campaign"}
      <span aria-hidden="true">·</span>
      {entry.includes.length} {entry.includes.length === 1 ? "workflow" : "workflows"}
      <span aria-hidden="true">·</span>
      Requires gh-aw {entry.minVersion}
    </p>
  </section>

  {
    ReadmeContent ? (
      <section class="campaign-guide" aria-labelledby="campaign-guide">
        <h2 id="campaign-guide">Campaign guide</h2>
        <div class="campaign-readme">
          <CampaignReadmeContent>
            <ReadmeContent />
          </CampaignReadmeContent>
        </div>
      </section>
    ) : (
      <section class="campaign-guide" aria-labelledby="campaign-guide">
        <h2 id="campaign-guide">Campaign guide</h2>
        <p>
          This campaign does not yet include a README. Use its manifest and workflow sources as the authoritative campaign
          inventory until a campaign guide is added.
        </p>
        <a href={campaignUrl}>Browse this campaign on GitHub</a>
      </section>
    )
  }

  <section class="install-campaign" aria-labelledby="install-campaign">
    <h2 id="install-campaign">Add this campaign</h2>
    <p>
      From a private control repository, install a published release tag:
    </p>
    <pre><code>{installCommand}</code></pre>
    <p>
      Replace <code>&lt;catalog-release&gt;</code> with the latest published tag shown in
      <a href={`${repositoryBase}/releases/latest`}> GitHub Releases</a>.
      Follow the <a href={`${basePath}/getting-started/`}>Quickstart</a> for prerequisites and first-run validation, or
      <a href={campaignUrl}> view the campaign source on GitHub</a>.
    </p>
  </section>

  <section class="campaign-inventory" aria-labelledby="campaign-inventory">
    <h2 id="campaign-inventory">Campaign inventory</h2>
    <ul>
      {entry.includes.map((includedPath) => <li><code>{includedPath}</code></li>)}
    </ul>
    <a href={manifestUrl}>View {entry.manifestFile} on GitHub</a>
  </section>
</StarlightPage>

<style>
  .campaign-meta {
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
  }

  .campaign-meta span {
    margin-inline: 0.35rem;
  }

  .campaign-guide,
  .install-campaign,
  .campaign-inventory {
    margin-block-start: 2.5rem;
  }

  .campaign-guide :global(pre),
  .install-campaign pre {
    max-width: 100%;
    overflow-x: auto;
  }

  .campaign-inventory ul {
    padding-inline-start: 1.25rem;
  }
</style>