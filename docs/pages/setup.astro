---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import OpsWizard from "../components/OpsWizard.astro";
---

<StarlightPage
  frontmatter={{
    title: "Setup wizard",
    description: "Generate an agent-ready prompt for a bounded Central Agentic Ops setup.",
    template: "splash",
    editUrl: false,
  }}
>
<main class="setup-page">
  <OpsWizard />
  <p class="setup-alternative">
    Prefer direct commands? Follow the <a href="/gh-aw-cao/getting-started/">15-minute Quickstart</a>.
  </p>
  </main>
</StarlightPage>

<style>
  .setup-page {
    width: 100%;
    min-height: calc(100svh - var(--sl-nav-height));
  }

  .setup-alternative {
    margin: 0;
    padding: 1.5rem;
    color: var(--sl-color-gray-2);
    text-align: center;
  }
</style>
