{
  "extends": "cao.json",
  "control-plane": {
    "web": {
      "host": {
        "target": {
          "module": "container",
          "name": "coolify"
        },
        "redis": {
          "module": "local",
          "url-env": "REDIS_URL",
          "namespace-env": "REDIS_NAMESPACE",
          "allow-private-plaintext": true,
          "tls": {
            "mode": "disabled"
          }
        }
      }
    }
  }
}
